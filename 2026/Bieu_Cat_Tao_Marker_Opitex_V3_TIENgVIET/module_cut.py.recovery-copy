            _target = os.path.splitext(_target)[0] + '.xlsm'
        _tmp_xlsx = os.path.join(
            os.path.dirname(_target),
            '~cutplan_vba_' + str(os.getpid()) + '_' + str(int(time.time() * 1000)) + '.xlsx'
        )
        try:
