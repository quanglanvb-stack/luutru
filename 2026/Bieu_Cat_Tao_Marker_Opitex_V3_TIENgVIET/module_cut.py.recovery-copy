    def _info(self,key):
        widget=getattr(self.owner,'entry_'+key,None)
        try: return str(widget.get()).strip() if widget is not None else ''
        except Exception: return ''

    def refresh_info(self):
        self.info_var.set('Khách hàng: '+(self._info('customer') or '—')+'   |   Mã hàng: '+(self._info('style') or '—')+'   |   Đợt: '+(self._info('batch') or '—')+'   |   Màu: '+(self._info('color') or '—')+'   |   Ngày: '+(self._info('actual_export_date') or datetime.now().strftime('%d/%m/%Y')))
        for key in ('customer','style','batch','season','color','actual_export_date','prepared_by'):
            widget=getattr(self.owner,'entry_'+key,None)
            if widget is not None:
                try: widget.bind('<KeyRelease>',lambda _e:self.refresh_info(),add='+')
                except Exception: pass

    def _order_qty(self):
        total=0
        for po in getattr(self.owner,'po_list',[]) or []:
            try: total+=int(po.get('total',0) or 0)
            except Exception: pass
        return total

    def on_cut_type_change(self,event=None):
        bias=self.cut_type_var.get()=='Thiên'
        try: self.angle_entry.configure(state=('normal' if bias else 'disabled'))
        except Exception: pass
        self.vars['note'].set('')

    def on_splice_change(self):
        self.segment_entry.configure(state=('disabled' if self.splice_var.get() else 'normal'))
        self.trim_entry.configure(state=('normal' if self.splice_var.get() else 'disabled'))

    def _default_note(self):
        cut=self.cut_type_var.get()
        band=self.vars['band_width'].get().strip()
        if cut=='Thiên':
            angle=self.vars['angle'].get().strip() or '45'
            return f'Viền cắt {band}cm {angle}° - đủ chiều dài viền' if band else f'Viền cắt thiên {angle}° - đủ chiều dài viền'
        return self.note_templates.get(cut,'')

    @staticmethod
    def _number(value,label):
        try: x=float(str(value).strip().replace(',','.'))
        except Exception: raise ValueError('Vui lòng nhập '+label+' là số hợp lệ.')
        if x<=0: raise ValueError(label+' phải lớn hơn 0.')
        return x

    def _fabric_consumption(self,cut_type,qty,trim_length_m,fabric_width_cm,band_width_cm,angle_deg=45.0):
        """Tổng vải m trước hao hụt, định mức vải trên mỗi áo, số dải thiên."""
        fabric_width=fabric_width_cm/100.0
        band_width=band_width_cm/100.0
        total_trim=qty*trim_length_m
        if cut_type=='Dọc':
            lanes=int(fabric_width_cm//band_width_cm)
            if lanes<1: raise ValueError('Bản viền lớn hơn khổ vải; không cắt được dải dọc.')
            total_fabric=total_trim/lanes
            diagonal_cuts=0
        elif cut_type=='Ngang':
            cuts=math.ceil(total_trim/fabric_width)
            total_fabric=cuts*band_width
            diagonal_cuts=0
        else:
            if not (0.0 < angle_deg < 90.0): raise ValueError('Góc thiên phải lớn hơn 0° và nhỏ hơn 90°.')
            sine=math.sin(math.radians(angle_deg))
            diagonal_span=fabric_width/sine
            diagonal_cuts=math.ceil(total_trim/diagonal_span)
            total_fabric=diagonal_cuts*band_width/sine
        return total_fabric,total_fabric/qty,diagonal_cuts

    def _default_note_for_row(self,row):
        band=f"{row['band_width']:g}"
        if row['cut_type']=='Thiên': return f"Viền cắt {band}cm {row['angle']:g}°"
        return f"Viền cắt {band}cm {row['cut_type'].lower()}"

    def add_row(self):
        v={k:x.get().strip() for k,x in self.vars.items()}
        if not v['color']: v['color']=self._info('color')
        if not v['fabric']: v['fabric']='VẢI CHÍNH'
        try:
            qty=int(v['qty'])
            if qty<=0: raise ValueError('Số lượng áo phải là số nguyên lớn hơn 0.')
            if self.splice_var.get():
                trim_length=self._number(v['trim_length'],'chiều dài viền/áo')
                segment_lengths=[]
            else:
                raw_segments=v.get('segment_lengths','').strip()
                if not raw_segments: raise ValueError('Khi chọn không nối viền, vui lòng nhập chiều dài từng đoạn, ngăn cách bằng dấu chấm phẩy (;).')
                segment_lengths=[self._number(part.strip(),'chiều dài từng đoạn') for part in raw_segments.split(';') if part.strip()]
                if not segment_lengths: raise ValueError('Vui lòng nhập ít nhất một đoạn viền.')
                trim_length=sum(segment_lengths)
            fabric_width=self._number(v['fabric_width'],'khổ vải')
            band_width=self._number(v['band_width'],'bản viền')
            try: extra_pct=float((v.get('extra_pct','5') or '5').strip().replace(',','.'))
            except Exception: raise ValueError('Vui lòng nhập % thêm là một số hợp lệ.')
            if extra_pct<0: raise ValueError('% thêm không được nhỏ hơn 0.')
            angle=45.0
            if self.cut_type_var.get()=='Thiên': angle=self._number(v['angle'],'góc thiên')
            segment_breakdown=[]
            if self.splice_var.get():
                total_fabric,norm,diagonal_cuts=self._fabric_consumption(self.cut_type_var.get(),qty,trim_length,fabric_width,band_width,angle)
            else:
                cut_type=self.cut_type_var.get()
                if cut_type=='Thiên':
                    sine=math.sin(math.radians(angle))
                    strand_length=(fabric_width/100.0)/sine
                    fabric_per_strand=(band_width/100.0)/sine
                    diagonal_cuts=0
                    for segment in segment_lengths:
                        pieces_per_strand=int(math.floor(strand_length/segment+1e-9))
                        if pieces_per_strand<1:
                            raise ValueError('Đoạn '+str(segment)+' m dài hơn một sợi thiên khả dụng ('+format(strand_length,'.2f')+' m); không thể tính kiểu không nối với khổ và góc hiện tại.')
                        strands_needed=math.ceil(qty/pieces_per_strand)
                        part_fabric=strands_needed*fabric_per_strand
                        diagonal_cuts+=strands_needed
                        segment_breakdown.append({'length':segment,'pieces_per_strand':pieces_per_strand,'strands':strands_needed,'fabric_m':part_fabric,'norm':part_fabric/qty})
                    total_fabric=diagonal_cuts*fabric_per_strand
                elif cut_type=='Ngang':
                    strand_length=fabric_width/100.0
                    pieces_per_segment=[int(math.floor(strand_length/segment+1e-9)) for segment in segment_lengths]
                    if any(n<1 for n in pieces_per_segment):
                        raise ValueError('Có đoạn dài hơn chiều ngang khổ vải; không thể cắt liền đoạn đó theo kiểu ngang.')
                    segment_breakdown=[{'length':segment,'pieces_per_strand':n,'strands':math.ceil(qty/n),'fabric_m':math.ceil(qty/n)*(band_width/100.0),'norm':math.ceil(qty/n)*(band_width/100.0)/qty} for segment,n in zip(segment_lengths,pieces_per_segment)]
                    cuts=sum(item['strands'] for item in segment_breakdown)
                    total_fabric=cuts*(band_width/100.0)
                    diagonal_cuts=0
                else:
                    parts=[self._fabric_consumption(cut_type,qty,length,fabric_width,band_width,angle) for length in segment_lengths]
                    total_fabric=sum(part[0] for part in parts)
                    diagonal_cuts=sum(part[2] for part in parts)
                    segment_breakdown=[{'length':segment,'pieces_per_strand':None,'strands':part[2],'fabric_m':part[0],'norm':part[0]/qty} for segment,part in zip(segment_lengths,parts)]
                norm=total_fabric/qty
        except ValueError as exc:
            messagebox.showwarning('Kiểm tra dữ liệu',str(exc),parent=self.winfo_toplevel()); return
        meters=total_fabric*(1+extra_pct/100.0)
        yards=meters*self.YARDS_PER_METER
        row={**v,'cut_type':self.cut_type_var.get(),'splice_allowed':bool(self.splice_var.get()),'segment_lengths':segment_lengths,'segment_breakdown':segment_breakdown,'extra_pct':extra_pct,'qty':qty,'trim_length':trim_length,'fabric_width':fabric_width,'band_width':band_width,'angle':angle if self.cut_type_var.get()=='Thiên' else None,'diagonal_cuts':diagonal_cuts,'norm':norm,'meters':meters,'yards':yards}
        row['note']=self._default_note_for_row(row)
        if v['note']: row['note']+=' | '+v['note']
        self.rows.append(row); self.refresh_rows()
        for key in ('qty','trim_length','segment_lengths','fabric_width','band_width','angle'): self.vars[key].set('')
        self.vars['note'].set(self._default_note())

    def _segment_norm_summary(self,row):
        parts=row.get('segment_breakdown',[]) or []
        return '; '.join(f"{item['length']:g}m: {str(item['pieces_per_strand'])+' áo/sợi' if item.get('pieces_per_strand') is not None else 'tính riêng'}, ĐM {item['norm']:.5f}m/áo" for item in parts)

    def refresh_rows(self):
        self.tree.delete(*self.tree.get_children())
        for i,r in enumerate(self.rows):
            self.tree.insert('','end',iid=str(i),values=(r['color'],r.get('shade',''),r['fabric'],r['thread'],r['cut_type'],r['diagonal_cuts'] or '',r['qty'],f"{r['trim_length']:.3f}",f"{r['fabric_width']:g}",f"{r['band_width']:g}",f"{r['angle']:g}" if r['angle'] else '',f"{r['extra_pct']:g}%",self._segment_norm_summary(r),f"{r['norm']:.5f}",f"{r['meters']:.1f}",f"{r['yards']:.1f}",r['note']))
        self.status_var.set(f'{len(self.rows)} dòng · Tổng {sum(r["meters"] for r in self.rows):.1f} m · {sum(r["yards"] for r in self.rows):.1f} Y')

    def get_project_state(self):
        return {
            'cut_type': self.cut_type_var.get(),
            'splice_allowed': bool(self.splice_var.get()),
            'form': {key: var.get() for key, var in self.vars.items()},
            'rows': [dict(row) for row in self.rows],
        }

    def apply_project_state(self,state):
        if not isinstance(state,dict): return
        cut_type=str(state.get('cut_type','Ngang') or 'Ngang')
        self.cut_type_var.set(cut_type if cut_type in ('Thiên','Ngang','Dọc') else 'Ngang')
        self.splice_var.set(bool(state.get('splice_allowed',True)))
        form=state.get('form') if isinstance(state.get('form'),dict) else {}
        for key,var in self.vars.items():
            try: var.set(str(form.get(key,'') or ''))
            except Exception: pass
        if not self.vars['extra_pct'].get().strip(): self.vars['extra_pct'].set('5')
        self.on_cut_type_change()
        self.on_splice_change()
        try: self.vars['note'].set(str(form.get('note','') or ''))
        except Exception: pass
        rows=[]
        for row in state.get('rows',[]) or []:
            if isinstance(row,dict): rows.append(dict(row))
        self.rows=rows
        self.refresh_rows()
        self.refresh_info()

