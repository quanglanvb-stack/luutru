    def _get_extra_surplus_rows(self, silent=False):
        """V85: số dòng dư có công thức chừa thêm cho MỖI Shade khi xuất Excel."""
        raw = None
        try:
            raw = self.extra_surplus_rows_var.get() if hasattr(self, 'extra_surplus_rows_var') else self.EXTRA_SURPLUS_ROWS
            value = int(float(str(raw).strip().replace(',', '.')))
        except Exception:
            if silent:
                return max(0, int(getattr(self, 'EXTRA_SURPLUS_ROWS', 0) or 0))
            raise ValueError('Số dòng dư / Shade phải là số nguyên từ 0 đến 20.')
        if value < 0 or value > 20:
            if silent:
                value = min(20, max(0, value))
            else:
                raise ValueError('Số dòng dư / Shade phải từ 0 đến 20.')
        self.EXTRA_SURPLUS_ROWS = int(value)
        try:
            if hasattr(self, 'extra_surplus_rows_var'):
                self.extra_surplus_rows_var.set(str(int(value)))
        except Exception:
            pass
        return int(value)

    def _get_roll_extra_blank_rows(self, silent=False):
        """V100: số dòng trống chừa thêm cho mỗi khung bàn trong sheet PHÂN CÂY."""
        try:
            raw = (self.roll_extra_blank_rows_var.get()
                   if hasattr(self, 'roll_extra_blank_rows_var')
                   else self.ROLL_EXTRA_BLANK_ROWS)
            value = int(float(str(raw).strip().replace(',', '.')))
        except Exception:
            if silent:
                return max(0, int(getattr(self, 'ROLL_EXTRA_BLANK_ROWS', 3) or 0))
            raise ValueError('Số dòng trống / bàn PHÂN CÂY phải là số nguyên từ 0 đến 20.')
        if value < 0 or value > 20:
            if silent:
                value = min(20, max(0, value))
            else:
                raise ValueError('Số dòng trống / bàn PHÂN CÂY phải từ 0 đến 20.')
        self.ROLL_EXTRA_BLANK_ROWS = int(value)
        try:
            if hasattr(self, 'roll_extra_blank_rows_var'):
                self.roll_extra_blank_rows_var.set(str(int(value)))
