        """Lấy thông tin chung hiện tại để điền sẵn cho công cụ ghép V42."""
        def _entry(name):
            w = getattr(self, f"entry_{name}", None)
            try:
                return w.get().strip() if w is not None else ""
            except Exception:
                return ""

        po_names = [str(x.get("po", "") or "").strip() for x in self.po_list]
        po_names = [x for x in po_names if x]
        return {
            "customer": _entry("customer"),
            "style_code": _entry("style"),
            "color": _entry("color"),
            "batch": _entry("batch"),
            "season": _entry("season"),
