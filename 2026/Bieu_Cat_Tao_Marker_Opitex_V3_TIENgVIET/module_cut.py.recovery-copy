            widths = {'table':70,'ratio':260,'length':90,'plies':80}
            for col in cols:
                tree.heading(col, text=titles.get(col, labels.get(col,col)))
                tree.column(col, width=widths.get(col, 90), minwidth=60, anchor='center', stretch=(col=='ratio'))
            vs=ttk.Scrollbar(frame,orient='vertical',command=tree.yview); hs=ttk.Scrollbar(frame,orient='horizontal',command=tree.xview)
            tree.configure(yscrollcommand=vs.set,xscrollcommand=hs.set)
            tree.grid(row=0,column=0,sticky='nsew'); vs.grid(row=0,column=1,sticky='ns'); hs.grid(row=1,column=0,sticky='ew')
            frame.grid_rowconfigure(0,weight=1); frame.grid_columnconfigure(0,weight=1)
            for ti,tb in enumerate(opt.get('cutting_tables', [])):
                rm=tb.get('ratio_map',{}) or {}
                tree.insert('', 'end', values=[tb.get('table',f'B{ti+1}'),tb.get('ratio',''),f"{float(tb.get('raw_length',tb.get('length',0)) or 0):.2f}",tb.get('plies',0)] + [rm.get(k,0) for k in sizes])
            info=opt.get('adjust_info',{}) or {}
            diff=info.get('raw_diff',{}) or {}
            for label, vals in [('DƯ/THIẾU',diff)]:
                tree.insert('', 'end', values=[label,'','', ''] + [vals.get(k,0) for k in sizes], tags=('total',))
            tree.tag_configure('total',background='#dbeafe',font=('Segoe UI',9,'bold'))
            bi=info.get('balance_info',{}) or {}
            tk.Label(frame,text=f"Dư tổng: {bi.get('final_positive_surplus', info.get('final_positive_surplus', 0))} • Chuyển cỡ: {info.get('transfer_used', 0)}",anchor='w',bg='white',fg='#475569').grid(row=2,column=0,sticky='ew',padx=8,pady=5)
        selected={'index':None}
        buttons=tk.Frame(win,bg='#f8fafc'); buttons.pack(fill='x',padx=10,pady=(0,10))
        def choose(i): selected['index']=i; win.destroy()
        for oi in range(len(options)):
            tk.Button(buttons,text=f'✓ CHỌN PHƯƠNG ÁN {oi+1}',command=lambda n=oi:choose(n),font=('Segoe UI',9,'bold'),bg='#2563eb',fg='white',relief='flat',padx=14,pady=8).pack(side='left',padx=5)
        tk.Button(buttons,text='HỦY',command=win.destroy,font=('Segoe UI',9),bg='#64748b',fg='white',relief='flat',padx=16,pady=8).pack(side='right',padx=5)
        self.root.wait_window(win)
        if selected['index'] is None:
            return None
        chosen=dict(result); opt=options[selected['index']]
        for key in ('cutting_tables','preview_tables','lot_summary','adjust_info'):
            chosen[key]=opt.get(key,chosen.get(key))
        chosen.pop('plan_options',None)
        return chosen

    def recalculate_fabric_dashboard(self):
        idx = self._selected_dashboard_fabric_index()
        if idx is None:
            messagebox.showwarning('Cảnh báo','Hãy chọn loại vải cần tính lại.')
            return

        # V139: chụp lại bàn đã tính của TẤT CẢ loại vải khác trước khi
        # LƯU THÔNG TIN / đồng bộ Shade làm thay đổi cache-key.
        preserved_results = self._snapshot_dashboard_results(exclude_idx=idx)

        if not self._apply_fabric_dashboard_editors(silent=False):
            return

        try:
            self.fabric_recalc_button.config(
                state='disabled',
                text='⏳  ĐANG TÍNH LOẠI NÀY...',
                bg='#94a3b8',
                fg='white'
            )
            self.root.update_idletasks()
        except Exception:
            pass

        result, error = self._calculate_single_fabric_dashboard(idx)

        try:
            self.fabric_recalc_button.config(
                state='normal',
                text='↻  TÍNH LẠI LOẠI VẢI NÀY',
                bg='#2563eb',
                fg='white'
            )
        except Exception:
            pass

        if error:
            # Nếu loại đang tính lỗi thì vẫn khôi phục kết quả các loại khác.
            self._restore_dashboard_results(preserved_results, exclude_idx=idx)
            self._promote_individual_cache_to_global()
            self.fabric_dash_cache_var.set('LỖI')
            self.fabric_dash_note_var.set(error)
            self._refresh_fabric_dashboard_list(select_index=idx)
            messagebox.showerror('Lỗi tính toán', error)
            return

        if result.get('plan_options'):
            result = self._choose_fabric_plan_option(result)
            if result is None:
                self._restore_dashboard_results(preserved_results, exclude_idx=idx)
                return

        # Ghi kết quả mới của đúng loại đang chọn.
        self._cache_dashboard_result(idx, result)

        # Sau khi _calculate_single_fabric_dashboard() đồng bộ lại Shade,
        # cache-key của các loại khác có thể đã đổi. Gắn lại các kết quả cũ
        # với key mới để bàn của chúng không biến mất.
        self._restore_dashboard_results(preserved_results, exclude_idx=idx)

        # Nếu tất cả loại vải đều đã có kết quả thì tạo lại cache toàn bộ.
        # Xuất Excel sẽ dùng lại cache này, không cần tính lại.
        self._promote_individual_cache_to_global()

        self._refresh_fabric_dashboard_list(select_index=idx)
        self.status_var.set(
            f"Đã tính lại riêng {self.fabric_list[idx].get('name','')}. "
            "Bàn của các loại vải khác được giữ nguyên."
        )

    def recalculate_all_fabrics_dashboard(self):
        """V137: TÍNH TOÀN BỘ luôn tính lại từ đầu, không dùng kết quả/cache cũ."""
        idx = self._selected_dashboard_fabric_index()
        if idx is not None:
            if not self._apply_fabric_dashboard_editors(silent=False):
                return

        if not self.fabric_list:
            messagebox.showwarning('Cảnh báo', 'Chưa có loại vải để tính.')
            return

        # XÓA TOÀN BỘ CACHE trước khi tính.
        # Đây là điểm khác với xuất Excel: nút TÍNH TOÀN BỘ bắt buộc tối ưu lại từ đầu.
        self._cut_plan_cache_key = None
        self._cut_plan_cache_results = None
        self._fabric_preview_cache = {}

        self._calc_all_progress_begin()
        self._calc_all_progress(2, 'Đang chuẩn bị dữ liệu')

        try:
            results, error = self.calculate_cutting_plan(force_recalculate=True)
        except Exception as e:
            self._calc_all_progress_end(success=False)
            messagebox.showerror('Lỗi tính toán', str(e))
            return

        if error:
            self._calc_all_progress_end(success=False)
            messagebox.showerror('Lỗi tính toán', error)
            return

        self._calc_all_progress(94, 'Đang cập nhật kết quả từng loại vải')

        self._fabric_preview_cache = {}
        for i, result in enumerate(results or []):
            self._cache_dashboard_result(i, result)

        # Sau khi tính toàn bộ xong mới tạo cache mới để Xuất Excel dùng lại.
        self._promote_individual_cache_to_global()

        self._calc_all_progress(100, 'Hoàn tất tính toàn bộ')
        self._refresh_fabric_dashboard_list(select_index=idx if idx is not None else 0)
        self.status_var.set(
            'Đã TÍNH LẠI TOÀN BỘ từ đầu. Xuất Excel sẽ dùng kết quả này để xuất nhanh.'
        )
        self._calc_all_progress_end(success=True)

    def _apply_modern_theme_recursive(self, widget=None):
        """V131: làm giao diện đồng nhất/compact mà không đổi logic widget."""
        if widget is None:
            widget = self.root
        card = getattr(self, 'UI_CARD', '#ffffff')
        bg = getattr(self, 'UI_BG', '#eef2f6')
        text = getattr(self, 'UI_TEXT', '#243447')
        muted = getattr(self, 'UI_MUTED', '#6b7c8f')
        border = getattr(self, 'UI_BORDER', '#d7dee7')
        old_light = {'#f0f0f0', '#eef4fb', '#f7fbff', '#fffaf0', '#f4f6f7', 'SystemButtonFace'}
        try:
            cls = widget.winfo_class()
            current_bg = ''
            try:
                current_bg = str(widget.cget('bg'))
            except Exception:
                pass

            if isinstance(widget, tk.LabelFrame):
                widget.configure(bg=card, fg=text, font=('Segoe UI', 9, 'bold'),
                                 bd=1, relief='solid', padx=10, pady=7,
                                 highlightthickness=0)
            elif isinstance(widget, tk.Frame):
                # Không đụng header hoặc các frame có màu chức năng riêng.
                if current_bg in old_light or current_bg.lower() in {x.lower() for x in old_light}:
                    widget.configure(bg=card if widget is not getattr(self, 'cut_main_body', None) else bg)
            elif isinstance(widget, tk.Label):
                # Giữ label tiêu đề/header có nền màu riêng; các label nội dung chuyển sang Segoe UI.
                f = str(widget.cget('font'))
                size = 9
                if '18' in f or '15' in f: size = 15
                elif '13' in f: size = 11
                elif '11' in f: size = 9
                elif '10' in f: size = 9
                elif '8' in f: size = 8
                bold = 'bold' in f.lower()
                widget.configure(font=('Segoe UI', size, 'bold' if bold else 'normal'))
                if current_bg in old_light or current_bg.lower() in {x.lower() for x in old_light}:
                    widget.configure(bg=card)
                    try:
                        fg = str(widget.cget('fg'))
                        if fg in ('#555555', '#566573', '#7f8c8d', 'gray', 'grey'):
                            widget.configure(fg=muted)
                        elif fg in ('black', '#000000'):
                            widget.configure(fg=text)
                    except Exception:
                        pass
            elif isinstance(widget, tk.Entry):
                widget.configure(font=('Segoe UI', 9), relief='solid', bd=1,
                                 highlightthickness=1, highlightbackground=border,
                                 highlightcolor=getattr(self, 'UI_BLUE', '#246bce'))
            elif isinstance(widget, tk.Spinbox):
                widget.configure(font=('Segoe UI', 9), relief='solid', bd=1,
                                 highlightthickness=1, highlightbackground=border,
                                 highlightcolor=getattr(self, 'UI_BLUE', '#246bce'))
            elif isinstance(widget, tk.Button):
                # Giữ màu chức năng sẵn có nhưng chuyển nút sang dạng phẳng/gọn.
                widget.configure(font=('Segoe UI', 9, 'bold'), relief='flat', bd=0,
                                 cursor='hand2', padx=max(6, int(widget.cget('padx') or 0)),
                                 pady=min(6, max(3, int(widget.cget('pady') or 0))))
            elif isinstance(widget, (tk.Checkbutton, tk.Radiobutton)):
                widget.configure(font=('Segoe UI', 9), activebackground=card,
                                 selectcolor='white')
                if current_bg in old_light or current_bg.lower() in {x.lower() for x in old_light}:
                    widget.configure(bg=card)
            elif isinstance(widget, tk.Canvas):
                # Chỉ đổi canvas nền giao diện, không đổi canvas dùng để vẽ nội dung đặc biệt.
                if current_bg in old_light or current_bg.lower() in {x.lower() for x in old_light}:
                    widget.configure(bg=card, highlightthickness=0)
        except Exception:
            pass

        try:
            for child in widget.winfo_children():
                self._apply_modern_theme_recursive(child)
        except Exception:
            pass

    def _widget_is_inside(self, widget, ancestor):
        """Kiểm tra widget có nằm bên trong ancestor hay không."""
        try:
            cur = widget
            while cur is not None:
                if cur == ancestor:
                    return True
                parent_name = cur.winfo_parent()
                if not parent_name:
                    break
                cur = cur._nametowidget(parent_name)
        except Exception:
            pass
        return False

    def _nearest_scrollable_widget(self, widget):
        """V109: tìm vùng cuộn gần nhất dưới con trỏ (Canvas/Treeview/Listbox/Text)."""
        cur = widget
        while cur is not None:
            if cur is getattr(self, 'cut_main_canvas', None):
                return None
            if isinstance(cur, (tk.Canvas, tk.Listbox, tk.Text, ttk.Treeview)):
                return cur
            try:
                parent_name = cur.winfo_parent()
                if not parent_name:
                    break
                cur = cur._nametowidget(parent_name)
            except Exception:
                break
        return None

    def _apply_responsive_heights(self):
        """V110: co/giãn vùng nhiều dòng theo dữ liệu + chiều cao cửa sổ, tránh vùng trống lớn."""
        try:
            h = max(480, int(self.root.winfo_height() or 800))
            compact = h < 700

            if hasattr(self, 'po_grid_canvas'):
                # V186: giữ bảng PO gọn khoảng 10 dòng để nhập liệu ổn định,
                # tránh co/dãn liên tục gây cảm giác chớp.
                self.po_grid_canvas.configure(height=324)

            if hasattr(self, 'lot_inventory_canvas'):
                count = len(getattr(self, 'lot_inventory_entries', []) or [])
                rows = max(5, min(8 if compact else 10, count + 1))
                self.lot_inventory_canvas.configure(height=28 + rows * 23)

            if hasattr(self, 'global_lot_detail_canvas'):
                lots = getattr(self, 'global_lot_rows', []) or []
                if not lots:
                    dh = 54
                else:
                    roll_count = sum(max(1, len(x.get('rolls_detail') or [])) for x in lots if isinstance(x, dict))
                    estimated = 36 + roll_count * 24 + len(lots) * 58
                    dh = max(90, min(220 if compact else 320, estimated))
                self.global_lot_detail_canvas.configure(height=dh)

            if hasattr(self, 'info_tree'):
                n = len(getattr(self, 'custom_info_list', []) or [])
                self.info_tree.configure(height=max(3, min(6 if compact else 9, n + 2)))

            if hasattr(self, 'fabric_tree'):
                n = len(getattr(self, 'fabric_list', []) or [])
                self.fabric_tree.configure(height=max(3, min(6 if compact else 9, n + 2)))
        except Exception:
            pass

    def _on_root_responsive_configure(self, event):
        """V110: debounce khi kéo cửa sổ để giao diện mượt và không nhảy chiều cao liên tục."""
        try:
            if getattr(event, 'widget', None) is not self.root:
                return
            old = getattr(self, '_responsive_after_id', None)
            if old:
                try:
                    self.root.after_cancel(old)
                except Exception:
                    pass
            self._responsive_after_id = self.root.after(140, self._apply_responsive_heights)
        except Exception:
            pass

    def _cancel_smooth_refresh(self):
        """Hủy lần refresh nặng đang chờ.

        Dùng trước các thao tác TÍNH/XUẤT để tránh một refresh giao diện chen vào
        giữa lúc đang xử lý.
        """
        job = getattr(self, '_smooth_refresh_after_id', None)
        if job:
            try:
                self.root.after_cancel(job)
            except Exception:
                pass
        self._smooth_refresh_after_id = None

    def _schedule_smooth_refresh(self, delay=320, select_index=None):
        """Gom các refresh nặng thành 1 lần sau khi người dùng nhập xong.

        Trước đây mỗi FocusOut của PO/Shade có thể chạy _sync_global_lots() và
        update_fabric_table() ngay lập tức, làm Tkinter vẽ lại nhiều widget và
        tạo cảm giác chớp/khựng. Bản này chỉ refresh khi người dùng tạm ngừng
        nhập hoặc rời khỏi ô nhập.
        """
        try:
            if select_index is not None:
                self._smooth_refresh_select_index = select_index

            old = getattr(self, '_smooth_refresh_after_id', None)
            if old:
                try:
                    self.root.after_cancel(old)
                except Exception:
                    pass

            def _run():
                self._smooth_refresh_after_id = None

                # Nếu người dùng vẫn đang ở một ô nhập thì chưa redraw bảng.
                # Dữ liệu gốc đã được commit; chỉ phần hiển thị phụ được hoãn.
                try:
                    focus = self.root.focus_get()
                except Exception:
                    focus = None
                if isinstance(focus, (tk.Entry, ttk.Entry, ttk.Combobox)):
                    try:
                        self._smooth_refresh_after_id = self.root.after(220, _run)
                        return
                    except Exception:
                        pass

                idx = getattr(self, '_smooth_refresh_select_index', None)
                self._smooth_refresh_select_index = None

                try:
                    self._refresh_fabric_po_selector()
                except Exception:
                    pass
                try:
                    self._refresh_fabric_lot_selector()
                except Exception:
                    pass
                try:
                    if self.fabric_list:
                        self._sync_global_lots()
                except Exception:
                    pass
                try:
                    self.update_fabric_table(select_index=idx)
                except Exception:
                    pass

            self._smooth_refresh_after_id = self.root.after(max(80, int(delay)), _run)
        except Exception:
            pass

    def _on_global_mousewheel(self, event):
        """V109: con lăn ưu tiên vùng nhiều dòng dưới chuột; ngoài ra cuộn trang chính."""
        try:
            if getattr(event, 'num', None) == 4:
                steps = -3
            elif getattr(event, 'num', None) == 5:
                steps = 3
            else:
                delta = int(getattr(event, 'delta', 0) or 0)
                if delta == 0:
                    return
                steps = -3 if delta > 0 else 3

            pointer = None
            try:
                pointer = self.root.winfo_containing(event.x_root, event.y_root)
            except Exception:
                pass

            shift = bool(int(getattr(event, 'state', 0) or 0) & 0x0001)
            target = self._nearest_scrollable_widget(pointer)
            if target is not None:
                try:
                    if shift and hasattr(target, 'xview_scroll'):
                        first, last = target.xview()
                        if first > 1e-6 or last < 0.999999:
                            target.xview_scroll(steps, 'units')
                            return 'break'
                    if hasattr(target, 'yview_scroll'):
                        first, last = target.yview()
                        if first > 1e-6 or last < 0.999999:
                            target.yview_scroll(steps, 'units')
                            return 'break'
                except Exception:
                    pass

            # V149: menu PHÂN SỐ CẮT & BIỂU 10 không có canvas chính.
            canvas = getattr(self, 'cut_main_canvas', None)
            if canvas is None:
                return
            canvas.yview_scroll(steps, 'units')
            return 'break'
        except Exception:
            return

