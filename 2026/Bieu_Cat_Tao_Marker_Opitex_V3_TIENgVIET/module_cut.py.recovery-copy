                  getattr(self, "btn_export_bottom", None), getattr(self, "btn_export_form10_bottom", None)):
            if b is not None:
                try:
                    b.pack_forget()
                except Exception:
                    pass

        if mode == "form10":
            if hasattr(self, "btn_export_form10"):
                self.btn_export_form10.pack(side="right", padx=(0, 8))
            if hasattr(self, "btn_export_form10_bottom"):
                self.btn_export_form10_bottom.pack(side="right", padx=(0, 8))
        elif mode == "cut":
