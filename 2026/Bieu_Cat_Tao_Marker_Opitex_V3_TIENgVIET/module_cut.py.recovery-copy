class SerialNumberPanel(tk.Frame):
    """Tạo bảng đánh số tem nhiều cỡ, nhúng trong menu tác nghiệp cắt."""
    ROWS_PER_COLUMN = 48
    COLUMNS_PER_PAGE = 9
    NUMBERS_PER_PAGE = ROWS_PER_COLUMN * COLUMNS_PER_PAGE

    def __init__(self, parent):
        super().__init__(parent, bg='#f4f7fb')
        self.batches = []
        main = tk.Frame(self, bg='#f4f7fb')
        main.pack(fill='both', expand=True, padx=18, pady=16)
        tk.Label(main, text='PHẦN MỀM ĐÁNH SỐ TEM NHIỀU CỠ',
                 font=('Segoe UI', 16, 'bold'), fg='#173b61', bg='#f4f7fb').pack(anchor='w')
        tk.Label(main, text='Thêm cỡ, tổng số tem và số thứ tự bắt đầu; xuất chung thành file Excel A4 ngang.',
                 font=('Segoe UI', 9), fg='#526477', bg='#f4f7fb').pack(anchor='w', pady=(4, 12))

        form = tk.LabelFrame(main, text='Thông tin từng cỡ', bg='#f4f7fb', fg='#173b61',
                             font=('Segoe UI', 9, 'bold'), padx=10, pady=9)
        form.pack(fill='x')
        self.size_var = tk.StringVar()
        self.total_var = tk.StringVar()
        self.start_var = tk.StringVar(value='1')
        for i, (label, var) in enumerate((('Cỡ', self.size_var), ('Tổng số tem', self.total_var),
                                          ('STT bắt đầu', self.start_var))):
            tk.Label(form, text=label, bg='#f4f7fb', fg='#334155').grid(row=0, column=i, sticky='w', padx=(0, 12))
            ttk.Entry(form, textvariable=var).grid(row=1, column=i, sticky='ew', padx=(0, 12), pady=(4, 0))
            form.columnconfigure(i, weight=1)
        tk.Button(form, text='+ THÊM CỠ', command=self.add_size, bg='#16834a', fg='white',
                  activebackground='#116a3b', relief='flat', padx=15, pady=4,
                  font=('Segoe UI', 9, 'bold'), cursor='hand2').grid(row=1, column=3, padx=4, sticky='ew')

        tk.Label(main, text='Danh sách cỡ sẽ xuất Excel', font=('Segoe UI', 10, 'bold'),
                 fg='#173b61', bg='#f4f7fb').pack(anchor='w', pady=(12, 5))
        table = ttk.Frame(main)
        table.pack(fill='both', expand=True)
        self.tree = ttk.Treeview(table, columns=('size','total','start','end'), show='headings', height=10, selectmode='extended')
        for col, title, width in [('size','Cỡ',140),('total','Tổng số tem',150),('start','STT bắt đầu',150),('end','STT kết thúc',150)]:
            self.tree.heading(col, text=title); self.tree.column(col, width=width, anchor='center')
        sb = ttk.Scrollbar(table, orient='vertical', command=self.tree.yview)
        self.tree.configure(yscrollcommand=sb.set)
        self.tree.pack(side='left', fill='both', expand=True); sb.pack(side='right', fill='y')
        actions = tk.Frame(main, bg='#f4f7fb'); actions.pack(fill='x', pady=9)
        ttk.Button(actions, text='Xóa cỡ đang chọn', command=self.remove_selected).pack(side='left')
        ttk.Button(actions, text='Xóa tất cả', command=self.clear_all).pack(side='left', padx=8)
        tk.Button(actions, text='XUẤT EXCEL (.XLSX)', command=self.export, bg='#2375c6', fg='white',
                  activebackground='#1b62a8', relief='flat', padx=16, pady=6,
                  font=('Segoe UI', 9, 'bold'), cursor='hand2').pack(side='right')
        self.status = tk.StringVar(value='Chưa có cỡ nào được thêm.')
        tk.Label(main, textvariable=self.status, fg='#526477', bg='#f4f7fb', font=('Segoe UI', 9)).pack(anchor='w')
        tk.Label(main, text='A4 ngang · 9 cụm cột × 48 dòng = 432 tem/trang. Hết trang tự sang trang tiếp.',
                 fg='#64748b', bg='#f4f7fb', font=('Segoe UI', 8)).pack(anchor='w', pady=(5,0))

    def add_size(self):
        size = self.size_var.get().strip()
        try:
            total, start = int(self.total_var.get().strip()), int(self.start_var.get().strip())
            if total <= 0 or start < 0: raise ValueError
        except ValueError:
            messagebox.showwarning('Kiểm tra dữ liệu', 'Tổng số tem phải lớn hơn 0; STT bắt đầu là số nguyên không âm.', parent=self.winfo_toplevel()); return
        if not size:
            messagebox.showwarning('Thiếu dữ liệu', 'Vui lòng nhập cỡ.', parent=self.winfo_toplevel()); return
        self.batches.append({'size': size, 'total': total, 'start': start})
        self.size_var.set(''); self.total_var.set(''); self.start_var.set(str(start + total)); self.refresh()

    def refresh(self):
        self.tree.delete(*self.tree.get_children())
        for i, item in enumerate(self.batches):
            self.tree.insert('', 'end', iid=str(i), values=(item['size'], item['total'], item['start'], item['start'] + item['total'] - 1))
        total = sum(x['total'] for x in self.batches)
        pages = (total + self.NUMBERS_PER_PAGE - 1) // self.NUMBERS_PER_PAGE
        self.status.set(f'{len(self.batches)} cỡ · Tổng {total} tem · Dự kiến {pages} trang A4 ngang')

    def remove_selected(self):
        selected = self.tree.selection()
        if not selected:
            messagebox.showinfo('Thông báo', 'Hãy chọn cỡ cần xóa.', parent=self.winfo_toplevel()); return
        for i in sorted((int(x) for x in selected), reverse=True): del self.batches[i]
        self.refresh()

    def clear_all(self):
        if self.batches and messagebox.askyesno('Xác nhận', 'Xóa toàn bộ danh sách cỡ?', parent=self.winfo_toplevel()):
            self.batches.clear(); self.start_var.set('1'); self.refresh()

    def build_entries(self):
        columns = []
        for batch in self.batches:
            nums = [(n, batch['size']) for n in range(batch['start'], batch['start'] + batch['total'])]
            columns.extend(nums[i:i+self.ROWS_PER_COLUMN] for i in range(0, len(nums), self.ROWS_PER_COLUMN))
        return columns

    def export(self):
        if not self.batches:
            messagebox.showinfo('Thông báo', 'Hãy thêm ít nhất một cỡ trước khi xuất Excel.', parent=self.winfo_toplevel()); return
        filename = filedialog.asksaveasfilename(parent=self.winfo_toplevel(), title='Lưu bảng đánh số',
            defaultextension='.xlsx', filetypes=[('Excel Workbook','*.xlsx')], initialfile='Danh_so_nhieu_co_A4_ngang.xlsx')
        if not filename: return
        from openpyxl.worksheet.pagebreak import Break
        from openpyxl.worksheet.page import PageMargins
        columns_data = self.build_entries()
        wb = Workbook(); ws = wb.active; ws.title = 'Danh so tem'
        number_cols = [1,4,7,10,13,16,19,22,25]; size_cols = [c+1 for c in number_cols]
        for c in range(1,27): ws.column_dimensions[ws.cell(1,c).column_letter].width = 9.15 if c in number_cols+size_cols else 1.6
        thin = Side(style='thin', color='000000'); border = Border(left=thin,right=thin,top=thin,bottom=thin)
        center = Alignment(horizontal='center', vertical='center'); font = Font(name='Arial', size=10)
        pages = (len(columns_data) + self.COLUMNS_PER_PAGE - 1) // self.COLUMNS_PER_PAGE
        for page in range(pages):
            if page: ws.row_breaks.append(Break(id=ws.max_row))
            first_row = ws.max_row + 1
            page_columns = columns_data[page*self.COLUMNS_PER_PAGE:(page+1)*self.COLUMNS_PER_PAGE]
            for block in range(self.COLUMNS_PER_PAGE):
                column_data = page_columns[block] if block < len(page_columns) else None
                for offset in range(self.ROWS_PER_COLUMN):
                    row = first_row + offset; nc = ws.cell(row, number_cols[block]); sc = ws.cell(row, size_cols[block])
                    if column_data is not None and offset < len(column_data): nc.value, sc.value = column_data[offset]
                    if column_data is not None:
                        for cell in (nc,sc): cell.border=border; cell.alignment=center; cell.font=font
            for offset in range(self.ROWS_PER_COLUMN): ws.row_dimensions[first_row+offset].height=15
        ws.sheet_view.showGridLines=False; ws.sheet_properties.pageSetUpPr.fitToPage=True
        ws.page_setup.orientation='landscape'; ws.page_setup.paperSize=ws.PAPERSIZE_A4
        ws.page_setup.fitToWidth=1; ws.page_setup.fitToHeight=0
        ws.page_margins=PageMargins(left=.25,right=.25,top=.13,bottom=.13,header=0,footer=0)
        ws.print_area=f'A1:Z{ws.max_row}'
        try: wb.save(filename)
        except Exception as exc:
            messagebox.showerror('Lỗi lưu file', str(exc), parent=self.winfo_toplevel()); return
        total=sum(x['total'] for x in self.batches)
        messagebox.showinfo('Hoàn thành', f'Đã xuất Excel thành công.\nSố cỡ: {len(self.batches)}\nTổng số tem: {total}\nSố trang A4 ngang: {pages}\n\n{filename}', parent=self.winfo_toplevel())


