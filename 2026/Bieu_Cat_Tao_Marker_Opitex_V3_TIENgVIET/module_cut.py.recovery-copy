                img.height = 106
                ws.add_image(img, "A1")
            except Exception:
                pass

        ws.merge_cells("I1:R2")
        t = ws["I1"]
        t.value = "BIỂU PHÂN BỔ SỐ BÀN CẮT"
        t.font = Font(name="Times New Roman", size=20, bold=True)
        t.alignment = Alignment(horizontal="center", vertical="center")

        info_font = Font(name="Times New Roman", size=11, bold=True)
        info_cells = {
            "E3": f"KHÁCH HÀNG : {data['customer']}",
            "E4": f"MÃ HÀNG : {data['style_code']}",
            "J4": f"MÀU : {data['color']}",
            "O4": f"ĐỢT : {data['batch']}",
            "R4": f"TỔNG SỐ LƯỢNG : {data['total']}",
            "Y4": f"PO : {data['po']}",
            "AC3": f"DATE : {data['date']}",
        }
        for addr, val in info_cells.items():
            ws[addr] = val
            ws[addr].font = info_font
            ws[addr].alignment = Alignment(vertical="center")

        thin = Side(style="thin", color="000000")
        medium = Side(style="medium", color="000000")
        border_thin = Border(left=thin, right=thin, top=thin, bottom=thin)
        fill_head = PatternFill("solid", fgColor="F2F2F2")
        font_head = Font(name="Times New Roman", size=10, bold=True)
        font_data = Font(name="Times New Roman", size=10)
        font_size_title = Font(name="Times New Roman", size=20, bold=True)

        # Vị trí đóng gói hiện tại: mỗi trang có 4 cột khối.
        page_index = 0
        slot = 0
        cursor_row = first_data_top
        page_top = first_data_top
        page_bottom = page_top + page_bottom_offset
        last_used_row = first_data_top
        page_break_rows = []

        def new_slot():
            nonlocal page_index, slot, cursor_row, page_top, page_bottom
            slot += 1
            if slot >= 4:
                slot = 0
                page_index += 1
                page_top = first_data_top + page_index * page_body_rows
                page_bottom = page_top + page_bottom_offset
                cursor_row = page_top
                page_break_rows.append(page_top)
            else:
                cursor_row = page_top

        def rows_fit_from(start_row, table_count):
            # 2 dòng tiêu đề + số dòng bàn
            return start_row + 2 + table_count - 1 <= page_bottom

        def full_block_capacity(start_row):
            # số bàn tối đa còn vừa từ dòng hiện tại tới hết chiều cao trang
            return max(0, page_bottom - (start_row + 2) + 1)

        def manufacturer_lot_for_shade(shade_name):
            """Lấy các LOT nhà sản xuất đã ghi trên cây thuộc Shade này."""
            owner = getattr(self, "owner", None)
            shade_key = str(shade_name or "").strip().casefold()
            if not owner or not shade_key:
                return ""
            marks = []
            for lot_row in getattr(owner, "global_lot_rows", []) or []:
                if str(lot_row.get("lot", "") or "").strip().casefold() != shade_key:
                    continue
                details = lot_row.get("rolls_detail", []) or []
                for detail in details:
                    mark = str(detail.get("lot_mark", "") or "").strip()
                    if mark and mark not in marks:
                        marks.append(mark)
                fallback = str(lot_row.get("lot_mark", "") or "").strip()
                if fallback and fallback not in marks:
                    marks.append(fallback)
            return ", ".join(marks)

        def draw_block(item, rows_data, r0, c0, table_no_start, continued=False):
            nonlocal last_used_row
            c1 = c0 + block_width - 1
            r_head2 = r0 + 1
            data_start = r0 + 2
            data_end = data_start + len(rows_data) - 1

            ws.row_dimensions[r0].height = title_h
            ws.row_dimensions[r_head2].height = subhead_h
            for rr in range(data_start, data_end + 1):
                ws.row_dimensions[rr].height = data_h

            ws.cell(r0, c0, "SIZE")
            ws.merge_cells(start_row=r0, start_column=c0 + 1, end_row=r0, end_column=c1)
            ws.cell(r0, c0 + 1, item["size"] if not continued else f"{item['size']} (tiếp)")
            ws.cell(r0, c0).font = font_head
            ws.cell(r0, c0).alignment = Alignment(horizontal="center", vertical="center")
            ws.cell(r0, c0 + 1).font = font_size_title
            ws.cell(r0, c0 + 1).alignment = Alignment(horizontal="center", vertical="center")

            ws.cell(r_head2, c0, "SL size")
            ws.cell(r_head2, c0 + 1, "Shade")
            ws.cell(r_head2, c0 + 2, "Lot nhà\nsản xuất")
            ws.cell(r_head2, c0 + 3, "Số bàn")
            ws.cell(r_head2, c0 + 4, "SL Bàn")
            ws.merge_cells(start_row=r_head2, start_column=c0 + 5, end_row=r_head2, end_column=c1)
            ws.cell(r_head2, c0 + 5, "Số thứ tự")
            for cc in range(c0, c1 + 1):
                cell = ws.cell(r_head2, cc)
                cell.font = font_head
                cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
                cell.fill = fill_head

            if data_end >= data_start:
                # SL size là tổng của tất cả các Shade trong cỡ.
                if data_end > data_start:
                    ws.merge_cells(start_row=data_start, start_column=c0, end_row=data_end, end_column=c0)
                ws.cell(data_start, c0, item["qty"])
                ws.cell(data_start, c0).font = Font(name="Times New Roman", size=11, bold=True)
                ws.cell(data_start, c0).alignment = Alignment(horizontal="center", vertical="center")

                # Gộp riêng Shade và Lot nhà sản xuất theo từng nhóm liên tiếp.
                for col_offset, value_index in ((1, 3), (2, 4)):
                    group_start = 0
                    while group_start < len(rows_data):
                        group_value = rows_data[group_start][value_index]
                        group_end = group_start
                        while group_end + 1 < len(rows_data) and rows_data[group_end + 1][value_index] == group_value:
                            group_end += 1
                        rr1 = data_start + group_start
                        rr2 = data_start + group_end
                        if rr2 > rr1:
                            ws.merge_cells(start_row=rr1, start_column=c0 + col_offset, end_row=rr2, end_column=c0 + col_offset)
                        ws.cell(rr1, c0 + col_offset, group_value)
                        ws.cell(rr1, c0 + col_offset).font = Font(name="Times New Roman", size=10, bold=True)
                        ws.cell(rr1, c0 + col_offset).alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
                        group_start = group_end + 1

            for j, row_data in enumerate(rows_data):
                q, seq_start, seq_end, light_name, manufacturer_lot, local_table_no = row_data
                rr = data_start + j
                # Khi tách sang Shade mới, Số bàn đánh lại từ 1.
                ws.cell(rr, c0 + 3, local_table_no)
                ws.cell(rr, c0 + 4, q)
                ws.cell(rr, c0 + 5, seq_start)
                ws.cell(rr, c0 + 6, "->")
                ws.cell(rr, c0 + 7, seq_end)
                for cc in range(c0 + 3, c1 + 1):
                    ws.cell(rr, cc).font = font_data
                    ws.cell(rr, cc).alignment = Alignment(horizontal="center", vertical="center")

            for rr in range(r0, data_end + 1):
                for cc in range(c0, c1 + 1):
                    ws.cell(rr, cc).border = border_thin
            for cc in range(c0, c1 + 1):
                top_cell = ws.cell(r0, cc)
                top_cell.border = Border(top=medium, left=top_cell.border.left, right=top_cell.border.right, bottom=top_cell.border.bottom)
                bot_cell = ws.cell(data_end, cc)
                bot_cell.border = Border(bottom=medium, left=bot_cell.border.left, right=bot_cell.border.right, top=bot_cell.border.top)
            for rr in range(r0, data_end + 1):
                lc = ws.cell(rr, c0)
                rc = ws.cell(rr, c1)
                lc.border = Border(left=medium, right=lc.border.right, top=lc.border.top, bottom=lc.border.bottom)
                rc.border = Border(right=medium, left=rc.border.left, top=rc.border.top, bottom=rc.border.bottom)

            widths = [7.2, 5.5, 8.0, 5.5, 6.5, 7.5, 3.0, 7.5]
            for off, w in enumerate(widths):
                ws.column_dimensions[get_column_letter(c0 + off)].width = w

            last_used_row = max(last_used_row, data_end)
            return data_end

        for item in data["sizes"]:
            # Mỗi cỡ có thể có nhiều Shade. Số thứ tự sản phẩm chạy liên tiếp,
            # nhưng Số bàn sẽ đánh lại từ 1 khi sang Shade mới.
            seq = item["start_no"]
            all_rows = []
            for light_index, light in enumerate(item["lights"]):
