    def _on_fabric_tree_double_click(self, event):
        if not hasattr(self, 'fabric_tree'):
            return
        item = self.fabric_tree.identify_row(event.y)
        col_id = self.fabric_tree.identify_column(event.x)
        if not item or not col_id or not col_id.startswith('#'):
            return
        try:
            col_index = int(col_id[1:]) - 1
            columns = list(self.fabric_tree['columns'])
            col_key = columns[col_index]
            row_index = self.fabric_tree.index(item)
        except Exception:
            return
        readonly = {'lot_count','lot_meters','roll_count'}
        if col_key in readonly or not (0 <= row_index < len(self.fabric_list)):
            return
        if col_key == 'cut_mode':
            self._open_fabric_mode_popup(row_index, item)
            return
        if col_key == 'optimizer_mode':
            self._open_optimizer_mode_popup(row_index, item)
            return
        if col_key in ('po_apply', 'lot_apply'):
            self._open_fabric_select_popup(row_index, col_key, item)
            return
        if col_key in ('export_roll', 'export_edit'):
            # Đã xử lý bằng click tích/bỏ tích ở _on_fabric_tree_single_click.
            return

        def save(value):
            fabric = self.fabric_list[row_index]
            try:
                if col_key == 'name':
                    if not value.strip():
                        raise ValueError('Tên loại vải không được để trống.')
                    fabric['name'] = value.strip()
                elif col_key == 'cut_mode':
                    fabric['cut_mode'] = self._fabric_mode_key_from_label(value)
                elif col_key == 'po_apply':
                    mode, targets = self._parse_fabric_po_text(value)
                    fabric['po_mode'], fabric['po_targets'] = mode, list(targets)
                elif col_key == 'lot_apply':
                    mode, targets = self._parse_fabric_lot_text(value)
                    fabric['lot_mode'], fabric['lot_targets'] = mode, list(targets)
                elif col_key == 'norm':
                    num = float(str(value).replace(',', '.'))
                    if num <= 0:
                        raise ValueError('Định mức phải lớn hơn 0.')
                    fabric[col_key] = num
                elif col_key == 'min_length':
                    txt = str(value).strip().replace(',', '.')
                    num = float(txt) if txt else 1.0
                    if num < 0:
                        raise ValueError('Chiều dài tối thiểu không được âm.')
                    max_now = float(fabric.get('max_length', 0) or 0)
                    if max_now > 0 and num > max_now + 1e-9:
                        raise ValueError('Chiều dài tối thiểu không được lớn hơn chiều dài tối đa.')
                    fabric[col_key] = num
                elif col_key == 'max_length':
                    txt = str(value).strip().replace(',', '.')
                    num = float(txt) if txt else 0.0
                    if num < 0:
                        raise ValueError('Chiều dài tối đa không được âm.')
                    if num <= 0 and int(fabric.get('max_products', 0) or 0) <= 0:
                        raise ValueError('Phải có Chiều dài tối đa hoặc SP tối đa / sơ đồ.')
                    min_now = float(fabric.get('min_length', 1.0) or 0)
                    if num > 0 and min_now > num + 1e-9:
                        raise ValueError('Chiều dài tối đa không được nhỏ hơn chiều dài tối thiểu.')
                    fabric[col_key] = num
                elif col_key == 'max_products':
                    txt = str(value).strip().replace(',', '.')
                    num = int(float(txt)) if txt else 0
                    if num < 0:
                        raise ValueError('SP tối đa không được âm.')
                    if num <= 0 and float(fabric.get('max_length', 0) or 0) <= 0:
                        raise ValueError('Phải có SP tối đa / sơ đồ hoặc Chiều dài tối đa.')
                    fabric[col_key] = num
                elif col_key == 'export_roll':
                    fabric['export_roll'] = self._parse_yes_no(value, fabric.get('export_roll', True))
                elif col_key == 'export_edit':
                    fabric['export_edit'] = self._parse_yes_no(value, fabric.get('export_edit', True))
            except ValueError as e:
                messagebox.showerror('Lỗi', str(e))
                return
            self._sync_global_lots()
            self.update_fabric_table(select_index=row_index)
            self.status_var.set('Đã sửa trực tiếp danh sách loại vải')

        self._begin_tree_cell_edit(self.fabric_tree, item, col_key, save)

    def paste_fabrics_from_clipboard(self):
        """Dán loại vải (hàm tương thích cũ; giao diện hiện không dùng nút dán)."""
        try:
            text = self.root.clipboard_get()
        except Exception:
            messagebox.showwarning('Cảnh báo', 'Clipboard không có dữ liệu để dán!')
            return
        rows = [r for r in str(text).replace('\r','').split('\n') if r.strip()]
        if not rows:
            return
        parsed = [r.split('\t') for r in rows]
        if parsed and ('LOẠI VẢI' in str(parsed[0][0]).strip().upper() or 'TEN LOAI VAI' in str(parsed[0][0]).strip().upper()):
            parsed = parsed[1:]
        added = bad = 0
        errors = []
        for rn, vals in enumerate(parsed, start=1):
            vals = list(vals) + [''] * (7-len(vals))
            name = str(vals[0]).strip()
            if not name:
                continue
            try:
                po_mode, po_targets = self._parse_fabric_po_text(vals[1])
                lot_mode, lot_targets = self._parse_fabric_lot_text(vals[2])
                norm = float(str(vals[3]).strip().replace(',', '.'))
                max_len = float(str(vals[4]).strip().replace(',', '.'))
                if norm <= 0 or max_len <= 0:
                    raise ValueError('Định mức/chiều dài tối đa phải > 0')
                export_roll = self._parse_yes_no(vals[5], True)
                export_edit = self._parse_yes_no(vals[6], True)
            except Exception as e:
                bad += 1; errors.append(f'Dòng {rn}: {e}')
                continue
            self.fabric_list.append({
                'name': name, 'cut_mode': 'auto', 'norm': norm, 'min_length': 1.0, 'max_length': max_len,
                'balance_pct': 1.0,
                'reserve_m': 1.0, 'reserve_plies': 1,
                'po_mode': po_mode, 'po_targets': list(po_targets),
                'lot_mode': lot_mode, 'lot_targets': list(lot_targets),
                'export_roll': export_roll, 'export_edit': export_edit,
                'lots': [], 'rolls': [], 'shades': []
            })
            added += 1
        self._sync_global_lots(); self.update_fabric_table()
        self.status_var.set(f'Dán loại vải: thêm {added}, lỗi {bad}')
        if bad:
            msg = '\n'.join(errors[:8])
            if len(errors) > 8: msg += f'\n... và {len(errors)-8} lỗi khác'
            messagebox.showwarning('Dán loại vải', msg)

    def _ensure_lot_roll_details(self, row, force_rebuild=False):
        """Đảm bảo mỗi Shade có danh sách từng cây riêng: tên cây + mét.

        Khi dữ liệu chỉ có SỐ CÂY/TỔNG MÉT, chương trình chia đều để tạo các cây 1..N.
        Sau khi người dùng sửa từng cây, tổng SỐ CÂY/SỐ MÉT được tính ngược từ chi tiết.
        """
        try:
            cnt = max(0, int(float(row.get('roll_count', 0) or 0)))
        except Exception:
            cnt = 0
        try:
            total = max(0.0, float(row.get('meters', 0) or 0))
        except Exception:
            total = 0.0
        details = row.get('rolls_detail') if isinstance(row.get('rolls_detail'), list) else []
        valid = (len(details) == cnt and all(isinstance(x, dict) for x in details))
        if force_rebuild or not valid:
            old = details if isinstance(details, list) else []
            details = []
            each = total / cnt if cnt else 0.0
            made = 0.0
            for i in range(cnt):
                old_item = old[i] if i < len(old) and isinstance(old[i], dict) else {}
                if force_rebuild or not old_item:
                    met = (total - made) if i == cnt - 1 else round(each, 4)
                else:
                    try: met = max(0.0, float(old_item.get('meters', each) or 0))
                    except Exception: met = each
                made += met
                try:
                    _yd = max(0.0, float(old_item.get('yards', 0) or 0))
                except Exception:
                    _yd = 0.0
                if _yd <= 0 and float(met or 0) > 0:
                    _yd = float(met or 0) / self.YARD_TO_METER
                details.append({
                    'roll': str(old_item.get('roll', '') or (i + 1)),
                    'lot_mark': str(old_item.get('lot_mark', row.get('lot_mark', '')) or ''),
                    'yards': max(0.0, float(_yd or 0)),
                    'meters': max(0.0, float(met or 0)),
                    'fabric_width_cm': str(old_item.get('fabric_width_cm', '') or ''),
                })
            # Nếu giữ dữ liệu cũ làm tổng bị lệch đáng kể, scale lại theo tổng mới.
            cur = sum(float(x.get('meters', 0) or 0) for x in details)
            if cnt and total >= 0 and abs(cur - total) > 0.005:
                if cur > 0:
                    scale = total / cur
                    made = 0.0
                    for i, d in enumerate(details):
                        met = (total - made) if i == len(details)-1 else round(float(d.get('meters',0))*scale, 4)
                        d['meters'] = max(0.0, met); made += met
                else:
                    each = total / cnt if cnt else 0.0
                    made = 0.0
                    for i, d in enumerate(details):
                        met = (total-made) if i == cnt-1 else round(each,4)
                        d['meters'] = max(0.0, met); made += met
            for d in details:
                try:
                    d['yards'] = max(0.0, float(d.get('meters', 0) or 0)) / self.YARD_TO_METER
                except Exception:
                    d['yards'] = 0.0
            row['rolls_detail'] = details
        else:
            # Dự án cũ chưa có SỐ Y: tự suy ra từ số mét để hiển thị trên phần mềm.
            for d in details:
                if not isinstance(d, dict):
                    continue
                try:
                    yd = max(0.0, float(d.get('yards', 0) or 0))
                except Exception:
                    yd = 0.0
                if yd <= 0:
                    try:
                        yd = max(0.0, float(d.get('meters', 0) or 0)) / self.YARD_TO_METER
                    except Exception:
                        yd = 0.0
                d['yards'] = yd
        return row.get('rolls_detail', [])

    def _recalc_lot_from_roll_details(self, row):
        details = [x for x in (row.get('rolls_detail') or []) if isinstance(x, dict)]
        cleaned = []
        for i, d in enumerate(details, start=1):
            name = str(d.get('roll', '') or '').strip()
            try: met = max(0.0, float(d.get('meters', 0) or 0))
            except Exception: met = 0.0
            # Cây không tên nhưng có mét vẫn tự đặt số để không làm mất dữ liệu.
            if not name and met <= 0:
                continue
            if not name:
                name = str(i)
            try:
                yd = max(0.0, float(d.get('yards', 0) or 0))
            except Exception:
                yd = 0.0
            if yd <= 0 and met > 0:
                yd = met / self.YARD_TO_METER
            cleaned.append({'roll': name,
                            'lot_mark': str(d.get('lot_mark', row.get('lot_mark','')) or ''),
                            'yards': yd,
                            'meters': met,
                            'fabric_width_cm': str(d.get('fabric_width_cm', '') or '')})
        row['rolls_detail'] = cleaned
        row['roll_count'] = len(cleaned)
        row['meters'] = round(sum(float(x.get('meters',0) or 0) for x in cleaned), 4)
        # Lot nhà sản xuất cấp Shade dùng làm mặc định; cây riêng có thể khác.
        marks = [str(x.get('lot_mark','') or '').strip() for x in cleaned if str(x.get('lot_mark','') or '').strip()]
        if marks and len(set(marks)) == 1:
            row['lot_mark'] = marks[0]
        return row

    def create_lot_inventory_tab(self, parent):
        """V110 - Kho CÂY/Shade: mỗi dòng nhập là MỘT CÂY thật, không phải số lượng cây.

        Thứ tự dán: Shade - SỐ CÂY - SỐ Y - Lot nhà sản xuất - SỐ MÉT - Khổ vải (cm). SỐ MÉT tự quy đổi từ SỐ Y.
        Cột SỐ CÂY là tên/mã cây (ví dụ 01, 02, A15...). Tổng số cây của Shade
        được tự đếm từ số dòng cây đang có trong Shade đó.
        """
        top = tk.LabelFrame(parent, text="KHO CÂY / Shade - MỖI DÒNG = 1 CÂY",
                            font=('Arial', 11, 'bold'), padx=10, pady=10)
        top.pack(fill='x', padx=15, pady=(15, 6))
        tk.Label(top, text=(
        "Thứ tự dán: Shade | SỐ CÂY | SỐ Y | Lot nhà sản xuất | SỐ MÉT | Khổ vải (cm). "
            "SỐ MÉT tự tính theo 1Y = 0,9144m, không cần dán cột mét. "
