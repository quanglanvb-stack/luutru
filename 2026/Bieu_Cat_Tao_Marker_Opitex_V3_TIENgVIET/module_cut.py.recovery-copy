                tk.Button(foot, text='🗑 XÓA Shade', command=del_lot, font=('Arial', 8, 'bold'),
                          bg='#c0392b', fg='white').pack(side='right', padx=3)
                total_c += int(row.get('roll_count', 0) or 0)
                total_m += float(row.get('meters', 0) or 0)

            self.global_lot_summary_var.set(
                f'TỔNG KHO: {len(self.global_lot_rows)} SHADE | {total_c} CÂY | {total_m:.2f} m'
            )
            self._apply_responsive_heights()
            if hasattr(self, '_refresh_fabric_lot_selector'):
                self._refresh_fabric_lot_selector()
            if self.fabric_list:
                self.update_fabric_table()

        self.refresh_global_lot_inventory = refresh

        def save_grid():
            """Lưu từng dòng cây; nếu Shade + SỐ CÂY đã có thì cập nhật cây đó."""
            added = updated = bad = 0
            for entries in self.lot_inventory_entries:
                vals = [e.get().strip() for e in entries]
                if not any(vals):
                    continue
                lot, roll_name, yards_text, mark, meters_text = vals[:5]
                width_text = vals[5] if len(vals)>5 else ''
                if lot.upper() in ('SHADE', 'LOT') and roll_name.upper() in ('SỐ CÂY', 'SO CAY'):
                    continue
                try:
                    yd = max(0.0, float(yards_text.replace(',', '.'))) if yards_text else 0.0
                    if yd > 0:
                        met = yd * self.YARD_TO_METER
                    else:
                        met = max(0.0, float(meters_text.replace(',', '.'))) if meters_text else 0.0
                        yd = (met / self.YARD_TO_METER) if met > 0 else 0.0
                except Exception:
                    bad += 1
                    continue
                if not lot or not roll_name:
                    bad += 1
                    continue

                found = next((x for x in self.global_lot_rows
                              if str(x.get('lot','')).strip().lower() == lot.lower()), None)
                if found is None:
                    found = {'lot': lot, 'lot_mark': mark, 'roll_count': 0,
                             'meters': 0.0, 'rolls_detail': []}
                    self.global_lot_rows.append(found)

                details = self._ensure_lot_roll_details(found)
                # V93: cho phép trùng SỐ CÂY nếu Lot nhà sản xuất khác nhau.
                _mark_key = str(mark or '').strip().lower()
                existing = next((d for d in details
                                 if str(d.get('roll','')).strip().lower() == roll_name.lower()
                                 and str(d.get('lot_mark','') or '').strip().lower() == _mark_key), None)
                if existing:
                    existing['roll'] = roll_name
                    existing['lot_mark'] = mark
                    existing['yards'] = yd
                    existing['meters'] = met
                    existing['fabric_width_cm'] = width_text
                    updated += 1
                else:
                    details.append({'roll': roll_name, 'lot_mark': mark, 'yards': yd, 'meters': met, 'fabric_width_cm': width_text})
                    added += 1
                found['rolls_detail'] = details
                self._recalc_lot_from_roll_details(found)

            for row in self.lot_inventory_entries:
                for e in row:
                    e.delete(0, tk.END)
            _trim_lot_input_rows(12)
            refresh()
            self.status_var.set(f'Kho cây/Shade: thêm {added} cây, cập nhật {updated} cây, lỗi {bad}')

        def clear_grid():
            for row in self.lot_inventory_entries:
                for e in row:
                    e.delete(0, tk.END)
            _trim_lot_input_rows(12)

        def add_input_row():
            _ensure_lot_input_rows(len(self.lot_inventory_entries) + 1)
            try:
                self.lot_inventory_entries[-1][0].focus_set()
                lot_grid_canvas.yview_moveto(1.0)
            except Exception:
                pass

        tk.Button(btns, text='✅ LƯU / CẬP NHẬT CÂY', command=save_grid,
                  font=('Arial', 9, 'bold'), bg='#27ae60', fg='white',
                  padx=8, pady=4, wraplength=180).grid(row=0, column=2, sticky='ew', padx=3)
        tk.Button(btns, text='🧹 XÓA KHUNG NHẬP', command=clear_grid,
                  font=('Arial', 9, 'bold'), bg='#7f8c8d', fg='white',
                  padx=8, pady=4, wraplength=180).grid(row=0, column=3, sticky='ew', padx=(3, 0))
        tk.Button(btns, text='➕ THÊM DÒNG NHẬP', command=add_input_row,
                  font=('Arial', 8, 'bold'), bg='#5d6d7e', fg='white',
                  padx=8, pady=3).grid(row=1, column=0, columnspan=4, sticky='ew', pady=(5, 0))
        refresh()

    # ==================== V72: CHẾ ĐỘ GIÁC THEO LOẠI VẢI ====================
    @staticmethod
    def _fabric_text_key(value):
        """Chuẩn hóa tên vật tư để nhận diện tự động, bỏ dấu và ký tự thừa."""
        txt = str(value or '').strip().upper()
        txt = ''.join(
            ch for ch in unicodedata.normalize('NFD', txt)
            if unicodedata.category(ch) != 'Mn'
        )
        txt = re.sub(r'[^A-Z0-9]+', ' ', txt)
        return re.sub(r'\s+', ' ', txt).strip()

    def _infer_fabric_mode_key(self, name):
        """Nhận diện nhóm giác theo tên vật tư; tên không rõ mặc định VẢI CHÍNH."""
        txt = self._fabric_text_key(name)
        # Ưu tiên nhóm đặc thù trước để tránh tên ghép bị nhận nhầm.
        if any(k in txt for k in ('KEP TANG', 'INTERLAYER', 'SANDWICH LAYER', 'INNER LAYER')):
            return 'interlayer'
        if any(k in txt for k in ('DUNG', 'MEX', 'FUSING', 'FUSE', 'INTERLINING', 'KEO DUNG', 'KEO MEX')):
            return 'interlining'
        if any(k in txt for k in ('BONG', 'PADDING', 'WADDING', 'FILLING', 'QUILTING')):
            return 'padding'
        if any(k in txt for k in ('VAI Shade', 'Shade', 'LINING', 'POCKETING')):
            return 'lining'
        if 'VC' in txt.split() or any(k in txt for k in ('VAI CHINH', 'MAIN FABRIC', 'SHELL', 'OUTER', 'BODY FABRIC')):
            return 'main'
        return 'main'

    def _fabric_mode_key_from_label(self, value):
        txt = self._fabric_text_key(value)
        for key, label in self.FABRIC_MODE_LABELS.items():
            if self._fabric_text_key(label) == txt:
                return key
        # Cho phép dữ liệu cũ hoặc dữ liệu nhập thẳng bằng key.
        raw = str(value or '').strip().lower()
        return raw if raw in self.FABRIC_MODE_LABELS else 'auto'

    def _resolved_fabric_mode(self, fabric):
        mode = self._fabric_mode_key_from_label(fabric.get('cut_mode', 'auto'))
        if mode == 'auto':
            return self._infer_fabric_mode_key(fabric.get('name', ''))
        return mode

    def _fabric_mode_display(self, fabric):
        saved = self._fabric_mode_key_from_label(fabric.get('cut_mode', 'auto'))
        resolved = self._resolved_fabric_mode(fabric)
        if saved == 'auto':
            return f"TỰ ĐỘNG → {self.FABRIC_MODE_LABELS.get(resolved, 'VẢI CHÍNH')}"
        return self.FABRIC_MODE_LABELS.get(resolved, 'VẢI CHÍNH')

    def _fabric_cut_profile(self, mode_key, total_by_size, norm, max_len, balance_pct=1.0):
        """Thông số tối ưu V72 theo từng nhóm vật tư.

        - Vải chính: chính xác nhất, dương thấp.
        - Vải lót: ghép nhiều cỡ, marker đủ dài, dương vừa.
        - Kẹp tầng: định mức thường lớn nhưng ít quan trọng -> ưu tiên ít bàn,
          tỷ lệ đơn giản và cho phép dương rộng hơn.
        - Dựng/Mex: định mức có thể rất nhỏ -> marker chính phải đủ dài,
          nhiều cỡ/tỷ lệ để tránh sơ đồ vài cm và không kín khổ.
        - Bông: ưu tiên ít bàn/tận dụng khổ, cho phép dương rộng nhất.
        """
        mode_key = mode_key if mode_key in self.FABRIC_MODE_LABELS else 'main'
        max_len = max(0.0, float(max_len or 0))
        norm = max(0.000001, float(norm or 0.000001))

        base = {
            'mode': mode_key,
            'label': self.FABRIC_MODE_LABELS.get(mode_key, 'VẢI CHÍNH'),
            'merge_style': 'balanced',
            'score_style': 'exact',
            'base_over': int(getattr(self, 'MAX_OVER', 3) or 3),
            'over_pct': 0.0,
            'over_cap': int(getattr(self, 'MAX_OVER', 3) or 3),
            'target_min_marker': 0.8,
            'prefer_size_spread': True,
            # V115: mặc định các nhóm vải vẫn không cho âm. Riêng DỰNG/MEX và BÔNG
            # được phép âm/dương theo từng cỡ và phần dương của cỡ lớn có thể hạ
            # xuống bù cho cỡ nhỏ.
            'allow_under': False,
            'under_pct': 0.0,
            'under_cap': 0,
            'downgrade_large_to_small': False,
            # V117: giới hạn TỔNG dương còn lại sau khi đã hạ cỡ lớn -> cỡ bé.
            # -1 = không áp dụng giới hạn tổng.
            'total_surplus_pct': 0.0,
            'total_surplus_cap': -1,
        }
        if mode_key == 'lining':
            base.update({
                'merge_style': 'strong', 'score_style': 'lining',
                'base_over': 5, 'over_pct': 0.01, 'over_cap': 10,
                'target_min_marker': 1.20, 'prefer_size_spread': True,
            })
        elif mode_key == 'interlayer':
            base.update({
                'merge_style': 'simple', 'score_style': 'few_tables',
                'base_over': 8, 'over_pct': 0.03, 'over_cap': 20,
                'target_min_marker': 0.60, 'prefer_size_spread': False,
            })
        elif mode_key == 'interlining':
            base.update({
                'merge_style': 'strong', 'score_style': 'high_ratio',
                'base_over': 8, 'over_pct': 0.04, 'over_cap': 25,
                'target_min_marker': 1.50, 'prefer_size_spread': True,
                'allow_under': True, 'under_pct': 0.04, 'under_cap': 25,
                'downgrade_large_to_small': True,
                'total_surplus_pct': 0.01,
            })
        elif mode_key == 'padding':
            base.update({
                'merge_style': 'strong', 'score_style': 'few_tables',
                'base_over': 10, 'over_pct': 0.05, 'over_cap': 30,
                'target_min_marker': 1.20, 'prefer_size_spread': True,
                'allow_under': True, 'under_pct': 0.05, 'under_cap': 30,
                'downgrade_large_to_small': True,
                'total_surplus_pct': 0.01,
            })

        # V141: DỰNG/MEX và BÔNG dùng % âm/dương do người dùng chọn RIÊNG
        # cho từng loại vải. Giá trị trên giao diện nhập theo %, ví dụ 1 = 1%.
        # Các loại vải khác giữ logic cũ và không dùng giới hạn tổng này.
        if mode_key in ('interlining', 'padding'):
            try:
                _user_balance_pct = max(0.0, min(100.0, float(balance_pct if balance_pct is not None else 1.0)))
            except Exception:
                _user_balance_pct = 1.0
            base['total_surplus_pct'] = _user_balance_pct / 100.0

        # Không đặt mục tiêu dài hơn giới hạn marker. Kẹp tầng định mức lớn thường
        # tự đạt chiều dài này chỉ với 1-2 nhịp tỷ lệ.
        if max_len > 0:
            base['target_min_marker'] = min(float(base['target_min_marker']), max_len)

        over_limits = {}
        for key, qty in (total_by_size or {}).items():
            q = max(0, int(qty or 0))
            by_pct = int(math.ceil(q * float(base['over_pct']) - 1e-12)) if q > 0 else 0
            limit = max(int(base['base_over']), by_pct)
            limit = min(limit, int(base['over_cap']))
            over_limits[key] = max(0, limit)
        base['over_limits'] = over_limits
        base['max_over_any'] = max(over_limits.values(), default=int(base['base_over']))

        # V115: giới hạn âm dùng đối xứng với cách tính dương nhưng chỉ bật cho
        # DỰNG/MEX và BÔNG. Ví dụ BÔNG 5% (min 10, max 30); DỰNG 4% (min 8, max 25).
        under_limits = {}
        allow_under = bool(base.get('allow_under', False))
        for key, qty in (total_by_size or {}).items():
            q = max(0, int(qty or 0))
            if allow_under:
                by_pct = int(math.ceil(q * float(base.get('under_pct', 0.0)) - 1e-12)) if q > 0 else 0
                limit = max(int(base.get('base_over', 0) or 0), by_pct)
                cap = int(base.get('under_cap', 0) or 0)
                if cap > 0:
                    limit = min(limit, cap)
                under_limits[key] = max(0, min(q, limit))
            else:
                under_limits[key] = 0
        base['under_limits'] = under_limits
        base['max_under_any'] = max(under_limits.values(), default=0)

        # V117: DỰNG/MEX và BÔNG chỉ được phép dương tổng tối đa 1% sau khi
        # đã dùng phần dương cỡ lớn để bù phần âm của cỡ bé.
        _surplus_pct = max(0.0, float(base.get('total_surplus_pct', 0.0) or 0.0))
        if bool(base.get('allow_under', False)) and mode_key in ('interlining', 'padding'):
            _total_target = sum(max(0, int(v or 0)) for v in (total_by_size or {}).values())
            # 0% = yêu cầu sau cân size không còn dương; không phải "tắt giới hạn".
            base['total_surplus_cap'] = max(0, int(math.floor(_total_target * _surplus_pct + 1e-12)))
        else:
            base['total_surplus_cap'] = -1
        return base

