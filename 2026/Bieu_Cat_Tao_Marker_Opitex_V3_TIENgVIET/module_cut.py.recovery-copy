    def apply_initial_info(self, initial, overwrite=False):
        """Điền thông tin chung từ TÁC NGHIỆP CẮT vào công cụ ghép; không đụng dữ liệu cỡ đã nhập."""
        if not initial:
            return
        mapping = {
            "customer": getattr(self, "customer", None),
            "style_code": getattr(self, "style_code", None),
            "color": getattr(self, "color", None),
            "batch": getattr(self, "batch", None),
            "season": getattr(self, "season", None),
            "date": getattr(self, "date", None),
            "po": getattr(self, "po", None),
        }
        for key, var in mapping.items():
            if var is None:
                continue
            value = str(initial.get(key, "") or "").strip()
            if not value:
                continue
            try:
                if overwrite or not str(var.get() or "").strip():
                    var.set(value)
            except Exception:
                pass

        logo = str(initial.get("logo", "") or "").strip()
        if logo and os.path.exists(logo):
            self.logo_path = logo
            try:
                self.logo_label.configure(text=os.path.basename(logo))
            except Exception:
                pass

    def refresh_source_fabrics(self):
        """V43: cập nhật danh sách loại vải có thể dùng làm nguồn Shade/Shade."""
        names = []
        owner = getattr(self, "owner", None)
        if owner is not None:
            for f in getattr(owner, "fabric_list", []) or []:
                name = str(f.get("name", "") or "").strip()
                if name and name not in names:
                    names.append(name)
        try:
            self.source_fabric_combo["values"] = names
        except Exception:
            pass
        current = str(getattr(self, "source_fabric_var", tk.StringVar()).get() or "").strip()
        if current in names:
            return
        preferred = next((n for n in names if "CHÍNH" in n.upper() or "CHINH" in n.upper()), "")
        if not preferred and names:
            preferred = names[0]
        if preferred:
            self.source_fabric_var.set(preferred)

    def _replace_size_rows_from_sync(self, size_payloads):
        """Thay danh sách cỡ bằng dữ liệu đã liên kết, giữ số bắt đầu cũ nếu trùng tên cỡ."""
        old_starts = {}
        for row in self.size_rows:
            try:
                name = row.size_var.get().strip().upper()
                if name:
                    old_starts[name] = row.start_var.get().strip()
            except Exception:
                pass
        for row in list(self.size_rows):
            row.destroy()
        self.size_rows.clear()

        for idx, payload in enumerate(size_payloads):
            row = self.add_size_row()
            name = str(payload.get("size", "") or "").strip()
            row.size_var.set(name)
            lights = payload.get("lights", []) or []
            if not lights:
                lights = [{"qty": int(payload.get("qty", 0) or 0), "light": "CHƯA CÓ Shade"}]
            # Xóa các dòng Shade mặc định thừa và ghi dòng đầu.
            first = lights[0]
            row.set_first_light(int(first.get("qty", 0) or 0), str(first.get("light", "") or ""))
            for extra in lights[1:]:
                h = row.add_light_row(first=False)
                h["qty_var"].set(str(int(extra.get("qty", 0) or 0)))
                h["light_var"].set(str(extra.get("light", "") or ""))

            old = old_starts.get(name.upper(), "")
            if old:
                row.start_var.set(old)
            elif idx == 0:
                row.start_var.set("1")
            else:
                row.start_var.set("")
        self._regrid_rows()

    def _add_default_rows(self):
        defaults = [("XS", 204, "A", 1), ("S", 1, "A", ""), ("M", 1152, "A", ""), ("L", 1152, "A", "")]
        for s, q, a, st in defaults:
            row = self.add_size_row()
            row.size_var.set(s)
            row.set_first_light(q, a)
            row.start_var.set(str(st))

    def add_size_row(self):
        row = SizeRow(self.rows_holder, len(self.size_rows) + 1, self.delete_size_row)
        self.size_rows.append(row)
