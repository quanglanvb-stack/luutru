                allocation = self._distribute_integer_total(targets.get(key, 0), selected_lots, weights.get(key, {}))
                self._set_row_lights(row, [(lot, allocation.get(lot, 0)) for lot in selected_lots])

            self.po.set(" + ".join(selected_pos))
            msg = f"Đã cập nhật SL của {len(selected_pos)} PO | {len(selected_lots)} Shade"
