                    continue

                existing = None
                for row in self.global_lot_rows:
                    if (str(row.get('lot','')).strip().lower() == lot.lower()
                        and row.get('fabric_mode','all') == fmode
                        and set(row.get('fabric_names',[]) or []) == set(fnames)
                        and row.get('po_mode','all') == pmode
                        and set(row.get('po_names',[]) or []) == set(pnames)):
                        existing = row
                        break

                data = {
                    'lot': lot, 'roll_count': cnt, 'meters': meters,
                    'fabric_mode': fmode, 'fabric_names': list(fnames),
                    'po_mode': pmode, 'po_names': list(pnames)
                }
                if existing:
                    existing.update(data)
                    updated += 1
                else:
                    self.global_lot_rows.append(data)
                    added += 1

            if not has_data:
                messagebox.showwarning('Cảnh báo', 'Khung nhập chưa có dữ liệu.', parent=win)
                return

            refresh()
            clear_paste_grid()
            paste_entries[0][0].focus_set()
            self.status_var.set(f'Shade: thêm {added}, cập nhật {updated}, bỏ qua {bad}')

        def add_blank():
            fmode, fnames, pmode, pnames = selected_scope()
            self.global_lot_rows.append({'lot':'Shade MỚI','roll_count':0,'meters':0.0,
                                         'fabric_mode':fmode,'fabric_names':list(fnames),
                                         'po_mode':pmode,'po_names':list(pnames)})
            refresh()
            iid=str(len(self.global_lot_rows)-1); tree.selection_set(iid); tree.focus(iid); tree.see(iid)

        def delete_selected():
            ids=tree.selection()
            if not ids: return
            for i in sorted([int(x) for x in ids], reverse=True):
                if 0<=i<len(self.global_lot_rows): del self.global_lot_rows[i]
            refresh()

        def apply_scope_selected():
            ids=tree.selection()
            if not ids:
                messagebox.showwarning('Cảnh báo','Chọn Shade cần đổi phạm vi.', parent=win); return
            fmode, fnames, pmode, pnames = selected_scope()
            if fmode=='selected' and not fnames:
                messagebox.showwarning('Cảnh báo','Chọn loại vải.', parent=win); return
            if pmode=='selected' and not pnames:
                messagebox.showwarning('Cảnh báo','Chọn PO.', parent=win); return
            for iid in ids:
                row=self.global_lot_rows[int(iid)]
                row.update({'fabric_mode':fmode,'fabric_names':list(fnames),
                            'po_mode':pmode,'po_names':list(pnames)})
            refresh()

        # Sửa trực tiếp 3 cột đầu bằng Entry chồng lên ô Treeview.
        editor={'widget':None}
        def start_edit(event):
            region=tree.identify('region', event.x, event.y)
            if region!='cell': return
            iid=tree.identify_row(event.y); col=tree.identify_column(event.x)
            if not iid or col not in ('#1','#2','#3'): return
            bbox=tree.bbox(iid,col)
            if not bbox: return
            x,y,w,h=bbox
            old=tree.set(iid, cols[int(col[1:])-1])
            ent=tk.Entry(tree, font=('Arial',9)); ent.place(x=x,y=y,width=w,height=h); ent.insert(0,old); ent.select_range(0,tk.END); ent.focus_set()
            editor['widget']=ent
            def commit(ev=None):
                if not ent.winfo_exists(): return
                val=ent.get().strip(); idx=int(iid); row=self.global_lot_rows[idx]
                try:
                    if col=='#1':
                        if val: row['lot']=val
                    elif col=='#2': row['roll_count']=max(0,int(float(val.replace(',','.'))))
                    elif col=='#3': row['meters']=max(0.0,float(val.replace(',','.')))
                except ValueError:
                    messagebox.showwarning('Sai dữ liệu','SỐ CÂY phải là số nguyên; SỐ MÉT phải là số.', parent=win)
                ent.destroy(); refresh()
            ent.bind('<Return>',commit); ent.bind('<FocusOut>',commit); ent.bind('<Escape>',lambda e: ent.destroy())
        tree.bind('<Double-1>', start_edit)

        buttons=tk.Frame(win); buttons.pack(fill='x', padx=12, pady=(2,10))
        tk.Button(buttons,text='✅ ĐƯA KHUNG NHẬP VÀO DANH SÁCH',command=paste_rows,font=('Arial',10,'bold'),bg='#27ae60',fg='white',padx=14,pady=5).pack(side='left')
        tk.Button(buttons,text='➕ Thêm dòng',command=add_blank,font=('Arial',9,'bold'),bg='#2980b9',fg='white',padx=10,pady=5).pack(side='left',padx=6)
        tk.Button(buttons,text='✅ Áp dụng LOẠI VẢI/PO cho dòng chọn',command=apply_scope_selected,font=('Arial',9,'bold'),bg='#8e44ad',fg='white',padx=10,pady=5).pack(side='left',padx=6)
        tk.Button(buttons,text='🗑️ Xóa dòng',command=delete_selected,font=('Arial',9,'bold'),bg='#c0392b',fg='white',padx=10,pady=5).pack(side='left',padx=6)
        tk.Label(buttons,text='1 Shade có thể dùng cho nhiều LOẠI VẢI; mỗi CÂY chỉ tự cấp cho 1 loại vải. Shade/cây dư giữ CHƯA GÁN để điều chỉnh sau.',font=('Arial',9),fg='#555').pack(side='left',padx=10)
        refresh()

    def _fabric_roll_reserve_settings(self, fabric):
        """V163: đọc quy tắc chừa đầu tấm của từng loại vải.

        reserve_m: nếu sau khi trải tối đa phần dư nhỏ hơn ngưỡng này thì bớt lá.
        reserve_plies: số lá bớt lại để làm đầu tấm. Mặc định 1.00 m / 1 lá.
        """
        fabric = fabric or {}
        try:
            reserve_m = max(0.0, float(fabric.get('reserve_m', 1.0)
                                       if fabric.get('reserve_m', 1.0) is not None else 1.0))
        except Exception:
            reserve_m = 1.0
        try:
            reserve_plies = max(1, int(float(fabric.get('reserve_plies', 1) or 1)))
        except Exception:
            reserve_plies = 1
        return reserve_m, reserve_plies

    def allocate_rolls_to_tables(self, fabric, tables):
        """Phân từng cây vải cho các bàn cắt, cho phép một cây đi qua nhiều bàn.

        Quy tắc V163:
        - Ngưỡng đầu tấm và số lá chừa được chỉnh riêng theo từng loại vải.
          Mặc định: nếu trải tối đa mà đầu tấm còn dưới 1.00 m thì bớt 1 lá.
        - Một cây đang dùng được phép tiếp tục sang bàn kế tiếp nếu phần mét còn lại
          của cây đó có thể trải TỪ 3 LÁ TRỞ LÊN cho marker của bàn kế tiếp.
        - Nếu phần còn lại chỉ đủ 1-2 lá cho bàn đang xét thì KHÔNG đưa cây đó vào
          bàn này; giữ phần dư để xét cho một bàn ngắn hơn phía sau.
        - Bàn có chiều dài sơ đồ ngắn nhất vẫn được xử lý cuối để ưu tiên tận dụng
          các đầu tấm/cây đang dùng còn đủ >= 3 lá.
        - Cây mới vẫn được mở khi cần để hoàn thành số lá của bàn.

        Mỗi lá dùng = chiều dài sơ đồ * 1.01, đồng bộ với logic Shade hiện tại.
        """
        MIN_CONTINUE_PLIES = 3
        reserve_m, reserve_plies = self._fabric_roll_reserve_settings(fabric)
        src_rolls = []
        for i, r in enumerate(fabric.get('rolls', []) or []):
            try:
                length = float(r.get('length', 0) or 0)
            except (TypeError, ValueError):
                length = 0.0
            if length <= 0:
                continue
            src_rolls.append({
                'source_index': i,
                'lot': str(r.get('lot', '') or '').strip(),
                'lot_mark': str(r.get('lot_mark', r.get('shade', '')) or '').strip(),
                'shade': str(r.get('lot_mark', r.get('shade', '')) or '').strip(),
                'roll': str(r.get('roll', '') or '').strip() or str(i+1),
                'length': length,
                'remaining': length,
                'used': 0.0,
                'started': False,
                'parked': False,
                'assigned_table_idx': None,
            })

        if not src_rolls or not tables:
            return [], src_rolls, None

        valid = [(i, t) for i, t in enumerate(tables)
                 if int(t.get('plies', 0) or 0) > 0 and float(t.get('length', 0) or 0) > 0]
        if not valid:
            return [], src_rolls, None

        # Giữ logic bàn ngắn nhất xử lý cuối để tận dụng đầu tấm tốt hơn.
        min_len = min(float(t.get('length', 0)) for _, t in valid)
        target_idx = max(i for i, t in valid if abs(float(t.get('length', 0)) - min_len) < 1e-9)
        allocations = []
        eps = 1e-9

        def raw_capacity(state, mpp):
            """Sức chứa tối đa nhưng luôn chừa đầu tấm.

            Quy tắc V163:
            - Trước hết tính số lá tối đa có thể trải.
            - Nếu phần dư sau khi trải tối đa nhỏ hơn reserve_m thì bớt
              reserve_plies lá. Mặc định reserve_m=1.00 m và reserve_plies=1.
            """
            if mpp <= 0:
                return 0
            raw = max(0, int((state['remaining'] + eps) // mpp))
            if raw <= 0:
                return 0
            rem_after_raw = max(0.0, state['remaining'] - raw * mpp)
            if rem_after_raw < reserve_m - eps:
                raw = max(0, raw - reserve_plies)
            return raw

        def add_alloc(table_idx, state, use_plies, mpp, source_note):
            if use_plies <= 0:
                return
            meters = use_plies * mpp
            state['remaining'] = max(0.0, state['remaining'] - meters)
            state['used'] += meters
            state['started'] = True
            state['parked'] = False
            if state.get('assigned_table_idx') is None:
                state['assigned_table_idx'] = table_idx
            table = tables[table_idx]
            allocations.append({
                'fabric': fabric.get('name', ''),
                'lot': state.get('lot',''),
                'lot_mark': state.get('lot_mark',''),
                'shade': state.get('lot_mark',''),
                'table': table.get('table', f'B{table_idx+1}'),
                'table_index': table_idx,
                'roll': state['roll'],
                'roll_length': state['length'],
                'marker_length': float(table.get('length', 0)),
                'meters_per_ply': mpp,
                'plies': int(use_plies),
                'meters_used': meters,
                'remaining_after': state['remaining'],
                'source': source_note,
                'is_short_final': table_idx == target_idx,
            })

        def use_existing_rolls(table_idx, table, need, final_table=False):
            """Bàn thường cần >=3 lá/cây; bàn vét dùng mọi đầu tấm còn lại sau reserve."""
            min_use_plies = 1 if final_table else MIN_CONTINUE_PLIES
            if need < min_use_plies:
                return need
            mpp = float(table.get('length', 0) or 0) * 1.01
            if mpp <= 0:
                return need

            candidates = [r for r in src_rolls
                          if r['started'] and raw_capacity(r, mpp) >= min_use_plies]
            # Bàn cuối ưu tiên đầu tấm ngắn trước; bàn thường giữ đúng thứ tự cây nhập.
            if final_table:
                candidates.sort(key=lambda r: (r['remaining'], r['source_index']))
            else:
                candidates.sort(key=lambda r: r['source_index'])

            for state in candidates:
                if need < min_use_plies:
                    break
                cap = raw_capacity(state, mpp)
                if cap < min_use_plies:
                    state['parked'] = True
                    continue
                use = min(need, cap)
                # Bàn thường không chuyển cây nếu chỉ đủ 1-2 lá; bàn vét được gom phần này.
                if use < min_use_plies:
                    continue
                note = ('ĐẦU TẤM/CÂY ĐANG DÙNG → BÀN NGẮN CUỐI'
                        if final_table else 'CÂY ĐANG DÙNG → BÀN TIẾP')
                add_alloc(table_idx, state, use, mpp, note)
                need -= use
            return need

        def use_new_rolls(table_idx, table, need, final_table=False):
            """Mở cây mới để hoàn thành số lá còn thiếu của bàn."""
            mpp = float(table.get('length', 0) or 0) * 1.01
            if mpp <= 0:
                return need
            for state in src_rolls:
                if need <= 0:
                    break
                if state['started'] or state['remaining'] + eps < mpp:
                    continue
                cap = raw_capacity(state, mpp)
                if cap <= 0:
                    continue
                use = min(need, cap)
                note = 'CÂY MỚI → BÀN NGẮN CUỐI' if final_table else 'CÂY MỚI'
                add_alloc(table_idx, state, use, mpp, note)
                need -= use
            return need

        # 1) Các bàn thường: ưu tiên tiếp tục cây đang dùng nếu còn đủ >=3 lá,
        # sau đó mới mở cây mới. Cây còn 1-2 lá cho bàn hiện tại được giữ lại.
        for table_idx, table in valid:
            if table_idx == target_idx:
                continue
            need = int(table.get('plies', 0) or 0)
            mpp = float(table.get('length', 0) or 0) * 1.01
            need = use_existing_rolls(table_idx, table, need, final_table=False)
            need = use_new_rolls(table_idx, table, need, final_table=False)

            # Đánh dấu những cây đã mở nhưng hiện chỉ còn đủ 1-2 lá cho marker này.
            for state in src_rolls:
                if state['started'] and state['remaining'] > eps:
                    cap = raw_capacity(state, mpp)
                    if 0 < cap < MIN_CONTINUE_PLIES:
                        state['parked'] = True

            if need > 0:
                allocations.append({
                    'fabric': fabric.get('name', ''), 'lot': '', 'lot_mark': '', 'shade': '',
                    'table': table.get('table', f'B{table_idx+1}'), 'table_index': table_idx,
                    'roll': 'THIẾU VẢI', 'roll_length': 0.0,
                    'marker_length': float(table.get('length', 0)), 'meters_per_ply': mpp,
                    'plies': need, 'meters_used': need * mpp, 'remaining_after': 0.0,
                    'source': 'THIẾU VẢI', 'is_short_final': False,
                })

        # 2) Bàn ngắn nhất xử lý cuối: tận dụng đầu tấm theo đúng ngưỡng/số lá chừa;
        # phần còn đủ sau khi chừa có thể gom cả khi chỉ còn 1-2 lá.
        target = tables[target_idx]
        need = int(target.get('plies', 0) or 0)
        mpp = float(target.get('length', 0) or 0) * 1.01
        need = use_existing_rolls(target_idx, target, need, final_table=True)
        need = use_new_rolls(target_idx, target, need, final_table=True)

        if need > 0:
            allocations.append({
                'fabric': fabric.get('name', ''), 'lot': '', 'lot_mark': '', 'shade': '',
                'table': target.get('table', f'B{target_idx+1}'), 'table_index': target_idx,
                'roll': 'THIẾU VẢI', 'roll_length': 0.0,
                'marker_length': float(target.get('length', 0)), 'meters_per_ply': mpp,
                'plies': need, 'meters_used': need * mpp, 'remaining_after': 0.0,
                'source': 'THIẾU VẢI', 'is_short_final': True,
            })

        return allocations, src_rolls, target_idx

    def allocate_lots_to_tables(self, fabric, tables):
        """
        Phân mét Shade vào các bàn sau khi thuật toán cắt đã hoàn tất.

        Quy tắc V28 (phần xem trước):
        - Shade là riêng cho từng loại vải, giữ nguyên logic marker / sản lượng V13.
        - ƯU TIÊN LOT NHÀ SẢN XUẤT THEO THỨ TỰ GHI TRÊN CÂY; trong mỗi LOT,
          dùng mét của Shade tương ứng tối đa trước khi chuyển sang LOT kế tiếp.
        - Với mỗi Shade, chương trình chọn phần bàn/số lá giúp sử dụng được nhiều mét
          nhất có thể. Chỉ chuyển Shade khi phần mét còn lại không đủ cho 1 lá của
          bất kỳ marker nào còn chưa phân.
        - Một marker có thể bị tách số lá sang nhiều Shade; tổng số lá và sản lượng
          của marker không thay đổi.
        - Mét mỗi phần = chiều dài marker * số lá * 1.01, đúng công thức Excel.
        - Nếu tất cả LOT nhà sản xuất không đủ, phần còn lại được gắn Shade = 'THIẾU VẢI'.
        """
        lots_src = fabric.get('lots', []) or []
        if not lots_src:
            plain = []
            for i, table in enumerate(tables, start=1):
                t = dict(table)
                t['table'] = f'B{i}'
                t['source_table_index'] = i - 1
                t['lot'] = ''
                t['meters_needed'] = float(t['length']) * int(t['plies']) * 1.01
                plain.append(t)
            return plain, []

        # Tách mét từng Shade theo LOT nhà sản xuất ghi trên cây. Bàn cắt sẽ
        # tiêu thụ lần lượt từng nhóm theo thứ tự LOT nhà sản xuất xuất hiện.
        rolls = list(fabric.get('rolls', []) or [])
        rolls_by_shade = {}
        manufacturer_order = {}
        for roll_index, roll in enumerate(rolls):
            shade_name = str(roll.get('lot', roll.get('shade', '')) or '').strip()
            manufacturer_lot = str(roll.get('lot_mark') or roll.get('shade', '') or '').strip()
            mark_key = manufacturer_lot.casefold()
            if mark_key and mark_key not in manufacturer_order:
                manufacturer_order[mark_key] = roll_index
            try:
                roll_meters = max(0.0, float(roll.get('length', 0) or 0))
            except (TypeError, ValueError):
                roll_meters = 0.0
            if not shade_name or roll_meters <= 0:
                continue
            shade_key = shade_name.casefold()
            group = rolls_by_shade.setdefault(shade_key, {}).setdefault(mark_key, {
                'lot_mark': manufacturer_lot,
                'widths': {},
                'first_roll': roll_index,
            })
            width_text = str(roll.get('fabric_width_cm', '') or '').strip()
            width_key = width_text.replace(',', '.')
            width_group = group['widths'].setdefault(width_key, {
                'fabric_width_cm': width_text, 'meters': 0.0, 'first_roll': roll_index
            })
            width_group['meters'] += roll_meters

        ordered_lots = []
        for lot_index, lot in enumerate(lots_src):
            total_meters = max(0.0, float(lot.get('meters', 0) or 0))
            if total_meters <= 0:
                continue
            name = str(lot.get('name', '')).strip() or f'Shade {lot_index+1}'
            source_name = str(lot.get('source_lot', name) or name).strip()
            shade_key = source_name.casefold()
            groups = []
            for mark_group in (rolls_by_shade.get(shade_key) or {}).values():
                for width_group in mark_group.get('widths', {}).values():
                    groups.append({**width_group, 'lot_mark': mark_group.get('lot_mark', '')})
            if groups:
                def _width_sort_key(g):
                    raw = str(g.get('fabric_width_cm', '') or '').replace(',', '.')
                    try: width_num = float(raw) if raw else float('inf')
                    except Exception: width_num = float('inf')
                    maker_num = manufacturer_order.get(g['lot_mark'].casefold(), len(manufacturer_order))
                    # Ưu tiên được chọn trong thông tin loại vải; khổ còn lại bù phần lá thiếu.
                    return ((maker_num, width_num, g['first_roll']) if str(fabric.get('split_priority','lot')).lower() != 'width'
                            else (width_num, maker_num, g['first_roll']))
                groups.sort(key=_width_sort_key)
                source_meters = sum(g['meters'] for g in groups)
                allocated = 0.0
                for group_index, group in enumerate(groups):
                    group_meters = (total_meters - allocated if group_index == len(groups) - 1
                                    else total_meters * group['meters'] / source_meters)
                    allocated += group_meters
                    mark = group['lot_mark']
                    order = manufacturer_order.get(mark.casefold(), len(manufacturer_order) + lot_index)
                    raw_width = str(group.get('fabric_width_cm', '') or '').replace(',', '.')
                    try: width_num = float(raw_width) if raw_width else float('inf')
                    except Exception: width_num = float('inf')
                    ordered_lots.append((width_num, order, group['first_roll'], lot_index, {
                        'name': name,
                        'lot_mark': mark,
                        'fabric_width_cm': group.get('fabric_width_cm', ''),
                        'meters': group_meters,
                        'remaining': group_meters,
                        'used': 0.0,
                    }))
            else:
                mark = str(lot.get('lot_mark', '') or '').strip()
                order = manufacturer_order.get(mark.casefold(), len(manufacturer_order) + lot_index)
                ordered_lots.append((float('inf'), order, len(rolls) + lot_index, lot_index, {
                    'name': name,
                    'lot_mark': mark,
                    'fabric_width_cm': '',
                    'meters': total_meters,
                    'remaining': total_meters,
                    'used': 0.0,
                }))
        lots = [item[-1] for item in sorted(ordered_lots, key=lambda item: ((item[1],item[0],item[2],item[3]) if str(fabric.get('split_priority','lot')).lower() != 'width' else item[:-1]))]
        if not lots:
            return self.allocate_lots_to_tables({'lots': []}, tables)

        # Chuẩn bị dữ liệu marker, giữ nguyên thứ tự ban đầu.
        works = []
        for idx, table in enumerate(tables):
            plies = int(table.get('plies', 0))
            if plies <= 0:
                continue
            length = float(table.get('length', 0))
            mpp = length * 1.01  # mét vải cho 1 lá của marker
            ratios = {}
            for key, qty in table.get('sizes', {}).items():
                q = int(qty)
                if q > 0:
                    ratios[key] = int(round(q / plies))
            works.append({
                'index': idx,
                'table': table,
                'plies': plies,
                'left': plies,
                'mpp': mpp,
                'ratios': ratios,
                'segments': []
            })

        eps = 1e-9

        if str(fabric.get('split_priority','lot')).lower() == 'width':
            # Chọn khổ phù hợp theo từng bàn: khổ đủ thì lấy phần dư nhỏ nhất;
            # nếu chưa khổ nào đủ thì chọn khổ có sức chứa lớn nhất rồi mới chuyển khổ.
            for work in works:
                blocked_widths = set()
                while work['left'] > 0:
                    groups_by_width = {}
                    for li, lot in enumerate(lots):
                        if lot['remaining'] <= eps:
                            continue
                        raw_width = str(lot.get('fabric_width_cm','') or '').strip().replace(',', '.')
                        try:
                            width_key = float(raw_width) if raw_width else float('inf')
                        except Exception:
                            width_key = float('inf')
                        if width_key in blocked_widths:
                            continue
                        entry = groups_by_width.setdefault(width_key, {'meters':0.0,'items':[]})
                        entry['meters'] += lot['remaining']
                        entry['items'].append(li)
                    candidates = []
                    for width_key, group in groups_by_width.items():
                        cap = int((group['meters'] + eps) // work['mpp']) if work['mpp'] > 0 else 0
                        if cap <= 0 or (cap < 3 and cap < work['left']):
                            continue
                        enough = cap >= work['left']
                        score = (0, group['meters'] - work['left'] * work['mpp'], width_key) if enough else (1, -cap, width_key)
                        candidates.append((score, width_key, group))
                    if not candidates:
                        break
                    _, chosen_width, chosen_group = min(candidates, key=lambda x: x[0])
                    made_progress = False
                    for li in chosen_group['items']:
                        lot = lots[li]
                        cap = int((lot['remaining'] + eps) // work['mpp'])
                        use_plies = min(work['left'], cap)
                        if use_plies <= 0 or (use_plies < 3 and use_plies < work['left']):
                            continue
                        meters = work['mpp'] * use_plies
                        work['segments'].append((li, use_plies, meters))
                        work['left'] -= use_plies
                        lot['remaining'] = max(0.0, lot['remaining'] - meters)
                        lot['used'] += meters
                        made_progress = True
                        if work['left'] <= 0:
                            break
                    if not made_progress:
                        blocked_widths.add(chosen_width)
        else:
            for li, lot in enumerate(lots):
                for work in works:
                    if lot['remaining'] <= eps:
                        break
                    if work['left'] <= 0 or work['mpp'] <= 0:
                        continue

                    cap = int((lot['remaining'] + eps) // work['mpp'])
                    if cap <= 0:
                        continue

                    use_plies = min(work['left'], cap)

                    # Không tạo đoạn LOT 1-2 lá nếu bàn vẫn còn nhiều lá phải chuyển
                    # sang LOT nhà sản xuất kế tiếp. Nếu 1-2 lá này hoàn tất toàn bộ bàn thì vẫn dùng.
                    if use_plies < 3 and use_plies < work['left']:
                        continue

                    meters = work['mpp'] * use_plies
                    work['segments'].append((li, use_plies, meters))
                    work['left'] -= use_plies
                    lot['remaining'] -= meters
                    if abs(lot['remaining']) < 1e-8:
                        lot['remaining'] = 0.0
                    lot['used'] += meters

                if all(w['left'] <= 0 for w in works):
                    break


        # Sau khi đã dùng hết khả năng của tất cả LOT nhà sản xuất, phần còn lại là thiếu vải.
        for work in works:
            if work['left'] > 0:
                meters = work['mpp'] * work['left']
                work['segments'].append((None, work['left'], meters))
                work['left'] = 0

        # Trả về theo thứ tự marker gốc; mỗi segment là 1 bàn thực tế.
        expanded = []
        for work in sorted(works, key=lambda x: x['index']):
            src = work['table']
            for li, plies, meters in work['segments']:
                sizes = {
                    k: ratio * plies
                    for k, ratio in work['ratios'].items()
                    if ratio * plies > 0
                }
                t = dict(src)
                t['plies'] = plies
                t['sizes'] = sizes
                t['lot'] = lots[li]['name'] if li is not None else 'THIẾU VẢI'
                t['lot_mark'] = lots[li].get('lot_mark', '') if li is not None else ''
                t['fabric_width_cm'] = lots[li].get('fabric_width_cm', '') if li is not None else ''
                t['source_table_index'] = work['index']
                t['meters_needed'] = meters
                expanded.append(t)

        for i, table in enumerate(expanded, start=1):
            table['table'] = f'B{i}'

        summary = [
            {
                'name': lot['name'],
                'lot_mark': lot.get('lot_mark', ''),
                'fabric_width_cm': lot.get('fabric_width_cm', ''),
                'meters': lot['meters'],
                'used': max(0.0, lot['used']),
                'remaining': max(0.0, lot['remaining'])
            }
            for lot in lots
        ]
        return expanded, summary

    # ==================== THUẬT TOÁN TỐI ƯU MỚI ====================
    def optimize_cutting_global(self, total_by_size, size_factor, norm, max_len, max_products=0, fabric_mode='main', min_marker_length=1.0, balance_pct=1.0, fixed_table_count=0, even_ratio=False):
        """V106: tối ưu toàn cục 1..6 bàn, giữ NHIỀU cách phân bổ tỷ lệ cho mỗi cỡ.

        Điểm sửa quan trọng so với V104: cùng một sản lượng của một cỡ có thể được
        tạo bởi nhiều cách phân bổ tỷ lệ khác nhau giữa các bàn. V104 chỉ giữ 1
        vector cho mỗi tổng sản lượng nên thường vô tình dồn nhiều cỡ vào cùng một
        bàn, làm vượt chiều dài và khiến bộ toàn cục thất bại rồi rơi về V100.
        V106 giữ nhiều vector phân bổ khác nhau và chấm cả bộ bàn đồng thời.

        V106 sửa thêm lỗi V105: nếu giới hạn chiều dài khiến KHÔNG THỂ ghép
        bất kỳ 2 cỡ nào trên cùng sơ đồ, phương án bàn đơn cỡ là bắt buộc và
        phải được trả về thay vì báo thiếu toàn bộ sản lượng.
        """
        from itertools import combinations as _comb

        name_map = {x['key']: x['name'] for x in self.sizes}
        profile = self._fabric_cut_profile(fabric_mode, total_by_size, norm, max_len, balance_pct)
        over_limits = dict(profile.get('over_limits', {}))
        under_limits = dict(profile.get('under_limits', {}))
        allow_under = bool(profile.get('allow_under', False))
        downgrade_large_to_small = bool(profile.get('downgrade_large_to_small', False))
        total_surplus_cap = int(profile.get('total_surplus_cap', -1))
        total_surplus_pct = float(profile.get('total_surplus_pct', 0.0) or 0.0)
        try:
            fixed_table_count = max(0, min(6, int(fixed_table_count or 0)))
        except Exception:
            fixed_table_count = 0

        # Số bàn cố định: áp dụng % người dùng nhập lên tổng sản lượng.
        # Vải chính chỉ được dư; nhóm vật tư khác có thể âm/dương trong biên
        # đó. DỰNG/MEX và BÔNG vẫn dùng chuyển dư cỡ lớn xuống bù cỡ bé.
        if fixed_table_count > 0:
            try:
                _fixed_pct = max(0.0, min(100.0, float(balance_pct if balance_pct is not None else 1.0))) / 100.0
            except Exception:
                _fixed_pct = 0.01
            _fixed_total = sum(max(0, int(v or 0)) for v in total_by_size.values())
            _fixed_cap = max(0, int(math.floor(_fixed_total * _fixed_pct + 1e-12)))
            total_surplus_cap = _fixed_cap
            if fabric_mode != 'main' and fabric_mode not in ('interlining', 'padding'):
                allow_under = True
                downgrade_large_to_small = True
                for _k, _q in total_by_size.items():
                    _q = max(0, int(_q or 0))
                    over_limits[_k] = min(max(0, int(over_limits.get(_k, 0) or 0)), _fixed_cap)
                    under_limits[_k] = min(_q, _fixed_cap)

        def ratio_is_allowed(value):
            value = int(value or 0)
            return (not even_ratio) or value == 0 or value == 1 or value % 2 == 0

        def over_limit(k):
            return max(0, int(over_limits.get(k, self.MAX_OVER) or 0))

        def under_limit(k):
            return max(0, int(under_limits.get(k, 0) or 0)) if allow_under else 0

        keys = [x['key'] for x in self.sizes if int(total_by_size.get(x['key'], 0) or 0) > 0]
        if not keys:
            return [], {'unresolved': {}}

        # V127: Chiều dài sơ đồ dùng đúng DMTB × TỔNG TỈ LỆ.
        # Không nhân hệ số size; người dùng nhập DMTB là định mức trung bình cho 1 SP.
        slen = {k: float(norm) for k in keys}
        min_len = max(0.0, float(min_marker_length or 0.0))
        max_len = max(0.0, float(max_len or 0.0))
        try:
            max_products = max(0, int(float(max_products or 0)))
        except Exception:
            max_products = 0

        if max_len > 0 and min_len > max_len + 1e-9:
            raise ValueError(f"Chiều dài sơ đồ tối đa {max_len:.2f} m nhỏ hơn chiều dài tối thiểu {min_len:.2f} m.")

        min_unit = min(max(1e-9, slen[k]) for k in keys)
        ratio_cap = int(max_len / min_unit) if max_len > 0 else 24
        ratio_cap = max(1, min(36, ratio_cap))
        if max_products > 0:
            ratio_cap = min(ratio_cap, max_products)

        max_q = max(int(total_by_size[k]) + over_limit(k) for k in keys)
        max_lays = max(12, min(max_q, 500))
        min_lays = 4

        def fmt(r):
            return ' + '.join(
                f"{name_map.get(k, k)}/{int(r.get(k, 0))}"
                for k in keys if int(r.get(k, 0)) > 0
            )

        # V106: xác định xem về mặt chiều dài có thể đặt >=2 cỡ trên
        # cùng một sơ đồ hay không. Nếu ngay cả cặp ngắn nhất cũng vượt MAX,
        # thì việc tách từng cỡ thành một bàn không phải lỗi thuật toán mà là
        # nghiệm duy nhất theo mô hình chiều dài hiện tại.
        def can_merge_two_sizes():
            if len(keys) < 2:
                return False
            if max_products > 0 and max_products < 2:
                return False
            vals = sorted(float(slen[k]) for k in keys)
            if max_len > 0:
                return vals[0] + vals[1] <= max_len + 1e-9
            return True

        merge_physically_possible = can_merge_two_sizes()

        # V128: số lá càng ít so với bàn chính thì marker càng phải ngắn.
        # Quy tắc áp dụng cho mọi loại vải trong bộ TOÀN CỤC:
        #   <=10% số lá lớn nhất: tối đa 40% chiều dài MAX
        #   <=25%: tối đa 60% MAX
        #   <=50%: tối đa 80% MAX
        #   >50%: được dùng toàn bộ MAX
        # Không bao giờ ép thấp hơn chiều dài tối thiểu người dùng đã nhập.
        def dynamic_marker_cap(plies, max_plies):
            if max_len <= 0 or max_plies <= 0:
                return max_len
            share = float(plies) / float(max_plies)
            if share <= 0.10 + 1e-12:
                frac = 0.40
            elif share <= 0.25 + 1e-12:
                frac = 0.60
            elif share <= 0.50 + 1e-12:
                frac = 0.80
            else:
                frac = 1.00
            return min(max_len, max(min_len, max_len * frac))

        def build_forced_singletons():
            """Tạo phương án 1 bàn/cỡ khi chiều dài không cho phép ghép cỡ.

            Ưu tiên tỷ lệ nhỏ nhất thỏa MIN để giữ sơ đồ ngắn và số lá cao.
            Chỉ dùng khi KHÔNG có bất kỳ cặp cỡ nào có thể ghép theo MAX.
            """
            if len(keys) > 6:
                return None
            out = []
            for idx, k in enumerate(keys, start=1):
                q = int(total_by_size[k])
                # Tìm ratio nhỏ nhất thỏa chiều dài min/max và SP tối đa.
                best = None
                for r in range(1, ratio_cap + 1):
                    if not ratio_is_allowed(r):
                        continue
                    L = slen[k] * r
                    if L + 1e-9 < min_len:
                        continue
                    if max_len > 0 and L > max_len + 1e-9:
                        break
                    if max_products > 0 and r > max_products:
                        break
                    n = int(math.ceil(q / float(r)))
                    if n < min_lays:
                        continue
                    made = r * n
                    over = made - q
                    if over < 0 or over > over_limit(k):
                        continue
                    cand = (r, n, L, over)
                    if best is None or (over, r, -n) < (best[3], best[0], -best[1]):
                        best = cand
                if best is None:
                    return None
                r, n, L, over = best
                ratios = {k: r}
                sizes = {k: r * n}
                out.append({
                    'table': f'B{idx}', 'sizes': sizes, 'ratio': fmt(ratios),
                    'length': L, 'raw_length': L, 'plies': n,
                    'ratio_map': ratios, 'total_output': sum(sizes.values()),
                    'size_count': 1, 'left_total': 0, 'small_left_count': 0,
                    'small_left_sum': 0, 'zeroed': 0, 'over_total': over,
                    'size_span': 0, 'meter_rate': L / max(1, r)
                })
            return out

        def build_feasible_emergency():
            """V120: bộ cứu hộ khả thi, không báo thiếu toàn bộ chỉ vì beam bỏ sót nghiệm.

            Mỗi cỡ được giải độc lập bằng 1 hoặc 2 bàn đơn cỡ trong đúng giới hạn
            chiều dài / SP tối đa / dương cho phép. Sau đó các bàn có cùng số lá
            được ghép lại nếu marker sau ghép vẫn không vượt giới hạn.

            Điểm khác build_forced_singletons: một cỡ không bắt buộc phải biểu diễn
            bằng đúng 1 phép r*n. Ví dụ nếu q không có bội phù hợp trong khoảng
            q..q+MAX_OVER thì có thể tách thành 2 bàn để đạt đúng q hoặc dương thấp.
            """
            from bisect import bisect_left, bisect_right

            segments = []
            total_emergency_over = 0

            for k in keys:
                q = int(total_by_size[k])
                hi = q + over_limit(k)
                unit = float(slen[k])
                if unit <= 0:
                    return None

                r_lo = 1
                if min_len > 0:
                    r_lo = max(r_lo, int(math.ceil((min_len - 1e-9) / unit)))
                r_hi = ratio_cap
                if max_len > 0:
                    r_hi = min(r_hi, int(math.floor((max_len + 1e-9) / unit)))
                if max_products > 0:
                    r_hi = min(r_hi, int(max_products))
                if r_lo > r_hi:
                    return None

                # output -> lựa chọn (ratio, plies, length) tốt nhất cho output đó.
                # Ưu tiên ratio ít/marker ngắn, sau đó nhiều lá.
                by_output = {}
                for r in range(r_lo, r_hi + 1):
                    if not ratio_is_allowed(r):
                        continue
                    L = unit * r
                    if L + 1e-9 < min_len:
                        continue
                    if max_len > 0 and L > max_len + 1e-9:
                        continue
                    n_hi = min(max_lays, hi // r)
                    if n_hi < min_lays:
                        continue
                    for n in range(min_lays, n_hi + 1):
                        made = r * n
                        if made <= 0 or made > hi:
                            continue
                        old = by_output.get(made)
                        cand = (r, n, L)
                        if old is None or (r, L, -n) < (old[0], old[2], -old[1]):
                            by_output[made] = cand

                if not by_output:
                    return None

                values = sorted(by_output)
                best = None

                # 1 bàn.
                for made in values:
                    if made < q:
                        continue
                    r, n, L = by_output[made]
                    score = (made - q, 1, r, L, -n)
                    cand = (score, [(k, r, n, L, made)])
                    if best is None or score < best[0]:
                        best = cand

                # 2 bàn. Cho phép hai bàn cùng số lá / cùng ratio.
                # Chỉ cần xem các tổng q..hi; dùng bisect để tránh O(N^2) đầy đủ.
                for p1 in values:
                    lo2 = max(values[0], q - p1)
                    hi2 = hi - p1
                    if hi2 < values[0]:
                        continue
                    a = bisect_left(values, lo2)
                    b = bisect_right(values, hi2)
                    if a >= b:
                        continue
                    # Với mỗi p1, chỉ cần vài p2 gần mục tiêu thấp nhất và biên trên.
                    idxs = {a, min(b - 1, a + 1), b - 1}
                    for ii in idxs:
                        if not (a <= ii < b):
                            continue
                        p2 = values[ii]
                        made = p1 + p2
                        if made < q or made > hi:
                            continue
                        r1, n1, L1 = by_output[p1]
                        r2, n2, L2 = by_output[p2]
                        score = (made - q, 2, r1 + r2, max(L1, L2), -(n1 + n2))
                        cand = (score, [(k, r1, n1, L1, p1),
                                        (k, r2, n2, L2, p2)])
                        if best is None or score < best[0]:
                            best = cand

                if best is None:
                    return None

                total_emergency_over += int(best[0][0])
                segments.extend(best[1])

            # DỰNG/BÔNG: cứu hộ cũng phải giữ giới hạn dương tổng sau cùng.
            # Bộ cứu hộ này không tạo âm nên dương sau hạ cỡ chính là tổng dương.
            if allow_under and total_surplus_cap >= 0 and total_emergency_over > total_surplus_cap:
                return None

            # Ghép các segment có CÙNG số lá. Đây là phép ghép an toàn vì sản lượng
            # từng cỡ không đổi; chỉ gom marker nếu tổng chiều dài vẫn hợp lệ.
            packed = []
            for k, r, n, L, made in sorted(segments, key=lambda x: (-x[2], x[3], x[1])):
                placed = False
                for tb in packed:
                    if int(tb['plies']) != int(n):
                        continue
                    new_ratio_total = int(tb['_ratio_total']) + int(r)
                    new_len = float(tb['length']) + float(L)
                    if max_products > 0 and new_ratio_total > max_products:
                        continue
                    if max_len > 0 and new_len > max_len + 1e-9:
                        continue
                    tb['ratio_map'][k] = int(tb['ratio_map'].get(k, 0)) + int(r)
                    tb['sizes'][k] = int(tb['sizes'].get(k, 0)) + int(made)
                    tb['_ratio_total'] = new_ratio_total
                    tb['length'] = new_len
                    tb['raw_length'] = new_len
                    tb['total_output'] = sum(tb['sizes'].values())
                    tb['size_count'] = len(tb['ratio_map'])
                    placed = True
                    break
                if not placed:
                    packed.append({
                        'table': '', 'sizes': {k: int(made)}, 'ratio': '',
                        'length': float(L), 'raw_length': float(L), 'plies': int(n),
                        'ratio_map': {k: int(r)}, '_ratio_total': int(r),
                        'total_output': int(made), 'size_count': 1,
                        'left_total': 0, 'small_left_count': 0, 'small_left_sum': 0,
                        'zeroed': 0, 'over_total': 0, 'size_span': 0,
                        'meter_rate': float(L) / max(1, int(r)),
                    })

            # Sắp nhiều lá trước; bàn ít lá/tỷ lệ ít/ngắn để cuối đúng logic V118+.
            packed.sort(key=lambda tb: (-int(tb.get('plies', 0)),
                                        -int(tb.get('_ratio_total', 0)),
                                        -float(tb.get('length', 0))))
            if len(packed) > 1:
                tail_i = min(range(len(packed)), key=lambda i: (
                    int(packed[i].get('plies', 0)),
                    int(packed[i].get('_ratio_total', 0)),
                    float(packed[i].get('length', 0)),
                ))
                tail = packed.pop(tail_i)
                packed.append(tail)

            if even_ratio and any(not ratio_is_allowed(tb.get('_ratio_total', 0)) for tb in packed):
                return None

            for i, tb in enumerate(packed, start=1):
                tb['table'] = f'B{i}'
                tb['ratio'] = fmt(tb['ratio_map'])
                tb.pop('_ratio_total', None)

            # Kiểm tra lần cuối: phải đủ từng cỡ và không vượt dương từng cỡ.
            actual = {k: 0 for k in keys}
            for tb in packed:
                for k, v in (tb.get('sizes', {}) or {}).items():
                    actual[k] = actual.get(k, 0) + int(v or 0)
            for k in keys:
                d = int(actual.get(k, 0)) - int(total_by_size[k])
                if d < 0 or d > over_limit(k):
                    return None
            return packed

        def build_fast_flexible_single_table():
            """V121: đường tìm nhanh cho DỰNG/BÔNG định mức nhỏ.

            Với các vật tư cho phép âm/dương + hạ cỡ lớn xuống cỡ bé, marker có
            định mức rất nhỏ (ví dụ DỰNG 14G) thường cần tổng tỷ lệ lớn. Beam tổng
            quát có thể phải duyệt cực nhiều trạng thái rồi bỏ sót nghiệm, dù một
            marker duy nhất đã có nghiệm rất đẹp.

            Hàm này quét số lá, mỗi cỡ chỉ giữ vài tỷ lệ gần sản lượng mục tiêu,
            sau đó kiểm tra hạ cỡ lớn -> cỡ bé y hệt tiêu chí cuối của solver.
            Chỉ dùng cho norm <= 0.15 để không thay đổi cách chia vải chính/lót/
            kẹp tầng và DỰNG định mức lớn.
            """
            if not (allow_under and downgrade_large_to_small):
                return None
            if float(norm or 0.0) > 0.15:
                return None

            from itertools import product as _product

            def _transfer_eval(raw_diff):
                sources = []
                transfers = []
                residual = {k: 0 for k in keys}
                used = 0
                for k in reversed(keys):
                    d = int(raw_diff.get(k, 0))
                    if d > 0:
                        sources.append([k, d])
                        continue
                    if d >= 0:
                        continue
                    need = -d
                    # nguồn gần nhất trước: khi duyệt từ lớn -> bé, nguồn được
                    # thêm theo thứ tự lớn dần về gần; reversed = gần nhất trước.
                    for src in reversed(sources):
                        if need <= 0:
                            break
                        if src[1] <= 0:
                            continue
                        take = min(need, src[1])
                        if take > 0:
                            src[1] -= take
                            need -= take
                            used += take
                            transfers.append((src[0], k, take))
                    residual[k] = need
                positive = sum(max(0, int(src[1])) for src in sources)
                return residual, positive, transfers, used

            best = None
            # Quét rộng số lá nhưng mỗi n chỉ có rất ít tỷ lệ cần thử.
            for n in range(min_lays, max_lays + 1):
                ratio_choices = []
                impossible = False
                for idx, k in enumerate(keys):
                    q = int(total_by_size[k])
                    transfer_cap = (sum(over_limit(x) for x in keys[idx + 1:])
                                    if downgrade_large_to_small else 0)
                    lo = max(0, q - under_limit(k) - transfer_cap)
                    hi = q + over_limit(k)

                    choices = []
                    for r in range(0, ratio_cap + 1):
                        if not ratio_is_allowed(r):
                            continue
                        made = int(r) * int(n)
                        if lo <= made <= hi:
                            choices.append(int(r))
                    if not choices:
                        impossible = True
                        break
                    # Giữ tối đa 5 tỷ lệ gần mục tiêu để tổ hợp vẫn rất nhẹ.
                    choices.sort(key=lambda r: (
                        abs(int(r) * int(n) - q),
                        0 if int(r) * int(n) >= q else 1,
                        int(r)
                    ))
                    ratio_choices.append(choices[:5])

                if impossible:
                    continue

                for rr in _product(*ratio_choices):
                    if not any(int(r) > 0 for r in rr):
                        continue
                    ratio_total = sum(int(r) for r in rr)
                    if even_ratio and not ratio_is_allowed(ratio_total):
                        continue
                    if max_products > 0 and ratio_total > max_products:
                        continue

                    L = sum(float(slen[k]) * int(r) for k, r in zip(keys, rr))
                    if L + 1e-9 < min_len:
                        continue
                    if max_len > 0 and L > max_len + 1e-9:
                        continue

                    actual = {k: int(n) * int(r) for k, r in zip(keys, rr)}
                    raw_diff = {k: int(actual[k]) - int(total_by_size[k]) for k in keys}
                    if any(raw_diff[k] > over_limit(k) for k in keys):
                        continue

                    residual, positive, transfers, used = _transfer_eval(raw_diff)
                    if any(int(residual[k]) > under_limit(k) for k in keys):
                        continue
                    if total_surplus_cap >= 0 and int(positive) > int(total_surplus_cap):
                        continue

                    residual_short = sum(int(v) for v in residual.values())
                    total_abs = sum(abs(int(v)) for v in raw_diff.values())
                    # DỰNG/BÔNG: âm còn lại -> dương còn lại -> nhiều lá ->
                    # tỷ lệ gọn -> marker ngắn. Một bàn nên không cần tiêu chí số bàn.
                    score = (
                        residual_short,
                        int(positive),
                        total_abs,
                        -int(n),
                        ratio_total,
                        float(L),
                    )
                    if best is None or score < best[0]:
                        ratios = {k: int(r) for k, r in zip(keys, rr) if int(r) > 0}
                        best = (score, n, L, ratios, actual, raw_diff,
                                residual, positive, transfers, used)

            if best is None:
                return None

            _, n, L, ratios, actual, raw_diff, residual, positive, transfers, used = best
            table = {
                'table': 'B1',
                'sizes': {k: int(v) for k, v in actual.items() if int(v) > 0},
                'ratio': fmt(ratios),
                'length': float(L),
                'raw_length': float(L),
                'plies': int(n),
                'ratio_map': dict(ratios),
                'total_output': sum(int(v) for v in actual.values()),
                'size_count': len(ratios),
                'left_total': 0,
                'small_left_count': 0,
                'small_left_sum': 0,
                'zeroed': 0,
                'over_total': sum(max(0, int(v)) for v in raw_diff.values()),
                'size_span': 0,
                'meter_rate': float(L) / max(1, sum(int(v) for v in ratios.values())),
            }
            info = {
                'unresolved': {},
                'optimizer': 'global_v121_fast_flexible_1_table',
                'fabric_mode': fabric_mode,
                'fabric_mode_label': profile.get('label', ''),
                'over_limits': dict(over_limits),
                'under_limits': dict(under_limits),
                'allow_under': allow_under,
                'downgrade_large_to_small': downgrade_large_to_small,
                'raw_diff': dict(raw_diff),
                'residual_under': dict(residual),
                'size_transfers': list(transfers),
                'transfer_used': int(used),
                'final_positive_surplus': int(positive),
                'total_surplus_cap': int(total_surplus_cap),
                'total_surplus_pct': float(total_surplus_pct),
                'note': 'V121: dùng bộ tìm nhanh 1 bàn cho DỰNG/BÔNG định mức nhỏ.'
            }
            return [table], info

        # V126: DỰNG/BÔNG dùng CÙNG một nguyên tắc cho phương án 1 bàn.
        # Sau khi cho cỡ lớn hạ xuống bù cỡ bé, nếu KHÔNG còn thiếu và tổng dương
        # cuối cùng vẫn nằm trong giới hạn thì chốt 1 bàn ngay. Không còn giới hạn
        # số lượng phải hạ cỡ (transfer_used), vì giới hạn này làm BÔNG bị ép sang
        # 2 bàn dù một marker đã cân đủ sản lượng sau quy đổi.
        fast_flexible = build_fast_flexible_single_table()
        _fast_low_norm_mode = fast_flexible is not None
        if fast_flexible is not None:
            _fi = fast_flexible[1] if isinstance(fast_flexible, tuple) and len(fast_flexible) > 1 else {}
            _fr = _fi.get('residual_under', {}) if isinstance(_fi, dict) else {}
            _f_residual = sum(max(0, int(v or 0)) for v in _fr.values())
            _f_positive = int((_fi or {}).get('final_positive_surplus', 0) or 0)
            _pos_cap = max(0, int(total_surplus_cap)) if total_surplus_cap >= 0 else 10**9
            if _f_residual == 0 and _f_positive <= _pos_cap:
                return fast_flexible

        # Nếu không thể ghép 2 cỡ ngay từ điều kiện chiều dài, trả phương án
        # bắt buộc này ngay. V105 trước đây cấm mọi nghiệm toàn bàn đơn cỡ nên
        # cuối cùng báo "thiếu" toàn bộ sản lượng dù thực tế vẫn cắt được.
        if not merge_physically_possible:
            singles = build_forced_singletons()
            if singles is not None:
                return singles, {
                    'unresolved': {},
                    'optimizer': 'global_v106_forced_singletons',
                    'note': 'Không thể ghép 2 cỡ trong giới hạn chiều dài; dùng bàn đơn cỡ bắt buộc.'
                }

        def _vec_rank(vec):
            active = sum(1 for x in vec if x > 0)
            mx = max(vec) if vec else 0
            ss = sum(vec)
            spread = (mx - min((x for x in vec if x > 0), default=0)) if active else 0
            # Giữ cả vector trải đều và vector tập trung để beam phía sau còn lựa chọn.
            return (-active, mx, ss, spread, vec)

        def options_for_size(k, lays, keep=9, per_output=5):
            """Tìm nhiều vector tỷ lệ cho một cỡ.

            V115: DỰNG/MEX và BÔNG được phép âm/dương. Vì vậy output của một
            cỡ có thể nằm trong [yêu cầu-under, yêu cầu+over]. Cỡ lớn dương sẽ
            được phép hạ xuống bù cỡ bé ở bước chấm toàn bộ phương án.
            """
            q = int(total_by_size[k])
            if allow_under:
                _idx = keys.index(k)
                _transfer_cap = (sum(over_limit(x) for x in keys[_idx + 1:])
                                 if downgrade_large_to_small else 0)
                # Có thể thiếu sâu hơn giới hạn âm riêng nếu phần thiếu đó có khả năng
                # được cỡ lớn dương hạ xuống bù. Phần âm CÒN LẠI sau hạ cỡ mới bị
                # giới hạn bởi under_limit(k).
                lo = max(0, q - under_limit(k) - _transfer_cap)
            else:
                lo = q
            hi = q + over_limit(k)

            # got -> danh sách vector. Không chỉ giữ 1 vector như V104.
            states = {0: [tuple()]}
            for j, n in enumerate(lays):
                nxt = {}
                for got, vecs in states.items():
                    max_r = min(ratio_cap, (hi - got) // n)
                    for vec in vecs:
                        for r in range(max_r + 1):
                            if not ratio_is_allowed(r):
                                continue
                            ng = got + r * n
                            nv = vec + (r,)
                            bucket = nxt.setdefault(ng, [])
                            bucket.append(nv)
                # Cắt gọn nhưng giữ nhiều kiểu phân bổ khác nhau cho cùng output.
                pruned = {}
                for got, vecs in nxt.items():
                    uniq = list(dict.fromkeys(vecs))
                    a = sorted(uniq, key=_vec_rank)[:max(2, per_output // 2)]
                    b = sorted(uniq, key=lambda v: (sum(v), max(v) if v else 0,
                                                   -sum(1 for x in v if x > 0), v))[:max(2, per_output // 2)]
                    merged = list(dict.fromkeys(a + b))[:per_output]
                    pruned[got] = merged
                states = pruned
                if not states:
                    return []

            out = []
            for got in range(lo, hi + 1):
                for vec in states.get(got, []):
                    if not any(vec):
                        continue
                    rs = sum(vec)
                    active = sum(1 for v in vec if v > 0)
                    diff = got - q
                    # Với BÔNG/DỰNG: phạt theo độ lệch tuyệt đối, không coi âm là lỗi.
                    penalty = abs(diff) if allow_under else max(0, diff)
                    out.append((penalty, rs, vec, active, diff))

            # Ưu tiên lệch ít, ghép nhiều bàn, tỷ lệ gọn. Nếu độ lệch bằng nhau
            # thì hơi ưu tiên dương vì dương cỡ lớn còn có thể hạ xuống cỡ bé.
            out.sort(key=lambda z: (z[0], -z[3], z[1], 0 if z[4] >= 0 else 1,
                                    max(z[2]), z[2]))
            return [(a, b, c) for a, b, c, _, _ in out[:keep]]

        def solve_lays(lays, beam_width=320):
            # V128: cap chiều dài riêng cho từng bàn dựa trên tương quan số lá.
            # VD max=4m, bàn chính 109 lá, bàn vét 4 lá -> bàn 4 lá chỉ được <=1.6m.
            _max_lay_in_set = max(int(n) for n in lays) if lays else 0
            _dynamic_caps = tuple(dynamic_marker_cap(int(n), _max_lay_in_set) for n in lays)

            opts_all = []
            for k in keys:
                oo = options_for_size(k, lays)
                if not oo:
                    return None
                opts_all.append((k, oo))

            m = len(lays)
            # over, ratio_total, lengths, ratios_per_table, dicts
            beam = [(0, 0, tuple(0.0 for _ in range(m)),
                     tuple(0 for _ in range(m)), tuple({} for _ in range(m)))]

            for k, opts in opts_all:
                nxt = []
                for ov, rt, lens, rps, dicts in beam:
                    for addov, addr, rr in opts:
                        nl = list(lens)
                        np = list(rps)
                        nd = [dict(d) for d in dicts]
                        bad = False
                        for j, r in enumerate(rr):
                            if not r:
                                continue
                            np[j] += r
                            if max_products > 0 and np[j] > max_products:
                                bad = True
                                break
                            nl[j] += slen[k] * r
                            _cap_j = _dynamic_caps[j] if j < len(_dynamic_caps) else max_len
                            if _cap_j > 0 and nl[j] > _cap_j + 1e-9:
                                bad = True
                                break
                            nd[j][k] = r
                        if not bad:
                            nxt.append((ov + addov, rt + addr, tuple(nl),
                                        tuple(np), tuple(nd)))
                if not nxt:
                    return None

                # Beam ưu tiên trước hết khả năng ghép: nhiều bàn đã có >=2 cỡ,
                # sau đó dương thấp và chiều dài cân đối.
                def partial_score(x):
                    ov, rt, lens, rps, dicts = x
                    counts = [len(d) for d in dicts]
                    multi = sum(1 for c in counts if c >= 2)
                    used = sum(1 for c in counts if c >= 1)
                    single = sum(1 for c in counts if c == 1)

                    # V119: beam chỉ giữ tiêu chí khả thi/chất lượng chính.
                    # Không đưa quy tắc bàn cuối vào đây vì có thể loại sớm một
                    # trạng thái đang cần thiết để ghép đủ sản lượng ở bước sau.
                    return (ov, -multi, -used, single, rt,
                            max(lens) if lens else 0,
                            (max(lens) - min(lens)) if lens else 0)

                nxt.sort(key=partial_score)
                beam = nxt[:beam_width]

            best = None
            for st in beam:
                ov, rt, lens, rps, dicts = st
                if any(not d for d in dicts):
                    continue
                if even_ratio and any(not ratio_is_allowed(sum(int(v or 0) for v in d.values())) for d in dicts):
                    continue
                if any(L + 1e-9 < min_len for L in lens):
                    continue
                # V128: kiểm tra lại cap động ở nghiệm hoàn chỉnh.
                if any((_dynamic_caps[j] > 0 and float(lens[j]) > float(_dynamic_caps[j]) + 1e-9)
                       for j in range(m)):
                    continue

                size_counts = [len(d) for d in dicts]
                singleton_count = sum(1 for c in size_counts if c <= 1)
                multi_count = sum(1 for c in size_counts if c >= 2)

                # Nếu thực sự có thể ghép cỡ thì không nhận phương án tất cả bàn
                # đều đơn cỡ. Một bàn đuôi đơn cỡ vẫn được phép.
                if m > 1 and singleton_count == m and merge_physically_possible:
                    continue

                # Tính sản lượng thực của từng cỡ từ toàn bộ bàn.
                actual = {k: 0 for k in keys}
                for j, d in enumerate(dicts):
                    for k, r in d.items():
                        actual[k] += int(r) * int(lays[j])

                raw_diff = {k: int(actual.get(k, 0)) - int(total_by_size[k]) for k in keys}
                # Dương thô của từng cỡ vẫn không vượt profile.
                if any(raw_diff[k] > over_limit(k) for k in keys):
                    continue

                transfers = []
                residual_under = {k: max(0, -raw_diff[k]) for k in keys}
                transfer_used = 0
                final_positive_surplus = sum(max(0, raw_diff[k]) for k in keys)

                if allow_under and downgrade_large_to_small:
                    # Hạ cỡ một chiều: cỡ LỚN -> cỡ BÉ. Đi từ cỡ lớn về bé,
                    # giữ lượng dương chưa dùng của cỡ lớn làm nguồn bù.
                    sources = []  # [size_key, qty_available]
                    residual_under = {k: 0 for k in keys}
                    for k in reversed(keys):
                        d = raw_diff[k]
                        if d > 0:
                            sources.append([k, int(d)])
                            continue
                        if d >= 0:
                            continue
                        need = int(-d)
                        # Dùng cỡ lớn GẦN NHẤT trước.
                        for src in reversed(sources):
                            if need <= 0:
                                break
                            if src[1] <= 0:
                                continue
                            use = min(need, src[1])
                            if use > 0:
                                transfers.append((src[0], k, use))
                                src[1] -= use
                                need -= use
                                transfer_used += use
                        residual_under[k] = need
                    # Sau khi hạ cỡ, chỉ phần dương CHƯA DÙNG mới là dương thực sự.
                    final_positive_surplus = sum(max(0, int(src[1])) for src in sources)
                elif allow_under:
                    residual_under = {k: max(0, -raw_diff[k]) for k in keys}
                    final_positive_surplus = sum(max(0, raw_diff[k]) for k in keys)
                else:
                    # Các nhóm vải khác không được âm.
                    if any(raw_diff[k] < 0 for k in keys):
                        continue
                    residual_under = {k: 0 for k in keys}
                    final_positive_surplus = sum(max(0, raw_diff[k]) for k in keys)

                # Với DỰNG/BÔNG, chỉ phần âm CÒN LẠI sau khi hạ cỡ mới phải
                # nằm trong giới hạn âm của cỡ đó.
                if allow_under and any(residual_under[k] > under_limit(k) for k in keys):
                    continue

                # V117: DỰNG/BÔNG không được chấp nhận phương án dương tổng quá rộng.
                # Tổng dương này được tính SAU khi cỡ lớn đã hạ xuống bù cỡ bé.
                if total_surplus_cap >= 0 and final_positive_surplus > total_surplus_cap:
                    continue
                if fixed_table_count > 0 and sum(residual_under.values()) > 0:
                    continue

                residual_short = sum(residual_under.values())
                total_abs_diff = sum(abs(v) for v in raw_diff.values())
                balanced_abs_diff = residual_short + final_positive_surplus

                # Không ép cứng mọi bàn phải >=2 cỡ; chấm phạt bàn đơn cỡ.
                total_size_links = sum(size_counts)
                target_mid = ((min_len + max_len) / 2.0) if max_len > 0 else min_len
                length_pen = sum(abs(L - target_mid) for L in lens)

                # V119 - quy tắc chung cho TẤT CẢ LOẠI VẢI:
                # bàn có SỐ LÁ ÍT NHẤT là bàn vét/bàn cuối. Khi so các phương án
                # cùng chất lượng sản lượng, ưu tiên bàn này có:
                #   1) tổng tỷ lệ ít hơn;
                #   2) chiều dài sơ đồ ngắn hơn;
                #   3) ít cỡ hơn.
                tail_idx = min(range(m), key=lambda j: (int(lays[j]), j))
                tail_ratio_total = int(rps[tail_idx])
                tail_length = float(lens[tail_idx])
                tail_size_count = int(size_counts[tail_idx])

                # V128: ngoài giới hạn cứng ở trên, còn ưu tiên mềm để bàn ít lá
                # tự chọn tỷ lệ ít và chiều dài ngắn hơn trong các nghiệm cùng chất lượng.
                _max_lay_score = max(int(n) for n in lays) if lays else 1
                low_ply_length_score = 0.0
                for _j in range(m):
                    _share = float(lays[_j]) / float(max(1, _max_lay_score))
                    # Bàn càng ít lá thì trọng số chiều dài càng lớn.
                    low_ply_length_score += float(lens[_j]) * max(0.0, 1.0 - _share)

                if allow_under:
                    # V117 - thứ tự ưu tiên cho DỰNG/BÔNG:
                    # 1) âm còn lại sau hạ cỡ thấp nhất;
                    # 2) dương thực sự sau hạ cỡ thấp nhất;
                    # 3) ít bàn hơn;
                    # 4) nhiều lá hơn;
                    # 5) marker hợp lý / ghép cỡ tốt.
                    score = (
                        residual_short,
                        final_positive_surplus,
                        m,
                        transfer_used,
                        # V128: cùng chất lượng sản lượng/số bàn thì bàn ít lá phải gọn trước.
                        tail_ratio_total,
                        tail_length,
                        low_ply_length_score,
                        -sum(lays),
                        singleton_count,
                        -multi_count,
                        -total_size_links,
                        balanced_abs_diff,
                        total_abs_diff,
                        length_pen,
                        rt,
                        max(lens),
                        max(lens) - min(lens),
                        -min(lays),
                        tail_size_count,
                    )
                else:
                    score = (
                        ov,                         # dương thấp nhất
                        # V128: sau dương, ưu tiên bàn ít lá có tỷ lệ/chiều dài gọn.
                        tail_ratio_total,
                        tail_length,
                        low_ply_length_score,
                        singleton_count,
                        -multi_count,
                        -total_size_links,
                        rt,
                        length_pen,
                        -sum(lays),
                        max(lens),
                        max(lens) - min(lens),
                        -min(lays),
                        tail_size_count,
                    )

                if best is None or score < best[0]:
                    # Gắn thông tin cân cỡ vào state phụ để lấy lại sau khi chọn.
                    best = (score, st, {
                        'raw_diff': raw_diff,
                        'residual_under': residual_under,
                        'transfers': transfers,
                        'transfer_used': transfer_used,
                        'final_positive_surplus': final_positive_surplus,
                        'total_surplus_cap': total_surplus_cap,
                    })
            return best

        # Sinh số lá ứng viên quanh q/r. V105 giữ dải rộng hơn cho 2-4 bàn.
        cand = {min_lays}
        anchor_score = {}
        for k in keys:
            q = int(total_by_size[k])
            for r in range(1, ratio_cap + 1):
                base = int(round(q / r))
                for d in range(-8, 9):
                    n = base + d
                    if min_lays <= n <= max_lays:
                        cand.add(n)
        step = max(1, max_lays // 70)
        cand.update(range(min_lays, max_lays + 1, step))
        cand = sorted(cand)

        for n in cand:
            anchor_score[n] = min(
                abs(n - int(round(int(total_by_size[k]) / r)))
                for k in keys for r in range(1, ratio_cap + 1)
            )

        # Không cắt cand quá mạnh như V104 vì có thể làm mất đúng số lá cần ghép.
        if len(cand) > 130:
            keep = {n for _, n in sorted((anchor_score[n], n) for n in cand)[:105]}
            keep.update(cand[::max(1, len(cand) // 24)])
            cand = sorted(keep)

        # Tập gọn cho 4-6 bàn phải giữ cả các số lá "phần dư". Ví dụ một
        # cỡ 229 có thể được chia 203 + 26; nếu chỉ giữ q/r thì số 26 biến mất.
        exact_anchors = set()
        split_values = set()
        qvals = [int(total_by_size[k]) for k in keys]
        for qv in qvals:
            for r in range(1, ratio_cap + 1):
                for n in (qv // r, int(math.ceil(qv / r))):
                    if min_lays <= n <= max_lays:
                        exact_anchors.add(n)
        for a in qvals:
            for b in qvals:
                if a <= b:
                    continue
                d = a - b
                if min_lays <= d <= max_lays:
                    split_values.add(d)
                for r in range(2, min(ratio_cap, 4) + 1):
                    for bb in (b // r, int(math.ceil(b / r))):
                        d2 = a - bb
                        if min_lays <= d2 <= max_lays:
                            split_values.add(d2)

        compact_pool = set(sorted(cand, key=lambda n: (anchor_score[n], -n))[:16])
        compact_pool.update(exact_anchors)
        compact_pool.update(split_values)
        compact_pool = {n for n in compact_pool if min_lays <= n <= max_lays}

        def compact_score(n):
            support = 0
            for qv in qvals:
                _tol = max(max(over_limit(k), under_limit(k)) for k in keys)
                if any(abs(qv - r*n) <= _tol
                       for r in range(1, ratio_cap + 1)):
                    support += 3
            for a in qvals:
                for b in qvals:
                    if a > b and abs((a-b) - n) <= 3:
                        support += 2
            return (-support, anchor_score.get(n, 9999), -n)

        _compact_keep = 18 if allow_under else 24
        compact = sorted(compact_pool, key=compact_score)[:_compact_keep]
        compact = sorted(compact)

        # Tập số lá dùng cho tìm 2-3 bàn: DỰNG/BÔNG dùng tập gọn hơn để vẫn
        # thử được nhiều số bàn mà không làm chậm xuất Excel.
        _search_keep = 18 if allow_under else 22
        search_cand = sorted(cand, key=lambda n: (anchor_score[n], -n))[:_search_keep]
        search_cand = sorted(set(search_cand + [cand[0], cand[-1]]))

        # V107 FAST PREFILTER: V106 gọi options_for_size() cho HÀNG NGHÌN
        # tổ hợp số lá chỉ để xếp hạng. Đây là phần làm TOÀN CỤC rất chậm.
        # Ta chỉ kiểm tra nhanh khả năng biểu diễn SL bằng DP số nguyên; chỉ các
        # tổ hợp tốt nhất mới đi vào solve_lays() đầy đủ (chiều dài/ghép cỡ).
        from bisect import bisect_left as _bisect_left
        max_hi_all = max(int(total_by_size[k]) + over_limit(k) for k in keys)
        _reach_cache = {}

        def _reachable_outputs(lays):
            lays = tuple(lays)
            hit = _reach_cache.get(lays)
            if hit is not None:
                return hit
            reachable = {0}
            for n in lays:
                nxt = set()
                for got in reachable:
                    max_r = min(ratio_cap, (max_hi_all - got) // n)
                    for r in range(max_r + 1):
                        nxt.add(got + r * n)
                reachable = nxt
                if not reachable:
                    break
            vals = tuple(sorted(reachable))
            _reach_cache[lays] = vals
            return vals

        def _cheap_combo_score(lays):
            vals = _reachable_outputs(lays)
            if not vals:
                return None
            total_dev = 0
            for k in keys:
                q = int(total_by_size[k])
                if allow_under:
                    _idx = keys.index(k)
                    _transfer_cap = (sum(over_limit(x) for x in keys[_idx + 1:])
                                     if downgrade_large_to_small else 0)
                    lo = max(0, q - under_limit(k) - _transfer_cap)
                else:
                    lo = q
                hi = q + over_limit(k)
                left = _bisect_left(vals, lo)
                right = _bisect_left(vals, hi + 1)
                if left >= right:
                    return None
                pos = _bisect_left(vals, q)
                candidates = []
                for ii in (left, right - 1, pos, pos - 1):
                    if left <= ii < right:
                        candidates.append(vals[ii])
                if not candidates:
                    return None
                best_v = min(candidates, key=lambda v: (abs(v - q), 0 if v >= q else 1, v))
                total_dev += abs(best_v - q) if allow_under else max(0, best_v - q)
            # Sau độ lệch, ưu tiên các số lá gần điểm q/r rồi tổng lá cao.
            anch = sum(anchor_score.get(n, 9999) for n in lays)
            return (total_dev, anch, -sum(lays), max(lays) - min(lays))

        # 4-6 bàn dùng tập nhỏ hơn để tránh C(24,6)=134,596 tổ hợp.
        # 18 ứng viên vẫn giữ các điểm q/r và số lá phần dư quan trọng.
        _large_keep = 24 if fixed_table_count > 0 else (12 if allow_under else 18)
        compact_large_ranked = sorted(compact_pool, key=compact_score)[:_large_keep]
        compact_large = sorted(compact_large_ranked)

        chosen = None
        option_solutions = []
        _search_all_table_counts = bool(fixed_table_count > 0 or (allow_under and total_surplus_cap >= 0))

        def _keep_solution(sol, lays):
            nonlocal chosen
            if sol is None:
                return
            candidate = (sol[0], tuple(lays), sol[1], sol[2])
            if fixed_table_count > 0:
                _state = sol[1]
                _sig = (tuple(lays), tuple(tuple(sorted((d or {}).items())) for d in (_state[4] or ())))
                if not any(x[1] == _sig for x in option_solutions):
                    option_solutions.append((candidate[0], _sig, candidate))
                    option_solutions.sort(key=lambda x: x[0])
                    del option_solutions[5:]
            if chosen is None or candidate[0] < chosen[0]:
                chosen = candidate

        def _primary_perfect():
            # Với DỰNG/BÔNG, 0 âm còn lại + 0 dương sau hạ cỡ là tối ưu tuyệt đối
            # cho hai tiêu chí quan trọng nhất; không cần thử thêm nhiều bàn hơn.
            return bool(fixed_table_count <= 0 and _search_all_table_counts and chosen is not None
                        and len(chosen[0]) >= 2
                        and chosen[0][0] == 0 and chosen[0][1] == 0)

        def _fast_flexible_good_enough():
            """V125: với BÔNG/DỰNG định mức nhỏ, sau khi đã thử 2 bàn thì
            dừng sớm nếu không còn âm sau hạ cỡ và lượng hạ cỡ ở mức nhỏ.
            Tránh tiếp tục quét 3-6 bàn rất lâu chỉ để cải thiện vài sản phẩm.
            """
            if fixed_table_count > 0 or not _fast_low_norm_mode or chosen is None or len(chosen) < 4:
                return False
            bi = chosen[3] if isinstance(chosen[3], dict) else {}
            residual = sum(max(0, int(v or 0)) for v in (bi.get('residual_under', {}) or {}).values())
            positive = int(bi.get('final_positive_surplus', 0) or 0)
            transfer = int(bi.get('transfer_used', 0) or 0)
            total_target = sum(int(total_by_size.get(k, 0) or 0) for k in keys)
            soft_transfer = max(5,
                                (int(total_surplus_cap) + 5) if total_surplus_cap >= 0 else 30,
                                int(math.floor(total_target * 0.012 + 1e-9)))
            pos_cap = int(total_surplus_cap) if total_surplus_cap >= 0 else max(3, int(total_target * 0.01))
            return residual == 0 and positive <= pos_cap and transfer <= soft_transfer

        # 1 bàn
        for n in (search_cand if fixed_table_count in (0, 1) else ()):
            sol = solve_lays((n,), beam_width=350)
            if sol is not None:
                _keep_solution(sol, (n,))
                if _primary_perfect():
                    break
        # Với các loại vải thường, nếu 1 bàn đã có nghiệm thì giữ nguyên ưu tiên
        # ít bàn như trước. DỰNG/BÔNG phải tiếp tục thử 2..6 bàn để so tổng dương.
        if chosen is not None and not _search_all_table_counts:
            pass
        else:
            # 2 bàn: DP nhẹ để xếp hạng, solver sâu cho nhóm ứng viên tốt.
            ranked = []
            for lays in (_comb(search_cand, 2) if fixed_table_count in (0, 2) else ()): 
                if fixed_table_count <= 0 and math.gcd(lays[0], lays[1]) > 3:
                    continue
                cs = _cheap_combo_score(lays)
                if cs is not None:
                    ranked.append((*cs, lays))
            ranked.sort()
            _found_for_count = False
            _feasible_seen = 0
            for *_, lays in ranked[:140]:
                sol = solve_lays(lays, beam_width=320)
                if sol is None:
                    continue
                _keep_solution(sol, lays)
                _found_for_count = True
                _feasible_seen += 1
                if _primary_perfect():
                    break
                # V118: vải thường vẫn ưu tiên ít bàn, nhưng thử thêm một nhóm nhỏ
                # nghiệm CÙNG số bàn để chọn được bàn ít lá có tỷ lệ/chiều dài đẹp.
                if (not _search_all_table_counts) and _feasible_seen >= 12:
                    break

            # 3 bàn
            if (not _primary_perfect()) and (not _fast_flexible_good_enough()) and (_search_all_table_counts or (chosen is None)):
                ranked = []
                for lays in (_comb(compact, 3) if fixed_table_count in (0, 3) else ()): 
                    if fixed_table_count <= 0 and math.gcd(math.gcd(lays[0], lays[1]), lays[2]) > 3:
                        continue
                    cs = _cheap_combo_score(lays)
                    if cs is not None:
                        ranked.append((*cs, lays))
                ranked.sort()
                _feasible_seen = 0
                for *_, lays in ranked[:200]:
                    sol = solve_lays(lays, beam_width=380)
                    if sol is None:
                        continue
                    _keep_solution(sol, lays)
                    _feasible_seen += 1
                    if _primary_perfect():
                        break
                    if (not _search_all_table_counts) and _feasible_seen >= 14:
                        break

            # 4..6 bàn
            for table_count in ([fixed_table_count] if fixed_table_count >= 4 else (range(4, 7) if fixed_table_count == 0 else ())):
                if _primary_perfect() or _fast_flexible_good_enough():
                    break
                if chosen is not None and not _search_all_table_counts:
                    break
                ranked = []
                for lays in _comb(compact_large, table_count):
                    g = lays[0]
                    for n in lays[1:]:
                        g = math.gcd(g, n)
                    if g > 3 and fixed_table_count <= 0:
                        continue
                    cs = _cheap_combo_score(lays)
                    if cs is not None:
                        ranked.append((*cs, lays))
                ranked.sort()
                limit = min(len(ranked), 1000) if fixed_table_count > 0 else (120 if table_count == 4 else (90 if table_count == 5 else 60))
                _feasible_seen = 0
                for *_, lays in ranked[:limit]:
                    sol = solve_lays(lays, beam_width=600 if fixed_table_count > 0 else 320)
                    if sol is None:
                        continue
                    _keep_solution(sol, lays)
                    _feasible_seen += 1
                    if _primary_perfect():
                        break
                    if (not _search_all_table_counts) and _feasible_seen >= 8:
                        break

        # V164: nếu đã cố định đúng 1 bàn cho BÔNG/DỰNG/MEX mà giới hạn cân
        # bằng chặt không sinh nghiệm, vẫn tạo các phương án khả thi theo chiều dài.
        # Bảng sẽ hiện rõ dư/thiếu để người dùng tự chọn, thay vì báo lỗi và dừng.
        if chosen is None and fixed_table_count == 1 and allow_under and downgrade_large_to_small:
            fallback_options = []
            for n in range(min_lays, max_lays + 1):
                ratios = {}
                for k in keys:
                    q = int(total_by_size[k])
                    ideal = q / max(1, n)
                    choices = sorted((r for r in range(0, ratio_cap + 1) if ratio_is_allowed(r)),
                                     key=lambda r:(abs(r*n-q), 0 if r*n >= q else 1, r))
                    ratios[k] = int(choices[0])
                rtotal = sum(ratios.values())
                if even_ratio and not ratio_is_allowed(rtotal):
                    continue
                length = sum(float(slen[k]) * ratios[k] for k in keys)
                if rtotal <= 0 or (max_products > 0 and rtotal > max_products):
                    continue
                if length + 1e-9 < min_len or (max_len > 0 and length > max_len + 1e-9):
                    continue
                actual = {k: ratios[k] * n for k in keys}
                raw_diff = {k: actual[k] - int(total_by_size[k]) for k in keys}
                sources = []
                residual = {k: 0 for k in keys}
                transfers = []
                used = 0
                for k in reversed(keys):
                    delta = int(raw_diff[k])
                    if delta > 0:
                        sources.append([k, delta]); continue
                    need = -delta
                    for src in reversed(sources):
                        take = min(need, src[1])
                        if take > 0:
                            transfers.append((src[0], k, take)); src[1] -= take
                            need -= take; used += take
                        if need <= 0: break
                    residual[k] = need
                positive = sum(max(0, x[1]) for x in sources)
                if any(raw_diff[k] > over_limit(k) for k in keys):
                    continue
                if any(residual[k] > under_limit(k) for k in keys):
                    continue
                if total_surplus_cap >= 0 and positive > total_surplus_cap:
                    continue
                if sum(residual.values()) > 0:
                    continue
                score = (sum(residual.values()), positive, sum(abs(v) for v in raw_diff.values()),
                         abs(sum(raw_diff.values())), -n, length, tuple(ratios[k] for k in keys))
                table = {'table':'B1','sizes':{k:actual[k] for k in keys if ratios[k]},
                         'ratio':fmt({k:v for k,v in ratios.items() if v}), 'length':length,
                         'raw_length':length,'plies':n,'ratio_map':{k:v for k,v in ratios.items() if v},
                         'total_output':sum(actual.values()),'size_count':sum(1 for v in ratios.values() if v),
                         'left_total':0,'small_left_count':0,'small_left_sum':0,'zeroed':0,
                         'over_total':sum(max(0,v) for v in raw_diff.values()),'size_span':0,
                         'meter_rate':length/max(1,rtotal)}
                bi = {'raw_diff':raw_diff,'residual_under':residual,'transfers':transfers,
                      'transfer_used':used,'final_positive_surplus':positive,
                      'total_surplus_cap':total_surplus_cap}
                fallback_options.append((score, table, bi))
            fallback_options.sort(key=lambda x:x[0])
            unique = []
            signatures = set()
            for entry in fallback_options:
                sig = (entry[1]['plies'], tuple(sorted(entry[1]['ratio_map'].items())))
                if sig not in signatures:
                    signatures.add(sig); unique.append(entry)
                if len(unique) >= 5: break
            if unique:
                def _fallback_info(bi):
                    return {'unresolved':{}, 'optimizer':'fixed_one_table_balanced_options',
                            'fabric_mode':fabric_mode,'fabric_mode_label':profile.get('label',''),
                            'over_limits':dict(over_limits),'under_limits':dict(under_limits),
                            'allow_under':allow_under,'downgrade_large_to_small':downgrade_large_to_small,
                            'raw_diff':dict(bi['raw_diff']),'residual_under':dict(bi['residual_under']),
                            'size_transfers':list(bi['transfers']),'transfer_used':int(bi['transfer_used']),
                            'final_positive_surplus':int(bi['final_positive_surplus']),
                            'total_surplus_cap':total_surplus_cap,'balance_info':dict(bi)}
                primary = unique[0]
                result_options = [{'cutting_tables':[dict(x[1])], 'balance_info':dict(x[2]), 'score':x[0]} for x in unique]
                return [dict(primary[1])], dict(_fallback_info(primary[2]), plan_options=result_options,
                                                note='Đang hiển thị các phương án gần sản lượng nhất trong giới hạn 1 bàn; xem rõ số âm/dương trước khi chọn.')

        if chosen is None and fixed_table_count > 0:
            return [], {'unresolved': {k: int(total_by_size[k]) for k in keys},
                        'fixed_table_count': fixed_table_count,
                        'note': f'Không tìm thấy phương án khả thi đúng {fixed_table_count} bàn trong giới hạn hiện tại.'}

        if chosen is None:
            # V120: trước tiên dùng bộ cứu hộ khả thi 1-2 bàn/cỡ. Bộ này mạnh hơn
            # build_forced_singletons vì không bắt q phải gần đúng một bội r*n.
            # Nhờ vậy không còn trường hợp beam bỏ sót nghiệm rồi báo thiếu toàn bộ
            # 100/110/120/... dù thực tế vẫn có thể trải trong Min-Max.
            emergency = build_feasible_emergency()
            if emergency is not None:
                return emergency, {
                    'unresolved': {},
                    'optimizer': f'global_v120_emergency_{len(emergency)}_tables',
                    'note': ('Bộ toàn cục không tìm được nghiệm trong vùng beam; '
                             'đã dùng bộ cứu hộ khả thi 1-2 bàn/cỡ và ghép lại các bàn cùng số lá.')
                }

            # Fallback đơn cỡ 1 bàn/cỡ cũ vẫn giữ lại cho trường hợp đơn giản.
            rescue = build_forced_singletons()
            if rescue is not None:
                # V117: DỰNG/BÔNG cũng phải tôn trọng giới hạn dương tổng 1%.
                if allow_under and total_surplus_cap >= 0:
                    _r_actual = {k: 0 for k in keys}
                    for _tb in rescue:
                        for _k, _v in (_tb.get('sizes', {}) or {}).items():
                            _r_actual[_k] = _r_actual.get(_k, 0) + int(_v or 0)
                    _r_pos = sum(max(0, int(_r_actual.get(k, 0)) - int(total_by_size[k])) for k in keys)
                    if _r_pos > total_surplus_cap:
                        rescue = None
                if rescue is not None:
                    return rescue, {
                        'unresolved': {},
                        'optimizer': 'global_v120_rescue_singletons',
                        'note': 'Bộ tối ưu toàn cục không tìm được tổ hợp ghép cỡ; dùng phương án cứu hộ đủ sản lượng trong giới hạn dương tổng.'
                    }
            # V119: nếu beam toàn cục bỏ sót nghiệm, thử thuật toán tuần tự như
            # một phương án cứu hộ THỰC SỰ trước khi báo thiếu toàn bộ. Kết quả
            # cứu hộ vẫn phải đủ sản lượng theo điều kiện của loại vải.
            try:
                _seq_tables, _seq_info = self.optimize_cutting(
                    dict(total_by_size), dict(size_factor), norm, max_len,
                    max_products, fabric_mode, min_marker_length, balance_pct, even_ratio=even_ratio
                )
                if _seq_tables and not (_seq_info or {}).get('unresolved'):
                    _seq_info = dict(_seq_info or {})
                    _seq_info['optimizer'] = 'global_v120_rescue_sequential'
                    _seq_info['note'] = ('Bộ toàn cục không tìm được nghiệm trong vùng beam; '
                                         'đã dùng phương án cứu hộ tuần tự đủ sản lượng.')
                    return _seq_tables, _seq_info
            except Exception:
                pass
            return [], {'unresolved': {k: int(total_by_size[k]) for k in keys},
                        'optimizer': 'global_v120_no_solution'}

        def _candidate_tables(candidate):
            _score, _lays, _st, _balance = candidate
            _ov, _rt, _lens, _rps, _dicts = _st
            _tables = []
            for _idx, (_n, _L, _ratios) in enumerate(zip(_lays, _lens, _dicts), start=1):
                _sizes = {k: int(r) * _n for k, r in _ratios.items() if int(r) > 0}
                _tables.append({
                    'table': f'B{_idx}', 'sizes': _sizes, 'ratio': fmt(_ratios), 'length': _L,
                    'raw_length': _L, 'plies': _n, 'ratio_map': dict(_ratios),
                    'total_output': sum(_sizes.values()), 'size_count': len(_ratios),
                    'left_total': 0, 'small_left_count': 0, 'small_left_sum': 0,
                    'zeroed': 0, 'over_total': 0, 'size_span': 0,
                    'meter_rate': _L / max(1, sum(_ratios.values()))
                })
            return _tables

        score, lays, st, balance_info = chosen
        tables = _candidate_tables(chosen)
        plan_options = []
        if fixed_table_count > 0:
            for _entry in option_solutions:
                _candidate = _entry[2]
                _opt_tables = _candidate_tables(_candidate)
                _bi = _candidate[3] or {}
                plan_options.append({
                    'cutting_tables': _opt_tables,
                    'balance_info': dict(_bi),
                    'score': _candidate[0],
                })
        return tables, {
            'plan_options': plan_options,
            'unresolved': {},
            'optimizer': f'global_v128_{len(tables)}_tables',
            'fabric_mode': profile.get('mode', fabric_mode),
            'fabric_mode_label': profile.get('label', ''),
            'over_limits': over_limits,
            'under_limits': under_limits,
            'allow_under': allow_under,
            'downgrade_large_to_small': downgrade_large_to_small,
            'raw_diff': dict(balance_info.get('raw_diff', {})),
            'residual_under': dict(balance_info.get('residual_under', {})),
            'size_transfers': list(balance_info.get('transfers', [])),
            'transfer_used': int(balance_info.get('transfer_used', 0) or 0),
            'final_positive_surplus': int(balance_info.get('final_positive_surplus', 0) or 0),
            'total_surplus_cap': int(balance_info.get('total_surplus_cap', total_surplus_cap) or 0),
            'total_surplus_pct': total_surplus_pct,
        }

    def optimize_cutting(self, total_by_size, size_factor, norm, max_len, max_products=0, fabric_mode='main', min_marker_length=1.0, balance_pct=1.0, even_ratio=False):
        """V81: tối ưu theo chế độ giác của từng nhóm vật tư.

        Vải chính = chính xác; Vải lót = nhiều cỡ; Kẹp tầng = ít bàn/tỷ lệ gọn;
        Dựng-Mex = tỷ lệ lớn, tránh marker quá ngắn; Bông = ít bàn/tận dụng khổ.
        MỌI BÀN, kể cả bàn cuối, phải có chiều dài sơ đồ >= min_marker_length.
        Giá trị này lưu RIÊNG cho từng loại vải; mặc định gợi ý 1,00 m và người dùng có thể sửa.
        """
        tables = []
        name_map = {s['key']: s['name'] for s in self.sizes}
        size_order = {s['key']: i for i, s in enumerate(self.sizes)}

        profile = self._fabric_cut_profile(fabric_mode, total_by_size, norm, max_len, balance_pct)
        over_limits = dict(profile.get('over_limits', {}))
        under_limits = dict(profile.get('under_limits', {}))
        allow_under = bool(profile.get('allow_under', False))
        downgrade_large_to_small = bool(profile.get('downgrade_large_to_small', False))
        total_surplus_cap = int(profile.get('total_surplus_cap', -1))
        total_surplus_pct = float(profile.get('total_surplus_pct', 0.0) or 0.0)
        max_over_any = max(0, int(profile.get('max_over_any', self.MAX_OVER) or 0))
        target_min_marker = max(0.0, float(profile.get('target_min_marker', 0.0) or 0.0))
        merge_style = str(profile.get('merge_style', 'balanced') or 'balanced')
        score_style = str(profile.get('score_style', 'exact') or 'exact')
        prefer_size_spread = bool(profile.get('prefer_size_spread', False))

        def over_limit_for(size_key):
            return max(0, int(over_limits.get(size_key, self.MAX_OVER) or 0))

        def under_limit_for(size_key):
            return max(0, int(under_limits.get(size_key, 0) or 0)) if allow_under else 0

        def format_ratio(ratios):
            # Luôn hiển thị từ cỡ bé -> lớn theo thứ tự size trên giao diện.
            ordered = sorted(
                ((k, int(v)) for k, v in ratios.items() if int(v) > 0),
                key=lambda kv: size_order.get(kv[0], 10**6)
            )
            return ' + '.join(f"{name_map.get(k, k)}/{v}" for k, v in ordered)

        size_length = {}
        remaining = {}

        for size, qty in total_by_size.items():
            qty = int(qty or 0)
            if qty <= 0:
                continue
            # V127: chiều dài 1 đơn vị tỷ lệ = DMTB, không nhân hệ số cỡ.
            length = float(norm)
            if length <= 0:
                continue
            size_length[size] = length
            remaining[size] = qty

        if not remaining:
            return tables, {'unresolved': {}}

        max_len = max(0.0, float(max_len or 0))
        try:
            max_products = max(0, int(float(max_products or 0)))
        except Exception:
            max_products = 0

        # V76: sàn chiều dài sơ đồ lấy RIÊNG từ từng loại vải và áp dụng cho tất cả bàn.
        # Nếu người dùng đặt chiều dài tối đa < sàn này thì bài toán không thể hợp lệ.
        HARD_MIN_MARKER_LENGTH = max(0.0, float(min_marker_length if min_marker_length is not None else 1.0))
        if max_len > 0 and max_len + 1e-9 < HARD_MIN_MARKER_LENGTH:
            raise ValueError(
                f"Chiều dài sơ đồ tối đa {max_len:.2f} m nhỏ hơn chiều dài tối thiểu "
                f"{HARD_MIN_MARKER_LENGTH:.2f} m. Hãy tăng Chiều dài tối đa."
            )

        # Mục tiêu riêng từng loại vẫn được giữ (Lót 1.2m, Mex 1.5m...),
        # nhưng tuyệt đối không loại nào được có mục tiêu thấp hơn sàn 1m.
        target_min_marker = max(HARD_MIN_MARKER_LENGTH, target_min_marker)
        if max_len > 0:
            target_min_marker = min(target_min_marker, max_len)

        if max_len <= 0 and max_products <= 0:
            return tables, {'unresolved': dict(remaining)}

        # Làm tròn về mm để tránh sai số float. Nếu không giới hạn chiều dài
        # thì dùng một sức chứa rất lớn; khi đó chỉ giới hạn theo SP / sơ đồ.
        scale = 1000
        length_int = {s: max(1, int(round(v * scale))) for s, v in size_length.items()}
        cap_int = max(1, int(round(max_len * scale))) if max_len > 0 else 10**15

        # V129: áp dụng cùng quy tắc "ít lá -> marker ngắn" cho cả TUẦN TỰ.
        # So số lá của bàn đang xét với bàn nhiều lá nhất đã có trong kế hoạch.
        #   <=10%: tối đa 40% MAX; <=25%: 60%; <=50%: 80%; >50%: 100%.
        # Không bao giờ ép thấp hơn chiều dài tối thiểu người dùng đã nhập.
        def sequential_dynamic_marker_cap(plies, reference_tables=None):
            if max_len <= 0:
                return None
            try:
                p = max(1, int(plies or 0))
            except Exception:
                p = 1
            refs = [p]
            src_tabs = tables if reference_tables is None else reference_tables
            for tb in (src_tabs or []):
                try:
                    tp = int(tb.get('plies', 0) or 0)
                except Exception:
                    tp = 0
                if tp > 0:
                    refs.append(tp)
            max_p = max(refs) if refs else p
            share = float(p) / float(max(1, max_p))
            if share <= 0.10 + 1e-12:
                frac = 0.40
            elif share <= 0.25 + 1e-12:
                frac = 0.60
            elif share <= 0.50 + 1e-12:
                frac = 0.80
            else:
                frac = 1.00
            return min(max_len, max(HARD_MIN_MARKER_LENGTH, max_len * frac))

        def marker_within_limits(ratios, raw_len=None, plies=None, reference_tables=None):
            if even_ratio:
                _positive_ratios = [int(v or 0) for v in ratios.values() if int(v or 0) > 0]
                _ratio_total = sum(_positive_ratios)
                if any(v != 1 and v % 2 for v in _positive_ratios):
                    return False
                if _ratio_total > 0 and _ratio_total != 1 and _ratio_total % 2:
                    return False
            if max_products > 0 and sum(max(0, int(v)) for v in ratios.values()) > max_products:
                return False
            if raw_len is None:
                raw_len = sum(float(size_length[k]) * int(v) for k, v in ratios.items())
            if max_len > 0 and float(raw_len) > max_len + 1e-9:
                return False
            if plies is not None:
                dyn_cap = sequential_dynamic_marker_cap(plies, reference_tables)
                if dyn_cap is not None and float(raw_len) > float(dyn_cap) + 1e-9:
                    return False
            return True

        # V76: dùng đúng chiều dài thực của marker và áp dụng sàn riêng của loại vải cho MỌI bàn.
        # target_min_marker chỉ là mức ƯU TIÊN riêng của từng loại vật tư;
        # HARD_MIN_MARKER_LENGTH mới là giới hạn cứng không được thấp hơn.
        MIN_MARKER_LENGTH = HARD_MIN_MARKER_LENGTH
        FINAL_MIN_MARKER_LENGTH = HARD_MIN_MARKER_LENGTH

        def build_candidate(source_remaining, lays, preferred_main=None):
            """Tao 1 marker tai mot muc so la, cho phep dương toi da 3 SP/co."""
            if not source_remaining or lays < 4:
                return None

            # Co duoc tham gia neu voi so la nay phan dương khong vuot MAX_OVER.
            eligible = [
                s for s, q in source_remaining.items()
                if q + over_limit_for(s) >= lays
            ]
            if not eligible:
                return None

            # V71: không ép cặp nhỏ/lớn; bàn chính ưu tiên ghép nhiều cỡ.
            # Cỡ nào đi với cỡ nào không quan trọng; chương trình chọn từng nhịp
            # tỷ lệ theo hiệu quả thực tế của bàn cắt:
            #   1) tránh tạo phần thiếu 1..3 SP;
            #   2) hạn chế sản lượng dương / cắt thừa;
            #   3) ưu tiên triệt tiêu cỡ đang còn;
            #   4) tận dụng chiều dài marker còn trống tốt nhất.
            # Nhờ vậy thứ tự XS/S/M/L/XL không còn là tiêu chí ghép cỡ.
            # Cỡ chính (SL còn lớn nhất) chỉ được dùng làm điểm bắt đầu để giữ
            # mục tiêu ít bàn; các tỷ lệ tiếp theo được chọn hoàn toàn theo điểm tối ưu.
            ratios = {}
            used = 0
            ratio_pieces = 0

            # V129: TUẦN TỰ cũng dùng cap động theo số lá của bàn.
            dyn_cap = sequential_dynamic_marker_cap(lays)
            dyn_cap_int = cap_int if dyn_cap is None else max(1, int(round(dyn_cap * scale)))

            # Tỷ lệ tối đa hợp lệ của từng cỡ tại mức số lá hiện tại.
            max_ratio_map = {}
            for s in eligible:
                max_ratio = int((source_remaining[s] + over_limit_for(s)) // lays)
                if max_ratio <= 0:
                    continue
                max_ratio = min(max_ratio, int(dyn_cap_int // length_int[s]))
                if max_products > 0:
                    max_ratio = min(max_ratio, int(max_products))
                if max_ratio > 0:
                    max_ratio_map[s] = max_ratio

            if not max_ratio_map:
                return None

            # Bắt đầu bằng cỡ chính nếu có thể. Nếu cỡ chính không thể nằm trên
            # marker thì lấy cỡ còn lại có SL lớn nhất, không dựa vào vị trí size.
            if preferred_main in max_ratio_map:
                start_size = preferred_main
            else:
                start_size = max(
                    max_ratio_map,
                    key=lambda s: (source_remaining[s], -length_int[s], str(s))
                )

            ratios[start_size] = 1
            used = length_int[start_size]
            ratio_pieces = 1

            # Thêm từng nhịp tỷ lệ. Mỗi lần đều xét TẤT CẢ cỡ có thể thêm,
            # kể cả tăng tỷ lệ cỡ đã có hoặc thêm một cỡ mới. Đây là điểm khác
            # V65: không có danh sách cặp nhỏ-lớn cố định nữa.
            while True:
                if max_products > 0 and ratio_pieces >= max_products:
                    break

                options = []
                for s, max_ratio in max_ratio_map.items():
                    cur_ratio = int(ratios.get(s, 0))
                    increment = (1 if ratio_pieces <= 1 else 2) if even_ratio else 1
                    next_ratio = cur_ratio + increment
                    if even_ratio and next_ratio > 0 and next_ratio != 1 and next_ratio % 2:
                        continue
                    if next_ratio > max_ratio:
                        continue
                    if max_products > 0 and ratio_pieces + increment > max_products:
                        continue
                    if used + length_int[s] * increment > dyn_cap_int:
                        continue

                    q = int(source_remaining[s])
                    before_prod = cur_ratio * lays
                    after_prod = next_ratio * lays
                    before_left = max(0, q - before_prod)
                    after_left = max(0, q - after_prod)
                    after_over = max(0, after_prod - q)

                    small_left_penalty = 1 if 0 < after_left < 4 else 0
                    zero_penalty = 0 if after_left == 0 else 1
                    useful_added = min(lays, before_left)
                    gap_after = (dyn_cap_int - (used + length_int[s] * increment)) if max_len > 0 else 0

                    # V71: với bàn nhiều lá (bàn đầu/bàn chính), ưu tiên THÊM CỠ MỚI
                    # để một marker ghép được nhiều cỡ. Với bàn ít lá (bàn vét/bàn cuối),
                    # không cần ép ghép cỡ; ưu tiên giữ marker gọn và giảm dương.
                    low_plies_limit = max(4, int(getattr(self, 'MIN_PREFERRED_PLIES', 10)))
                    prefer_merge = lays >= low_plies_limit
                    is_new_size = s not in ratios
                    if merge_style == 'strong':
                        merge_penalty = 0 if is_new_size else (2 if prefer_merge else 1)
                    elif merge_style == 'simple':
                        merge_penalty = 2 if is_new_size else 0
                    else:
                        merge_penalty = (0 if is_new_size else 1) if prefer_merge else (1 if is_new_size else 0)

                    # Vải chính/lót/mex/bông: khi thêm cỡ mới, ưu tiên mở rộng
                    # khoảng size (cỡ nhỏ + cỡ lớn) để tăng cơ hội lấp khoảng trống khi giác CAD.
                    spread_gain = 0
                    if prefer_size_spread and is_new_size and ratios:
                        old_idx = [size_order.get(k, 0) for k in ratios]
                        old_span = max(old_idx) - min(old_idx) if old_idx else 0
                        new_idx = old_idx + [size_order.get(s, 0)]
                        new_span = max(new_idx) - min(new_idx) if new_idx else 0
                        spread_gain = max(0, new_span - old_span)

                    option_score = (
                        small_left_penalty,
                        after_over,
                        merge_penalty,
                        -spread_gain,
                        zero_penalty,
                        -useful_added,
                        gap_after,
                        -before_left,
                        length_int[s],
                        str(s),
                    )
                    options.append((option_score, s))

                if not options:
                    break

                options.sort(key=lambda x: x[0])
                _, picked = options[0]
                _old_ratio = int(ratios.get(picked, 0))
                _increment = (1 if ratio_pieces <= 1 else 2) if even_ratio else 1
                _new_ratio = _old_ratio + _increment
                ratios[picked] = _new_ratio
                used += length_int[picked] * _increment
                ratio_pieces += _increment

            chosen = list(ratios.keys())
            if not chosen:
                return None

            produced = {s: ratios[s] * lays for s in chosen}
            over = {s: max(0, produced[s] - source_remaining[s]) for s in chosen}
            if any(v > over_limit_for(s) for s, v in over.items()):
                return None

            remaining_after = dict(source_remaining)
            for s, qty_cut in produced.items():
                remaining_after[s] = max(0, remaining_after[s] - qty_cut)

            raw_marker_len = sum(length_int[s] * ratios[s] for s in chosen) / scale
            if not marker_within_limits(ratios, raw_marker_len, plies=lays):
                return None
            display_marker_len = raw_marker_len
            small_left = [q for q in remaining_after.values() if 0 < q < 4]

            return {
                'sizes': produced,
                'ratio': format_ratio(ratios),
                'length': display_marker_len,
                'raw_length': raw_marker_len,
                'plies': lays,
                'ratio_map': ratios,
                'total_output': sum(produced.values()),
                'size_count': len(chosen),
                'left_total': sum(remaining_after.values()),
                'small_left_count': len(small_left),
                'small_left_sum': sum(small_left),
                'zeroed': sum(1 for s in chosen if remaining_after[s] == 0),
                'over_total': sum(over.values()),
                'size_span': (max([size_order.get(s, 0) for s in chosen]) - min([size_order.get(s, 0) for s in chosen])) if chosen else 0,
                'meter_rate': (raw_marker_len / max(1, sum(int(v) for v in ratios.values()))),
            }

        def choose_pattern(source_remaining):
            """
            V71 - bàn đầu ưu tiên ghép nhiều cỡ; bàn vét/bàn cuối không ép ghép.

            Thu tu uu tien:
            1) Ban hien tai phai co co dang con so luong LON NHAT (co chinh).
            2) Khong de lai phan thieu 1..3 SP neu co phuong an khac.
            3) Triet tieu duoc nhieu co nhat tren ban hien tai.
            4) Voi cung muc triet tieu, tang TY LE cua co chinh toi da trong
               chieu dai marker. Vi du M=243, DMTB=1.5, max=4.0 thi M/2
               (122 la, cat 244, duong 1) duoc uu tien hon M/1 x 243 la.
            5) Sau do moi uu tien duong it, san luong con lai it, nhieu size
               tren marker va tan dung chieu dai.
            """
            if not source_remaining:
                return None

            size_order = {s['key']: i for i, s in enumerate(self.sizes)}
            main_size = max(
                source_remaining,
                key=lambda s: (source_remaining[s], -size_order.get(s, 9999))
            )

            max_lays = max(source_remaining.values())
            best = None

            for lays in range(4, max_lays + 1):
                cand = build_candidate(source_remaining, lays, main_size)
                if cand is None:
                    continue

                main_ratio = int(cand.get('ratio_map', {}).get(main_size, 0))
                main_missing_penalty = 0 if main_ratio > 0 else 1
                # Chi uu tien ty le cao neu so la ly tuong cua co chinh van >= 4.
                # VD XS con 5SP: XS/2 can ly tuong 3 la (<4), khong nen ep thanh
                # 4 la de duong +3; XS/1 x 5 la se hop ly hon.
                if main_ratio > 0:
                    ideal_main_lays = (source_remaining[main_size] + main_ratio - 1) // main_ratio
                    effective_main_ratio = main_ratio if ideal_main_lays >= 4 else 0
                else:
                    effective_main_ratio = 0
                balance_cost = cand['left_total'] + 2 * cand['over_total']

                # V71:
                # - BÀN ĐẦU / BÀN CHÍNH (nhiều lá): ưu tiên ghép NHIỀU CỠ trước,
                #   sau đó mới so dương và độ tận dụng marker.
                # - BÀN VÉT / BÀN CUỐI (ít lá): KHÔNG ép ghép cỡ; ưu tiên ít cỡ,
                #   marker ngắn, dương thấp. Điều này cũng phù hợp yêu cầu bàn cuối
                #   ít cỡ + chiều dài sơ đồ ngắn.
                low_plies_limit = max(4, int(getattr(self, 'MIN_PREFERRED_PLIES', 10)))
                low_plies = cand['plies'] < low_plies_limit

                short_penalty = max(0.0, target_min_marker - float(cand['raw_length']))
                span_score = -int(cand.get('size_span', 0) or 0) if prefer_size_spread else 0
                low_plies_penalty = 1 if low_plies else 0

                # V73: mọi ứng viên dùng cùng cấu trúc điểm trong từng chế độ.
                # Không dùng hai tuple khác nghĩa cho bàn ít lá/nhiều lá vì điều đó
                # có thể khiến marker 4-9 lá thắng marker 100-200 lá chỉ do vị trí tuple.
                if score_style == 'exact':
                    # VẢI CHÍNH: dương thấp -> hoàn thành nhiều SL -> ít bàn -> hiệu suất marker.
                    score = (
                        main_missing_penalty, cand['over_total'], cand['left_total'],
                        cand['small_left_count'], low_plies_penalty, cand['meter_rate'],
                        span_score, -cand['size_count'], -effective_main_ratio,
                        -cand['zeroed'], -cand['raw_length'], -cand['total_output'], cand['plies'],
                    )
                elif score_style == 'lining':
                    # VẢI LÓT: marker đủ dài, nhiều cỡ và trải rộng size; vẫn kiểm soát dương.
                    score = (
                        main_missing_penalty, short_penalty, cand['over_total'],
                        cand['left_total'], cand['small_left_count'], low_plies_penalty,
                        -cand['size_count'], span_score, cand['meter_rate'],
                        -cand['total_output'], -cand['raw_length'], cand['plies'],
                    )
                elif score_style == 'high_ratio':
                    # DỰNG/MEX: tránh marker ngắn, tăng tỷ lệ/nhiều cỡ để có cơ hội kín khổ.
                    score = (
                        main_missing_penalty, short_penalty, cand['left_total'],
                        cand['small_left_count'], low_plies_penalty, -cand['size_count'],
                        span_score, cand['over_total'], cand['meter_rate'],
                        -cand['raw_length'], -cand['total_output'], cand['plies'],
                    )
                else:
                    # V73 - KẸP TẦNG/BÔNG đều ưu tiên ít bàn, nhưng KHÔNG được
                    # chọn một bàn chính dương quá lớn chỉ vì left_total nhỏ hơn.
                    #
                    # BÔNG: trước hết phân biệt phương án đã xong trong 1 bàn hay
                    # còn phải có bàn vét. Nếu đều còn cần bàn vét thì cân bằng
                    # (SL còn + 3 x SL dương) để giữ chỗ cho bàn cuối xử lý đẹp.
                    # Ví dụ BÔNG 80G trong ca thực tế: B1 x52 lá tạo +49 SP rồi
                    # vẫn phải B2. B1 x50 lá vẫn 2 bàn nhưng bàn vét có thể cân
                    # phần còn lại với dương rất thấp -> phải ưu tiên x50.
                    #
                    # KẸP TẦNG: vẫn ưu tiên ít bàn/tỷ lệ đơn giản hơn BÔNG vì vật
                    # tư ít quan trọng; tuy vậy cùng số bàn thì dương thấp hơn thắng.
                    simple_penalty = cand['size_count'] if merge_style == 'simple' else -cand['size_count']
                    needs_followup = 0 if int(cand['left_total']) <= 0 else 1
                    if profile.get('mode') == 'padding':
                        balance_cost = int(cand['left_total']) + 3 * int(cand['over_total'])
                        score = (
                            main_missing_penalty, needs_followup, balance_cost,
                            cand['over_total'], cand['small_left_count'], low_plies_penalty,
                            short_penalty, simple_penalty, span_score,
                            -cand['total_output'], cand['meter_rate'],
                            -cand['raw_length'], cand['plies'],
                        )
                    else:
                        balance_cost = int(cand['left_total']) + int(cand['over_total'])
                        score = (
                            main_missing_penalty, needs_followup, balance_cost,
                            low_plies_penalty, cand['over_total'], cand['small_left_count'],
                            short_penalty, simple_penalty, span_score,
                            -cand['total_output'], cand['meter_rate'],
                            -cand['raw_length'], cand['plies'],
                        )
                if best is None or score < best[0]:
                    best = (score, cand)

            return best[1] if best else None

        def calc_actual(source_tables):
            actual = {k: 0 for k in total_by_size}
            for table in source_tables:
                for k, v in table.get('sizes', {}).items():
                    actual[k] = actual.get(k, 0) + int(v)
            return actual

        def rebuild_table(table):
            """Tinh lai sizes/ratio/length sau khi sua ratio hoac so la."""
            ratios = dict(table.get('ratio_map', {}))
            lays = int(table.get('plies', 0))
            raw_len = sum(size_length[k] * r for k, r in ratios.items())
            table['raw_length'] = raw_len
            table['length'] = raw_len
            table['sizes'] = {k: int(r) * lays for k, r in ratios.items()}
            table['ratio'] = format_ratio(ratios)
            table['total_output'] = sum(table['sizes'].values())
            table['size_count'] = len(ratios)

        # V73: riêng BÔNG, khi đã có bàn chính thì thử đóng toàn bộ phần
        # còn lại bằng MỘT bàn cân. Tỷ lệ mỗi cỡ = ceil(SL còn / số lá).
        # Cách này ngăn trường hợp bàn chính cắt dương rất nhiều rồi bàn cuối
        # chỉ còn 1 cỡ cực ngắn. Với cùng 2 bàn, phương án dương thấp hơn thắng.
        def build_padding_finish_candidate(source_remaining):
            if profile.get('mode') != 'padding' or not source_remaining:
                return None
            upper = max(
                [int(q) + over_limit_for(s) for s, q in source_remaining.items()] or [4]
            )
            best = None
            for lays in range(4, max(4, upper) + 1):
                ratios = {}
                produced = {}
                valid = True
                for s, q in source_remaining.items():
                    q = int(q or 0)
                    if q <= 0:
                        continue
                    r = int(math.ceil(q / lays))
                    if r <= 0:
                        continue
                    cut = r * lays
                    if cut - q > over_limit_for(s):
                        valid = False
                        break
                    ratios[s] = r
                    produced[s] = cut
                if not valid or not ratios:
                    continue
                raw_len = sum(float(size_length[s]) * int(r) for s, r in ratios.items())
                if not marker_within_limits(ratios, raw_len, plies=lays):
                    continue
                over = {s: max(0, produced[s] - int(source_remaining[s])) for s in ratios}
                over_total = sum(over.values())
                ratio_pieces = sum(ratios.values())
                # Bàn cuối: dương thấp nhất trước; nếu bằng nhau thì marker ngắn
                # và tổng tỷ lệ nhỏ hơn để dễ giác/cắt hơn.
                score = (over_total, raw_len, ratio_pieces, -lays)
                if best is None or score < best[0]:
                    best = (score, {
                        'sizes': produced,
                        'ratio': format_ratio(ratios),
                        'length': raw_len,
                        'raw_length': raw_len,
                        'plies': lays,
                        'ratio_map': ratios,
                        'total_output': sum(produced.values()),
                        'size_count': len(ratios),
                        'left_total': 0,
                        'small_left_count': 0,
                        'small_left_sum': 0,
                        'zeroed': len(ratios),
                        'over_total': over_total,
                        'size_span': (max([size_order.get(s, 0) for s in ratios]) - min([size_order.get(s, 0) for s in ratios])) if ratios else 0,
                        'meter_rate': raw_len / max(1, ratio_pieces),
                    })
            return best[1] if best else None

        # -------------------- BUOC 1: LAP BAN CHINH --------------------
        table_num = 1
        while remaining:
            # Neu chi con 1..3 SP/co thi khong tao them ban moi.
            if all(q < 4 for q in remaining.values()):
                break

            # Sau ít nhất một bàn chính của BÔNG, nếu phần còn lại có thể gói
            # vào đúng một marker thì dùng bàn cân trực tiếp.
            if tables and profile.get('mode') == 'padding':
                finish_pattern = build_padding_finish_candidate(remaining)
                if finish_pattern is not None:
                    tables.append({'table': f'B{table_num}', **finish_pattern})
                    remaining = {}
                    table_num += 1
                    break

            pattern = choose_pattern(remaining)
            if pattern is None:
                too_long = [
                    f"{name_map[s]} ({size_length[s]:.2f}m)"
                    for s in remaining
                    if max_len > 0 and length_int[s] > cap_int
                ]
                if too_long:
                    raise ValueError(
                        "Khong the lap marker: " + ', '.join(too_long) +
                        f" vuot chieu dai toi da {max_len:.2f}m."
                    )
                break

            tables.append({'table': f'B{table_num}', **pattern})
            for s, qty_cut in pattern['sizes'].items():
                remaining[s] -= qty_cut
                if remaining[s] <= 0:
                    del remaining[s]
            table_num += 1

        # -------------------- BUOC 2: TRIET TIEU PHAN THIEU 1..3 --------------------
        # Khong tao ban moi. Thu ghep co thieu vao ban co san; neu khong duoc,
        # thu tang SO LA cua mot ban dang co co do.
        for _ in range(20):
            actual = calc_actual(tables)
            deficits = {
                k: int(req) - actual.get(k, 0)
                for k, req in total_by_size.items()
                if int(req) - actual.get(k, 0) > 0
            }
            if not deficits:
                break

            changed_any = False

            # Xu ly phan thieu nho truoc.
            for s, deficit in sorted(deficits.items(), key=lambda x: x[1]):
                best_change = None

                # A) Them co nay vao mot marker co san voi ty le 1.
                for ti, table in enumerate(tables):
                    lays = int(table.get('plies', 0))
                    if lays < deficit or lays > deficit + over_limit_for(s):
                        continue
                    ratios = dict(table.get('ratio_map', {}))
                    if s in ratios:
                        continue
                    raw_len = sum(size_length[k] * r for k, r in ratios.items()) + size_length[s]
                    trial_ratios = dict(ratios)
                    trial_ratios[s] = 1
                    if not marker_within_limits(trial_ratios, raw_len, plies=lays):
                        continue

                    trial = [dict(t) for t in tables]
                    trial[ti] = dict(table)
                    trial[ti]['ratio_map'] = ratios
                    trial[ti]['ratio_map'][s] = 1
                    rebuild_table(trial[ti])
                    trial_actual = calc_actual(trial)
                    diffs = {k: trial_actual.get(k, 0) - int(req) for k, req in total_by_size.items()}
                    if any(v > over_limit_for(k) for k, v in diffs.items()):
                        continue
                    neg_total = sum(-v for v in diffs.values() if v < 0)
                    pos_total = sum(v for v in diffs.values() if v > 0)
                    score = (neg_total, pos_total, trial[ti]['raw_length'])
                    if best_change is None or score < best_change[0]:
                        best_change = (score, trial)

                # B) Tang ty le cua co nay +1 tren marker da co.
                for ti, table in enumerate(tables):
                    ratios = dict(table.get('ratio_map', {}))
                    if s not in ratios:
                        continue
                    lays = int(table.get('plies', 0))
                    if lays < deficit or lays > deficit + over_limit_for(s):
                        continue
                    raw_len = sum(size_length[k] * r for k, r in ratios.items()) + size_length[s]
                    trial_ratios = dict(ratios)
                    trial_ratios[s] = int(trial_ratios.get(s, 0)) + 1
                    if not marker_within_limits(trial_ratios, raw_len, plies=lays):
                        continue

                    trial = [dict(t) for t in tables]
                    trial[ti] = dict(table)
                    trial[ti]['ratio_map'] = ratios
                    trial[ti]['ratio_map'][s] += 1
                    rebuild_table(trial[ti])
                    trial_actual = calc_actual(trial)
                    diffs = {k: trial_actual.get(k, 0) - int(req) for k, req in total_by_size.items()}
                    if any(v > over_limit_for(k) for k, v in diffs.items()):
                        continue
                    neg_total = sum(-v for v in diffs.values() if v < 0)
                    pos_total = sum(v for v in diffs.values() if v > 0)
                    score = (neg_total, pos_total, trial[ti]['raw_length'])
                    if best_change is None or score < best_change[0]:
                        best_change = (score, trial)

                # C) Tang so la cua ban co chua co nay. Chi nhan neu khong co co nao dương >3.
                for ti, table in enumerate(tables):
                    ratios = dict(table.get('ratio_map', {}))
                    if s not in ratios:
                        continue
                    old_lays = int(table.get('plies', 0))
                    for delta in range(1, max_over_any + 1):
                        trial = [dict(t) for t in tables]
                        trial[ti] = dict(table)
                        trial[ti]['ratio_map'] = ratios
                        trial[ti]['plies'] = old_lays + delta
                        rebuild_table(trial[ti])
                        trial_actual = calc_actual(trial)
                        diffs = {k: trial_actual.get(k, 0) - int(req) for k, req in total_by_size.items()}
                        if any(v > over_limit_for(k) for k, v in diffs.items()):
                            continue
                        neg_total = sum(-v for v in diffs.values() if v < 0)
                        pos_total = sum(v for v in diffs.values() if v > 0)
                        # Chi coi la cai thien neu tong thieu giam.
                        current_neg = sum(
                            max(0, int(req) - actual.get(k, 0))
                            for k, req in total_by_size.items()
                        )
                        if neg_total >= current_neg:
                            continue
                        score = (neg_total, pos_total, delta)
                        if best_change is None or score < best_change[0]:
                            best_change = (score, trial)

                if best_change is not None:
                    tables = best_change[1]
                    changed_any = True
                    break

            if not changed_any:
                break

        # -------------------- V76 - BUOC 3: BAN IT LA -> GIAM TY LE / RUT NGAN MARKER --------------------
        # Quy tac moi:
        # - Bàn có số lá < MIN_PREFERRED_PLIES (mặc định 10) được coi là bàn ít lá.
        # - Thử TĂNG số lá và GIẢM tổng tỷ lệ để marker ngắn lại.
        # - Marker sau rút gọn KHÔNG được thấp hơn CHIỀU DÀI TỐI THIỂU của loại vải.
        # - Tổng thực cắt toàn bộ kế hoạch vẫn phải >= nhu cầu và không vượt giới hạn dương
        #   riêng của từng chế độ giác.
        # - Chỉ nhận phương án nếu tổng tỷ lệ thực sự giảm và marker thực sự ngắn hơn.
        #
        # Ví dụ: một bàn 4 lá đang có tỷ lệ lớn và dài 3.0m; nếu có thể đổi thành
        # 8-12 lá với tỷ lệ nhỏ hơn, chương trình sẽ kéo marker về gần mức tối thiểu
        # (ví dụ 1.0m) thay vì giữ một marker dài nhưng chỉ trải vài lá.
        preferred_plies = max(4, int(getattr(self, 'MIN_PREFERRED_PLIES', 10)))

        def _compact_low_plies_marker(table):
            old_lays = int(table.get('plies', 0) or 0)
            old_ratios = {k: int(v) for k, v in (table.get('ratio_map', {}) or {}).items() if int(v) > 0}
            if old_lays <= 0 or old_lays >= preferred_plies or not old_ratios:
                return False

            rebuild_table(table)
            old_raw = float(table.get('raw_length', 0) or 0)
            old_ratio_pieces = sum(old_ratios.values())

            # Nếu marker hiện đã ở sát/ dưới sàn thì không rút nữa.
            # Phần V76 phía sau sẽ chịu trách nhiệm nâng marker quá ngắn lên lại sàn.
            if old_raw <= FINAL_MIN_MARKER_LENGTH + 1e-9:
                return False

            # Sản lượng do tất cả bàn KHÁC đã cắt. Từ đây tính khoảng sản lượng
            # mà bàn hiện tại được phép đảm nhận cho từng cỡ.
            actual_all = calc_actual(tables)
            old_sizes = {k: int(v or 0) for k, v in (table.get('sizes', {}) or {}).items()}
            base_actual = {
                k: int(actual_all.get(k, 0)) - int(old_sizes.get(k, 0))
                for k in total_by_size
            }

            # Số lá không cần thử vô hạn. Với tỷ lệ tối thiểu 1, số lá lớn hơn
            # lượng tối đa còn được phép cắt của mọi cỡ sẽ không tạo được candidate.
            max_lays_allowed = max([
                max(0, int(total_by_size.get(k, 0)) + over_limit_for(k) - int(base_actual.get(k, 0)))
                for k in total_by_size if k in size_length
            ] or [old_lays])
            max_lays_allowed = max(old_lays, max_lays_allowed)

            best = None

            # Chỉ tăng hoặc giữ số lá; mục đích của bước này là biến bàn ít lá
            # thành bàn nhiều lá hơn với tỷ lệ nhỏ hơn.
            for lays in range(max(4, old_lays), max_lays_allowed + 1):
                ratios = {}
                rmax_map = {}
                valid = True

                for s in total_by_size:
                    if s not in size_length:
                        continue
                    req = int(total_by_size.get(s, 0) or 0)
                    base = int(base_actual.get(s, 0) or 0)
                    lo_qty = max(0, req - base)
                    hi_qty = max(0, req + over_limit_for(s) - base)

                    rmin = int(math.ceil(lo_qty / lays)) if lo_qty > 0 else 0
                    rmax = int(hi_qty // lays) if hi_qty > 0 else 0
                    if rmin > rmax:
                        valid = False
                        break
                    if rmin > 0:
                        ratios[s] = rmin
                    rmax_map[s] = rmax

                if not valid or not ratios:
                    continue

                ratio_pieces = sum(int(v) for v in ratios.values())
                if ratio_pieces >= old_ratio_pieces:
                    continue
                if max_products > 0 and ratio_pieces > max_products:
                    continue

                raw_len = sum(float(size_length[s]) * int(r) for s, r in ratios.items())
                if max_len > 0 and raw_len > max_len + 1e-9:
                    continue

                # Sau khi giảm tỷ lệ, nếu marker ngắn hơn sàn thì tăng lại NHẸ NHẤT
                # có thể để chạm/gần sàn. Không quay lại marker dài như cũ.
                guard = 0
                while raw_len + 1e-9 < FINAL_MIN_MARKER_LENGTH and guard < 200:
                    guard += 1
                    options = []
                    for s in total_by_size:
                        if s not in size_length:
                            continue
                        cur = int(ratios.get(s, 0))
                        if cur >= int(rmax_map.get(s, 0)):
                            continue
                        next_ratio_pieces = ratio_pieces + 1
                        if next_ratio_pieces >= old_ratio_pieces:
                            continue
                        if max_products > 0 and next_ratio_pieces > max_products:
                            continue
                        nl = raw_len + float(size_length[s])
                        if max_len > 0 and nl > max_len + 1e-9:
                            continue

                        # Tính dương toàn kế hoạch nếu thêm 1 nhịp tỷ lệ của cỡ này.
                        trial_cut = (cur + 1) * lays
                        trial_total = int(base_actual.get(s, 0)) + trial_cut
                        over_after = max(0, trial_total - int(total_by_size.get(s, 0) or 0))
                        options.append((
                            0 if nl >= FINAL_MIN_MARKER_LENGTH - 1e-9 else 1,
                            abs(nl - FINAL_MIN_MARKER_LENGTH),
                            over_after,
                            size_order.get(s, 9999),
                            s,
                            nl,
                        ))

                    if not options:
                        break
                    options.sort()
                    _, _, _, _, picked, nl = options[0]
                    ratios[picked] = int(ratios.get(picked, 0)) + 1
                    ratio_pieces += 1
                    raw_len = nl

                # Không chấp nhận bàn dưới chiều dài tối thiểu.
                if raw_len + 1e-9 < FINAL_MIN_MARKER_LENGTH:
                    continue
                # Mục tiêu là RÚT NGẮN marker. Nếu không ngắn hơn thì giữ phương án cũ.
                if raw_len >= old_raw - 1e-9:
                    continue
                if ratio_pieces >= old_ratio_pieces:
                    continue
                if not marker_within_limits(ratios, raw_len, plies=lays):
                    continue

                produced = {s: int(r) * lays for s, r in ratios.items() if int(r) > 0}
                trial_actual = {
                    k: int(base_actual.get(k, 0)) + int(produced.get(k, 0))
                    for k in total_by_size
                }
                diffs = {
                    k: int(trial_actual.get(k, 0)) - int(total_by_size.get(k, 0) or 0)
                    for k in total_by_size
                }
                if any(v < 0 or v > over_limit_for(k) for k, v in diffs.items()):
                    continue

                over_total = sum(max(0, v) for v in diffs.values())
                size_count = sum(1 for v in ratios.values() if int(v) > 0)

                # Ưu tiên marker NGẮN NHẤT nhưng vẫn >= sàn; sau đó mới xét
                # tổng tỷ lệ, dương và số lá. Vì vậy bàn ít lá sẽ có xu hướng
                # tự kéo chiều dài về gần mức tối thiểu người dùng đã nhập.
                score = (
                    raw_len,
                    ratio_pieces,
                    over_total,
                    size_count,
                    0 if lays >= preferred_plies else 1,
                    -lays,
                )
                if best is None or score < best[0]:
                    best = (score, lays, dict(ratios))

            if best is None:
                return False

            _, lays, ratios = best
            table['plies'] = int(lays)
            table['ratio_map'] = {k: int(v) for k, v in ratios.items() if int(v) > 0}
            rebuild_table(table)
            return True

        # Xử lý bàn ít lá nhất trước. Sau mỗi lần thay đổi, hàm tự tính lại sản lượng
        # toàn bộ các bàn nên các bàn tiếp theo vẫn không làm âm hoặc dương quá giới hạn.
        low_ply_indexes = sorted(
            range(len(tables)),
            key=lambda i: (int(tables[i].get('plies', 0) or 0), -float(tables[i].get('raw_length', 0) or 0), i)
        )
        for _idx in low_ply_indexes:
            _compact_low_plies_marker(tables[_idx])

        # -------------------- V76: KHÔNG BÀN NÀO ĐƯỢC < CHIỀU DÀI TỐI THIỂU --------------------
        # Nếu một marker dưới 1m, cố ghép thêm cỡ/tăng tỷ lệ nhưng chỉ khi sản lượng
        # dương của cỡ đó vẫn <= MAX_OVER. Sau cùng đưa marker ngắn nhất xuống cuối.
        def _try_raise_short_marker(table):
            """Tìm lại tỷ lệ + số lá cho marker ngắn để đạt khoảng >=1m nếu có thể.

            Giữ tổng sản lượng toàn bộ kế hoạch trong khoảng yêu cầu .. yêu cầu+MAX_OVER.
            Cách này cho phép ví dụ XS/1+S/1 x7 lá (0.63m) đổi thành
            XS/2+S/2 x4 lá (1.26m) mà sản lượng chỉ dương +1/cỡ.
            """
            rebuild_table(table)
            current_raw = float(table.get('raw_length', 0) or 0)
            if current_raw + 1e-9 >= FINAL_MIN_MARKER_LENGTH:
                return

            actual_all = calc_actual(tables)
            old_sizes = {k:int(v or 0) for k,v in (table.get('sizes',{}) or {}).items()}
            base_actual = {k:int(actual_all.get(k,0))-int(old_sizes.get(k,0)) for k in total_by_size}
            max_hi = max([max(0, int(total_by_size.get(k,0))+over_limit_for(k)-base_actual.get(k,0))
                          for k in total_by_size] or [4])
            best = None

            for lays in range(4, max(4, max_hi) + 1):
                ratios = {}
                rmax_map = {}
                valid = True
                for s in total_by_size:
                    if s not in size_length:
                        continue
                    lo = max(0, int(total_by_size.get(s,0)) - int(base_actual.get(s,0)))
                    hi = max(0, int(total_by_size.get(s,0)) + over_limit_for(s) - int(base_actual.get(s,0)))
                    rmin = int(math.ceil(lo / lays)) if lo > 0 else 0
                    rmax = int(hi // lays)
                    if rmin > rmax:
                        valid = False
                        break
                    if rmin > 0:
                        ratios[s] = rmin
                    rmax_map[s] = rmax
                if not valid or not ratios:
                    continue

                raw_len = sum(float(size_length[s]) * int(r) for s,r in ratios.items())
                if not marker_within_limits(ratios, raw_len, plies=lays):
                    continue

                # Nếu còn dưới 1m, tăng tỷ lệ hợp lệ từng bước sao cho gần 1m nhất.
                guard = 0
                while raw_len + 1e-9 < FINAL_MIN_MARKER_LENGTH and guard < 50:
                    guard += 1
                    options = []
                    for s in total_by_size:
                        if s not in size_length:
                            continue
                        cur = int(ratios.get(s,0))
                        if cur >= int(rmax_map.get(s,0)):
                            continue
                        nl = raw_len + float(size_length[s])
                        trial_ratio_sum = sum(int(v) for v in ratios.values()) + 1
                        if (max_products <= 0 or trial_ratio_sum <= max_products) and (max_len <= 0 or nl <= max_len + 1e-9):
                            options.append((0 if nl >= FINAL_MIN_MARKER_LENGTH-1e-9 else 1,
                                            abs(nl-FINAL_MIN_MARKER_LENGTH),
                                            size_order.get(s,9999), s, nl))
                    if not options:
                        break
                    options.sort()
                    _,_,_,s,raw_len = options[0]
                    ratios[s] = int(ratios.get(s,0)) + 1

                produced = {s:int(r)*lays for s,r in ratios.items() if int(r)>0}
                trial_actual = {k:int(base_actual.get(k,0))+int(produced.get(k,0)) for k in total_by_size}
                diffs = {k:trial_actual.get(k,0)-int(total_by_size.get(k,0)) for k in total_by_size}
                if any(v < 0 or v > over_limit_for(k) for k, v in diffs.items()):
                    continue
                reach_penalty = 0 if raw_len >= FINAL_MIN_MARKER_LENGTH-1e-9 else 1
                score = (reach_penalty, abs(raw_len-FINAL_MIN_MARKER_LENGTH),
                         sum(max(0,v) for v in diffs.values()), raw_len, lays)
                if best is None or score < best[0]:
                    best = (score, lays, ratios)

            if best is not None:
                _, lays, ratios = best
                table['plies'] = int(lays)
                table['ratio_map'] = {k:int(v) for k,v in ratios.items() if int(v)>0}
                rebuild_table(table)

        # -------------------- V78: SÀN CHIỀU DÀI LÀ GIỚI HẠN CỨNG --------------------
        # Trước tiên vẫn thử sửa RIÊNG bàn ngắn. Nếu không đủ sàn, phần mềm không
        # bắt người dùng thêm sản lượng đơn hàng; thay vào đó nó tự giảm số lá của
        # một bàn trước để CHỪA LẠI nhiều cỡ cho bàn ngắn, rồi tính lại tỷ lệ bàn
        # ngắn sao cho chiều dài >= sàn và toàn bộ sản lượng vẫn nằm trong giới hạn.

        def _build_strict_finish_marker(base_actual):
            """Tạo một bàn kết thúc từ phần sản lượng còn lại sau các bàn khác.

            Kết quả bắt buộc:
            - đủ toàn bộ sản lượng còn thiếu;
            - dương từng cỡ không vượt giới hạn của chế độ giác;
            - chiều dài marker >= FINAL_MIN_MARKER_LENGTH;
            - không vượt chiều dài tối đa / SP tối đa mỗi sơ đồ.
            """
            # Nếu các bàn nền đã dương quá giới hạn thì không thể cứu bằng bàn cuối.
            for _k, _req in total_by_size.items():
                _base = int(base_actual.get(_k, 0) or 0)
                if _base > int(_req) + over_limit_for(_k):
                    return None

            # Số lá tối đa hữu ích: với tỷ lệ tối thiểu 1, lớn hơn sức chứa dương
            # còn lại của mọi cỡ thì không thể tạo thêm sản lượng hợp lệ.
            _max_hi = max([
                max(0, int(total_by_size.get(_k, 0)) + over_limit_for(_k) - int(base_actual.get(_k, 0) or 0))
                for _k in total_by_size if _k in size_length
            ] or [4])
            _best = None

            for _lays in range(4, max(4, _max_hi) + 1):
                _ratios = {}
                _rmax_map = {}
                _valid = True

                for _sz in total_by_size:
                    if _sz not in size_length:
                        continue
                    _base = int(base_actual.get(_sz, 0) or 0)
                    _req = int(total_by_size.get(_sz, 0) or 0)
                    _lo = max(0, _req - _base)
                    _hi = _req + over_limit_for(_sz) - _base
                    if _hi < 0:
                        _valid = False
                        break
                    _rmin = int(math.ceil(_lo / _lays)) if _lo > 0 else 0
                    _rmax = int(_hi // _lays) if _hi > 0 else 0
                    if _rmin > _rmax:
                        _valid = False
                        break
                    if _rmin > 0:
                        _ratios[_sz] = _rmin
                    _rmax_map[_sz] = _rmax

                if not _valid:
                    continue

                # Nếu không còn thiếu gì thì không cần tạo bàn kết thúc nữa.
                if not _ratios:
                    _diffs = {
                        _k: int(base_actual.get(_k, 0) or 0) - int(total_by_size.get(_k, 0) or 0)
                        for _k in total_by_size
                    }
                    if all(0 <= _v <= over_limit_for(_k) for _k, _v in _diffs.items()):
                        return {'remove_table': True}
                    continue

                _ratio_pieces = sum(int(v) for v in _ratios.values())
                if max_products > 0 and _ratio_pieces > max_products:
                    continue
                _raw = sum(float(size_length[_sz]) * int(_r) for _sz, _r in _ratios.items())
                if max_len > 0 and _raw > max_len + 1e-9:
                    continue

                # Marker còn ngắn: thêm từng nhịp tỷ lệ trong phần dương còn cho phép.
                # Chọn nhịp đưa chiều dài tới sàn gần nhất; không tăng vô ích.
                _guard = 0
                while _raw + 1e-9 < FINAL_MIN_MARKER_LENGTH and _guard < 200:
                    _guard += 1
                    _options = []
                    for _sz in total_by_size:
                        if _sz not in size_length:
                            continue
                        _cur = int(_ratios.get(_sz, 0) or 0)
                        if _cur >= int(_rmax_map.get(_sz, 0) or 0):
                            continue
                        _next_count = _ratio_pieces + 1
                        if max_products > 0 and _next_count > max_products:
                            continue
                        _next_len = _raw + float(size_length[_sz])
                        if max_len > 0 and _next_len > max_len + 1e-9:
                            continue

                        _options.append((
                            0 if _next_len + 1e-9 >= FINAL_MIN_MARKER_LENGTH else 1,
                            abs(_next_len - FINAL_MIN_MARKER_LENGTH),
                            size_order.get(_sz, 9999),
                            _sz, _next_len
                        ))
                    if not _options:
                        break
                    _options.sort()
                    _, _, _, _sz, _raw = _options[0]
                    _ratios[_sz] = int(_ratios.get(_sz, 0) or 0) + 1
                    _ratio_pieces += 1

                # V78: khác V77, dưới sàn là KHÔNG HỢP LỆ.
                if _raw + 1e-9 < FINAL_MIN_MARKER_LENGTH:
                    continue
                if not marker_within_limits(_ratios, _raw, plies=_lays):
                    continue

                _produced = {_sz: int(_r) * _lays for _sz, _r in _ratios.items() if int(_r) > 0}
                _final_actual = {
                    _k: int(base_actual.get(_k, 0) or 0) + int(_produced.get(_k, 0) or 0)
                    for _k in total_by_size
                }
                _diffs = {
                    _k: int(_final_actual.get(_k, 0) or 0) - int(total_by_size.get(_k, 0) or 0)
                    for _k in total_by_size
                }
                if any(_v < 0 or _v > over_limit_for(_k) for _k, _v in _diffs.items()):
                    continue

                _over = sum(max(0, _v) for _v in _diffs.values())
                _size_count = sum(1 for _v in _ratios.values() if int(_v) > 0)
                _score = (
                    _over,
                    abs(_raw - FINAL_MIN_MARKER_LENGTH),
                    _ratio_pieces,
                    0 if _lays >= preferred_plies else 1,
                    _size_count,
                    -_lays,
                )
                if _best is None or _score < _best[0]:
                    _best = (_score, {
                        'sizes': _produced,
                        'ratio': format_ratio(_ratios),
                        'length': _raw,
                        'raw_length': _raw,
                        'plies': int(_lays),
                        'ratio_map': {k: int(v) for k, v in _ratios.items() if int(v) > 0},
                        'total_output': sum(_produced.values()),
                        'size_count': _size_count,
                    })

            return _best[1] if _best is not None else None

        def _rebalance_one_short_marker(short_idx):
            """Chừa sản lượng từ bàn trước cho một marker đang dưới sàn.

            Ưu tiên giữ nguyên số bàn. Mỗi lần thử giảm 1, 2, 3... lá của MỘT
            bàn trước; phần sản lượng được chừa lại sẽ được gom cùng phần của bàn
            ngắn để tạo marker mới đủ chiều dài tối thiểu.
            """
            nonlocal tables
            if short_idx < 0 or short_idx >= len(tables):
                return False

            # 1) Thử xây lại bàn ngắn từ các bàn khác mà chưa đụng bàn trước.
            _base_tables = []
            for _i, _tb in enumerate(tables):
                if _i == short_idx:
                    continue
                _cp = dict(_tb)
                _cp['ratio_map'] = dict(_tb.get('ratio_map', {}) or {})
                rebuild_table(_cp)
                _base_tables.append(_cp)
            _base_actual = calc_actual(_base_tables)
            _direct = _build_strict_finish_marker(_base_actual)
            if isinstance(_direct, dict) and _direct.get('remove_table'):
                del tables[short_idx]
                return True
            if _direct is not None:
                _direct['table'] = tables[short_idx].get('table', f'B{short_idx+1}')
                tables[short_idx] = _direct
                return True

            # 2) Không đủ: giảm số lá của một bàn khác để chừa thêm nhiều cỡ.
            _best = None
            _donor_indexes = [
                _i for _i, _tb in enumerate(tables)
                if _i != short_idx and int(_tb.get('plies', 0) or 0) > 4
            ]
            # Ưu tiên bàn có nhiều cỡ / nhiều lá vì chỉ cần giảm ít lá thường đã
            # tạo đủ phần còn lại cho bàn cuối đạt sàn.
            _donor_indexes.sort(key=lambda _i: (
                -int(tables[_i].get('size_count', 0) or 0),
                -int(tables[_i].get('plies', 0) or 0),
                -float(tables[_i].get('raw_length', 0) or 0),
            ))

            for _di in _donor_indexes:
                _old_p = int(tables[_di].get('plies', 0) or 0)
                # Dừng tại phương án khả thi ĐẦU TIÊN của từng donor để không làm
                # chậm xuất Excel và cũng đúng mục tiêu: chừa ít nhất có thể.
                for _delta in range(1, max(1, _old_p - 4) + 1):
                    _trial_base = []
                    for _i, _tb in enumerate(tables):
                        if _i == short_idx:
                            continue
                        _cp = dict(_tb)
                        _cp['ratio_map'] = dict(_tb.get('ratio_map', {}) or {})
                        if _i == _di:
                            _cp['plies'] = _old_p - _delta
                        rebuild_table(_cp)
                        _trial_base.append(_cp)

                    _base_actual = calc_actual(_trial_base)
                    _finish = _build_strict_finish_marker(_base_actual)
                    if _finish is None or _finish.get('remove_table'):
                        continue

                    _trial_all = list(_trial_base) + [_finish]
                    _fa = calc_actual(_trial_all)
                    _diffs = {
                        _k: int(_fa.get(_k, 0) or 0) - int(total_by_size.get(_k, 0) or 0)
                        for _k in total_by_size
                    }
                    if any(_v < 0 or _v > over_limit_for(_k) for _k, _v in _diffs.items()):
                        continue

                    _over = sum(max(0, _v) for _v in _diffs.values())
                    _meters = sum(float(_t.get('raw_length', 0) or 0) * int(_t.get('plies', 0) or 0) for _t in _trial_all)
                    _score = (
                        _over,
                        _delta,
                        abs(float(_finish.get('raw_length', 0) or 0) - FINAL_MIN_MARKER_LENGTH),
                        _meters,
                        -int(_finish.get('plies', 0) or 0),
                    )
                    if _best is None or _score < _best[0]:
                        _best = (_score, _di, _old_p - _delta, _finish)
                    break

            if _best is None:
                return False

            _, _di, _new_p, _finish = _best
            tables[_di]['plies'] = int(_new_p)
            rebuild_table(tables[_di])
            _finish['table'] = tables[short_idx].get('table', f'B{short_idx+1}')
            tables[short_idx] = _finish
            return True

        # Bước A: sửa riêng marker ngắn nếu có thể.
        if FINAL_MIN_MARKER_LENGTH > 0 and tables:
            for _tb in tables:
                if float(_tb.get('raw_length', 0) or 0) + 1e-9 < FINAL_MIN_MARKER_LENGTH:
                    _try_raise_short_marker(_tb)

        # Bước B: marker nào vẫn ngắn thì tự chừa sản lượng từ bàn trước.
        if FINAL_MIN_MARKER_LENGTH > 0 and tables:
            for _round in range(10):
                _short = [
                    _i for _i, _tb in enumerate(tables)
                    if float(_tb.get('raw_length', 0) or 0) + 1e-9 < FINAL_MIN_MARKER_LENGTH
                ]
                if not _short:
                    break
                _changed = False
                # Bàn ngắn nhất sửa trước.
                for _si in sorted(_short, key=lambda _i: float(tables[_i].get('raw_length', 0) or 0)):
                    if _rebalance_one_short_marker(_si):
                        _changed = True
                        break
                if not _changed:
                    break

        # -------------------- V81: CÒN THIẾU 1..3 SP -> TỰ CÂN LẠI TOÀN BỘ BÀN --------------------
        # V80 chỉ tự cân lại khi có marker < chiều dài tối thiểu. Vì vậy có trường hợp
        # mọi marker đều >= sàn nhưng cuối kế hoạch vẫn còn thiếu 1..3 SP (ví dụ XXS thiếu 2),
        # calculate_cutting_plan() sẽ chặn xuất Excel.
        #
        # V81 xử lý phần thiếu nhỏ theo đúng nguyên tắc đã thống nhất:
        #   1) KHÔNG yêu cầu người dùng tăng số lượng đơn hàng;
        #   2) thử xây lại một bàn hiện có để gom phần thiếu vào bàn đó;
        #   3) nếu chưa được, giảm ít nhất số lá của một bàn khác để chừa thêm nhiều cỡ;
        #   4) chỉ khi cần mới thêm 1 bàn mới;
        #   5) mọi marker sau cân lại vẫn phải >= chiều dài tối thiểu, <= chiều dài tối đa,
        #      không âm sản lượng và không dương quá giới hạn của chế độ giác.

        def _plan_diffs(_tabs):
            _act = calc_actual(_tabs)
            return {
                _k: int(_act.get(_k, 0) or 0) - int(total_by_size.get(_k, 0) or 0)
                for _k in total_by_size
            }

        def _plan_is_valid(_tabs):
            if not _tabs:
                return False
            _diffs = _plan_diffs(_tabs)
            if any(_v < 0 or _v > over_limit_for(_k) for _k, _v in _diffs.items()):
                return False
            for _tb in _tabs:
                rebuild_table(_tb)
                _raw = float(_tb.get('raw_length', 0) or 0)
                if FINAL_MIN_MARKER_LENGTH > 0 and _raw + 1e-9 < FINAL_MIN_MARKER_LENGTH:
                    return False
                if not marker_within_limits(_tb.get('ratio_map', {}) or {}, _raw, plies=int(_tb.get('plies', 0) or 0), reference_tables=_tabs):
                    return False
                if int(_tb.get('plies', 0) or 0) < 4:
                    return False
            return True

        def _clone_table(_tb):
            _cp = dict(_tb)
            _cp['ratio_map'] = dict(_tb.get('ratio_map', {}) or {})
            _cp['sizes'] = dict(_tb.get('sizes', {}) or {})
            return _cp

        def _score_repair_plan(_tabs, _change_cost=0, _added_table=0):
            _diffs = _plan_diffs(_tabs)
            _over = sum(max(0, _v) for _v in _diffs.values())
            _meters = sum(
                float(_t.get('raw_length', 0) or 0) * int(_t.get('plies', 0) or 0)
                for _t in _tabs
            )
            _last_gap = min(
                [abs(float(_t.get('raw_length', 0) or 0) - FINAL_MIN_MARKER_LENGTH) for _t in _tabs]
                or [0.0]
            )
            # V118: trong các phương án sửa tương đương, bàn ÍT LÁ NHẤT phải
            # có tổng tỷ lệ ít + chiều dài ngắn + ít cỡ để làm bàn cuối.
            if _tabs:
                _tail = min(
                    _tabs,
                    key=lambda _t: (
                        int(_t.get('plies', 0) or 0),
                        sum(int(v or 0) for v in (_t.get('ratio_map', {}) or {}).values()),
                        float(_t.get('raw_length', 0) or 0),
                    )
                )
                _tail_ratio = sum(int(v or 0) for v in (_tail.get('ratio_map', {}) or {}).values())
                _tail_len = float(_tail.get('raw_length', 0) or 0)
                _tail_sizes = int(_tail.get('size_count', len(_tail.get('ratio_map', {}) or {})) or 0)
            else:
                _tail_ratio = 0
                _tail_len = 0.0
                _tail_sizes = 0
            # Không tăng bàn trước; sau đó thay đổi ít lá nhất; tiếp theo dương.
            # Sau đó mới tối ưu bàn vét và tổng mét.
            return (
                int(_added_table), int(_change_cost), int(_over),
                int(_tail_ratio), float(_tail_len), int(_tail_sizes),
                float(_meters), float(_last_gap)
            )

        def _repair_unresolved_deficits():
            nonlocal tables
            _diffs0 = _plan_diffs(tables)
            _def0 = {_k: -_v for _k, _v in _diffs0.items() if _v < 0}
            if not _def0:
                return True

            _best = None

            # A) Giữ nguyên số bàn: bỏ 1 bàn khỏi kế hoạch rồi xây lại bàn đó từ toàn bộ
            # phần còn thiếu. Đây thường là cách tốt nhất cho trường hợp chỉ thiếu 1..3 SP.
            for _ri in range(len(tables)):
                _base_tabs = [_clone_table(_tb) for _i, _tb in enumerate(tables) if _i != _ri]
                for _tb in _base_tabs:
                    rebuild_table(_tb)
                _base_actual = calc_actual(_base_tabs)
                _finish = _build_strict_finish_marker(_base_actual)
                if _finish is None:
                    continue
                if isinstance(_finish, dict) and _finish.get('remove_table'):
                    _trial = _base_tabs
                else:
                    _finish = dict(_finish)
                    _finish['ratio_map'] = dict(_finish.get('ratio_map', {}) or {})
                    _finish['table'] = tables[_ri].get('table', f'B{_ri+1}')
                    rebuild_table(_finish)
                    _trial = list(_base_tabs)
                    # Giữ vị trí gần bàn cũ để không làm thứ tự nhảy quá mạnh.
                    _trial.insert(min(_ri, len(_trial)), _finish)
                if not _plan_is_valid(_trial):
                    continue
                _score = _score_repair_plan(_trial, _change_cost=0, _added_table=max(0, len(_trial)-len(tables)))
                if _best is None or _score < _best[0]:
                    _best = (_score, _trial)

            # B) Vẫn giữ số bàn: giảm một ít lá của một bàn donor rồi xây lại một bàn khác.
            # Giảm 1 lá của marker nhiều cỡ sẽ chừa đồng thời nhiều size, giúp bàn cuối đủ
            # chiều dài tối thiểu thay vì chỉ vá XXS/1 rất ngắn.
            if _best is None and len(tables) >= 2:
                _targets = list(range(len(tables)))
                _targets.sort(key=lambda _i: (
                    int(tables[_i].get('size_count', 0) or 0),
                    float(tables[_i].get('raw_length', 0) or 0),
                    int(tables[_i].get('plies', 0) or 0),
                ))
                _donors = list(range(len(tables)))
                _donors.sort(key=lambda _i: (
                    -int(tables[_i].get('size_count', 0) or 0),
                    -int(tables[_i].get('plies', 0) or 0),
                ))

                for _ri in _targets:
                    for _di in _donors:
                        if _di == _ri:
                            continue
                        _old_p = int(tables[_di].get('plies', 0) or 0)
                        if _old_p <= 4:
                            continue
                        # Chừa ít nhất có thể; giới hạn thử để giữ tốc độ xuất Excel.
                        _max_delta = min(_old_p - 4, 12)
                        for _delta in range(1, _max_delta + 1):
                            _base_tabs = []
                            for _i, _tb in enumerate(tables):
                                if _i == _ri:
                                    continue
                                _cp = _clone_table(_tb)
                                if _i == _di:
                                    _cp['plies'] = _old_p - _delta
                                rebuild_table(_cp)
                                _base_tabs.append(_cp)
                            _finish = _build_strict_finish_marker(calc_actual(_base_tabs))
                            if _finish is None or (isinstance(_finish, dict) and _finish.get('remove_table')):
                                continue
                            _finish = dict(_finish)
                            _finish['ratio_map'] = dict(_finish.get('ratio_map', {}) or {})
                            _finish['table'] = tables[_ri].get('table', f'B{_ri+1}')
                            rebuild_table(_finish)
                            _trial = list(_base_tabs)
                            _trial.insert(min(_ri, len(_trial)), _finish)
                            if not _plan_is_valid(_trial):
                                continue
                            _score = _score_repair_plan(_trial, _change_cost=_delta, _added_table=0)
                            if _best is None or _score < _best[0]:
                                _best = (_score, _trial)
                            # Với donor/target này, delta nhỏ nhất hợp lệ là đủ.
                            break

            # C) Nếu thật sự không thể giữ nguyên số bàn, cho phép thêm đúng 1 bàn.
            # Trước khi thêm vẫn thử giảm ít lá của một donor để tạo đủ nhiều cỡ cho
            # marker mới >= sàn. Điều này phù hợp yêu cầu "thêm bàn nếu tối ưu".
            if _best is None:
                _donors = list(range(len(tables)))
                _donors.sort(key=lambda _i: (
                    -int(tables[_i].get('size_count', 0) or 0),
                    -int(tables[_i].get('plies', 0) or 0),
                ))

                # C1: thử thêm bàn trực tiếp trước.
                _base_tabs = [_clone_table(_tb) for _tb in tables]
                for _tb in _base_tabs:
                    rebuild_table(_tb)
                _finish = _build_strict_finish_marker(calc_actual(_base_tabs))
                if _finish is not None and not (isinstance(_finish, dict) and _finish.get('remove_table')):
                    _finish = dict(_finish)
                    _finish['ratio_map'] = dict(_finish.get('ratio_map', {}) or {})
                    rebuild_table(_finish)
                    _trial = _base_tabs + [_finish]
                    if _plan_is_valid(_trial):
                        _best = (_score_repair_plan(_trial, _change_cost=0, _added_table=1), _trial)

                # C2: chừa thêm từ một donor rồi mới thêm bàn.
                if _best is None:
                    for _di in _donors:
                        _old_p = int(tables[_di].get('plies', 0) or 0)
                        if _old_p <= 4:
                            continue
                        _max_delta = min(_old_p - 4, 12)
                        for _delta in range(1, _max_delta + 1):
                            _base_tabs = []
                            for _i, _tb in enumerate(tables):
                                _cp = _clone_table(_tb)
                                if _i == _di:
                                    _cp['plies'] = _old_p - _delta
                                rebuild_table(_cp)
                                _base_tabs.append(_cp)
                            _finish = _build_strict_finish_marker(calc_actual(_base_tabs))
                            if _finish is None or (isinstance(_finish, dict) and _finish.get('remove_table')):
                                continue
                            _finish = dict(_finish)
                            _finish['ratio_map'] = dict(_finish.get('ratio_map', {}) or {})
                            rebuild_table(_finish)
                            _trial = _base_tabs + [_finish]
                            if not _plan_is_valid(_trial):
                                continue
                            _score = _score_repair_plan(_trial, _change_cost=_delta, _added_table=1)
                            if _best is None or _score < _best[0]:
                                _best = (_score, _trial)
                            break

            if _best is None:
                return False

            tables = [_clone_table(_tb) for _tb in _best[1]]
            for _tb in tables:
                rebuild_table(_tb)
            return True

        # Chạy sửa phần thiếu sau khi đã xử lý chiều dài tối thiểu. Có thể lặp vài vòng
        # vì một lần xây lại bàn có thể làm thay đổi bàn nào nên đứng cuối.
        for _repair_round in range(4):
            _now_diffs = _plan_diffs(tables)
            if not any(_v < 0 for _v in _now_diffs.values()):
                break
            if not _repair_unresolved_deficits():
                break

        # V118: QUY TẮC BÀN CUỐI CHO TẤT CẢ LOẠI VẢI.
        # Bàn có SỐ LÁ ÍT NHẤT phải xuống cuối. Nếu có nhiều bàn cùng số lá ít
        # nhất thì chọn bàn có TỔNG TỶ LỆ ÍT hơn, CHIỀU DÀI NGẮN hơn, rồi ít cỡ hơn.
        # Các bàn chính còn lại: nhiều lá trước; cùng lá thì tỷ lệ/marker lớn hơn trước
        # để bàn nhỏ-gọn luôn nằm về cuối.
        if len(tables) > 1:
            for _tb in tables:
                rebuild_table(_tb)

            def _ratio_total(_tb):
                return sum(int(v or 0) for v in (_tb.get('ratio_map', {}) or {}).values())

            last_idx = min(
                range(len(tables)),
                key=lambda i: (
                    int(tables[i].get('plies', 0) or 0),
                    _ratio_total(tables[i]),
                    float(tables[i].get('raw_length', 0) or 0),
                    int(tables[i].get('size_count', 0) or 0),
                    int(tables[i].get('total_output', 0) or 0),
                    i,
                )
            )
            last_table = tables.pop(last_idx)

            tables.sort(key=lambda t: (
                -int(t.get('plies', 0) or 0),
                -_ratio_total(t),
                -float(t.get('raw_length', 0) or 0),
                -int(t.get('size_count', 0) or 0),
            ))
            tables.append(last_table)

        # Danh lai so ban sau moi dieu chinh.
        for i, table in enumerate(tables, start=1):
            table['table'] = f'B{i}'
            rebuild_table(table)

        # V78 - SAU KHI ĐÃ TỰ CÂN LẠI BÀN TRƯỚC, SÀN LÀ GIỚI HẠN CỨNG.
        # Nếu vẫn không thể đạt sàn thì đây là bài toán thực sự không khả thi với
        # sản lượng + mức dương + chiều dài tối đa hiện tại. Không tự tạo marker
        # dưới sàn và cũng không yêu cầu người dùng phải tăng số lượng đơn hàng.
        short_tables = [
            t for t in tables
            if float(t.get('raw_length', t.get('length', 0)) or 0) + 1e-9 < HARD_MIN_MARKER_LENGTH
        ]
        if short_tables:
            _detail = ', '.join(
                f"{t.get('table','B?')} {float(t.get('raw_length', t.get('length',0)) or 0):.2f}m"
                for t in short_tables
            )
            raise ValueError(
                f"Không thể tạo tất cả sơ đồ >= {HARD_MIN_MARKER_LENGTH:.2f} m sau khi đã tự cân lại các bàn trước "
                f"({_detail}). Hãy giảm Chiều dài tối thiểu, tăng Chiều dài tối đa hoặc chọn chế độ giác cho phép dương rộng hơn."
            )
        short_marker_warning = []

        # V117 - KIỂM TRA CUỐI.
        # VẢI CHÍNH/LÓT/KẸP vẫn theo quy tắc cũ: không âm.
        # DỰNG/MEX và BÔNG: cho phép âm/dương; dương cỡ lớn được hạ xuống bù cỡ bé.
        final_actual = calc_actual(tables)
        ordered_keys = [x['key'] for x in self.sizes if x['key'] in total_by_size]
        raw_diff = {
            k: int(final_actual.get(k, 0) or 0) - int(total_by_size.get(k, 0) or 0)
            for k in ordered_keys
        }
        unresolved = {}
        over_too_high = {}
        for k in ordered_keys:
            diff = raw_diff[k]
            if diff > over_limit_for(k):
                over_too_high[k] = diff
            elif diff < 0 and not allow_under:
                unresolved[k] = -diff

        size_transfers = []
        residual_under = {k: max(0, -raw_diff[k]) for k in ordered_keys}
        transfer_used = 0
        final_positive_surplus = sum(max(0, raw_diff[k]) for k in ordered_keys)
        if allow_under and downgrade_large_to_small:
            sources = []
            residual_under = {k: 0 for k in ordered_keys}
            for k in reversed(ordered_keys):
                d = raw_diff[k]
                if d > 0:
                    sources.append([k, int(d)])
                    continue
                if d >= 0:
                    continue
                need = int(-d)
                # Cỡ lớn gần nhất hạ xuống trước.
                for src in reversed(sources):
                    if need <= 0:
                        break
                    if src[1] <= 0:
                        continue
                    use = min(need, src[1])
                    if use > 0:
                        size_transfers.append((src[0], k, use))
                        src[1] -= use
                        need -= use
                        transfer_used += use
                residual_under[k] = need
            final_positive_surplus = sum(max(0, int(src[1])) for src in sources)
            for k, qty in residual_under.items():
                if qty > under_limit_for(k):
                    unresolved[k] = qty - under_limit_for(k)
        elif allow_under:
            final_positive_surplus = sum(max(0, raw_diff[k]) for k in ordered_keys)
            for k, qty in residual_under.items():
                if qty > under_limit_for(k):
                    unresolved[k] = qty - under_limit_for(k)

        if over_too_high:
            raise ValueError(
                f"Sản lượng dương vượt giới hạn chế độ {profile.get('label','')}: " + ', '.join(
                    f"{name_map.get(k, k)} +{v} (max +{over_limit_for(k)})"
                    for k, v in over_too_high.items()
                )
            )

        if allow_under and total_surplus_cap >= 0 and final_positive_surplus > total_surplus_cap:
            raise ValueError(
                f"Tổng sản lượng dương sau khi hạ cỡ còn {final_positive_surplus} SP, "
                f"vượt giới hạn {total_surplus_cap} SP ({total_surplus_pct * 100:g}% tổng sản lượng). "
                f"Hãy dùng TOÀN CỤC để phần mềm thử thêm bàn và giảm dương."
            )

        return tables, {
            'unresolved': unresolved,
            'fabric_mode': profile.get('mode', fabric_mode),
            'fabric_mode_label': profile.get('label', ''),
            'over_limits': over_limits,
            'under_limits': under_limits,
            'allow_under': allow_under,
            'downgrade_large_to_small': downgrade_large_to_small,
            'raw_diff': raw_diff,
            'residual_under': residual_under,
            'size_transfers': size_transfers,
            'transfer_used': transfer_used,
            'final_positive_surplus': final_positive_surplus,
            'total_surplus_cap': total_surplus_cap,
            'total_surplus_pct': total_surplus_pct,
            'target_min_marker': target_min_marker,
            'short_marker_warning': short_marker_warning,
        }

    # ==================== TÍNH TOÁN VÀ XEM TRƯỚC ====================
    def calculate_cutting_plan(self, force_recalculate=False):
        # V185-SMOOTH: tránh refresh bảng đang chờ chen vào giữa lúc tính/xuất.
        self._cancel_smooth_refresh()

        # V93: lấy cả dữ liệu PO/MÀU vừa gõ nhưng chưa FocusOut trước khi tính/xuất Excel.
        try:
            self._sync_po_grid_from_ui()
        except Exception:
            pass

        if not self.po_list:
            return None, "Chưa có dữ liệu PO!"

        if not self.fabric_list:
            return None, "Chưa có dữ liệu loại vải!"

        # Trước mỗi lần tính/xuất, đồng bộ kho Shade dùng chung theo phạm vi LOẠI VẢI + PO.
        # Nếu PO thay đổi, số mét Shade được chia lại theo sản lượng hiện tại.
        self._sync_all_shade_lots()

        # V62: commit % tăng từng cỡ trước khi tính. Kế hoạch Python và Excel dùng cùng số lượng.
        try:
            self._sync_size_percent_from_ui(silent=False)
        except ValueError as e:
            return None, str(e)

        # V107: tạo chữ ký từ đúng dữ liệu ảnh hưởng tới kế hoạch cắt.
        # Xuất Excel ngay sau Xem trước sẽ dùng lại kết quả, không tối ưu lần nữa.
        cache_key = None
        try:
            cache_payload = {
                'sizes': self.sizes,
                'po_list': self.po_list,
                'fabric_list': self.fabric_list,
                'global_lot_rows': self.global_lot_rows,
                'increase_enabled': bool(self.increase_enabled_var.get()),
                'increase_mode': str(self.increase_mode_var.get()),
                'max_over': int(self.MAX_OVER),
            }
            cache_key = json.dumps(cache_payload, ensure_ascii=False, sort_keys=True, default=str)
            if (not force_recalculate and
                    cache_key == getattr(self, '_cut_plan_cache_key', None) and
                    getattr(self, '_cut_plan_cache_results', None) is not None):
                self._export_progress(55, 'Dùng lại kết quả tối ưu đã tính')
                return self._cut_plan_cache_results, None
        except Exception:
            cache_key = None

        size_keys = [s['key'] for s in self.sizes]
        production_percent = 0.0  # giữ field cũ để tương thích dự án trước
        size_factor = {s['key']: s.get('factor', 1.0) for s in self.sizes}

        results = []
        _fabric_total_count = max(1, len(self.fabric_list))
        for _fabric_progress_idx, fabric in enumerate(self.fabric_list):
            _p0 = 8 + int(47 * _fabric_progress_idx / _fabric_total_count)
            self._export_progress(_p0, f"Đang tối ưu {fabric.get('name', 'loại vải')}")
            # V137: % thật cho nút TÍNH TOÀN BỘ.
            _cp0 = 5 + int(85 * _fabric_progress_idx / _fabric_total_count)
            self._calc_all_progress(_cp0, f"Đang tính {fabric.get('name', 'loại vải')}")
            raw_total_by_size = self._fabric_total_by_size(fabric)
            total_by_size = self._fabric_planned_total_by_size(fabric)
            if sum(total_by_size.values()) <= 0:
                return None, (f"Loại vải '{fabric['name']}' không có sản lượng từ PO đã chọn. "
                              f"PO áp dụng: {self._fabric_po_display(fabric)}")

            norm = fabric['norm']
            min_len = max(0.0, float(fabric.get('min_length', 1.0) or 0))
            max_len = float(fabric.get('max_length', 0) or 0)
            max_products = int(fabric.get('max_products', 0) or 0)
            balance_pct = float(fabric.get('balance_pct', 1.0) if fabric.get('balance_pct', 1.0) is not None else 1.0)

            resolved_mode = self._resolved_fabric_mode(fabric)
            optimizer_mode = self._optimizer_mode_key_from_label(fabric.get('optimizer_mode', 'smart'))
            try:
                cutting_tables, adjust_info = self._run_optimizer_strategy(
                    optimizer_mode, dict(total_by_size), size_factor, norm,
                    max_len, max_products, resolved_mode, min_len, balance_pct,
                    fabric=fabric, fixed_table_count=int(fabric.get('table_count', 0) or 0),
                    even_ratio=bool(fabric.get('even_ratio', False))
                )
            except ValueError as e:
                return None, f"{fabric.get('name','Loại vải')}: {e}"
            except Exception as e:
                return None, f"Lỗi tính loại vải '{fabric.get('name','')}': {e}"

            unresolved = adjust_info.get('unresolved', {}) if isinstance(adjust_info, dict) else {}
            if unresolved:
                names_missing = {s['key']: s['name'] for s in self.sizes}
                detail = ', '.join(f"{names_missing.get(k, k)} thiếu {v}" for k, v in unresolved.items())
                return None, ("Phần mềm đã tự cân lại các bàn nhưng vẫn chưa thể đủ sản lượng: " + detail +
                              ". Không cần tăng số lượng đơn hàng. Hãy thử giảm Chiều dài tối thiểu, tăng Chiều dài tối đa "
                              "hoặc chọn chế độ giác cho phép dương rộng hơn.")

            # V130: BÀN CHÍNH - tăng chiều dài để giảm số lá trải.
            # Phép đổi này KHÔNG làm đổi sản lượng: nếu nhân toàn bộ tỷ lệ của
            # một bàn lên k lần và chia số lá cho k (k phải là ước của số lá),
            # thì sản lượng từng cỡ và tổng mét vải của bàn vẫn giữ nguyên.
            #
            # Mục tiêu:
            #   - bàn nhiều lá: ưu tiên kéo marker dài lên trong giới hạn MAX
            #     để giảm số lá, giảm thời gian trải;
            #   - bàn vét rất ít lá vẫn giữ tỷ lệ/chiều dài gọn, không kéo dài.
            # Áp dụng chung cho cả TOÀN CỤC và TUẦN TỰ, mọi loại vải.
            def _stretch_main_tables(_tables):
                if not _tables or max_len <= 0:
                    return _tables

                _name_map = {x['key']: x['name'] for x in self.sizes}
                _size_order = {x['key']: i for i, x in enumerate(self.sizes)}
                # Tối ưu sản xuất cũng kéo dài bàn chính trong giới hạn MAX;
                # bàn vét ít lá được giữ ngắn ở bước bảo vệ phía dưới.
                if optimizer_mode == 'high_plies':
                    return _tables
                if optimizer_mode == 'long_marker':
                    _preferred = 4
                else:
                    _preferred = max(4, int(getattr(self, 'MIN_PREFERRED_PLIES', 10) or 10))
                _max_plies = max([int(t.get('plies', 0) or 0) for t in _tables] or [0])
                _min_plies = min([int(t.get('plies', 0) or 0) for t in _tables if int(t.get('plies', 0) or 0) > 0] or [0])

                # Chỉ coi là bàn vét cần bảo vệ khi thực sự ít lá hơn nhiều so với bàn chính.
                # VD 115 lá + 4 lá -> 4 lá phải giữ ngắn.
                # VD 144 lá + 110 lá -> cả hai đều là bàn chính và đều có thể kéo dài.
                _protect_tail = (_max_plies > 0 and _min_plies > 0 and
                                 (_min_plies < _preferred or _min_plies <= 0.50 * _max_plies))

                for _tb in _tables:
                    _n = int(_tb.get('plies', 0) or 0)
                    _rm = {k: int(v or 0) for k, v in (_tb.get('ratio_map', {}) or {}).items()
                           if int(v or 0) > 0}
                    if _n <= 0 or not _rm:
                        continue

                    # Bàn vét ít lá giữ marker gọn/ngắn theo logic trước.
                    if _protect_tail and _n == _min_plies:
                        continue

                    _raw = float(_tb.get('raw_length', _tb.get('length', 0)) or 0)
                    if _raw <= 0:
                        # V127: chiều dài = DMTB × tổng tỷ lệ.
                        _raw = float(norm) * sum(_rm.values())
                    if _raw <= 0:
                        continue

                    _ratio_total = sum(_rm.values())
                    if _ratio_total <= 0:
                        continue

                    # Giữ bàn sau khi co vẫn ít nhất khoảng MIN_PREFERRED_PLIES.
                    # Nhờ vậy không tạo bàn 4-5 lá dài gần MAX chỉ để giảm lá.
                    _max_factor_by_plies = max(1, _n // _preferred)
                    _max_factor_by_len = max(1, int((max_len + 1e-9) // _raw))
                    _max_factor = min(_max_factor_by_plies, _max_factor_by_len)
                    if max_products > 0:
                        _max_factor = min(_max_factor, max(1, int(max_products // _ratio_total)))
                    if _max_factor < 2:
                        continue

                    # Chọn hệ số LỚN NHẤT có thể chia hết số lá.
                    # VD 144 lá, marker 1.03m, MAX 4m -> k=3 -> 48 lá, 3.09m.
                    # VD 110 lá, marker 1.03m -> k=2 -> 55 lá, 2.06m.
                    _k = 1
                    for _f in range(_max_factor, 1, -1):
                        if _n % _f == 0:
                            _k = _f
                            break
                    if _k <= 1:
                        continue

                    _new_n = _n // _k
                    _new_rm = {k: int(v) * _k for k, v in _rm.items()}
                    if bool(fabric.get('even_ratio', False)) and (
                        any(v != 1 and v % 2 for v in _new_rm.values())
                        or (sum(_new_rm.values()) != 1 and sum(_new_rm.values()) % 2)
                    ):
                        continue
                    _new_raw = _raw * _k
                    _new_ratio_total = sum(_new_rm.values())
                    if _new_n < _preferred:
                        continue
                    if _new_raw > max_len + 1e-9:
                        continue
                    if max_products > 0 and _new_ratio_total > max_products:
                        continue

                    # Kiểm tra bất biến sản lượng từng cỡ trước khi nhận.
                    _ok = True
                    for _k_size, _old_r in _rm.items():
                        if int(_old_r) * _n != int(_new_rm[_k_size]) * _new_n:
                            _ok = False
                            break
                    if not _ok:
                        continue

                    _tb['plies'] = int(_new_n)
                    _tb['ratio_map'] = dict(_new_rm)
                    _tb['raw_length'] = float(_new_raw)
                    _tb['length'] = float(_new_raw)
                    _tb['ratio'] = ' + '.join(
                        f"{_name_map.get(k, k)}/{int(_new_rm[k])}"
                        for k in sorted(_new_rm, key=lambda x: _size_order.get(x, 10**6))
                    )
                    _tb['size_count'] = len(_new_rm)
                    _tb['meter_rate'] = float(_new_raw) / max(1, _new_ratio_total)
                    # sizes/total_output giữ nguyên vì sản lượng không đổi.

                return _tables

            cutting_tables = _stretch_main_tables([dict(tb) for tb in cutting_tables])

            # Hạn chót: không đưa ra bảng nào vi phạm quy tắc tích chọn, kể cả khi
            # một nhánh dự phòng hoặc thao tác sửa tay tạo ra tỷ lệ không hợp lệ.
            if bool(fabric.get('even_ratio', False)):
                for _i, _tb in enumerate(cutting_tables, start=1):
                    _ratios = [int(v or 0) for v in (
                        _tb.get('ratio_map', {}) or {}
                    ).values() if int(v or 0) > 0]
                    _total_ratio = sum(_ratios)
                    if (any(v != 1 and v % 2 for v in _ratios)
                            or (_total_ratio != 1 and _total_ratio % 2)):
                        return None, (
                            f"{fabric.get('name','Loại vải')}: B{_i} vi phạm quy tắc tỷ lệ đã tích. "
                            'Hãy tính lại bằng phiên bản mới của phần mềm.'
                        )

            # V165: sắp bàn theo chiều dài sơ đồ giảm dần để bàn dài nhất luôn là B1.
            base_cutting_tables = [dict(tb) for tb in cutting_tables]
            base_cutting_tables.sort(
                key=lambda tb: (
                    -float(tb.get('raw_length', tb.get('length', 0)) or 0),
                    -int(tb.get('plies', 0) or 0),
                    -int(tb.get('size_count', 0) or 0),
                    -int(tb.get('total_output', 0) or 0),
                )
            )

            for _bi, _tb in enumerate(base_cutting_tables, start=1):
                _tb['table'] = f'B{_bi}'

            # Phần xem trước vẫn dùng bộ phân Shade Python để người dùng thấy kế hoạch
            # dự kiến ngay trong giao diện trước khi xuất.
            preview_tables, lot_summary = self.allocate_lots_to_tables(fabric, base_cutting_tables)

            results.append({
                'fabric': fabric,
                'raw_total_by_size': dict(raw_total_by_size),
                'total_by_size': dict(total_by_size),
                'production_percent': production_percent,
                'cutting_tables': base_cutting_tables,
                'preview_tables': preview_tables,
                'lot_summary': lot_summary,
                'adjust_info': adjust_info,
                'fabric_mode': resolved_mode,
                'fabric_mode_label': self.FABRIC_MODE_LABELS.get(resolved_mode, 'VẢI CHÍNH')
            })
            _p1 = 8 + int(47 * (_fabric_progress_idx + 1) / _fabric_total_count)
            self._export_progress(_p1, f"Đã tối ưu {fabric.get('name', 'loại vải')}")
            _cp1 = 5 + int(85 * (_fabric_progress_idx + 1) / _fabric_total_count)
            self._calc_all_progress(_cp1, f"Đã tính {fabric.get('name', 'loại vải')}")

        if cache_key is not None:
            self._cut_plan_cache_key = cache_key
            self._cut_plan_cache_results = results
        return results, None

