        """Lưu dự án ra .cutplan. Trả về đường dẫn nếu thành công, None nếu lỗi/hủy."""
        self._last_project_error = ''
        if not filename:
            initial = ''
            style = ''
            try:
                style = self.entry_style.get().strip()
            except Exception:
                pass
            if self.current_project_path:
                initial = os.path.basename(self.current_project_path)
            else:
                initial = f"BC_{style or 'DU_AN'}.cutplan"
            filename = filedialog.asksaveasfilename(
                title='Lưu dự án Cutting Plan',
                defaultextension='.cutplan',
                filetypes=[('Cutting Plan Project', '*.cutplan'), ('JSON', '*.json'), ('All files', '*.*')],
                initialfile=initial
            )
            if not filename:
                return None
        if not os.path.splitext(filename)[1]:
            filename += '.cutplan'
        try:
            payload = self._build_project_payload()
            filename = os.path.abspath(filename)

            # V184: file .cutplan cũ có thể đang Hidden/System/Read-only.
            # Tạm gỡ thuộc tính trước khi thay thế.
            if os.path.isfile(filename):
                self._prepare_cutplan_for_write(filename)

            # Ghi ra file tạm CÙNG THƯ MỤC rồi os.replace.
            # Cách này vừa tránh PermissionError do ghi trực tiếp file Hidden,
            # vừa tránh làm hỏng dự án nếu quá trình json.dump bị gián đoạn.
            _save_dir = os.path.dirname(filename) or os.getcwd()
            os.makedirs(_save_dir, exist_ok=True)
            _tmp_project = os.path.join(
                _save_dir,
                '~cutplan_save_' + str(os.getpid()) + '_' + str(int(time.time() * 1000)) + '.tmp'
            )

            try:
                with open(_tmp_project, 'w', encoding='utf-8') as f:
                    json.dump(payload, f, ensure_ascii=False, indent=2)
                    try:
                        f.flush()
                        os.fsync(f.fileno())
                    except Exception:
                        pass

                # Nếu file đích tồn tại, gỡ thuộc tính thêm một lần ngay trước replace.
                if os.path.isfile(filename):
                    self._prepare_cutplan_for_write(filename)

                os.replace(_tmp_project, filename)
            finally:
                try:
                    if os.path.isfile(_tmp_project):
                        os.remove(_tmp_project)
                except Exception:
                    pass

            # Sau khi lưu xong chỉ đặt Hidden, không để Read-only/System.
            self._set_cutplan_hidden(filename, True)
            self.current_project_path = os.path.abspath(filename)
            try:
                self._last_project_dir = os.path.dirname(self.current_project_path)
            except Exception:
                pass
            if hasattr(self, 'status_var'):
                self.status_var.set(f"Đã lưu dự án: {self.current_project_path}")
            if hasattr(self, 'export_status') and not silent:
                self.export_status.config(text=f"✓ Đã lưu dự án: {os.path.basename(filename)}", fg='#8e44ad')
            if not silent:
                messagebox.showinfo('Lưu dự án', f'Đã lưu toàn bộ dữ liệu dự án (bao gồm % DƯƠNG từng cỡ):\n\n{filename}')
            return filename
        except Exception as e:
            self._last_project_error = str(e)
            if not silent:
                _msg = f'Không thể lưu file dự án:\n\n{e}'
                if isinstance(e, PermissionError):
                    _msg += (
                        '\n\nPhần mềm đã tự bỏ thuộc tính Read-only/Hidden/System nhưng Windows vẫn từ chối ghi. '
                        'Hãy kiểm tra file có đang được chương trình khác giữ/khóa hoặc thư mục có quyền chỉ đọc hay không.'
                    )
                messagebox.showerror('Lỗi lưu dự án', _msg)
            return None

    def save_project_manual(self):
        """V159 - SAVE.

        Nút LƯU trên thanh menu:
        - Có file hiện tại -> lưu đè vào đúng file đó, không hỏi lại đường dẫn.
        - Chưa có file hiện tại -> hỏi đường dẫn/tên file lần đầu.
        """
        if self.current_project_path:
            return self.save_project(self.current_project_path, silent=False)
        return self.save_project(None, silent=False)

    def save_project_as(self):
        """V159 - SAVE AS / LƯU DỰ ÁN MỚI.

        Luôn mở hộp thoại để người dùng chọn:
        - thư mục
        - tên file mới

        Sau khi lưu, file mới trở thành dự án hiện tại.
        Những lần bấm LƯU trên thanh menu sau đó sẽ lưu vào file mới này.
        """
        initial_file = ''
        initial_dir = ''

        try:
            style = self.entry_style.get().strip()
        except Exception:
            style = ''

        if self.current_project_path:
            try:
                initial_dir = os.path.dirname(os.path.abspath(self.current_project_path))
                initial_file = os.path.basename(self.current_project_path)
            except Exception:
                initial_dir = ''
                initial_file = ''

        if not initial_file:
            initial_file = f"BC_{style or 'DU_AN'}.cutplan"

        kwargs = {
            'title': 'Lưu dự án mới - Save As',
            'defaultextension': '.cutplan',
            'filetypes': [
                ('Cutting Plan Project', '*.cutplan'),
                ('JSON', '*.json'),
                ('All files', '*.*')
            ],
            'initialfile': initial_file,
        }
        if initial_dir and os.path.isdir(initial_dir):
            kwargs['initialdir'] = initial_dir

        filename = filedialog.asksaveasfilename(**kwargs)
        if not filename:
            return None

        if not os.path.splitext(filename)[1]:
            filename += '.cutplan'

        # Gọi save_project với đường dẫn cụ thể để không hiện hộp Save lần hai.
        saved = self.save_project(filename, silent=False)
        if saved:
            try:
                self.status_var.set(f"Đã LƯU DỰ ÁN MỚI: {os.path.abspath(saved)}")
            except Exception:
                pass
            try:
                self.export_status.config(
                    text=f"✓ Save As: {os.path.basename(saved)}",
                    fg=self.UI_PURPLE
                )
            except Exception:
                pass
        return saved

    def _restore_project_logo(self, logo_info):
        """Khôi phục logo nhúng trong dự án; nếu không có thì thử đường dẫn cũ."""
        if not isinstance(logo_info, dict):
            return
        path = str(logo_info.get('path', '') or '').strip()
        restored = None
        try:
            if logo_info.get('embedded') and logo_info.get('data_base64'):
                name = str(logo_info.get('name', '') or 'project_logo.png')
                ext = os.path.splitext(name)[1].lower()
                if ext not in ('.png', '.jpg', '.jpeg', '.bmp', '.webp'):
                    ext = '.png'
                restored = os.path.join(self._logo_config_dir(), 'project_logo' + ext)
                raw = base64.b64decode(str(logo_info.get('data_base64')).encode('ascii'))
                with open(restored, 'wb') as f:
                    f.write(raw)
            elif path and os.path.isfile(path):
                restored = path
        except Exception:
            restored = path if path and os.path.isfile(path) else None
        if restored and os.path.isfile(restored):
            self.logo_path = restored
            if hasattr(self, 'logo_name_var'):
                self.logo_name_var.set(str(logo_info.get('name', '') or os.path.basename(restored)))
            try:
                self._update_logo_preview()
            except Exception:
                pass

    def _apply_project_payload(self, data):
        if not isinstance(data, dict) or data.get('format') != self.PROJECT_MAGIC:
            raise ValueError('File không phải dự án Cutting Plan hợp lệ.')

        # ----- Dữ liệu cỡ -----
        sizes = data.get('sizes') or []
        clean_sizes = []
        seen_keys = set()
        for i, item in enumerate(sizes, start=1):
            if not isinstance(item, dict):
                continue
            key = str(item.get('key', '') or '').strip() or f'size{i}'
            if key in seen_keys:
                continue
            seen_keys.add(key)
            name = str(item.get('name', '') or '').strip() or f'SIZE {i}'
            try:
                factor = float(item.get('factor', 1.0) or 1.0)
            except Exception:
                factor = 1.0
            try:
                increase_pct = max(0.0, float(item.get('increase_pct', 0.0) or 0.0))
            except Exception:
                increase_pct = 0.0
            clean_sizes.append({'key': key, 'name': name, 'factor': factor, 'increase_pct': increase_pct})
        if not clean_sizes:
            clean_sizes = [
                {'key': 'size1', 'name': 'XS', 'factor': 0.90, 'increase_pct': 0.0},
                {'key': 'size2', 'name': 'S',  'factor': 0.95, 'increase_pct': 0.0},
                {'key': 'size3', 'name': 'M',  'factor': 1.00, 'increase_pct': 0.0},
                {'key': 'size4', 'name': 'L',  'factor': 1.05, 'increase_pct': 0.0},
                {'key': 'size5', 'name': 'XL', 'factor': 1.10, 'increase_pct': 0.0},
            ]
        self.sizes = clean_sizes

        # V122: nếu dự án có block % DƯƠNG riêng thì ưu tiên dùng block này.
        # Dự án cũ vẫn dùng increase_pct nằm trong từng size như trước.
        surplus_state = data.get('surplus_percent_state') if isinstance(data.get('surplus_percent_state'), dict) else {}
        saved_by_size = surplus_state.get('by_size') if isinstance(surplus_state.get('by_size'), dict) else {}
        if saved_by_size:
            for sz in self.sizes:
                key = str(sz.get('key', '') or '')
                if key in saved_by_size:
                    try:
                        sz['increase_pct'] = max(0.0, float(saved_by_size.get(key, 0.0) or 0.0))
                    except Exception:
                        pass

        try:
            self.next_size_number = max(int(data.get('next_size_number', 0) or 0), 1)
        except Exception:
            self.next_size_number = 1
        nums = []
        for s in self.sizes:
            m = re.search(r'(\d+)$', str(s.get('key', '')))
            if m:
                nums.append(int(m.group(1)))
        if nums:
            self.next_size_number = max(self.next_size_number, max(nums) + 1)

        # ----- PO -----
        self.po_list = []
        for item in data.get('po_list') or []:
            if not isinstance(item, dict):
                continue
            po = {'po': str(item.get('po', '') or '').strip(),
                  'color': str(item.get('color', '') or '').strip(),
                  'apply_increase': bool(item.get('apply_increase', True))}
            for sz in self.sizes:
                try:
                    po[sz['key']] = max(0, int(float(item.get(sz['key'], 0) or 0)))
                except Exception:
                    po[sz['key']] = 0
            po['total'] = sum(po[sz['key']] for sz in self.sizes)
            self.po_list.append(po)

        saved_po_apply = surplus_state.get('po_apply') if isinstance(surplus_state.get('po_apply'), list) else None
        if saved_po_apply is not None:
            for i, po in enumerate(self.po_list):
                if i < len(saved_po_apply):
                    po['apply_increase'] = bool(saved_po_apply[i])

        # ----- Kho Shade/CÂY -----
        raw_rows = data.get('global_lot_rows') or []
        self.global_lot_rows = [x for x in raw_rows if isinstance(x, dict)]
        for row in self.global_lot_rows:
            row.setdefault('lot', '')
            row.setdefault('lot_mark', '')
            self._ensure_lot_roll_details(row)
            self._recalc_lot_from_roll_details(row)

        # ----- Loại vải -----
        self.fabric_list = []
        for item in data.get('fabric_list') or []:
            if not isinstance(item, dict):
                continue
            f = dict(item)
            f['name'] = str(f.get('name', '') or '').strip()
            try:
                f['norm'] = float(f.get('norm', 0) or 0)
            except Exception:
                f['norm'] = 0.0
            try:
                f['min_length'] = max(0.0, float(f.get('min_length', 1.0) if f.get('min_length', 1.0) is not None else 1.0))
            except Exception:
                f['min_length'] = 1.0
            try:
                f['max_length'] = float(f.get('max_length', 0) or 0)
            except Exception:
                f['max_length'] = 0.0
            if f['max_length'] > 0 and f['min_length'] > f['max_length']:
                # Dự án cũ/giá trị lỗi: không làm hỏng file; hạ min về max để vẫn mở được.
                f['min_length'] = f['max_length']
            try:
                f['max_products'] = max(0, int(float(f.get('max_products', 0) or 0)))
            except Exception:
                f['max_products'] = 0
            f.setdefault('cut_mode', 'auto')
            f.setdefault('optimizer_mode', 'smart')
            f.setdefault('even_ratio', False)
            try:
                f['balance_pct'] = max(0.0, min(100.0, float(f.get('balance_pct', 1.0) if f.get('balance_pct', 1.0) is not None else 1.0)))
            except Exception:
                f['balance_pct'] = 1.0
            # V163: dự án cũ chưa có 2 trường này sẽ tự dùng mặc định 1 m / 1 lá.
            try:
                f['reserve_m'] = max(0.0, float(f.get('reserve_m', 1.0) if f.get('reserve_m', 1.0) is not None else 1.0))
            except Exception:
                f['reserve_m'] = 1.0
            try:
                f['reserve_plies'] = max(1, int(float(f.get('reserve_plies', 1) or 1)))
            except Exception:
                f['reserve_plies'] = 1
            f.setdefault('po_mode', 'all')
            f.setdefault('po_targets', [])
            f.setdefault('lot_mode', 'none')
            f.setdefault('lot_targets', [])
            f.setdefault('export_roll', True)
            f.setdefault('roll_po_targets', [])
            f.setdefault('roll_po_selection_set', False)
            f.setdefault('export_edit', True)
            f.setdefault('lots', [])
            f.setdefault('rolls', [])
            f.setdefault('shades', [])
            self.fabric_list.append(f)

        # ----- Thông tin chung / bổ sung -----
        info = data.get('info') if isinstance(data.get('info'), dict) else {}
        defaults = {'customer':'', 'style':'', 'batch':'', 'season':'', 'color':'',
                    'code':'F-TECH-17', 'date':'15/12/2023',
                    'actual_export_date': datetime.now().strftime('%d/%m/%Y'),
                    'prepared_by': ''}
        defaults.update({k: str(v or '') for k, v in info.items() if k in defaults and k != 'actual_export_date'})
        defaults['actual_export_date'] = datetime.now().strftime('%d/%m/%Y')
        self.info = defaults
        for key, value in defaults.items():
            ent = getattr(self, f'entry_{key}', None)
            if ent is not None:
                if key == 'actual_export_date':
                    ent.configure(state='normal')
                ent.delete(0, tk.END)
                ent.insert(0, value)
                if key == 'actual_export_date':
                    ent.configure(state='readonly')
        self.custom_info_list = [x for x in (data.get('custom_info_list') or []) if isinstance(x, dict)]

        settings = data.get('settings') if isinstance(data.get('settings'), dict) else {}
        try:
            self.MAX_OVER = int(settings.get('MAX_OVER', self.MAX_OVER))
        except Exception:
            pass
        try:
            self.MIN_PREFERRED_PLIES = int(settings.get('MIN_PREFERRED_PLIES', self.MIN_PREFERRED_PLIES))
        except Exception:
            pass
        try:
            self.MIN_MARKER_LENGTH = max(0.0, float(settings.get('MIN_MARKER_LENGTH', self.MIN_MARKER_LENGTH)))
        except Exception:
            self.MIN_MARKER_LENGTH = 1.0
        try:
            enabled_value = surplus_state.get('enabled', settings.get('increase_enabled', True))
            self.increase_enabled_var.set(bool(enabled_value))
        except Exception:
            pass
        try:
            mode = str(surplus_state.get('mode', settings.get('increase_mode', 'all')) or 'all').strip().lower()
            self.increase_mode_var.set(mode if mode in ('all', 'selected') else 'all')
        except Exception:
            pass
        try:
            self.EXTRA_SURPLUS_ROWS = min(20, max(0, int(float(settings.get('EXTRA_SURPLUS_ROWS', self.EXTRA_SURPLUS_ROWS) or 0))))
            if hasattr(self, 'extra_surplus_rows_var'):
                self.extra_surplus_rows_var.set(str(self.EXTRA_SURPLUS_ROWS))
        except Exception:
            self.EXTRA_SURPLUS_ROWS = 3
            if hasattr(self, 'extra_surplus_rows_var'):
                self.extra_surplus_rows_var.set('3')
        try:
            self.ROLL_EXTRA_BLANK_ROWS = min(20, max(0, int(float(
                settings.get('ROLL_EXTRA_BLANK_ROWS', self.ROLL_EXTRA_BLANK_ROWS) or 0
            ))))
            if hasattr(self, 'roll_extra_blank_rows_var'):
                self.roll_extra_blank_rows_var.set(str(self.ROLL_EXTRA_BLANK_ROWS))
        except Exception:
            self.ROLL_EXTRA_BLANK_ROWS = 3
            if hasattr(self, 'roll_extra_blank_rows_var'):
                self.roll_extra_blank_rows_var.set('3')

        # ----- Vẽ lại toàn bộ giao diện dựa trên dữ liệu vừa nạp -----
        self.refresh_size_ui()
        self.update_custom_info_table()
        self._refresh_fabric_po_selector()
        self._refresh_fabric_lot_selector()
        if self.fabric_list:
            self._sync_global_lots()
        self.update_fabric_table()
        if hasattr(self, 'refresh_global_lot_inventory'):
            self.refresh_global_lot_inventory()
        self.refresh_lot_table()
        self.update_summary()
        if hasattr(self, 'preview_text'):
            self.preview_text.delete('1.0', tk.END)
        self._restore_project_logo(data.get('logo'))

        # V113: khôi phục luôn dữ liệu dùng chung cho XUẤT BẢNG CẮT + FORM 10.
        # File dự án cũ không có aux_cut_state vẫn mở bình thường.
        aux_state = data.get('aux_cut_state')
        if aux_state is not None and hasattr(self, 'aux_cut_panel') and self.aux_cut_panel is not None:
            try:
                self.aux_cut_panel.apply_project_state(aux_state)
            except Exception as e:
                # Không làm hỏng việc mở toàn bộ dự án nếu riêng phần phụ có dữ liệu cũ/lỗi.
                if hasattr(self, 'status_var'):
                    self.status_var.set(f"Đã mở dự án; phần BẢNG CẮT/FORM 10 chưa khôi phục hết: {e}")

        binding_state = data.get('bias_binding_state')
        if binding_state is not None and hasattr(self, 'bias_binding_panel') and self.bias_binding_panel is not None:
            try:
                self.bias_binding_panel.apply_project_state(binding_state)
            except Exception as e:
                if hasattr(self, 'status_var'):
                    self.status_var.set(f"Đã mở dự án; phần CẮT VIỀN chưa khôi phục hết: {e}")

    def load_project(self, filename=None, confirm=True, silent=False):
        """Mở file .cutplan và nạp lại trạng thái để tiếp tục chỉnh sửa."""
        if not filename:
            # 2.12-HIDDEN-CUTPLAN: mở thẳng hộp chọn file Windows và ép hiển thị
            # cả .cutplan đang Hidden; không tạo thêm cửa sổ danh sách riêng.
            filename = self._choose_project_file_in_app()
            if not filename:
                return None
        if confirm and (self.po_list or self.fabric_list or self.global_lot_rows):
            ok = messagebox.askyesno(
                'Mở dự án',
                'Dữ liệu hiện tại sẽ được thay bằng dữ liệu trong file dự án.\n\nBạn có tiếp tục không?'
            )
            if not ok:
                return None
        try:
            with open(filename, 'r', encoding='utf-8-sig') as f:
                data = json.load(f)
            self._apply_project_payload(data)
            self.current_project_path = os.path.abspath(filename)
            # File .cutplan cũ nếu đang hiện sẽ được chuyển sang Hidden sau khi mở thành công.
            self._set_cutplan_hidden(self.current_project_path, True)
            try:
                self._last_project_dir = os.path.dirname(self.current_project_path)
            except Exception:
                pass
            if hasattr(self, 'status_var'):
                self.status_var.set(f"Đã mở dự án: {self.current_project_path}")
            if hasattr(self, 'export_status'):
                self.export_status.config(text=f"✓ Đã mở: {os.path.basename(filename)}", fg='#2471a3')
            if not silent:
                messagebox.showinfo(
                    'Mở dự án thành công',
                    f'Đã nạp lại dữ liệu để tiếp tục chỉnh sửa.\n\n{filename}'
                )
            return filename
        except Exception as e:
            if not silent:
                messagebox.showerror('Lỗi mở dự án', f'Không thể mở file dự án:\n\n{e}')
            return None

