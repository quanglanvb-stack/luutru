                self.btn_export.pack(side="right")
            if hasattr(self, "btn_export_bottom"):
                self.btn_export_bottom.pack(side="right")
        else:
            # Giống bản cũ: cùng một dữ liệu, hai nút xuất cùng xuất hiện.
