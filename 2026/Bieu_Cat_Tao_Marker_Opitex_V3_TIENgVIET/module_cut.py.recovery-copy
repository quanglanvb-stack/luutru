    $std = $wb.VBProject.VBComponents.Add(1)
    $std.Name = "QLFormulaGuard"
    $std.CodeModule.AddFromString($guardModule)

    # V168: Tắt tam giác xanh bằng chính Excel COM, KHÔNG sửa XML của file.
    # Chỉ áp dụng cho các ô công thức đã được ghi trong _FORMULA_BACKUP.
    try {
        $bk = $wb.Worksheets.Item("_FORMULA_BACKUP")
        $xlUp = -4162
        $lastRow = $bk.Cells.Item($bk.Rows.Count, 1).End($xlUp).Row
        for ($r = 2; $r -le $lastRow; $r++) {
            $addr = [string]$bk.Cells.Item($r, 1).Value2
            if ([string]::IsNullOrWhiteSpace($addr)) { continue }
            $cell = $null
            try {
                $cell = $ws.Range($addr)
