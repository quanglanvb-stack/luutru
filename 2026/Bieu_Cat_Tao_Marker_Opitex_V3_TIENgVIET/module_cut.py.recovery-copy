            for _rr_final in range(_r1_final, _r2_final + 1):
                for _cc_final in range(_c1_final, _c2_final + 1):
                    ws.cell(_rr_final, _cc_final).border = Border()

        self._export_progress(94, 'Đang hoàn thiện định dạng Excel')
