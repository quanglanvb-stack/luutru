    def _calculate_single_fabric_dashboard(self, idx):
        """Tính đúng MỘT loại vải, dùng cùng thuật toán/post-process với kế hoạch chính."""
        if not (0 <= idx < len(self.fabric_list)):
            return None, 'Không tìm thấy loại vải.'
        try:
            self._sync_po_grid_from_ui()
        except Exception:
            pass
        if not self.po_list:
            return None, 'Chưa có dữ liệu PO!'
        try:
            self._sync_all_shade_lots()
            self._sync_size_percent_from_ui(silent=False)
        except ValueError as e:
            return None, str(e)
        except Exception:
            pass

        fabric = self.fabric_list[idx]
        raw_total_by_size = self._fabric_total_by_size(fabric)
        total_by_size = self._fabric_planned_total_by_size(fabric)
        if sum(total_by_size.values()) <= 0:
            return None, f"Loại vải '{fabric.get('name','')}' không có sản lượng từ PO đã chọn."
        size_factor = {s['key']: s.get('factor',1.0) for s in self.sizes}
        norm = float(fabric.get('norm',0) or 0)
        min_len = max(0.0, float(fabric.get('min_length',1.0) or 0))
        max_len = float(fabric.get('max_length',0) or 0)
        max_products = int(fabric.get('max_products',0) or 0)
        balance_pct = float(fabric.get('balance_pct', 1.0) if fabric.get('balance_pct', 1.0) is not None else 1.0)
        resolved_mode = self._resolved_fabric_mode(fabric)
        optimizer_mode = self._optimizer_mode_key_from_label(fabric.get('optimizer_mode','smart'))
        try:
            cutting_tables, adjust_info = self._run_optimizer_strategy(
                optimizer_mode, dict(total_by_size), size_factor, norm,
                max_len, max_products, resolved_mode, min_len, balance_pct,
                fabric=fabric, fixed_table_count=int(fabric.get('table_count', 0) or 0),
                even_ratio=bool(fabric.get('even_ratio', False))
            )
        except Exception as e:
            return None, f"{fabric.get('name','Loại vải')}: {e}"
        unresolved = adjust_info.get('unresolved', {}) if isinstance(adjust_info, dict) else {}
        if unresolved:
            names = {s['key']:s['name'] for s in self.sizes}
            detail = ', '.join(f"{names.get(k,k)} thiếu {v}" for k,v in unresolved.items())
            return None, 'Chưa đủ sản lượng: ' + detail

        # V154:
        # - LÁ CAO NHẤT: không stretch vì stretch sẽ giảm số lá.
        # - SƠ ĐỒ DÀI NHẤT: cho stretch mạnh hơn, chấp nhận bàn chính còn tối thiểu 4 lá.
        # - Các mode khác giữ logic V130.
        # V155: TỐI ƯU SẢN XUẤT cũng được kéo dài các bàn chính; giữ bàn lá cao thuần túy.
        if cutting_tables and max_len > 0 and optimizer_mode != 'high_plies':
            nm = {x['key']:x['name'] for x in self.sizes}; order={x['key']:i for i,x in enumerate(self.sizes)}
            if optimizer_mode == 'long_marker':
                pref = 4
            else:
                pref=max(4,int(getattr(self,'MIN_PREFERRED_PLIES',10) or 10))
            mxp=max([int(t.get('plies',0) or 0) for t in cutting_tables] or [0])
            mnp=min([int(t.get('plies',0) or 0) for t in cutting_tables if int(t.get('plies',0) or 0)>0] or [0])
            protect=(mxp>0 and mnp>0 and (mnp<pref or mnp<=0.50*mxp))
            newtabs=[dict(t) for t in cutting_tables]
            for tb in newtabs:
                n=int(tb.get('plies',0) or 0); rm={k:int(v or 0) for k,v in (tb.get('ratio_map',{}) or {}).items() if int(v or 0)>0}
                if n<=0 or not rm or (protect and n==mnp): continue
                raw=float(tb.get('raw_length',tb.get('length',0)) or 0) or (norm*sum(rm.values()))
                rt=sum(rm.values())
                mf=min(max(1,n//pref), max(1,int((max_len+1e-9)//raw)))
                if max_products>0: mf=min(mf,max(1,int(max_products//max(1,rt))))
                kfac=1
                for f in range(mf,1,-1):
                    if n%f==0: kfac=f; break
                if kfac<=1: continue
                nn=n//kfac; nrm={k:v*kfac for k,v in rm.items()}; nraw=raw*kfac
                if bool(fabric.get('even_ratio', False)) and (
                    any(v != 1 and v % 2 for v in nrm.values())
                    or (sum(nrm.values()) != 1 and sum(nrm.values()) % 2)
                ): continue
                if nn<pref or nraw>max_len+1e-9 or (max_products>0 and sum(nrm.values())>max_products): continue
                tb['plies']=nn; tb['ratio_map']=nrm; tb['raw_length']=nraw; tb['length']=nraw
                tb['ratio']=' + '.join(f"{nm.get(k,k)}/{nrm[k]}" for k in sorted(nrm,key=lambda x:order.get(x,10**6)))
                tb['size_count']=len(nrm); tb['meter_rate']=nraw/max(1,sum(nrm.values()))
            cutting_tables=newtabs

        if bool(fabric.get('even_ratio', False)):
            for _i, _tb in enumerate(cutting_tables, start=1):
                _ratios = [int(v or 0) for v in (_tb.get('ratio_map', {}) or {}).values() if int(v or 0) > 0]
                _total_ratio = sum(_ratios)
                if (any(v != 1 and v % 2 for v in _ratios)
                        or (_total_ratio != 1 and _total_ratio % 2)):
                    return None, (
                        f"{fabric.get('name','Loại vải')}: B{_i} có tỷ lệ không đúng quy tắc. "
                        'Hãy tính lại bằng phiên bản mới.'
                    )

        base=[dict(tb) for tb in cutting_tables]
        def rtot(tb):
            rm=tb.get('ratio_map',{}) or {}; return sum(int(v or 0) for v in rm.values()) if rm else int(tb.get('size_count',0) or 0)
        if len(base)>1:
            base.sort(key=lambda tb:(-float(tb.get('raw_length',tb.get('length',0)) or 0), -int(tb.get('plies',0) or 0), -rtot(tb)))
        for i,tb in enumerate(base,1): tb['table']=f'B{i}'
        preview_tables, lot_summary = self.allocate_lots_to_tables(fabric, base)
        result = {
            'fabric': fabric, 'raw_total_by_size': dict(raw_total_by_size),
            'total_by_size': dict(total_by_size), 'production_percent': 0.0,
            'cutting_tables': base, 'preview_tables': preview_tables,
            'lot_summary': lot_summary, 'adjust_info': adjust_info,
            'fabric_mode': resolved_mode,
            'fabric_mode_label': self.FABRIC_MODE_LABELS.get(resolved_mode,'VẢI CHÍNH')
        }
        # Mỗi phương án giữ nguyên hồ sơ âm/dương theo đúng loại vật tư.
        options = adjust_info.get('plan_options', []) if isinstance(adjust_info, dict) else []
        if options:
            prepared = []
            for opt in options[:5]:
                tabs = [dict(t) for t in opt.get('cutting_tables', [])]
                if bool(fabric.get('even_ratio', False)) and any(
                    any(int(v or 0) > 0 and int(v or 0) != 1 and int(v or 0) % 2
                        for v in (tb.get('ratio_map', {}) or {}).values())
                    or ((lambda total: total != 1 and total % 2)(
                        sum(int(v or 0) for v in (tb.get('ratio_map', {}) or {}).values())
                    )) for tb in tabs
                ):
                    continue
                if len(tabs) > 1:
                    tabs.sort(key=lambda t:(-float(t.get('raw_length',t.get('length',0)) or 0), -int(t.get('plies',0) or 0)))
                for n, tb in enumerate(tabs, 1): tb['table'] = f'B{n}'
                prev, lots = self.allocate_lots_to_tables(fabric, tabs)
                adj = dict(adjust_info); adj.pop('plan_options', None)
                adj['balance_info'] = dict(opt.get('balance_info', {}))
                if adj['balance_info']:
                    for key in ('raw_diff','residual_under','transfers','transfer_used','final_positive_surplus','total_surplus_cap'):
                        source_key = 'transfers' if key == 'transfers' else key
                        if source_key in adj['balance_info']:
                            target_key = 'size_transfers' if key == 'transfers' else key
                            adj[target_key] = adj['balance_info'][source_key]
                prepared.append({'cutting_tables': tabs, 'preview_tables': prev, 'lot_summary': lots, 'adjust_info': adj, 'score': opt.get('score')})
            result['plan_options'] = prepared
        return result, None

    def _calc_all_progress_begin(self):
        """V150: bắt đầu tính và giữ cửa sổ phản hồi với Windows."""
        self._calc_all_progress_active = True
        self._calc_all_progress_value = 0
        self._calculation_busy = True

        for attr in ('fabric_calc_all_button', 'fixed_recalc_button'):
            btn = getattr(self, attr, None)
            if btn is not None:
                try:
                    btn.config(
                        state='disabled',
                        text='⏳  ĐANG TÍNH... 0%',
                        bg='#94a3b8', fg='white',
                        activebackground='#94a3b8',
                        activeforeground='white',
                        disabledforeground='white',
                        relief='sunken'
                    )
                except Exception:
                    pass

        try:
            self.root.configure(cursor='watch')
            self.root.update()
        except Exception:
            pass

    def _calc_all_progress(self, percent, stage=''):
        """V150: cập nhật % và xử lý message queue để Windows không báo Not Responding."""
        if not getattr(self, '_calc_all_progress_active', False):
            return
        try:
            old = int(getattr(self, '_calc_all_progress_value', 0) or 0)
            pct = max(old, min(100, int(percent)))
        except Exception:
            pct = 0
        self._calc_all_progress_value = pct

        for attr in ('fabric_calc_all_button', 'fixed_recalc_button'):
            btn = getattr(self, attr, None)
            if btn is not None:
                try:
                    btn.config(text=f'⏳  ĐANG TÍNH... {pct}%')
                except Exception:
                    pass

        if stage and hasattr(self, 'status_var'):
            try:
                self.status_var.set(f'{stage} ({pct}%)')
            except Exception:
                pass

        try:
            # update() thay cho update_idletasks(): Windows vẫn nhận message
            # nên cửa sổ không bị gắn nhãn Not Responding trong các giai đoạn dài.
            self.root.update()
        except Exception:
            pass

    def _calc_all_progress_end(self, success=True):
        """V150: kết thúc tính và khôi phục cả nút trên trang lẫn nút cố định."""
        self._calc_all_progress_active = False
        self._calc_all_progress_value = 0
        self._calculation_busy = False

        try:
            self.root.configure(cursor='')
        except Exception:
            pass

        for attr in ('fabric_calc_all_button', 'fixed_recalc_button'):
            btn = getattr(self, attr, None)
            if btn is None:
                continue
            try:
                if success:
                    btn.config(
                        text='✓  HOÀN TẤT 100%',
                        bg='#94a3b8', fg='white',
                        disabledforeground='white'
                    )
                else:
                    btn.config(
                        text='✕  TÍNH LỖI',
                        bg='#94a3b8', fg='white',
                        disabledforeground='white'
                    )
            except Exception:
                pass

        try:
            self.root.update()
        except Exception:
            pass

        def _restore():
            configs = {
                'fabric_calc_all_button': {
                    'text':'↻  TÍNH TOÀN BỘ',
                    'bg':'#0f766e',
                    'activebackground':'#0b5f59'
                },
                'fixed_recalc_button': {
                    'text':'↻  TÍNH TOÁN LẠI',
                    'bg':'#2375c6',
                    'activebackground':'#1b62a8'
                }
            }
            for attr, cfg in configs.items():
                b = getattr(self, attr, None)
                if b is not None:
                    try:
                        b.config(
                            state='normal',
                            text=cfg['text'],
                            bg=cfg['bg'], fg='white',
                            activebackground=cfg['activebackground'],
                            activeforeground='white',
                            relief='flat'
                        )
                    except Exception:
                        pass

        try:
            self.root.after(700 if success else 1200, _restore)
        except Exception:
            _restore()

