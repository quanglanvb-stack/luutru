                c.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)

            details = block.get('details',[]) or []
            default_mark = str(block.get('lot_mark','') or '')
            lotn = str(block.get('lot','') or '')
            assign_abs = f'${col_letter(bs+1)}$5'

            # V85: chừa đúng số DÒNG DƯ người dùng đã chọn trên phần mềm trước khi xuất.
            # Chọn 0 = không sinh dòng dư/công thức thừa; chọn N = thêm N dòng dư cho mỗi Shade.
            extra_row_count = min(int(requested_extra_rows), max(0, MAX_TREE_ROWS_PER_LOT - len(details)))
            extra_rows = [lot_data_first_row + len(details) + i for i in range(extra_row_count)]
            block['extra_rows'] = extra_rows

            for j, rr in enumerate(range(lot_data_first_row, lot_data_last_row+1)):
