                        $err = $cell.Errors.Item($i)
                        if ($err.Value) { $err.Ignore = $true }
                        [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($err)
                    } catch {}
                }
            } finally {
                if ($cell -ne $null) {
                    try { [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($cell) } catch {}
                }
            }
        }
        try { [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($bk) } catch {}
    } catch {
        # Không làm hỏng bước xuất nếu Excel phiên bản cũ không hỗ trợ một loại Error Checking.
    }

    # Khôi phục events trước khi lưu/đóng.
    $excel.EnableEvents = $true

    if (Test-Path $OutputXlsm) { Remove-Item -Force $OutputXlsm }
    $wb.SaveAs($OutputXlsm, 52)
    $wb.Close($false)
    $wb = $null
}
finally {
    if ($wb -ne $null) { try { $wb.Close($false) } catch {} }
    if ($excel -ne $null) {
        try { $excel.Quit() } catch {}
        try { [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($excel) } catch {}
    }
    [GC]::Collect()
    [GC]::WaitForPendingFinalizers()
}
'''

    fd, ps1_name = tempfile.mkstemp(prefix='CutPlan_VBA_', suffix='.ps1')
    os.close(fd)
    try:
        with open(ps1_name, 'w', encoding='utf-8-sig') as f:
            f.write(ps_code)

        creationflags = getattr(subprocess, 'CREATE_NO_WINDOW', 0x08000000)
        result = subprocess.run(
            [
                'powershell.exe', '-NoProfile', '-ExecutionPolicy', 'Bypass',
                '-File', ps1_name,
                '-InputXlsx', xlsx_path,
                '-OutputXlsm', xlsm_path,
            ],
            stdout=subprocess.PIPE,
