    def open_aux_cut_tool(self, mode="cut", refresh_info=False, sync_cut_data=False):
        """Mở một cửa sổ dùng chung cho hai menu; chuyển menu không làm mất dữ liệu đã nhập."""
        win = getattr(self, "aux_cut_window", None)
        if win is None or not win.winfo_exists():
            self.aux_cut_window = AuxCutTableWindow(
                self.root, mode=mode, initial=self._collect_aux_initial_info(), owner=self
            )
            win = self.aux_cut_window
        else:
            if refresh_info:
                win.apply_initial_info(self._collect_aux_initial_info(), overwrite=True)
            win.set_mode(mode)
            win.deiconify()
            win.lift()
            try:
                win.focus_force()
            except Exception:
                pass
        if sync_cut_data:
            try:
                win.sync_from_main()
            except Exception as e:
                messagebox.showerror("Lỗi đồng bộ", str(e), parent=win)
        self.status_var.set(
            "Đã mở BIỂU 10" if mode == "form10" else "Đã mở PHÂN SỐ CẮT"
        )

