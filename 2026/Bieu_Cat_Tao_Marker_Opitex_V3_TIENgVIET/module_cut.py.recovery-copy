            ws[addr].alignment = Alignment(vertical="center")

        thin = Side(style="thin", color="000000")
        medium = Side(style="medium", color="000000")
        border_thin = Border(left=thin, right=thin, top=thin, bottom=thin)
        fill_head = PatternFill("solid", fgColor="F2F2F2")
        font_head = Font(name="Times New Roman", size=10, bold=True)
        font_data = Font(name="Times New Roman", size=10)
        font_size_title = Font(name="Times New Roman", size=20, bold=True)

        # Vị trí đóng gói hiện tại: mỗi trang có 4 cột khối.
        page_index = 0
        slot = 0
        cursor_row = first_data_top
        page_top = first_data_top
        page_bottom = page_top + page_bottom_offset
        last_used_row = first_data_top
        page_break_rows = []

        def new_slot():
            nonlocal page_index, slot, cursor_row, page_top, page_bottom
            slot += 1
            if slot >= 4:
                slot = 0
                page_index += 1
                page_top = first_data_top + page_index * page_body_rows
                page_bottom = page_top + page_bottom_offset
                cursor_row = page_top
                page_break_rows.append(page_top)
            else:
                cursor_row = page_top

        def rows_fit_from(start_row, table_count):
            # 2 dòng tiêu đề + số dòng bàn
            return start_row + 2 + table_count - 1 <= page_bottom

        def full_block_capacity(start_row):
            # số bàn tối đa còn vừa từ dòng hiện tại tới hết chiều cao trang
            return max(0, page_bottom - (start_row + 2) + 1)

        def manufacturer_lot_for_shade(shade_name):
            """Lấy các LOT nhà sản xuất đã ghi trên cây thuộc Shade này."""
            owner = getattr(self, "owner", None)
            shade_key = str(shade_name or "").strip().casefold()
            if not owner or not shade_key:
                return ""
            marks = []
            for lot_row in getattr(owner, "global_lot_rows", []) or []:
                if str(lot_row.get("lot", "") or "").strip().casefold() != shade_key:
                    continue
                details = lot_row.get("rolls_detail", []) or []
                for detail in details:
                    mark = str(detail.get("lot_mark", "") or "").strip()
                    if mark and mark not in marks:
                        marks.append(mark)
                fallback = str(lot_row.get("lot_mark", "") or "").strip()
                if fallback and fallback not in marks:
                    marks.append(fallback)
            return ", ".join(marks)

        def draw_block(item, rows_data, r0, c0, table_no_start, continued=False):
            nonlocal last_used_row
            c1 = c0 + block_width - 1
