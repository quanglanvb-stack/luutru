                     bg='#d9eaf7', bd=1, relief='solid').grid(row=0, column=c, sticky='nsew')

        _lot_resize_job = {'id': None, 'width': None}

        def _lot_grid_resize(event=None):
            """V185-SMOOTH: gom nhiều sự kiện Configure thành một lần redraw."""
            try:
                if event is not None and getattr(event, 'widget', None) == lot_grid_canvas:
                    _lot_resize_job['width'] = max(1, int(event.width or 1))

                old = _lot_resize_job.get('id')
                if old:
                    try:
                        self.root.after_cancel(old)
                    except Exception:
                        pass

                def _apply():
                    _lot_resize_job['id'] = None
                    try:
                        width = _lot_resize_job.get('width')
                        if not width:
                            width = max(1, int(lot_grid_canvas.winfo_width() or 1))
                        lot_grid_canvas.itemconfigure(lot_grid_window, width=width)
                        lot_grid_canvas.configure(scrollregion=lot_grid_canvas.bbox('all'))
                    except Exception:
                        pass

                _lot_resize_job['id'] = self.root.after(35, _apply)
            except Exception:
                pass

        grid.bind('<Configure>', _lot_grid_resize)
        lot_grid_canvas.bind('<Configure>', _lot_grid_resize)
        self.lot_inventory_entries = []
        self.lot_inventory_canvas = lot_grid_canvas

        def _clipboard_rows(txt):
            lines = [x for x in str(txt).replace('\r\n','\n').replace('\r','\n').split('\n') if x.strip()]
            rows = []
            for line in lines:
                parts = [p.strip() for p in line.split('\t')]
                # V181: thứ tự dán chuẩn: Shade | SỐ CÂY | SỐ Y | Lot nhà sản xuất.
                # Cột SỐ MÉT không cần dán; phần mềm tự quy đổi từ Y sau khi paste.
                if len(parts) == 4:
                    parts = [parts[0], parts[1], parts[2], parts[3], '']
                elif len(parts) == 3:
                    parts = [parts[0], parts[1], parts[2], '', '']
                rows.append((parts + [''] * 6)[:6])
            return rows

        _lot_meter_jobs = {}

        def _sync_meter_from_y_entries(entries):
            if len(entries) < 5:
                return
            raw = entries[2].get().strip().replace(',', '.')
            if not raw:
                # Không xóa SỐ MÉT trong lúc người dùng đang gõ dở.
                return
            try:
                yards = max(0.0, float(raw))
            except Exception:
                return
            meters_text = f"{yards * self.YARD_TO_METER:.2f}"
            try:
                if entries[4].get().strip() == meters_text:
                    return
            except Exception:
                pass
            entries[4].delete(0, tk.END)
            entries[4].insert(0, meters_text)

        def _queue_meter_from_y(entries, delay=170):
            """V185-SMOOTH: chờ người dùng ngừng gõ rồi mới quy đổi Y -> mét."""
            try:
                key = str(entries[2])
                old = _lot_meter_jobs.pop(key, None)
                if old:
                    try:
                        self.root.after_cancel(old)
                    except Exception:
                        pass

                def _run():
                    _lot_meter_jobs.pop(key, None)
                    _sync_meter_from_y_entries(entries)

                _lot_meter_jobs[key] = self.root.after(max(80, int(delay)), _run)
            except Exception:
                _sync_meter_from_y_entries(entries)

        def _create_lot_input_row():
            r = len(self.lot_inventory_entries) + 1
            row_entries = []
            for c, (_, width) in enumerate(headers):
                e = tk.Entry(grid, width=1, font=('Arial', 9), bd=1, relief='solid',
                             justify='left' if c in (0, 1, 3) else 'center')
                e.grid(row=r, column=c, sticky='nsew')
                row_entries.append(e)
            self.lot_inventory_entries.append(row_entries)
            # paste_into_grid được tra cứu khi sự kiện chạy nên có thể bind tại đây.
            for ent in row_entries:
                ent.bind('<Control-v>', paste_into_grid)
                ent.bind('<Control-V>', paste_into_grid)
            row_entries[2].bind(
                '<KeyRelease>',
                lambda ev, entries=row_entries: _queue_meter_from_y(entries),
                add='+'
            )
            row_entries[2].bind(
                '<FocusOut>',
                lambda ev, entries=row_entries: _sync_meter_from_y_entries(entries),
                add='+'
            )
            return row_entries

        def _ensure_lot_input_rows(count):
            count = max(1, int(count or 1))
            while len(self.lot_inventory_entries) < count:
                _create_lot_input_row()
            _lot_grid_resize()

        def _trim_lot_input_rows(keep=12):
            keep = max(1, int(keep or 1))
            while len(self.lot_inventory_entries) > keep:
                row = self.lot_inventory_entries.pop()
                for ent in row:
                    try:
                        ent.destroy()
                    except Exception:
                        pass
            _ensure_lot_input_rows(keep)
            try:
                lot_grid_canvas.yview_moveto(0)
            except Exception:
                pass

        def paste_into_grid(event=None):
            try:
                txt = self.root.clipboard_get()
            except Exception:
                return 'break'
            rows_to_paste = _clipboard_rows(txt)
            if not rows_to_paste:
                return 'break'
            start_r = start_c = 0
            widget = self.root.focus_get()
            for rr, row in enumerate(self.lot_inventory_entries):
                for cc, ent in enumerate(row):
                    if ent == widget:
                        start_r, start_c = rr, cc
                        break
            # V109: tự thêm dòng theo clipboard, thực tế không giới hạn số cây.
            _ensure_lot_input_rows(start_r + len(rows_to_paste))
            for dr, parts in enumerate(rows_to_paste):
                for dc, val in enumerate(parts[:6-start_c]):
                    ent = self.lot_inventory_entries[start_r+dr][start_c+dc]
                    ent.delete(0, tk.END)
                    ent.insert(0, val)
                _sync_meter_from_y_entries(self.lot_inventory_entries[start_r+dr])
            _lot_grid_resize()
            try:
                target_row = min(len(self.lot_inventory_entries)-1, start_r + len(rows_to_paste)-1)
                lot_grid_canvas.update_idletasks()
                bbox = lot_grid_canvas.bbox('all')
                if bbox and bbox[3] > 0:
                    y = self.lot_inventory_entries[target_row][0].winfo_y()
                    lot_grid_canvas.yview_moveto(max(0.0, min(1.0, y / bbox[3])))
            except Exception:
                pass
            self.status_var.set(f'Đã dán {len(rows_to_paste)} dòng CÂY/Shade')
            return 'break'

        _ensure_lot_input_rows(12)

        def _norm_excel_header(value):
            """Chuẩn hóa tiêu đề Excel để nhận cả tiếng Việt có/không dấu."""
            s = str(value or '').strip().upper()
            s = unicodedata.normalize('NFKD', s)
            s = ''.join(ch for ch in s if not unicodedata.combining(ch))
            s = s.replace('Đ', 'D')
            s = re.sub(r'[^A-Z0-9#]+', ' ', s)
            return ' '.join(s.split())

        def _excel_number(value):
            if value in (None, ''):
                return 0.0
            if isinstance(value, (int, float)):
                return max(0.0, float(value))
            s = str(value).strip().replace(' ', '').replace('m', '').replace('M', '')
            if not s:
                return 0.0
            # Hỗ trợ cả 1.234,5 và 1,234.5; trường hợp chỉ có dấu phẩy coi là dấu thập phân.
            if ',' in s and '.' in s:
                if s.rfind(',') > s.rfind('.'):
                    s = s.replace('.', '').replace(',', '.')
                else:
                    s = s.replace(',', '')
            else:
                s = s.replace(',', '.')
            return max(0.0, float(s))

        def import_lot_excel():
            filename = filedialog.askopenfilename(
                title='Chọn file Excel chứa Shade / SỐ CÂY / SỐ Y / Lot nhà sản xuất / Khổ vải',
                filetypes=[
                    ('Excel Workbook', '*.xlsx *.xlsm'),
                    ('Excel .xlsx', '*.xlsx'),
                    ('Excel Macro .xlsm', '*.xlsm'),
                    ('All files', '*.*'),
                ]
            )
            if not filename:
                return
            try:
                wb_in = load_workbook(filename, read_only=True, data_only=True)
            except Exception as e:
                messagebox.showerror('Không đọc được file Excel',
                                     f'Chỉ hỗ trợ .xlsx/.xlsm.\n\n{e}', parent=parent)
                return

            def detect_sheet(ws):
                max_r = min(int(ws.max_row or 0), 30)
                max_c = min(int(ws.max_column or 0), 30)
                for rr in range(1, max_r + 1):
                    found = {}
                    for cc in range(1, max_c + 1):
                        h = _norm_excel_header(ws.cell(rr, cc).value)
                        if not h:
                            continue
                        if h in ('SHADE', 'TEN SHADE', 'MA SHADE', 'LOT', 'TEN LOT', 'MA LOT'):
                            found.setdefault('lot', cc)
                        elif h in ('SO CAY', 'TEN CAY', 'MA CAY', 'CAY', 'ROLL', 'ROLL#', 'ROLL #'):
                            found.setdefault('roll', cc)
                        elif h in ('SO Y', 'Y', 'YARD', 'YARDS', 'SO YARD', 'CHIEU DAI Y', 'CHIEU DAI YARD'):
                            found.setdefault('yards', cc)
                        elif h in ('SO MET', 'SO M', 'SO MET VAI', 'MET', 'METER', 'METERS',
                                   'CHIEU DAI M', 'CHIEU DAI MET'):
                            found.setdefault('meters', cc)
                        elif h in ('KHO VAI', 'KHO VAI CM', 'FABRIC WIDTH', 'FABRIC WIDTH CM', 'WIDTH CM'):
                            found.setdefault('width', cc)
                        elif (('SHADE' in h or 'LOT' in h) and 'GHI' in h and 'CAY' in h) or h in ('SHADE TREN CAY', 'SHADE GHI TREN CAY', 'LOT NHA SAN XUAT'):
                            found.setdefault('mark', cc)
                    if all(k in found for k in ('lot', 'roll')) and ('meters' in found or 'yards' in found):
                        return rr, found
                return None

            chosen = None
            for ws_in in wb_in.worksheets:
                detected = detect_sheet(ws_in)
                if detected:
                    chosen = (ws_in, detected[0], detected[1])
                    break

            if chosen is None:
                ws_in = wb_in.active
                use_first3 = messagebox.askyesno(
                    'Không tìm thấy tiêu đề',
                    'Không tìm thấy đủ tiêu đề Shade, SỐ CÂY và SỐ Y/SỐ MÉT.\n\n'
                    'Bạn có muốn dùng sheet hiện tại theo thứ tự:\n'
                    'A = Shade | B = SỐ CÂY | C = SỐ Y | D = Lot nhà sản xuất?\n'
                    'SỐ MÉT sẽ tự quy đổi từ SỐ Y.',
                    parent=parent
                )
                if not use_first3:
                    wb_in.close()
                    return
                chosen = (ws_in, 0, {'lot': 1, 'roll': 2, 'yards': 3, 'mark': 4, 'meters': 5})

            ws_in, header_row, cols = chosen
            added = updated = bad = skipped = 0
            first_data_row = header_row + 1 if header_row else 1
            for rr in range(first_data_row, int(ws_in.max_row or 0) + 1):
                lot = str(ws_in.cell(rr, cols['lot']).value or '').strip()
                roll_name = str(ws_in.cell(rr, cols['roll']).value or '').strip()
                mark = ''
                if cols.get('mark'):
                    mark = str(ws_in.cell(rr, cols['mark']).value or '').strip()
                raw_yards = ws_in.cell(rr, cols['yards']).value if cols.get('yards') else None
                raw_meters = ws_in.cell(rr, cols['meters']).value if cols.get('meters') else None
                width_text = str(ws_in.cell(rr, cols['width']).value or '').strip() if cols.get('width') else ''

                if not lot and not roll_name and raw_yards in (None, '') and raw_meters in (None, ''):
                    skipped += 1
                    continue
                # Bỏ dòng tiêu đề lặp lại giữa dữ liệu.
                if _norm_excel_header(lot) in ('SHADE', 'TEN SHADE', 'MA SHADE', 'LOT', 'TEN LOT', 'MA LOT'):
                    skipped += 1
                    continue
                if not lot or not roll_name:
                    bad += 1
                    continue
                try:
                    yd = _excel_number(raw_yards) if raw_yards not in (None, '') else 0.0
                    if yd > 0:
                        met = yd * self.YARD_TO_METER
                    else:
                        met = _excel_number(raw_meters)
                        yd = (met / self.YARD_TO_METER) if met > 0 else 0.0
                except Exception:
                    bad += 1
                    continue

                found = next((x for x in self.global_lot_rows
                              if str(x.get('lot','')).strip().lower() == lot.lower()), None)
                if found is None:
                    found = {'lot': lot, 'lot_mark': mark, 'roll_count': 0,
                             'meters': 0.0, 'rolls_detail': []}
                    self.global_lot_rows.append(found)

                details = self._ensure_lot_roll_details(found)
                # V93: một cây được nhận diện bằng Shade + Lot nhà sản xuất + SỐ CÂY.
                # Vì vậy cùng SỐ CÂY nhưng Lot nhà sản xuất khác nhau là 2 cây độc lập.
                _mark_key = str(mark or '').strip().lower()
                existing = next((d for d in details
                                 if str(d.get('roll','')).strip().lower() == roll_name.lower()
                                 and str(d.get('lot_mark','') or '').strip().lower() == _mark_key), None)
                if existing:
                    existing['roll'] = roll_name
                    existing['lot_mark'] = mark
                    existing['yards'] = yd
                    existing['meters'] = met
                    existing['fabric_width_cm'] = width_text
                    updated += 1
                else:
                    details.append({'roll': roll_name, 'lot_mark': mark, 'yards': yd, 'meters': met, 'fabric_width_cm': width_text})
                    added += 1
                found['rolls_detail'] = details
                self._recalc_lot_from_roll_details(found)

            wb_in.close()
            refresh()
            if hasattr(self, '_refresh_fabric_lot_selector'):
                self._refresh_fabric_lot_selector()
            self.status_var.set(
                f'Nhập Excel: thêm {added} cây, cập nhật {updated} cây, lỗi {bad}'
            )
            messagebox.showinfo(
                'Nhập file Excel hoàn tất',
                f'Sheet: {ws_in.title}\n'
                f'Thêm mới: {added} cây\n'
                f'Cập nhật: {updated} cây\n'
                f'Dòng lỗi/bỏ qua: {bad + skipped}',
                parent=parent
            )

        btns = tk.Frame(top)
        btns.pack(fill='x', pady=(8, 0))
        for _c in range(4):
            btns.grid_columnconfigure(_c, weight=1, uniform='lot_actions')
        tk.Button(btns, text='📋 DÁN TỪ EXCEL', command=paste_into_grid,
                  font=('Arial', 9, 'bold'), bg='#16a085', fg='white',
                  padx=8, pady=4, wraplength=180).grid(row=0, column=0, sticky='ew', padx=(0, 3))
        tk.Button(btns, text='📥 NHẬP FILE EXCEL', command=import_lot_excel,
                  font=('Arial', 9, 'bold'), bg='#2471a3', fg='white',
                  padx=8, pady=4, wraplength=180).grid(row=0, column=1, sticky='ew', padx=3)

        detail_box = tk.LabelFrame(parent, text='CHI TIẾT TỪNG Shade - MỖI CÂY 1 DÒNG',
                                   font=('Arial', 11, 'bold'), padx=6, pady=6)
        detail_box.pack(fill='x', expand=False, padx=15, pady=(5, 8))
        canvas = tk.Canvas(detail_box, height=54, highlightthickness=0, bg='#f4f6f7')
        vbar = ttk.Scrollbar(detail_box, orient='vertical', command=canvas.yview)
        inner = tk.Frame(canvas, bg='#f4f6f7')
        inner_id = canvas.create_window((0, 0), window=inner, anchor='nw')
        canvas.configure(yscrollcommand=vbar.set)
        canvas.pack(side='left', fill='both', expand=True)
        vbar.pack(side='right', fill='y')
        self.global_lot_detail_canvas = canvas
        inner.bind('<Configure>', lambda e: canvas.configure(scrollregion=canvas.bbox('all')))
        canvas.bind('<Configure>', lambda e: canvas.itemconfigure(inner_id, width=e.width))
        self.global_lot_detail_inner = inner
        self.global_lot_summary_var = tk.StringVar(value='')
        tk.Label(parent, textvariable=self.global_lot_summary_var, font=('Arial', 10, 'bold'),
                 fg='#1f4e78', anchor='w').pack(fill='x', padx=18, pady=(0, 8))

        def refresh():
            if self.fabric_list:
                self._sync_global_lots()
            for w in inner.winfo_children():
                w.destroy()
            total_c = 0
            total_m = 0.0
            if not self.global_lot_rows:
                tk.Label(inner, text='Chưa có Shade. Hãy nhập từng cây ở khung phía trên.',
                         font=('Arial', 10), bg='#f4f6f7', fg='#7f8c8d').pack(anchor='w', padx=8, pady=8)

            for idx, row in enumerate(self.global_lot_rows):
                details = self._ensure_lot_roll_details(row)
                lot_name = str(row.get('lot', '') or f'Shade {idx+1}')
                frame = tk.LabelFrame(inner, text=f"Shade: {lot_name}", font=('Arial', 10, 'bold'),
                                      padx=6, pady=6, bg='#ffffff', fg='#1f4e78')
                frame.pack(fill='x', padx=5, pady=5)

                head = tk.Frame(frame, bg='#ffffff')
                head.pack(fill='x')
                hdr = [('SỐ CÂY', 16), ('SỐ Y', 12), ('Lot nhà sản xuất', 22), ('SỐ MÉT', 14), ('Khổ vải (cm)', 14)]
                for c, (t, wid) in enumerate(hdr):
                    tk.Label(head, text=t, width=wid, font=('Arial', 9, 'bold'), bg='#d9eaf7',
                             bd=1, relief='solid').grid(row=0, column=c, sticky='nsew')

                row_entries = []
                for ri, d in enumerate(details, start=1):
                    _met = float(d.get('meters',0) or 0)
                    try:
                        _yd = float(d.get('yards',0) or 0)
                    except Exception:
                        _yd = 0.0
                    if _yd <= 0 and _met > 0:
                        _yd = _met / self.YARD_TO_METER
                    vals = [str(d.get('roll', '') or ''),
                            f"{_yd:.2f}" if _yd > 0 else '',
                            str(d.get('lot_mark', row.get('lot_mark', '')) or ''),
                            f"{_met:.2f}",
                            str(d.get('fabric_width_cm','') or '')]
                    ents = []
                    for c, val in enumerate(vals):
                        e = tk.Entry(head, width=hdr[c][1], font=('Arial', 9), bd=1, relief='solid',
                                     justify='left' if c in (0, 2) else 'center')
                        e.insert(0, val)
                        e.grid(row=ri, column=c, sticky='nsew')
                        ents.append(e)
                    row_entries.append(ents)

                foot = tk.Frame(frame, bg='#ffffff')
                foot.pack(fill='x', pady=(5, 0))
                summary = tk.StringVar()

                def recalc_local(row=row, entries=row_entries, summary=summary):
                    new = []
                    for ents in entries:
                        name = ents[0].get().strip()
                        yt = ents[1].get().strip().replace(',', '.')
                        mark = ents[2].get().strip()
                        mt = ents[3].get().strip().replace(',', '.')
                        width_cm = ents[4].get().strip()
                        try:
                            yd = max(0.0, float(yt)) if yt else 0.0
                        except Exception:
                            yd = 0.0
                        try:
                            met = max(0.0, float(mt)) if mt else 0.0
                        except Exception:
                            met = 0.0
                        if yd > 0:
                            met = yd * self.YARD_TO_METER
                            _met_text = f"{met:.2f}"
                            try:
                                _same_met = (ents[3].get().strip() == _met_text)
                            except Exception:
                                _same_met = False
                            if not _same_met:
                                ents[3].delete(0, tk.END)
                                ents[3].insert(0, _met_text)
                        elif met > 0:
                            yd = met / self.YARD_TO_METER
                        if not name and met <= 0:
                            continue
                        if not name:
                            name = str(len(new) + 1)
                        new.append({'roll': name, 'lot_mark': mark, 'yards': yd, 'meters': met, 'fabric_width_cm': width_cm})
                    row['rolls_detail'] = new
                    self._recalc_lot_from_roll_details(row)
                    cnt = int(row.get('roll_count', 0) or 0)
                    met = float(row.get('meters', 0) or 0)
                    summary.set(f'TỔNG SHADE: {cnt} CÂY | {met:.2f} m')
                    self.global_lot_summary_var.set(
                        f"TỔNG KHO: {len(self.global_lot_rows)} SHADE | "
                        f"{sum(int(x.get('roll_count',0) or 0) for x in self.global_lot_rows)} CÂY | "
                        f"{sum(float(x.get('meters',0) or 0) for x in self.global_lot_rows):.2f} m"
                    )
                    if self.fabric_list:
                        # V185-SMOOTH: dữ liệu row đã cập nhật ngay; phần đồng bộ/vẽ
                        # lại toàn bộ danh sách loại vải được gom để tránh chớp.
                        self._schedule_smooth_refresh(delay=320)

                recalc_local()
                for ents in row_entries:
                    _detail_y_job = {'id': None}

                    def _sync_detail_y_now(entries=ents):
                        raw = entries[1].get().strip().replace(',', '.')
                        if raw:
                            try:
                                yd = max(0.0, float(raw))
                                txt = f"{yd * self.YARD_TO_METER:.2f}"
                                if entries[3].get().strip() != txt:
                                    entries[3].delete(0, tk.END)
                                    entries[3].insert(0, txt)
                            except Exception:
                                pass

                    def _sync_detail_y(ev=None, entries=ents, job=_detail_y_job):
                        try:
                            if job.get('id'):
                                self.root.after_cancel(job['id'])
                            job['id'] = self.root.after(
                                170,
                                lambda: (job.__setitem__('id', None), _sync_detail_y_now(entries))
                            )
                        except Exception:
                            _sync_detail_y_now(entries)

                    ents[1].bind('<KeyRelease>', _sync_detail_y, add='+')
                    for e in ents:
                        e.bind('<Return>', lambda ev, fn=recalc_local: fn())
                        e.bind('<FocusOut>', lambda ev, fn=recalc_local: fn())

                tk.Label(foot, textvariable=summary, font=('Arial', 9, 'bold'),
                         bg='#ffffff', fg='#1f4e78').pack(side='left')

                def add_one(row=row):
                    self._ensure_lot_roll_details(row)
                    existing = {str(x.get('roll','')).strip() for x in row['rolls_detail']}
                    n = 1
                    while str(n) in existing:
                        n += 1
                    row['rolls_detail'].append({'roll': str(n),
                                                'yards': 0.0,
                                                'lot_mark': str(row.get('lot_mark','') or ''),
                                                'meters': 0.0, 'fabric_width_cm': ''})
                    self._recalc_lot_from_roll_details(row)
                    refresh()

                def del_lot(i=idx):
                    if messagebox.askyesno('Xóa Shade',
                                           f'Xóa toàn bộ Shade {self.global_lot_rows[i].get("lot","")}?',
