Private Function QL_IsManaged(ByVal bk As Worksheet, ByVal addr As String) As Boolean
    Dim m As Variant

    m = Application.Match(addr, bk.Columns(1), 0)
    QL_IsManaged = Not IsError(m)
End Function

Private Sub QL_RestoreFormula(ByVal targetCell As Range, ByVal mirror As Worksheet)
    On Error GoTo Done

    Dim src As Range
    Set src = mirror.Range(targetCell.Address(False, False))

    If src.HasFormula Then
        ' Cùng tọa độ giữa 2 sheet => tham chiếu tương đối giữ nguyên.
        src.Copy
        targetCell.PasteSpecial Paste:=-4123   ' xlPasteFormulas
        Application.CutCopyMode = False
    End If

Done:
    Application.CutCopyMode = False
End Sub

Public Sub QL_HandleChange(ByVal Sh As Object, ByVal Target As Range)
    On Error GoTo SafeExit

    If QL_Busy Then Exit Sub
    If Sh Is Nothing Then Exit Sub
    If Not Sh Is ThisWorkbook.Worksheets(1) Then Exit Sub
    If Target Is Nothing Then Exit Sub

    Dim bk As Worksheet
    Dim mirror As Worksheet
    Dim c As Range
    Dim src As Range

    Set bk = ThisWorkbook.Worksheets("_FORMULA_BACKUP")
    Set mirror = ThisWorkbook.Worksheets("_FORMULA_MIRROR")

    QL_Busy = True

    For Each c In Target.Cells
        If QL_IsManaged(bk, c.Address(False, False)) Then

            Set src = mirror.Range(c.Address(False, False))

            ' Delete / Backspace / Clear Contents -> trả công thức gốc.
            If Len(CStr(c.Value2)) = 0 And Not c.HasFormula Then
                QL_RestoreFormula c, mirror

            ' Nhập một công thức khác -> trả lại công thức gốc.
            ElseIf c.HasFormula And src.HasFormula Then
                If CStr(c.Formula) <> CStr(src.Formula) Then
                    QL_RestoreFormula c, mirror
                End If

            ' Giá trị thường (số/chữ) -> giữ nguyên.
            End If
        End If
    Next c

SafeExit:
    QL_Busy = False
End Sub

Public Sub QL_CheckAndRestore()
    On Error GoTo Reschedule

    If Not QL_Running Then Exit Sub
    If QL_Busy Then GoTo Reschedule

    Dim ws As Worksheet
    Dim bk As Worksheet
    Dim mirror As Worksheet
    Dim lastRow As Long
    Dim r As Long
    Dim addr As String
    Dim c As Range
    Dim src As Range

    Set ws = ThisWorkbook.Worksheets(1)
    Set bk = ThisWorkbook.Worksheets("_FORMULA_BACKUP")
    Set mirror = ThisWorkbook.Worksheets("_FORMULA_MIRROR")

    QL_Busy = True
    lastRow = bk.Cells(bk.Rows.Count, 1).End(xlUp).Row

    For r = 2 To lastRow
        addr = Trim$(CStr(bk.Cells(r, 1).Value2))

        If Len(addr) > 0 Then
            Set c = Nothing
            Set src = Nothing

            On Error Resume Next
            Set c = ws.Range(addr)
            Set src = mirror.Range(addr)
            On Error GoTo Reschedule

            If Not c Is Nothing And Not src Is Nothing Then

                If Len(CStr(c.Value2)) = 0 And Not c.HasFormula Then
                    QL_RestoreFormula c, mirror

                ElseIf c.HasFormula And src.HasFormula Then
                    If CStr(c.Formula) <> CStr(src.Formula) Then
                        QL_RestoreFormula c, mirror
                    End If
                End If
            End If
        End If
    Next r

Reschedule:
    QL_Busy = False

    If QL_Running Then
        On Error Resume Next

        QL_NextRun = Now + TimeSerial(0, 0, 1)

        Application.OnTime _
            EarliestTime:=QL_NextRun, _
            Procedure:="'" & ThisWorkbook.Name & "'!QL_CheckAndRestore", _
            Schedule:=True
    End If
End Sub
'@

    # Ghi event vào ThisWorkbook.
    $comp = $wb.VBProject.VBComponents.Item("ThisWorkbook")
    $cm = $comp.CodeModule
    if ($cm.CountOfLines -gt 0) {
