    def _optimizer_plan_metrics(self, tables, adjust_info, total_by_size, fabric=None):
        """V154: quy đổi một phương án thành bộ chỉ số để 10 chiến lược mới so sánh."""
        tables = list(tables or [])
        info = adjust_info if isinstance(adjust_info, dict) else {}
        keys = [s.get('key') for s in self.sizes if s.get('key') in total_by_size]
        size_order = {k: i for i, k in enumerate(keys)}

        actual = {k: 0 for k in total_by_size}
        for tb in tables:
            for k, v in (tb.get('sizes', {}) or {}).items():
                actual[k] = actual.get(k, 0) + int(v or 0)

        raw_diff = {
            k: int(actual.get(k, 0)) - int(total_by_size.get(k, 0) or 0)
            for k in total_by_size
        }

        residual = info.get('residual_under')
        if isinstance(residual, dict):
            under = sum(max(0, int(residual.get(k, 0) or 0)) for k in total_by_size)
        else:
            under = sum(max(0, -v) for v in raw_diff.values())

        if 'final_positive_surplus' in info:
            over = max(0, int(info.get('final_positive_surplus', 0) or 0))
        else:
            over = sum(max(0, v) for v in raw_diff.values())

        abs_diff = under + over
        plies = [max(0, int(tb.get('plies', 0) or 0)) for tb in tables]
        lengths = [
            max(0.0, float(tb.get('raw_length', tb.get('length', 0)) or 0))
            for tb in tables
        ]
        ratio_totals = []
        size_counts = []
        spans = []
        total_meters = 0.0

        for tb, L, n in zip(tables, lengths, plies):
            rm = {
                k: int(v or 0)
                for k, v in (tb.get('ratio_map', {}) or {}).items()
                if int(v or 0) > 0
            }
            rt = sum(rm.values())
            ratio_totals.append(rt)
            size_counts.append(len(rm))
            idxs = [size_order[k] for k in rm if k in size_order]
            spans.append((max(idxs) - min(idxs)) if len(idxs) >= 2 else 0)
            total_meters += L * n

        if tables:
            tail_i = min(
                range(len(tables)),
                key=lambda i: (plies[i], ratio_totals[i], lengths[i], i)
            )
            tail_plies = plies[tail_i]
            tail_ratio = ratio_totals[tail_i]
            tail_length = lengths[tail_i]
            tail_sizes = size_counts[tail_i]
        else:
            tail_plies = tail_ratio = tail_sizes = 0
            tail_length = 0.0

        positive_plies = [x for x in plies if x > 0]
        min_plies = min(positive_plies) if positive_plies else 0
        avg_plies = (sum(positive_plies) / len(positive_plies)) if positive_plies else 0.0

        # V155: chỉ số phục vụ sản xuất thực tế.
        preferred_plies = max(4, int(getattr(self, 'MIN_PREFERRED_PLIES', 10) or 10))
        low_ply_count = sum(1 for x in positive_plies if x < preferred_plies)
        ply_shortfall = sum(max(0, preferred_plies - x) for x in positive_plies)

        avg_len = (sum(lengths) / len(lengths)) if lengths else 0.0
        avg_span = (sum(spans) / len(spans)) if spans else 0.0
        avg_sizes = (sum(size_counts) / len(size_counts)) if size_counts else 0.0

        # Điểm phù hợp Shade: ưu tiên tổng mét phương án nằm sát ranh giới tích lũy
        # của các Shade được phép dùng, để hạn chế mở dở nhiều Shade.
        lot_penalty = 0.0
        lot_shortage = 0.0
        if fabric is not None:
            try:
                mode = str(fabric.get('lot_mode', 'none') or 'none').lower()
                allowed = []
                if mode == 'selected':
                    allowed = list(self._fabric_lot_names(fabric))
                elif mode == 'all':
                    allowed = [
                        str(r.get('lot', '') or '').strip()
                        for r in (getattr(self, 'global_lot_rows', []) or [])
                        if str(r.get('lot', '') or '').strip()
                    ]

                if allowed:
                    caps = []
                    for r in (getattr(self, 'global_lot_rows', []) or []):
                        name = str(r.get('lot', '') or '').strip()
                        if name in allowed:
                            try:
                                meters = max(0.0, float(r.get('meters', 0) or 0))
                            except Exception:
                                meters = 0.0
                            if meters > 0:
                                caps.append(meters)

                    if caps:
                        cum = 0.0
                        boundaries = []
                        for c in caps:
                            cum += c
                            boundaries.append(cum)
                        lot_shortage = max(0.0, total_meters - cum)
                        if lot_shortage > 0:
                            lot_penalty = lot_shortage * 1000.0
                        else:
                            lot_penalty = min(abs(b - total_meters) for b in boundaries)
            except Exception:
                pass

        return {
            'tables': len(tables),
            'under': under,
            'over': over,
            'abs_diff': abs_diff,
            'min_plies': min_plies,
            'avg_plies': avg_plies,
            'sum_plies': sum(plies),
            'low_ply_count': low_ply_count,
            'ply_shortfall': ply_shortfall,
            'avg_len': avg_len,
            'max_len': max(lengths) if lengths else 0.0,
            'sum_len': sum(lengths),
            'avg_span': avg_span,
            'avg_sizes': avg_sizes,
            'tail_plies': tail_plies,
            'tail_ratio': tail_ratio,
            'tail_length': tail_length,
            'tail_sizes': tail_sizes,
            'total_meters': total_meters,
            'lot_penalty': lot_penalty,
            'lot_shortage': lot_shortage,
        }

    def _optimizer_candidate_score(self, mode, metrics, resolved_mode='main'):
        """V154: mỗi kiểu tối ưu có thứ tự ưu tiên riêng."""
        m = metrics
        # Mọi chiến lược đều đặt thiếu sản lượng lên đầu; không vì tối ưu hình thức mà cắt thiếu.
        common = (m['under'],)

        if mode == 'few_tables':
            return common + (
                m['tables'], m['over'], m['abs_diff'],
                m['tail_ratio'], m['tail_length'],
                -m['avg_plies'], -m['avg_len']
            )

        if mode == 'high_plies':
            return common + (
                m['over'],
                -m['min_plies'], -m['avg_plies'], -m['sum_plies'],
                m['tables'], m['tail_length']
            )

        if mode == 'long_marker':
            return common + (
                m['over'],
                -m['avg_len'], -m['max_len'], -m['sum_len'],
                m['tables'], -m['avg_sizes']
            )

        if mode == 'size_mix':
            return common + (
                m['over'],
                -m['avg_span'], -m['avg_sizes'],
                m['tables'], m['tail_ratio'], m['tail_length']
            )

        if mode == 'balance':
            return common + (
                m['over'], m['abs_diff'],
                m['tables'], m['tail_ratio'], m['tail_length']
            )

        if mode == 'tail_opt':
            return common + (
                m['over'],
                m['tail_ratio'], m['tail_length'], m['tail_sizes'],
                m['tables'], -m['avg_plies']
            )

        if mode == 'lot_opt':
            # Cơ cấu tỉ lệ bàn không phụ thuộc tồn mét hay Shade.
            # Shade chỉ được phân bổ sau khi đã chốt các bàn cắt.
            return common + (
                m['over'], m['abs_diff'],
                m['tables'], m['tail_ratio'], m['tail_length'],
                -m['avg_plies'], -m['avg_span']
            )

        if mode == 'accurate':
            return common + (
                m['over'], m['abs_diff'],
                m['tables'], m['tail_ratio'], m['tail_length'],
                -m['avg_plies'], -m['avg_span'], -m['avg_len']
            )

        if mode == 'production':
            # TỐI ƯU SẢN XUẤT:
            # không thiếu -> ít bàn -> hạn chế bàn ít lá -> dương thấp
            # -> ghép cỡ hợp lý -> lá cao -> bàn cuối gọn -> sơ đồ chính dài.
            return common + (
                m['tables'],
                m['low_ply_count'], m['ply_shortfall'],
                m['over'], m['abs_diff'],
                -m['avg_span'], -m['avg_sizes'],
                -m['avg_plies'],
                m['tail_ratio'], m['tail_length'], m['tail_sizes'],
                -m['avg_len']
            )

        # AUTO SMART: thay thứ tự ưu tiên theo loại vật tư.
        if mode == 'smart':
            if resolved_mode in ('interlining', 'padding'):
                return common + (
                    m['over'], m['abs_diff'],
                    m['tables'], m['tail_ratio'], m['tail_length'],
                    -m['avg_sizes']
                )
            if resolved_mode == 'interlayer':
                return common + (
                    m['tables'], m['over'],
                    -m['avg_plies'], -m['avg_len'],
                    m['tail_length']
                )
            if resolved_mode == 'lining':
                return common + (
                    m['tables'], m['over'],
                    -m['avg_len'], -m['avg_span'],
                    m['tail_length']
                )
            return common + (
                m['tables'], m['over'],
                -m['avg_span'], -m['avg_plies'],
                m['tail_ratio'], m['tail_length']
            )

        # fallback "chính xác" an toàn.
        return common + (
            m['over'], m['tables'],
            m['tail_ratio'], m['tail_length'],
            -m['avg_plies']
        )

    def _run_optimizer_strategy(
        self, optimizer_mode, total_by_size, size_factor, norm,
        max_len, max_products, resolved_mode, min_len, balance_pct,
        fabric=None, fixed_table_count=0, even_ratio=False
    ):
        """V154: bộ điều phối 13 kiểu tối ưu.

        Hai thuật toán nền TOÀN CỤC/TUẦN TỰ được giữ nguyên.
        11 kiểu mới thay đổi cách chọn phương án và cách ưu tiên sản xuất.
        """
        mode = self._optimizer_mode_key_from_label(optimizer_mode)
        try:
            fixed_table_count = max(0, min(6, int(fixed_table_count or 0)))
        except Exception:
            fixed_table_count = 0

        def run_global():
            return self.optimize_cutting_global(
                dict(total_by_size), size_factor, norm, max_len,
                max_products, resolved_mode, min_len, balance_pct,
                fixed_table_count=fixed_table_count, even_ratio=even_ratio
            )

        def run_sequential():
            return self.optimize_cutting(
                dict(total_by_size), size_factor, norm, max_len,
                max_products, resolved_mode, min_len, balance_pct, even_ratio=even_ratio
            )

        if fixed_table_count > 0:
            tables, info = run_global()
            if isinstance(info, dict):
                info = dict(info); info['optimizer_strategy'] = mode
            return tables, info

        if mode == 'global':
            tables, info = run_global()
            if isinstance(info, dict):
                info = dict(info); info['optimizer_strategy'] = mode
            return tables, info

        if mode in ('sequential', 'fast'):
            tables, info = run_sequential()
            if isinstance(info, dict):
                info = dict(info); info['optimizer_strategy'] = mode
            return tables, info

        # Các mode còn lại thử nhiều phương án rồi chấm điểm theo mục tiêu.
        candidates = []
        errors = []
        runners = [('global', run_global), ('sequential', run_sequential)]

        # V155: TỐI ƯU SẢN XUẤT sinh thêm cấu trúc bàn khác thực sự.
        if mode == 'production':
            if max_len and float(max_len) > 0:
                for factor in (0.90, 0.80):
                    alt_max = float(max_len) * factor
                    if alt_max + 1e-9 < float(min_len or 0):
                        continue

                    def _g(alt=alt_max):
                        return self.optimize_cutting_global(
                            dict(total_by_size), size_factor, norm, alt,
                            max_products, resolved_mode, min_len, balance_pct
                        )

                    def _s(alt=alt_max):
                        return self.optimize_cutting(
                            dict(total_by_size), size_factor, norm, alt,
                            max_products, resolved_mode, min_len, balance_pct
                        )

                    runners.append((f'global_{factor:.0%}', _g))
                    runners.append((f'sequential_{factor:.0%}', _s))

            elif max_products and int(max_products) > 2:
                alt_products = max(2, int(round(int(max_products) * 0.85)))
                if alt_products < int(max_products):
                    def _gp(mp=alt_products):
                        return self.optimize_cutting_global(
                            dict(total_by_size), size_factor, norm, max_len,
                            mp, resolved_mode, min_len, balance_pct
                        )

                    def _sp(mp=alt_products):
                        return self.optimize_cutting(
                            dict(total_by_size), size_factor, norm, max_len,
                            mp, resolved_mode, min_len, balance_pct
                        )

                    runners.append((f'global_{alt_products}sp', _gp))
                    runners.append((f'sequential_{alt_products}sp', _sp))

        for engine_name, runner in runners:
            try:
                tables, info = runner()
                if tables is not None:
                    if even_ratio and any(
                        any(int(v or 0) > 0 and int(v or 0) != 1 and int(v or 0) % 2
                            for v in (tb.get('ratio_map', {}) or {}).values())
                        or (lambda total: total > 0 and total != 1 and total % 2)(
                            sum(int(v or 0) for v in (tb.get('ratio_map', {}) or {}).values())
                        ) for tb in tables
                    ):
                        continue
                    metrics = self._optimizer_plan_metrics(
                        tables, info, total_by_size, fabric=fabric
                    )
                    score = self._optimizer_candidate_score(
                        mode, metrics, resolved_mode=resolved_mode
                    )
                    candidates.append((score, engine_name, tables, info, metrics))
            except Exception as e:
                errors.append((engine_name, e))

            try:
                self.root.update_idletasks()
            except Exception:
                pass

        if not candidates:
            if errors:
                raise errors[0][1]
            raise ValueError('Không tìm được phương án tối ưu phù hợp.')

        candidates.sort(key=lambda x: x[0])
        score, engine_name, tables, info, metrics = candidates[0]

        info = dict(info or {})
        info['optimizer_strategy'] = mode
        info['optimizer_engine'] = engine_name
        info['optimizer_metrics'] = metrics
        return tables, info

    def _optimizer_mode_key_from_label(self, value):
        txt = str(value or '').strip().upper()
        for key, label in self.OPTIMIZER_LABELS.items():
            if txt == label.upper() or txt == key.upper():
                return key

        # Quy đổi dự án cũ về ba chế độ mới, không làm lỗi file đã lưu.
        aliases = {
            'GLOBAL': 'smart', 'TOÀN CỤC': 'smart',
            'SEQUENTIAL': 'fast', 'TUẦN TỰ': 'fast',
            'FAST': 'fast', 'NHANH': 'fast',
            'PRODUCTION': 'production', 'TỐI ƯU SẢN XUẤT': 'production',
            'FEW_TABLES': 'production', 'ÍT BÀN NHẤT': 'production', 'ÍT BÀN': 'production',
            'HIGH_PLIES': 'production', 'LÁ CAO NHẤT': 'production', 'LÁ CAO': 'production',
            'LONG_MARKER': 'smart', 'SƠ ĐỒ DÀI NHẤT': 'smart', 'SƠ ĐỒ DÀI': 'smart',
            'SIZE_MIX': 'smart', 'GHÉP CỠ TỐI ƯU': 'smart', 'GHÉP CỠ': 'smart',
            'BALANCE': 'smart', 'CÂN ÂM / DƯƠNG': 'smart', 'CÂN DƯƠNG': 'smart',
            'TAIL_OPT': 'smart', 'BÀN CUỐI TỐI ƯU': 'smart', 'BÀN CUỐI': 'smart',
            'LOT_OPT': 'smart', 'TỐI ƯU THEO Shade': 'smart', 'THEO Shade': 'smart',
            'ACCURATE': 'smart', 'CHÍNH XÁC CAO': 'smart',
            'SMART': 'smart', 'TỰ ĐỘNG THÔNG MINH': 'smart',
            'TỰ ĐỘNG THEO LOẠI VẢI': 'smart', 'AUTO': 'smart',
            'SẢN XUẤT': 'production', 'TOI UU SAN XUAT': 'production',
