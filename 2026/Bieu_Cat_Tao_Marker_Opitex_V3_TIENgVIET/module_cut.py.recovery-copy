    def refresh_size_ui(self):
        """Ve lai o ten size va o nhap so luong theo danh sach size hien tai."""
        # Luu lai du lieu dang nhap truoc khi ve lai giao dien.
        old_po = ''
        old_color = ''
        if hasattr(self, 'entry_po'):
            try:
                old_po = self.entry_po.get()
            except tk.TclError:
                old_po = ''
        if hasattr(self, 'entry_po_color'):
            try:
                old_color = self.entry_po_color.get()
            except tk.TclError:
                old_color = ''
        old_qty = {}
        if hasattr(self, 'size_entries'):
            for key, entry in self.size_entries.items():
                try:
                    old_qty[key] = entry.get()
                except tk.TclError:
                    old_qty[key] = ''

        # Commit % đang nhập trước khi vẽ lại giao diện size.
        try:
            self._sync_size_percent_from_ui(silent=True)
        except Exception:
            pass

        if hasattr(self, 'size_name_frame'):
            for widget in self.size_name_frame.winfo_children():
                widget.destroy()
        if hasattr(self, 'size_percent_frame'):
            for widget in self.size_percent_frame.winfo_children():
                widget.destroy()
        if hasattr(self, 'qty_frame'):
            for widget in self.qty_frame.winfo_children():
                widget.destroy()

        self.size_name_entries = {}
        self.size_percent_entries = {}
        self.size_entries = {}
        self.size_labels = {}

        # Ten size: moi size co 1 o Entry. Sua xong roi khoi o se cap nhat ngay.
        for i, size in enumerate(self.sizes):
            key = size['key']
            col = (i % 6) * 2
            row = i // 6
            tk.Label(self.size_name_frame, text=f"Size {i+1}:",
                     font=('Arial', 9, 'bold')).grid(row=row, column=col, padx=3, pady=3, sticky='e')
            entry = tk.Entry(self.size_name_frame, width=9, font=('Arial', 9))
            entry.insert(0, size['name'])
            entry.grid(row=row, column=col + 1, padx=3, pady=3, sticky='w')
            tk.Button(self.size_name_frame, text='Xóa', command=lambda k=key: self.delete_size(k),
                      font=('Arial', 8, 'bold'), bg='#e74c3c', fg='white',
                      padx=5, pady=1).grid(row=row, column=col + 2, padx=2, pady=3, sticky='w')
            entry.bind('<FocusOut>', lambda e, k=key: self.rename_size(k))
            entry.bind('<Return>', lambda e, k=key: self.rename_size(k))
            self.size_name_entries[key] = entry

        add_row = max(0, (len(self.sizes) - 1) // 6) + 1

        # V182: 4 nút nằm CÙNG 1 HÀNG.
        # Bên trái = CỠ NHỎ / đầu danh sách; bên phải = CỠ LỚN / cuối danh sách.
