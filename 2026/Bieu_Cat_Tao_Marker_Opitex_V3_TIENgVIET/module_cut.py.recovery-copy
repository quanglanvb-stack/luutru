        t.alignment = Alignment(horizontal="center", vertical="center")

        info_font = Font(name="Times New Roman", size=11, bold=True)
        info_cells = {
            "E3": f"KHÁCH HÀNG : {data['customer']}",
            "E4": f"MÃ HÀNG : {data['style_code']}",
            "J4": f"MÀU : {data['color']}",
            "O4": f"ĐỢT : {data['batch']}",
            "R4": f"TỔNG SỐ LƯỢNG : {data['total']}",
            "Y4": f"PO : {data['po']}",
            "AC3": f"DATE : {data['date']}",
        }
