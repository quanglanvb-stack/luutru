        ttk.Button(footer,text='Đóng',command=top.destroy).pack(side='right')

    def remove_row(self):
        chosen=self.tree.selection()
        if not chosen:return
        for i in sorted((int(x) for x in chosen),reverse=True): del self.rows[i]
        self.refresh_rows()

