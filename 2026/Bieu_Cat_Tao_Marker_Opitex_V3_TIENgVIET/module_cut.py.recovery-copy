    """Tính định mức vải viền từ chiều dài viền, khổ vải và bản viền."""
    SQRT2 = 1.4142135623730951
    YARDS_PER_METER = 1.0936132983

    def __init__(self, parent, owner):
        super().__init__(parent, bg='#f3f6fa')
        self.owner = owner
