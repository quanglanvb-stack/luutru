        def available_lots():
            fname = source_var.get().strip()
            fabric = next((f for f in fabrics if str(f.get("name", "") or "").strip() == fname), None)
            names = []
            if fabric is not None:
                try:
                    for x in owner._fabric_lot_names(fabric):
                        x = str(x or "").strip()
                        if x and x not in names: names.append(x)
                except Exception:
                    pass
            for gr in getattr(owner, "global_lot_rows", []) or []:
                x = str(gr.get("lot", "") or "").strip()
                if x and x not in names: names.append(x)
            if not names:
                names = ["CHƯA CÓ Shade"]
            return names

        def rebuild_lots(event=None):
            for w in lot_checks_holder.winfo_children(): w.destroy()
            lot_vars.clear()
            names = available_lots()
            lot_all_var.set(True)
            def set_all_lots():
                v = bool(lot_all_var.get())
                for vv in lot_vars.values(): vv.set(v)
            tk.Checkbutton(lot_checks_holder, text="TẤT CẢ Shade", variable=lot_all_var,
                           command=set_all_lots, bg="white", font=("Arial", 9, "bold")).grid(
                               row=0, column=0, columnspan=3, sticky="w")
            for i, name in enumerate(names):
                vv = tk.BooleanVar(value=True)
                lot_vars[name] = vv
                tk.Checkbutton(lot_checks_holder, text=name, variable=vv, bg="white", anchor="w").grid(
                    row=1 + i // 3, column=i % 3, sticky="w", padx=4, pady=2)
        source_combo.bind('<<ComboboxSelected>>', rebuild_lots)
        rebuild_lots()

        def apply_update():
            selected_pos = [n for n, v in po_vars.items() if bool(v.get())]
            selected_lots = [n for n, v in lot_vars.items() if bool(v.get())]
            if not selected_pos:
                messagebox.showwarning("Chưa chọn PO", "Hãy tích ít nhất 1 PO.", parent=top); return
            if not selected_lots:
                messagebox.showwarning("Chưa chọn Shade", "Hãy tích ít nhất 1 Shade.", parent=top); return

            # Cập nhật cỡ trước nhưng giữ số bắt đầu nếu cỡ đã có.
            self.update_sizes_from_main(show_message=False)
            row_by_name = {r.size_var.get().strip().upper(): r for r in self.size_rows}
            size_defs = list(getattr(owner, "sizes", []) or [])
            po_map = {str(p.get("po", "") or "").strip(): p for p in getattr(owner, "po_list", []) or []}

            targets = {}
            for sd in size_defs:
                key = sd.get("key")
                name = str(sd.get("name", key) or key).strip()
                targets[key] = sum(max(0, int((po_map.get(pn) or {}).get(key, 0) or 0)) for pn in selected_pos)

            # Lấy trọng số phân Shade thực tế của loại vải nguồn (nếu có).
            weights = {sd.get("key"): {lot: 0 for lot in selected_lots} for sd in size_defs}
            source_name = source_var.get().strip()
            if source_name:
                try:
                    results, err = owner.calculate_cutting_plan()
                    if not err:
                        res = next((r for r in (results or [])
                                    if str(r.get("fabric", {}).get("name", "") or "").strip() == source_name), None)
                        if res:
                            for tb in (res.get("preview_tables") or res.get("cutting_tables") or []):
                                lot = str(tb.get("lot", "") or "").strip() or "CHƯA CÓ SHADE"
                                if lot not in selected_lots:
                                    continue
                                for key, qty in (tb.get("sizes", {}) or {}).items():
                                    if key in weights:
                                        weights[key][lot] = weights[key].get(lot, 0) + max(0, int(qty or 0))
                except Exception:
                    pass

            for sd in size_defs:
                key = sd.get("key")
                name = str(sd.get("name", key) or key).strip()
                row = row_by_name.get(name.upper())
                if row is None:
                    continue
                allocation = self._distribute_integer_total(targets.get(key, 0), selected_lots, weights.get(key, {}))
                self._set_row_lights(row, [(lot, allocation.get(lot, 0)) for lot in selected_lots])

            self.po.set(" + ".join(selected_pos))
            msg = f"Đã cập nhật SL của {len(selected_pos)} PO | {len(selected_lots)} Shade"
            if hasattr(self, "update_status_var"):
                self.update_status_var.set(msg)
            try: top.destroy()
            except Exception: pass
            messagebox.showinfo("Cập nhật hoàn tất", msg, parent=self.winfo_toplevel())

