    def refresh_lot_table(self):
        if not hasattr(self, 'lot_tree'):
            return
        for item in self.lot_tree.get_children():
            self.lot_tree.delete(item)
        idx = self._lot_target_fabric_index()
        if idx is None:
            return
        for lot in self.fabric_list[idx].get('lots', []) or []:
            try:
                meters = float(lot.get('meters', 0) or 0)
            except (TypeError, ValueError):
                meters = 0.0
            meters_text = f"{meters:.2f}" if meters > 0 else ''
            self.lot_tree.insert('', 'end', values=(lot.get('name', ''), meters_text))

    def add_lot(self):
        # Shade chỉ được thêm vào đúng loại vải đang chọn trong combobox Shade.
        idx = self._lot_target_fabric_index()
        if idx is None:
            messagebox.showwarning("Cảnh báo", "Hãy chọn 'Loại vải áp dụng Shade' trước khi thêm Shade!")
            return
        name = self.entry_lot_name.get().strip()
        if not name:
            messagebox.showwarning("Cảnh báo", "Vui lòng nhập tên Shade!")
            return
        meters_text = self.entry_lot_meters.get().strip().replace(',', '.')
        if meters_text:
            try:
                meters = float(meters_text)
            except ValueError:
                messagebox.showerror("Lỗi", "Số mét vải phải là số hoặc để trống!")
                return
            if meters < 0:
                messagebox.showwarning("Cảnh báo", "Số mét vải không được âm!")
                return
        else:
            meters = 0.0

        fabric = self.fabric_list[idx]
        # setdefault ở chính fabric, tuyệt đối không copy sang fabric khác.
        fabric.setdefault('lots', []).append({'name': name, 'meters': meters})
        self.entry_lot_name.delete(0, tk.END)
        self.entry_lot_meters.delete(0, tk.END)
        self.update_fabric_table(select_index=idx)
        if meters > 0:
            self.status_var.set(f"Đã thêm Shade {name}: {meters:.2f} m CHỈ cho {fabric['name']}")
        else:
            self.status_var.set(f"Đã thêm Shade {name} cho {fabric['name']} | chưa nhập số mét")

    def delete_lot(self):
