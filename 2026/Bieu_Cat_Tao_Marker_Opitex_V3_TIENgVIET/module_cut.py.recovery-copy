                if yards <= 0 and meters > 0:
                    yards = meters / self.YARD_TO_METER
                # Cột: LOẠI VẢI | MARK | Shade | CÂY | SỐ Y | SỐ MÉT | TRẠNG THÁI | GHI CHÚ
                # V58: mặc định LOẠI VẢI theo TỪNG CÂY, không lấy tên chung của cả Shade.
                _rfmap = block.get('roll_fabric_map', {}) or {}
