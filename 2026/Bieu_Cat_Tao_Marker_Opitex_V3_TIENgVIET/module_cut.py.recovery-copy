    def _get_main_owner(self):
        owner = getattr(self, "owner", None)
        if owner is None:
            raise ValueError("Không tìm thấy dữ liệu ở menu BIỂU CẮT.")
        try:
            if hasattr(owner, "_sync_po_grid_from_ui"):
                owner._sync_po_grid_from_ui()
        except Exception:
            pass
        return owner

    def update_common_from_main(self, show_message=True):
        """V96: chỉ cập nhật THÔNG TIN CHUNG, không thay cỡ / số lượng / Shade."""
        try:
            owner = self._get_main_owner()
            self.apply_initial_info(owner._collect_aux_initial_info(), overwrite=True)
            msg = "Đã cập nhật THÔNG TIN CHUNG từ BIỂU CẮT"
            if hasattr(self, "update_status_var"):
                self.update_status_var.set(msg)
            if show_message:
                messagebox.showinfo("Cập nhật", msg, parent=self.winfo_toplevel())
        except Exception as e:
            messagebox.showerror("Lỗi cập nhật", str(e), parent=self.winfo_toplevel())

    def update_sizes_from_main(self, show_message=True):
        """V96: cập nhật danh sách CỠ; giữ nguyên SỐ BẮT ĐẦU và SL/Shade của cỡ trùng tên."""
        try:
            owner = self._get_main_owner()
            main_sizes = list(getattr(owner, "sizes", []) or [])
            if not main_sizes:
                raise ValueError("Menu BIỂU CẮT chưa có danh sách cỡ.")

            old = {}
            for row in self.size_rows:
                try:
                    name = row.size_var.get().strip()
                    if not name:
                        continue
                    old[name.upper()] = {
                        "start": row.start_var.get().strip(),
                        "lights": [
                            {
                                "qty": h["qty_var"].get().strip(),
                                "light": h["light_var"].get().strip(),
                            }
                            for h in row.light_rows
                        ],
                    }
                except Exception:
                    pass

            for row in list(self.size_rows):
                row.destroy()
            self.size_rows.clear()

            for i, sd in enumerate(main_sizes):
                name = str(sd.get("name", sd.get("key", "")) or "").strip()
                row = self.add_size_row()
                row.size_var.set(name)
                prev = old.get(name.upper())
                if prev:
                    lights = prev.get("lights", []) or []
                    if lights:
                        first = lights[0]
                        row.set_first_light(first.get("qty", ""), first.get("light", ""))
                        for extra in lights[1:]:
                            h = row.add_light_row(first=False)
                            h["qty_var"].set(str(extra.get("qty", "") or ""))
                            h["light_var"].set(str(extra.get("light", "") or ""))
                    row.start_var.set(prev.get("start", ""))
                else:
                    row.set_first_light("", "")
                    row.start_var.set("1" if i == 0 else "")

            self._regrid_rows()
            msg = f"Đã cập nhật {len(main_sizes)} cỡ từ BIỂU CẮT"
            if hasattr(self, "update_status_var"):
                self.update_status_var.set(msg)
            if show_message:
                messagebox.showinfo("Cập nhật cỡ", msg, parent=self.winfo_toplevel())
        except Exception as e:
            messagebox.showerror("Lỗi cập nhật cỡ", str(e), parent=self.winfo_toplevel())

    @staticmethod
    def _distribute_integer_total(total, ordered_lots, weights):
        """Chia tổng nguyên theo trọng số và giữ đúng tổng bằng phương pháp phần dư lớn nhất."""
        total = max(0, int(total or 0))
        lots = list(ordered_lots or [])
        if not lots:
            return {}
        if len(lots) == 1:
            return {lots[0]: total}
        vals = [max(0, int(weights.get(x, 0) or 0)) for x in lots]
        sw = sum(vals)
        if sw <= 0:
            q, r = divmod(total, len(lots))
            return {lot: q + (1 if i < r else 0) for i, lot in enumerate(lots)}
        exact = [total * v / sw for v in vals]
        base = [int(math.floor(x)) for x in exact]
        remain = total - sum(base)
        order = sorted(range(len(lots)), key=lambda i: (-(exact[i] - base[i]), i))
        for i in order[:remain]:
            base[i] += 1
        return {lot: base[i] for i, lot in enumerate(lots)}

    def _set_row_lights(self, row, lot_qty_pairs):
        pairs = [(str(lot or ""), max(0, int(qty or 0))) for lot, qty in (lot_qty_pairs or [])]
        if not pairs:
            pairs = [("", 0)]
        while len(row.light_rows) > 1:
            row.remove_light_row(row.light_rows[-1])
        row.set_first_light(pairs[0][1], pairs[0][0])
        for lot, qty in pairs[1:]:
            h = row.add_light_row(first=False)
            h["qty_var"].set(str(qty))
            h["light_var"].set(lot)

