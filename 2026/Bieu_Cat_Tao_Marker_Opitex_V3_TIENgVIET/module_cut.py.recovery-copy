    def _paste_po_grid_from_clipboard(self):
        try:
            clip = self.root.clipboard_get()
        except Exception:
            messagebox.showwarning('Cảnh báo', 'Clipboard không có dữ liệu để dán!')
            return
        rows = [r.split('\t') for r in str(clip).replace('\r', '').split('\n') if r != '']
        if not rows:
            return
        r1, c1, r2, c2 = self._po_grid_selection_bounds()
        start_row, start_col = r1, c1
        cols = self._po_grid_columns()

        # Excel-like: một ô clipboard + vùng đang bôi đen => điền cùng giá trị cho cả vùng.
        if len(rows) == 1 and len(rows[0]) == 1 and (r1 != r2 or c1 != c2):
            raw = rows[0][0]
            changed = bad = 0
            for tr in range(r1, r2 + 1):
                for tc in range(c1, c2 + 1):
                    if tc >= len(cols) or cols[tc] == 'total':
                        continue
                    if tr >= len(self.po_list):
                        # Chỉ có thể tạo dòng mới khi đang điền cột SỐ PO.
                        if tc != 0 or not str(raw).strip():
                            bad += 1; continue
                        name = str(raw).strip()
                        if any(str(x.get('po','')).strip() == name for x in self.po_list):
                            bad += 1; continue
                        row = {'po': name, 'color': '', 'apply_increase': False}
                        for sz in self.sizes:
                            row[sz['key']] = 0
                        row['total'] = 0
                        self.po_list.append(row); changed += 1
                    elif self._po_cell_set_value(tr, cols[tc], raw, show_error=False):
                        changed += 1
                    else:
                        bad += 1
            self.update_po_table(); self.update_summary(); self._refresh_fabric_po_selector()
            if self.fabric_list:
                self._sync_global_lots(); self.update_fabric_table()
            self.status_var.set(f'Dán vào vùng chọn: cập nhật {changed} ô, lỗi/bỏ qua {bad}')
            return
        # Nếu dán cả tiêu đề bắt đầu từ cột PO thì bỏ dòng tiêu đề.
        if start_col == 0 and rows and str(rows[0][0]).strip().upper() in ('PO','SỐ PO','SO PO','SỐ PO:'):
            rows = rows[1:]
        if not rows:
            return

        changed = 0
        bad = 0
        for dr, vals in enumerate(rows):
            tr = start_row + dr
            # Nếu vượt số dòng hiện tại thì chỉ tạo dòng mới khi vùng dán có cột SỐ PO.
            if tr >= len(self.po_list):
                po_value = ''
                if start_col == 0 and vals:
                    po_value = str(vals[0]).strip()
                if not po_value:
                    bad += 1
                    continue
                new = {'po': po_value, 'color': '', 'apply_increase': False}
                for s in self.sizes:
                    new[s['key']] = 0
                new['total'] = 0
                # Không thêm PO trùng.
                if any(str(x.get('po','')).strip() == po_value for x in self.po_list):
                    bad += 1
                    continue
                self.po_list.append(new)
            for dc, raw in enumerate(vals):
                tc = start_col + dc
                if tc >= len(cols):
                    break
                key = cols[tc]
                if key == 'total':
                    continue
                if self._po_cell_set_value(tr, key, raw, show_error=False):
                    changed += 1
                else:
                    bad += 1

        self.update_po_table()
        self.update_summary()
        self._refresh_fabric_po_selector()
        if self.fabric_list:
            self._sync_global_lots()
            self.update_fabric_table()
        self.status_var.set(f'Dán từ ô đã chọn: cập nhật {changed} ô, lỗi/bỏ qua {bad}')
        if bad:
            messagebox.showwarning('Dán PO', f'Có {bad} ô/dòng không hợp lệ hoặc bị bỏ qua.')

    # ==================== V56: SỬA / DÁN TRỰC TIẾP PO + LOẠI VẢI ====================
    def _begin_tree_cell_edit(self, tree, item, column_key, on_commit):
        """Đặt một Entry đúng lên ô Treeview để sửa trực tiếp."""
        try:
            bbox = tree.bbox(item, column_key)
        except Exception:
            bbox = ()
        if not bbox:
            return
        x, y, w, h = bbox
        old_value = tree.set(item, column_key)
        editor = tk.Entry(tree, font=('Arial', 10), justify='center')
        editor.insert(0, old_value)
        editor.select_range(0, tk.END)
        editor.place(x=x, y=y, width=max(40, w), height=max(22, h))
        editor.focus_set()
        finished = {'done': False}

        def commit(event=None):
            if finished['done']:
                return
            finished['done'] = True
            value = editor.get().strip()
            editor.destroy()
            on_commit(value)

        def cancel(event=None):
            if finished['done']:
                return
            finished['done'] = True
            editor.destroy()

        editor.bind('<Return>', commit)
        editor.bind('<FocusOut>', commit)
        editor.bind('<Escape>', cancel)

    def _on_po_tree_double_click(self, event):
        if not hasattr(self, 'po_tree'):
            return
        item = self.po_tree.identify_row(event.y)
        col_id = self.po_tree.identify_column(event.x)
        if not item or not col_id or not col_id.startswith('#'):
            return
        try:
            col_index = int(col_id[1:]) - 1
            columns = list(self.po_tree['columns'])
            col_key = columns[col_index]
            row_index = self.po_tree.index(item)
        except Exception:
            return
        if col_key == 'total' or not (0 <= row_index < len(self.po_list)):
            return

        def save(value):
            po = self.po_list[row_index]
            if col_key == 'po':
                new_name = value.strip()
                if not new_name:
                    messagebox.showwarning('Cảnh báo', 'Số PO không được để trống!')
                    return
                old_name = str(po.get('po', '') or '').strip()
                if any(i != row_index and str(x.get('po','')).strip() == new_name
                       for i, x in enumerate(self.po_list)):
                    messagebox.showwarning('Cảnh báo', f'PO {new_name} đã tồn tại!')
                    return
                po['po'] = new_name
                # Đổi tên PO ở mọi loại vải đang chọn PO riêng.
                for fabric in self.fabric_list:
                    if str(fabric.get('po_mode','all')).lower() != 'all':
                        fabric['po_targets'] = [new_name if str(x) == old_name else x
                                                for x in (fabric.get('po_targets', []) or [])]
                        fabric['roll_po_targets'] = [new_name if str(x) == old_name else x
                                                     for x in (fabric.get('roll_po_targets', []) or [])]
            elif col_key == 'color':
                po['color'] = value.strip()
            else:
                try:
                    qty = int(float(value.replace(',', '.'))) if value else 0
                except Exception:
                    messagebox.showerror('Lỗi', 'Số lượng PO phải là số nguyên!')
                    return
                if qty < 0:
                    messagebox.showerror('Lỗi', 'Số lượng PO không được âm!')
                    return
                po[col_key] = qty
            po['total'] = sum(int(po.get(sz['key'], 0) or 0) for sz in self.sizes)
            self.update_po_table()
            self.update_summary()
            self._refresh_fabric_po_selector()
            if self.fabric_list:
                self._sync_global_lots()
                self.update_fabric_table()
            self.status_var.set('Đã sửa trực tiếp danh sách PO')

        self._begin_tree_cell_edit(self.po_tree, item, col_key, save)

    def paste_po_from_clipboard(self):
        """V26: dán từ clipboard bắt đầu đúng ô PO đang chọn."""
        if hasattr(self, 'po_grid_inner'):
            return self._paste_po_grid_from_clipboard()
        # Fallback cho giao diện Treeview cũ.
        try:
            clip = self.root.clipboard_get()
        except Exception:
            messagebox.showwarning('Cảnh báo', 'Clipboard không có dữ liệu để dán!')
            return
        rows = [r for r in str(clip).replace('\r','').split('\n') if r.strip()]
        if not rows:
            return
        parsed = [r.split('\t') for r in rows]
        if parsed and str(parsed[0][0]).strip().upper() in ('PO', 'SỐ PO', 'SO PO', 'SỐ PO:'):
            parsed = parsed[1:]
        size_keys = [s['key'] for s in self.sizes]
        added = updated = bad = 0
        for vals in parsed:
            if not vals:
                continue
            po_name = str(vals[0]).strip()
            if not po_name:
                continue
            color = str(vals[1]).strip() if len(vals) > 1 else ''
            qtys = {}
            ok = True
            for i, key in enumerate(size_keys):
                raw = str(vals[i+2]).strip() if i+2 < len(vals) else '0'
                try:
                    q = int(float(raw.replace(',', '.'))) if raw else 0
                except Exception:
                    ok = False; break
                if q < 0:
                    ok = False; break
                qtys[key] = q
            if not ok:
                bad += 1
                continue
            existing = next((x for x in self.po_list if str(x.get('po','')).strip() == po_name), None)
            if existing is None:
                existing = {'po': po_name, 'color': color, 'apply_increase': False}
                self.po_list.append(existing)
                added += 1
            else:
                updated += 1
            existing['color'] = color
            for key, q in qtys.items():
                existing[key] = q
            existing['total'] = sum(qtys.values())
        self.update_po_table(); self.update_summary(); self._refresh_fabric_po_selector()
        if self.fabric_list:
            self._sync_global_lots(); self.update_fabric_table()
        self.status_var.set(f'Dán PO: thêm {added}, cập nhật {updated}, lỗi {bad}')
        if bad:
            messagebox.showwarning('Dán PO', f'Có {bad} dòng không hợp lệ và đã được bỏ qua.')

    @staticmethod
    def _split_selection_text(value):
        return [x.strip() for x in re.split(r'[,+;|]+', str(value or '')) if x.strip()]

    def _parse_fabric_po_text(self, value):
        txt = str(value or '').strip()
        up = txt.upper()
        if not txt or up in ('TẤT CẢ PO', 'TAT CA PO', 'ALL', 'ALL PO', '*'):
            return 'all', []
        names = self._split_selection_text(txt)
        known = {str(x.get('po','')).strip() for x in self.po_list}
        unknown = [x for x in names if x not in known]
        if unknown:
            raise ValueError('PO không tồn tại: ' + ', '.join(unknown))
        return 'selected', names

    def _parse_fabric_lot_text(self, value):
        txt = str(value or '').strip()
        up = txt.upper()
        if not txt or up in ('KHÔNG DÙNG SHADE', 'KHONG DUNG SHADE', 'KHÔNG DÙNG LOT', 'KHONG DUNG LOT', 'NONE', 'NO SHADE', 'NO LOT', '-'):
            return 'none', []
        if up in ('TẤT CẢ SHADE', 'TAT CA SHADE', 'TẤT CẢ LOT', 'TAT CA LOT', 'ALL', 'ALL SHADE', 'ALL LOT', '*'):
            return 'all', []
        names = self._split_selection_text(txt)
        known = {str(x.get('lot','')).strip() for x in getattr(self, 'global_lot_rows', []) or []}
        unknown = [x for x in names if x not in known]
        if unknown:
            raise ValueError('Shade không tồn tại trong kho: ' + ', '.join(unknown))
        return 'selected', names

    @staticmethod
    def _parse_yes_no(value, default=True):
        txt = str(value or '').strip().upper()
        if not txt:
            return bool(default)
        if txt in ('CÓ','CO','YES','Y','1','TRUE','X'):
            return True
        if txt in ('KHÔNG','KHONG','NO','N','0','FALSE'):
            return False
        raise ValueError('Giá trị CÓ/KHÔNG không hợp lệ: ' + str(value))

    # ==================== V26: DROPDOWN PO / Shade TRONG DANH SÁCH LOẠI VẢI ====================
    def _on_fabric_tree_single_click(self, event):
        if not hasattr(self, 'fabric_tree'):
            return
        item = self.fabric_tree.identify_row(event.y)
        col_id = self.fabric_tree.identify_column(event.x)
        if not item or not col_id or not col_id.startswith('#'):
            return
        try:
            col_index = int(col_id[1:]) - 1
            columns = list(self.fabric_tree['columns'])
            col_key = columns[col_index]
            row_index = self.fabric_tree.index(item)
        except Exception:
            return
        if not (0 <= row_index < len(self.fabric_list)):
            return
        if col_key == 'cut_mode':
            self.root.after(80, lambda: self._open_fabric_mode_popup(row_index, item))
        elif col_key == 'optimizer_mode':
            self.root.after(80, lambda: self._open_optimizer_mode_popup(row_index, item))
        elif col_key in ('po_apply', 'lot_apply'):
            self.root.after(80, lambda: self._open_fabric_select_popup(row_index, col_key, item))
        elif col_key == 'export_roll':
            # V98: Xuất PHÂN CÂY có thêm lựa chọn PO CHỈ ĐỂ HIỂN THỊ TÊN.
            # Số lượng cắt vẫn luôn tính theo PO áp dụng của loại vải, không phụ thuộc lựa chọn này.
            self.root.after(80, lambda: self._open_roll_export_po_popup(row_index, item))
        elif col_key == 'export_edit':
            # SỬA PHÂN CÂY vẫn bật/tắt nhanh như trước.
            now = int(getattr(event, 'time', 0) or 0)
            last = getattr(self, '_fabric_last_check_click', None)
            if last and last[0] == row_index and last[1] == col_key and now - last[2] < 350:
                return
            self._fabric_last_check_click = (row_index, col_key, now)
            fabric = self.fabric_list[row_index]
            fabric[col_key] = not bool(fabric.get(col_key, True))
            self.update_fabric_table(select_index=row_index)
            self.status_var.set(f"{fabric.get('name','')}: SỬA PHÂN CÂY = {'CÓ' if fabric[col_key] else 'KHÔNG'}")

    def _fabric_roll_po_names(self, fabric):
        """V98: PO chỉ dùng để HIỂN THỊ tên trên sheet PHÂN CÂY.

        Không dùng danh sách này để tính số lượng. Số lượng vẫn theo po_mode/po_targets.
        """
        applicable = self._fabric_po_names(fabric)
        saved = [str(x).strip() for x in (fabric.get('roll_po_targets', []) or []) if str(x).strip()]
        # Dự án cũ/chưa từng chọn: mặc định hiện tất cả PO đang áp dụng.
        if not bool(fabric.get('roll_po_selection_set', False)):
            return list(applicable)
        allowed = set(applicable)
        return [x for x in saved if x in allowed]

    def _open_roll_export_po_popup(self, row_index, item=None):
        """V98: chọn CÓ/KHÔNG xuất PHÂN CÂY + PO nào chỉ xuất TÊN."""
        if not (0 <= row_index < len(self.fabric_list)):
            return
        old = getattr(self, '_fabric_select_popup', None)
        if old is not None:
            try:
                if old.winfo_exists(): old.destroy()
            except Exception:
                pass

        fabric = self.fabric_list[row_index]
        applicable = self._fabric_po_names(fabric)
        current_names = self._fabric_roll_po_names(fabric)

        top = tk.Toplevel(self.root)
        self._fabric_select_popup = top
        top.title('Xuất PHÂN CÂY / chọn tên PO')
