def _safe_filename_token(value, fallback=""):
    """Làm sạch một phần tên file để dùng an toàn trên Windows."""
    s = str(value or "").strip()
    # Windows không cho phép các ký tự này trong tên file.
    s = re.sub(r'[<>:"/\\|?*\x00-\x1f]+', '_', s)
    s = re.sub(r'\s+', '_', s)
    s = re.sub(r'_+', '_', s).strip(' ._')
    return s or fallback


def _style_last5(value):
    """Mã hàng khi đặt tên file: ưu tiên lấy đúng 5 chữ số cuối."""
    raw = str(value or "").strip()
    digits = ''.join(ch for ch in raw if ch.isdigit())
    if digits:
        return digits[-5:] if len(digits) >= 5 else digits
    # Mã hàng không có số: fallback 5 ký tự cuối để tên file vẫn có ý nghĩa.
    safe = _safe_filename_token(raw, 'MAHANG')
    return safe[-5:] if len(safe) > 5 else safe


def _suggest_excel_filename(prefix, style_code, batch, extension=".xlsm"):
    """Tạo tên file đúng với định dạng thực tế sẽ xuất.

    BIỂU CẮT dùng .xlsm vì có VBA.
    PHÂN SỐ CẮT / BIỂU 10 dùng .xlsx vì chỉ tạo bằng openpyxl, không có VBA.
    """
    style_part = _style_last5(style_code) or 'MAHANG'
    batch_part = _safe_filename_token(batch, 'DOT')
    prefix_part = str(prefix or '').strip()
    ext = str(extension or ".xlsx").strip()
    if not ext.startswith("."):
        ext = "." + ext
    return f"{prefix_part}_{style_part}_{batch_part}{ext}"


def _convert_xlsx_to_xlsm_with_formula_guard(xlsx_path, xlsm_path):
    # Dùng Microsoft Excel để nhúng VBA thật vào file .xlsm.
    if os.name != 'nt':
        raise RuntimeError('Xuất .xlsm có VBA chỉ hỗ trợ trên Windows có Microsoft Excel.')

    xlsx_path = os.path.abspath(str(xlsx_path))
    xlsm_path = os.path.abspath(str(xlsm_path))

    ps_code = r'''param([string]$InputXlsx, [string]$OutputXlsm)
