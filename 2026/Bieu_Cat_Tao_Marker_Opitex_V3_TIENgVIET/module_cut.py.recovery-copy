        for item in data["sizes"]:
            # Mỗi cỡ có thể có nhiều Shade. Số thứ tự sản phẩm chạy liên tiếp,
            # nhưng Số bàn sẽ đánh lại từ 1 khi sang Shade mới.
            seq = item["start_no"]
            all_rows = []
            for light_index, light in enumerate(item["lights"]):
                tables = split_tables(light["qty"], data["round_qty"], data["last_limit"])
                light_end = seq - 1
                # Mỗi Shade là một nhóm riêng: Số bàn luôn bắt đầu lại từ 1.
                for local_table_no, q in enumerate(tables, start=1):
                    seq_start = seq
                    seq_end = seq + q - 1
                    shade_name = str(light.get("light", "") or "").strip()
                    all_rows.append((q, seq_start, seq_end, shade_name,
                                     manufacturer_lot_for_shade(shade_name), local_table_no))
                    seq = seq_end + 1
                    light_end = seq_end
                # Shade kế tiếp bắt đầu ở mốc chục kế tiếp + 1.
                # Ví dụ Shade A kết thúc 204 -> Shade B bắt đầu 211.
                if light_index < len(item["lights"]) - 1 and light_end >= 0:
                    seq = next_light_start(light_end, 10)

            total_needed = 2 + len(all_rows)
            remaining_capacity = full_block_capacity(cursor_row)
            full_column_capacity = full_block_capacity(page_top)

            # Quy tắc xếp cỡ mới:
            # - Chỉ đặt cỡ tiếp theo xuống dưới cỡ trước khi TOÀN BỘ cỡ đó còn vừa
            #   trong phần chiều cao A4 còn lại (sau 2 dòng trống).
            # - Nếu không vừa thì chuyển cỡ đó sang khối/cột bên cạnh ngay từ đầu.
            # - Với cỡ rất dài hơn 1 cột A4, cũng KHÔNG dùng vài dòng trống còn lại
            #   của cột trước để bắt đầu cỡ mới; cỡ dài sẽ bắt đầu ở đầu cột mới rồi
            #   mới tách phần tiếp sang các cột kế tiếp.
            if cursor_row > page_top and not rows_fit_from(cursor_row, len(all_rows)):
                new_slot()

            pos = 0
            table_no = 1
            first_part = True
            while pos < len(all_rows):
                cap = full_block_capacity(cursor_row)
                if cap <= 0:
                    new_slot()
                    cap = full_block_capacity(cursor_row)

                take = min(cap, len(all_rows) - pos)
                chunk = all_rows[pos:pos + take]
                c0 = starts[slot]
                data_end = draw_block(item, chunk, cursor_row, c0, table_no, continued=not first_part)
                pos += take
                table_no += take
                first_part = False

                if pos < len(all_rows):
                    # Cỡ còn tiếp: đã hết chiều cao A4 -> sang cột bên cạnh.
                    new_slot()
                else:
                    # Cỡ đã xong. Để trống đúng 2 dòng rồi ưu tiên cỡ tiếp theo ở dưới
                    # nếu còn vừa trong cùng cột A4.
                    for rr in range(data_end + 1, data_end + 1 + gap_rows):
                        ws.row_dimensions[rr].height = blank_h
                    cursor_row = data_end + 1 + gap_rows

        # Ngắt trang dọc sau khi dùng hết 4 cột ngang.
        for br in sorted(set(page_break_rows)):
            try:
                ws.row_breaks.append(Break(id=br - 1))
            except Exception:
                pass

        ws.freeze_panes = "A6"
        ws.print_area = f"A1:AF{max(last_used_row, page_bottom)}"
        wb.save(path)




def safe_int(value, default=0):
    try:
        return int(str(value).strip().replace(",", ""))
    except Exception:
        return default


def split_tables(total, round_qty=50, last_limit=75):
    """Chia số lượng theo logic bàn cuối của người dùng."""
    total = max(0, int(total))
    round_qty = max(1, int(round_qty))
    last_limit = max(round_qty, int(last_limit))

    if total <= 0:
        return []
    if total <= round_qty:
        return [total]

    full = total // round_qty
    rem = total % round_qty

    if rem == 0:
        return [round_qty] * full

    candidate_last = round_qty + rem
    if candidate_last <= last_limit:
        # Giữ tổng số bàn = full, dồn phần dư vào bàn cuối
        if full == 1:
            return [candidate_last]
        return [round_qty] * (full - 1) + [candidate_last]

    # Bàn cuối vượt ngưỡng -> tách phần dư thành bàn tiếp theo
    return [round_qty] * full + [rem]


def next_light_start(end_no, step=10):
    """Số bắt đầu Shade kế tiếp: làm tròn lên theo chục rồi +1.
    Ví dụ Shade A kết thúc 204 -> Shade B bắt đầu 211.
    Nếu kết thúc đúng 200 -> Shade kế tiếp bắt đầu 201.
    """
    end_no = int(end_no)
    step = max(1, int(step))
    return int(math.ceil(end_no / step) * step) + 1


def size_end_with_lights(start_no, lights, light_step=10):
    """Tính số kết thúc thực tế của một cỡ, có tính khoảng làm tròn giữa các Shade."""
    seq = int(start_no)
    last_end = seq - 1
    for i, light in enumerate(lights):
        qty = int(light.get("qty", 0))
        if qty <= 0:
            continue
        last_end = seq + qty - 1
        if i < len(lights) - 1:
            seq = next_light_start(last_end, light_step)
    return last_end


class SizeRow:
    def __init__(self, parent, index, on_delete):
        self.frame = ttk.Frame(parent)
        self.index_var = tk.StringVar(value=str(index))
        self.size_var = tk.StringVar(value="")
        self.start_var = tk.StringVar(value="")
        self.on_delete = on_delete
        self.light_rows = []

        # Cột trái dùng chung cho cả cỡ. Dòng Shade đầu tiên nằm cùng hàng với tên cỡ.
        self.lbl_index = ttk.Label(self.frame, textvariable=self.index_var, width=4, anchor="center")
        self.ent_size = ttk.Entry(self.frame, textvariable=self.size_var, width=14, justify="center")
        self.ent_start = ttk.Entry(self.frame, textvariable=self.start_var, width=14, justify="center")
        self.btn_del = tk.Button(
            self.frame, text="Xóa cỡ", width=8, command=lambda: on_delete(self),
            bg="#d9534f", fg="white", activebackground="#c9302c", relief="flat"
        )

        self.lbl_index.grid(row=0, column=0, padx=(2, 4), pady=3, sticky="ew")
        self.ent_size.grid(row=0, column=1, padx=4, pady=3, sticky="ew")
        self.ent_start.grid(row=0, column=5, padx=4, pady=3, sticky="ew")
        self.btn_del.grid(row=0, column=6, padx=(4, 2), pady=3)

        self.frame.columnconfigure(1, weight=1)
        self.frame.columnconfigure(2, weight=1)
        self.frame.columnconfigure(3, weight=1)
        self.frame.columnconfigure(5, weight=1)

        self.add_light_row(first=True)

    def add_light_row(self, first=False):
        row_index = len(self.light_rows)
        qty_var = tk.StringVar(value="")
        light_var = tk.StringVar(value="A" if row_index == 0 else "")

        ent_qty = ttk.Entry(self.frame, textvariable=qty_var, width=14, justify="center")
        ent_light = ttk.Entry(self.frame, textvariable=light_var, width=10, justify="center")
        btn_add = tk.Button(
            self.frame, text="+ Shade", width=7, command=self.add_light_row,
            bg="#5bc0de", fg="white", activebackground="#31b0d5", relief="flat"
        )
        btn_remove = None
        if not first:
            btn_remove = tk.Button(
                self.frame, text="−", width=3,
                command=lambda: self.remove_light_row(holder),
                bg="#f0ad4e", fg="white", activebackground="#ec971f", relief="flat"
            )

        holder = {
            "qty_var": qty_var, "light_var": light_var,
            "ent_qty": ent_qty, "ent_light": ent_light,
            "btn_add": btn_add, "btn_remove": btn_remove
        }
        self.light_rows.append(holder)
        self._regrid_light_rows()
        return holder

    def remove_light_row(self, holder):
        if holder not in self.light_rows or len(self.light_rows) <= 1:
            return
        for key in ("ent_qty", "ent_light", "btn_add", "btn_remove"):
            w = holder.get(key)
            if w is not None:
                w.destroy()
        self.light_rows.remove(holder)
        self._regrid_light_rows()

    def _regrid_light_rows(self):
        for i, holder in enumerate(self.light_rows):
            r = i
            holder["ent_qty"].grid(row=r, column=2, padx=4, pady=3, sticky="ew")
            holder["ent_light"].grid(row=r, column=3, padx=4, pady=3, sticky="ew")
            # Chỉ hiện nút + Shade trên dòng Shade cuối cùng để giao diện gọn hơn.
            holder["btn_add"].grid_forget()
            if holder.get("btn_remove") is not None:
                holder["btn_remove"].grid(row=r, column=4, padx=(0, 2), pady=3, sticky="w")
        if self.light_rows:
            last = self.light_rows[-1]
            last["btn_add"].grid(row=len(self.light_rows)-1, column=4, padx=(0, 2), pady=3, sticky="e")

        # Tên cỡ / số bắt đầu / nút xóa luôn nằm ở dòng đầu.
        self.lbl_index.grid(row=0, column=0, padx=(2, 4), pady=3, sticky="ew")
        self.ent_size.grid(row=0, column=1, padx=4, pady=3, sticky="ew")
        self.ent_start.grid(row=0, column=5, padx=4, pady=3, sticky="ew")
        self.btn_del.grid(row=0, column=6, padx=(4, 2), pady=3)

    def set_first_light(self, qty, light="A"):
        if not self.light_rows:
            self.add_light_row(first=True)
        self.light_rows[0]["qty_var"].set(str(qty))
        self.light_rows[0]["light_var"].set(str(light))

    def grid(self, row):
        self.frame.grid(row=row, column=0, sticky="ew")

    def destroy(self):
        self.frame.destroy()

    def get(self):
        lights = []
        for holder in self.light_rows:
            qty_text = holder["qty_var"].get().strip()
            light_text = holder["light_var"].get().strip()
            qty = safe_int(qty_text, 0)
            if not qty_text and not light_text:
                continue
            lights.append({
                "qty": qty,
                "light": light_text,
            })
        return {
            "size": self.size_var.get().strip(),
            "lights": lights,
            "qty": sum(x["qty"] for x in lights),
            "start_no": safe_int(self.start_var.get(), 0),
        }


