    def export_excel(self):
        # V107: hỏi nơi lưu trước; chỉ khi người dùng xác nhận mới chạy tối ưu nặng.
        filename = filedialog.asksaveasfilename(
            defaultextension=".xlsm",
            filetypes=[("Excel Macro-Enabled Workbook", "*.xlsm"), ("All files", "*.*")],
            initialfile=_suggest_excel_filename("BIỂU CẮT", self.entry_style.get(), self.entry_batch.get())
        )
        if not filename:
            return

        self._export_progress_begin()
        self._export_progress(3, 'Đang chuẩn bị dữ liệu')

        try:
            results, error = self.calculate_cutting_plan()
            if error:
                self._export_progress_end(success=False)
                messagebox.showerror("Lỗi", error)
                return

            self._export_progress(60, 'Đang tạo file Excel')
            self.generate_excel(filename, results)
            self._export_progress(97, 'Đang lưu dự án')

            # V38: luôn lưu một file dự án cùng tên với Excel để có thể mở lại và sửa tiếp.
            project_filename = os.path.splitext(filename)[0] + '.cutplan'
            saved_project = self.save_project(project_filename, silent=True)
            self._export_progress(100, 'Hoàn tất xuất Excel')
            self.export_status.config(text=f"✓ Đã xuất: {os.path.basename(filename)}", fg='#27ae60')

            if saved_project:
                self.status_var.set(f"Đã xuất Excel + dự án: {filename}")
                self._export_progress_end(success=True)
                messagebox.showinfo(
                    "Thành công",
                    f"Đã xuất Excel và lưu bộ nhớ dự án!\n\n"
                    f"Excel: {filename}\n"
                    f"Dự án: {saved_project}\n\n"
                    "Lần sau bấm MỞ DỰ ÁN và chọn file .cutplan để chỉnh sửa tiếp."
                )
            else:
                self.status_var.set(f"Đã xuất Excel nhưng lỗi lưu dự án: {filename}")
                self._export_progress_end(success=True)
                messagebox.showwarning(
                    "Đã xuất Excel",
                    f"Excel đã xuất thành công:\n{filename}\n\n"
                    f"Nhưng không lưu được file dự án .cutplan:\n{self._last_project_error}"
                )
        except Exception as e:
            self._export_progress_end(success=False)
            messagebox.showerror("Lỗi", f"Không thể xuất file: {str(e)}")

