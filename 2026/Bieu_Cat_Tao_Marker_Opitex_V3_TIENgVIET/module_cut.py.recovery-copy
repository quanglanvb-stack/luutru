        source_frame.pack(fill="x", padx=18, pady=(10, 8))
        tk.Label(source_frame, text="Loại vải nguồn:", font=("Arial", 10, "bold"), bg="white").pack(side="left", padx=10, pady=8)
        source_var = tk.StringVar(value="")
        source_combo = ttk.Combobox(source_frame, textvariable=source_var, values=fabric_names,
