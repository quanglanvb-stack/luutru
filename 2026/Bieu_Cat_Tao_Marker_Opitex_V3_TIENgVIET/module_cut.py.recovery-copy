        MAX_DYNAMIC_LOTS = 50
        # V65: mỗi Shade có vùng cây riêng. Tổng vùng nguồn của một loại vải phải đủ
        # chứa toàn bộ Shade để khi đổi Shade từ CHƯA GÁN sang một loại vải trong Excel,
        # BIỂU CẮT/PHÂN CÂY vẫn nhận đủ cây.
        # V85: số dòng công thức không còn cố định 100 cây/Shade + 3 dòng dư.
        # Chỉ chừa đúng số cây thực tế lớn nhất + số dòng dư người dùng chọn trước khi xuất.
        requested_extra_rows = self._get_extra_surplus_rows(silent=True)
        _max_existing_roll_rows = 0
        for _g in (getattr(self, 'global_lot_rows', []) or []):
            if not str(_g.get('lot','') or '').strip():
                continue
            try:
                _max_existing_roll_rows = max(_max_existing_roll_rows, len(self._ensure_lot_roll_details(_g) or []))
            except Exception:
                pass
        if _max_existing_roll_rows <= 0:
            _count_by_lot = {}
            for _f in self.fabric_list:
                for _r in (_f.get('rolls', []) or []):
                    _ln = str(_r.get('lot', _r.get('shade','')) or '').strip()
                    if _ln:
                        _count_by_lot[_ln] = _count_by_lot.get(_ln, 0) + 1
            _max_existing_roll_rows = max(_count_by_lot.values(), default=0)
        MAX_TREE_ROWS_PER_LOT = max(1, int(_max_existing_roll_rows) + int(requested_extra_rows))
        _global_lot_count = len([g for g in (getattr(self, 'global_lot_rows', []) or [])
                                 if str(g.get('lot','') or '').strip()])
        if _global_lot_count <= 0:
            _lot_names_tmp = set()
            for _f in self.fabric_list:
                for _l in (_f.get('lots',[]) or []):
                    _n = str(_l.get('name','') or '').strip()
                    if _n: _lot_names_tmp.add(_n)
                for _r in (_f.get('rolls',[]) or []):
                    _n = str(_r.get('lot', _r.get('shade','')) or '').strip()
                    if _n: _lot_names_tmp.add(_n)
            _global_lot_count = max(1, len(_lot_names_tmp))
        MAX_TREE_ROWS_PER_FABRIC = max(1, MAX_TREE_ROWS_PER_LOT * max(1, _global_lot_count))
        supp_lot_input_rows = {}
        supp_lot_helper_info = {}
        result_by_fabric_id = {id(r.get('fabric')): r for r in results}
        hidden_cursor = 10000
        for fabric in self.fabric_list:
            if not bool(fabric.get('export_edit', True)):
                continue
            # 50 dòng tổng Shade ẩn: mỗi dòng là một Shade duy nhất của loại vải.
            lot_rows = list(range(hidden_cursor, hidden_cursor + MAX_DYNAMIC_LOTS))
            mirror_start = hidden_cursor + MAX_DYNAMIC_LOTS + 5
            mirror_end = mirror_start + MAX_TREE_ROWS_PER_FABRIC - 1
            section = {
                'start_row': 0, 'input_header_row': 0, 'input_rows': lot_rows,
                'existing_lots': [], 'existing_map': {},
                'blank_rows': lot_rows, 'detail_rows_info': [],
                'mirror_start': mirror_start, 'mirror_end': mirror_end
            }
            supp_lot_input_rows[id(fabric)] = section
            hidden_cursor = mirror_end + 20
        edit_cursor = 5
        # V82: 3 bàn dự phòng dùng Outline lồng nhau level 1..3.
        # Khi đóng: chỉ thấy dấu + ở bàn thật cuối. Mở lần 1 hiện bàn dự phòng 1,
        # sau đó xuất hiện dấu + tiếp theo để mở bàn 2 rồi bàn 3.
        # Không cần dòng summary siêu mỏng nên không tạo khoảng trắng khi in.
        reserve_row_groups = []

        def ratio_value_formula(excel_row, size_name):
            """Đọc hệ số của một size trực tiếp từ ô TỈ LỆ SƠ ĐỒ (cột C).

            Ví dụ C = "S/1 + M/2 + L/1" -> S=1, M=2, L=1.
            Công thức chỉ dùng hàm Excel cũ để tương thích nhiều phiên bản.
            """
            token_name = str(size_name or '').strip().upper().replace('"', '""')
            token = f'+{token_name}/'
            wrapped = f'"+"&SUBSTITUTE(UPPER($C{excel_row})," ","")&"+"'
            start = f'FIND("{token}",{wrapped})+{len(token)}'
            end = f'FIND("+",{wrapped},{start})'
            return f'IFERROR(VALUE(MID({wrapped},{start},({end})-({start}))),0)'

        def edited_ratio_plies_formula(excel_row, first_table_row, target_by_col, size_names, size_cols):
            """Tự tính số lá khi người dùng sửa tỷ lệ sơ đồ trong Excel.

            Lấy sản lượng còn thiếu trước dòng hiện tại và chọn số lá nhỏ nhất
            giúp hoàn tất ít nhất một cỡ đang có trong marker. Các dòng phía sau
            tiếp tục tự cân lại theo sản lượng còn thiếu.
            """
            active_flags = []
            choices = []
            for size_name, col in zip(size_names, size_cols):
                ratio_expr = ratio_value_formula(excel_row, size_name)
                if excel_row > first_table_row:
                    prev = f'SUM({col}${first_table_row}:{col}{excel_row-1})'
                else:
                    prev = '0'
                target_expr = target_by_col.get(col, '0')
                remaining = f'MAX(0,({target_expr})-{prev})'
                active = f'AND(({ratio_expr})>0,({remaining})>0)'
                active_flags.append(f'IF({active},1,0)')
                choices.append(
                    f'IF({active},ROUNDUP(({remaining})/({ratio_expr}),0),1000000000)'
                )

            active_count = '+'.join(active_flags) if active_flags else '0'
            candidate = f'MIN({",".join(choices)})' if choices else '0'
            return f'=IF(TRIM($C{excel_row})="",0,IF(({active_count})<=0,0,MAX(0,{candidate})))'

        def dynamic_plies_formula(table_index, tables, excel_row, first_table_row, target_by_col,
                                  size_keys, size_cols, base_target_by_key=None):
            """
            V60 - thay đổi % dương chỉ ĐIỀU CHỈNH TĂNG từ kế hoạch gốc,
            tuyệt đối không tính lại số lá từ đầu.

            Lý do: với tỷ lệ marker cố định, nếu tính lại tuần tự từ dòng B1,
            một bàn đầu có thể lấy quá nhiều một cỡ; bàn sau buộc phải giảm mạnh
            số lá để giữ dương <= MAX_OVER, làm các cỡ khác bị âm rất lớn.

            Quy tắc V60:
            1) Kế hoạch optimizer lúc xuất là nền cố định (base plan).
            2) Khi vừa xuất file: giữ nguyên tuyệt đối số lá của phần mềm.
               Chỉ khi mục tiêu/% dương trong Excel thay đổi mới xét phần tăng thêm.
            3) Một bàn chỉ được tăng thêm lá nếu sau phần tăng đó mọi cỡ trên
               marker vẫn <= mục tiêu hiện tại + MAX_OVER.
            4) Không bao giờ tự giảm số lá gốc chỉ vì một cỡ khác đã đủ.
               Nếu tỷ lệ marker hiện tại không thể đạt mục tiêu mới trong biên
               0..MAX_OVER, giữ kế hoạch gần nhất và để số âm nhỏ hiện ra để
               người dùng đổi tỷ lệ marker / dùng cột ĐIỀU CHỈNH SỐ LÁ.
            """
            ratio_map = tables[table_index].get('ratio_map', {}) or {}
            participants = [(k, int(ratio_map.get(k, 0) or 0))
                            for k in size_keys if int(ratio_map.get(k, 0) or 0) > 0]
            original_plies = int(tables[table_index].get('plies', 0) or 0)
            if not participants:
                return f'={original_plies}'

            col_map = dict(zip(size_keys, size_cols))

            # Sản lượng thực cắt của KẾ HOẠCH GỐC trên toàn bộ các bàn.
            base_actual = {k: 0 for k in size_keys}
            for _t in tables:
                _p = int(_t.get('plies', 0) or 0)
                _rm = _t.get('ratio_map', {}) or {}
                for _k in size_keys:
                    _r = int(_rm.get(_k, 0) or 0)
                    if _r > 0 and _p > 0:
                        base_actual[_k] += _r * _p

            extra_remaining = {}
            extra_required = {}
            safe_extra = {}
            last_chance = []

            for key, ratio in participants:
                col = col_map[key]
                target_expr = target_by_col.get(col, '0')

                # Phần tăng thêm đã được các bàn trước lấy so với số lá gốc.
                prev_terms = []
                for j in range(table_index):
                    prev_ratio = int((tables[j].get('ratio_map', {}) or {}).get(key, 0) or 0)
                    if prev_ratio <= 0:
                        continue
                    prev_base_plies = int(tables[j].get('plies', 0) or 0)
                    prev_row = first_table_row + j
                    prev_terms.append(
                        f'MAX(0,G{prev_row}-{prev_base_plies})*{prev_ratio}'
                    )
                prev_extra = '+'.join(prev_terms) if prev_terms else '0'

                # Chỉ bù phần mục tiêu mới vượt quá THỰC CẮT GỐC.
                rem = f'MAX(0,({target_expr})-{int(base_actual.get(key, 0))}-({prev_extra}))'
                extra_remaining[key] = rem
                extra_required[key] = f'ROUNDUP(({rem})/{ratio},0)'

                # Số lá được phép TĂNG thêm tối đa ở bàn hiện tại mà vẫn
                # không làm cỡ này vượt mục tiêu mới + MAX_OVER.
                headroom = (
                    f'(({target_expr})+{int(self.MAX_OVER)}-'
                    f'{int(base_actual.get(key, 0))}-({prev_extra}))'
                )
                safe_extra[key] = f'MAX(0,ROUNDDOWN(({headroom})/{ratio},0))'

                has_future = any(
                    int((future.get('ratio_map', {}) or {}).get(key, 0) or 0) > 0
                    for future in tables[table_index + 1:]
                )
                if not has_future:
                    last_chance.append(key)

            # Bàn chưa phải cơ hội cuối: tăng rất bảo thủ theo phần thiếu nhỏ nhất
            # của các cỡ đang cần tăng. Bàn cuối của một cỡ: cố bù cỡ đó trước.
            if last_chance:
                reqs = [extra_required[k] for k in last_chance]
                candidate_extra = f'MAX({",".join(reqs)})' if len(reqs) > 1 else reqs[0]
            else:
                choices = [
                    f'IF(({extra_remaining[k]})>0,{extra_required[k]},1000000000)'
                    for k, _r in participants
                ]
                min_need = f'MIN({",".join(choices)})' if len(choices) > 1 else choices[0]
                candidate_extra = f'IF(({min_need})>=1000000000,0,{min_need})'

            safe_parts = [safe_extra[k] for k, _r in participants]
            max_safe_extra = f'MIN({",".join(safe_parts)})' if len(safe_parts) > 1 else safe_parts[0]
            delta = f'MAX(0,MIN(({max_safe_extra}),({candidate_extra})))'

            # V162:
            # Khi vừa XUẤT EXCEL, số lá phải giữ đúng tuyệt đối số lá trên phần mềm.
            # Không tự bù phần âm của phương án gốc.
            # Chỉ khi mục tiêu/% dương trong Excel thay đổi mới cho phép tăng lá.
            changed_flags = []
            base_target_by_key = base_target_by_key or {}
            for key, _ratio in participants:
                col = col_map[key]
                target_expr = target_by_col.get(col, '0')
                try:
                    base_target = int(base_target_by_key.get(key, 0) or 0)
                except Exception:
                    base_target = 0
                changed_flags.append(
                    f'ABS(({target_expr})-{base_target})>0.000001'
                )

            target_changed = (
                f'OR({",".join(changed_flags)})'
                if len(changed_flags) > 1
                else (changed_flags[0] if changed_flags else 'FALSE')
            )

            return f'=IF({target_changed},{original_plies}+({delta}),{original_plies})'

        main_sheet_ref = ws.title.replace("'", "''")
        helper_sheet_ref = lot_ws.title.replace("'", "''")

        # V60: theo dõi lượng Shade đã dùng ở các loại vải đứng trước để GHI CHÚ
        # trên BIỂU CẮT hiển thị tổng Shade theo kiểu dây chuyền:
        #   vải 1: Tổng = tổng Shade gốc
        #   vải 2: Tổng = phần dư sau vải 1
        #   vải 3: Tổng = phần dư sau vải 1 + vải 2 ...
        # Chỉ thay cách HIỂN THỊ tổng/dư; việc phân cây vẫn giữ nguyên nguyên tắc
        # 1 Shade có thể dùng cho nhiều loại vải nhưng 1 cây chỉ thuộc 1 loại vải.
        prior_lot_note_blocks = []

        def build_dynamic_lot_formulas(fabric, main_rows, helper_start_row):
            """
            Tạo công thức Excel động để chia Shade theo SỐ LÁ nguyên.

            - Mỗi bàn vẫn giữ nguyên một dòng trong BIỂU CẮT.
            - Cột Shade (E) có thể hiện nhiều Shade nếu một bàn phải dùng nhiều Shade,
              ví dụ: Shade A: 40 lá | Shade B: 12 lá.
            - Khi người dùng sửa chiều dài ở cột D, mét/lá thay đổi và toàn bộ
              phân Shade + ghi chú dùng/dư tự tính lại.
            - Shade được ưu tiên theo thứ tự đã nhập. Một Shade được tiếp tục dùng
              cho các bàn sau nếu phần mét còn lại vẫn đủ cho ít nhất 1 lá.
            """
            lots = []
            section = supp_lot_input_rows.get(id(fabric), {})
            existing_map = section.get('existing_map', {})
            for i, lot in enumerate(fabric.get('lots', []) or []):
                lot_name = str(lot.get('name', '') or '').strip()
                if lot_name and i in existing_map:
                    try: meters = max(0.0, float(lot.get('meters', 0) or 0))
                    except Exception: meters = 0.0
                    lots.append({'name': lot_name, 'meters': meters, 'source_index': i,
                                 'edit_row': int(existing_map[i]), 'editable': True})
            for slot_no, edit_row in enumerate(section.get('blank_rows', []), start=1):
                lots.append({'name': '', 'meters': 0.0, 'source_index': None,
                             'supplemental': True, 'editable': True,
                             'slot_no': slot_no, 'edit_row': int(edit_row)})

            if not lots or not main_rows:
                return helper_start_row, None

            # Cấu trúc block helper:
            # A: dòng Sheet1, B: mét/1 lá, C: tổng số lá, D: số lá thiếu
            # E...: số lá được lấy từ từng Shade.
            title_row = helper_start_row
            cap_row = title_row + 1
            used_row = title_row + 2
            remain_row = title_row + 3
            note_row = title_row + 4
            data_start = title_row + 6
            data_end = data_start + len(main_rows) - 1

            lot_ws.cell(title_row, 1, f"LOẠI VẢI: {fabric.get('name', '')}")
            lot_ws.cell(title_row, 2, 'MÉT / 1 LÁ')
            lot_ws.cell(title_row, 3, 'SỐ LÁ')
            lot_ws.cell(title_row, 4, 'THIẾU LÁ')
            lot_ws.cell(cap_row, 4, 'SL MÉT Shade')
            lot_ws.cell(used_row, 4, 'ĐÃ DÙNG')
            lot_ws.cell(remain_row, 4, 'CÒN DƯ')
            lot_ws.cell(note_row, 4, 'GHI CHÚ')

            lot_first_col_idx = 5  # E
            lot_cols = []
            for j, lot in enumerate(lots):
                ci = lot_first_col_idx + j
                c = col_letter(ci)
                lot_cols.append(c)
                if lot.get('editable'):
                    er = int(lot.get('edit_row'))
                    slot_no = int(lot.get('slot_no', j + 1))
                    lot_ws.cell(title_row, ci, f"=IF('{edit_sheet_ref}'!B{er}<>\"\",'{edit_sheet_ref}'!B{er},IF(N('{edit_sheet_ref}'!E{er})>0,\"Shade MỚI {slot_no}\",\"\"))")
                    lot_ws.cell(cap_row, ci, f"=IFERROR(IF('{edit_sheet_ref}'!B{er}=\"\",0,MAX(0,N('{edit_sheet_ref}'!E{er}))),0)")
                else:
                    lot_ws.cell(title_row, ci, lot['name'])
                    lot_ws.cell(cap_row, ci, lot['meters'])
                lot_ws.cell(cap_row, ci).number_format = '0.00'

            # Dữ liệu và ma trận số lá / Shade.
            for offset, main_row in enumerate(main_rows):
                hr = data_start + offset
                lot_ws.cell(hr, 1, main_row)
                # V38: dòng dự phòng chưa nhập phải là 0 thật trong helper, không để
                # chuỗi rỗng đi vào phép chia/SUMPRODUCT gây #VALUE!/DIV0.
                lot_ws.cell(
                    hr, 2,
                    f"=IFERROR(IF(OR(TRIM('{main_sheet_ref}'!C{main_row})=\"\","
                    f"'{main_sheet_ref}'!D{main_row}=\"\"),0,'{main_sheet_ref}'!D{main_row}*1.01),0)"
                )
                lot_ws.cell(
                    hr, 3,
                    f"=IFERROR(IF(TRIM('{main_sheet_ref}'!C{main_row})=\"\",0,N('{main_sheet_ref}'!G{main_row})),0)"
                )
                lot_ws.cell(hr, 2).number_format = '0.0000'
                lot_ws.cell(hr, 3).number_format = '0'

                for j, c in enumerate(lot_cols):
                    # Số lá còn thiếu của bàn sau các Shade trước.
                    if j == 0:
                        remain_plies = f'$C{hr}'
                    else:
                        prev_c = lot_cols[j - 1]
                        remain_plies = f'$C{hr}-SUM(${lot_cols[0]}{hr}:${prev_c}{hr})'

                    # Số mét còn lại của Shade này sau các bàn phía trên.
                    if hr == data_start:
                        used_before = '0'
                    else:
                        used_before = f'SUMPRODUCT({c}${data_start}:{c}{hr-1},$B${data_start}:$B{hr-1})'

                    capacity = f'{c}${cap_row}'
                    # MAX(...,0.000001) chỉ là lớp bảo vệ; khi B<=0 nhánh ngoài trả 0.
                    cap_plies = f'INT(MAX(0,{capacity}-{used_before})/MAX($B{hr},0.000001))'
                    candidate_plies = f'MAX(0,MIN({remain_plies},{cap_plies}))'
                    # V50: dùng đầu tấm đến khi KHÔNG CÒN ĐỦ 1 LÁ.
                    # Không bỏ phần chỉ đủ 1-2 lá nữa; nếu đủ ít nhất 1 lá thì vẫn chuyển sang bàn tiếp theo.
                    formula = (
                        f'=IFERROR(IF(OR($B{hr}<=0,$C{hr}<=0),0,{candidate_plies}),0)'
                    )
                    lot_ws.cell(hr, lot_first_col_idx + j, formula)
                    lot_ws.cell(hr, lot_first_col_idx + j).number_format = '0'

                lot_range = f'{lot_cols[0]}{hr}:{lot_cols[-1]}{hr}'
                lot_ws.cell(hr, 4, f'=MAX(0,$C{hr}-SUM({lot_range}))')
                lot_ws.cell(hr, 4).number_format = '0'

                # Cột Shade trên BIỂU CẮT: tương thích cả Excel cũ.
                # Không dùng TEXTJOIN (Excel cũ sẽ báo #NAME?). Thay bằng IF + &.
                lot_formula_parts = []
                previous_refs = []
                for c in lot_cols:
                    lot_ref = f"'{helper_sheet_ref}'!{c}{hr}"
                    lot_name_ref = f"'{helper_sheet_ref}'!{c}${title_row}"
                    if previous_refs:
                        prev_sum = 'SUM(' + ','.join(previous_refs) + ')'
                        prefix = f'IF({prev_sum}>0," | ","")&'
                    else:
                        prefix = ''
                    lot_formula_parts.append(
                        f'IF({lot_ref}>0,{prefix}{lot_name_ref}&": "&{lot_ref}&" lá","")'
                    )
                    previous_refs.append(lot_ref)

                missing_ref = f"'{helper_sheet_ref}'!$D{hr}"
                if previous_refs:
                    prev_sum = 'SUM(' + ','.join(previous_refs) + ')'
                    missing_prefix = f'IF({prev_sum}>0," | ","")&'
                else:
                    missing_prefix = ''
                lot_formula_parts.append(
                    f'IF({missing_ref}>0,{missing_prefix}"THIẾU: "&{missing_ref}&" lá","")'
                )
                total_cap_expr = f"SUM('{helper_sheet_ref}'!{lot_cols[0]}${cap_row}:{lot_cols[-1]}${cap_row})"
                # V38: Shade chỉ tính khi dòng có đủ TỈ LỆ + CHIỀU DÀI + SỐ LÁ.
                # Dòng dự phòng trống luôn hiển thị trống thay vì #VALUE!.
                lot_concat_expr = '&'.join(lot_formula_parts)
                ws[f'E{main_row}'] = (
                    f'=IF(OR(TRIM($C{main_row})="",$D{main_row}="",$G{main_row}=""),"",'
                    f'IFERROR(IF({total_cap_expr}<=0,"",{lot_concat_expr}),""))'
                )
                ws[f'E{main_row}'].alignment = Alignment(
                    horizontal='center', vertical='center', wrap_text=False,
                    shrink_to_fit=False
                )

            # Tổng mét đã dùng / còn dư từng Shade.
            # V60: nếu cùng một Shade xuất hiện ở nhiều loại vải, cột GHI CHÚ của
            # BIỂU CẮT phải chạy theo số dư của Shade qua từng loại vải.
            #
            # Tổng Shade gốc được đọc động từ SỬA PHÂN CÂY bằng cột MÉT HIỆU LỰC
            # (cột ẩn ngay sau mỗi cụm Shade). Cột này đã tự trừ phần đầu tấm chuyển
            # đi và cộng dòng đầu tấm nhận lại nên tổng vật lý của Shade không bị nhân đôi.
            def _original_lot_total_expr(current_lot_name_ref):
                _parts = []
                _block_count = max(1, int(_global_lot_count or 0))
                _first = 7
                _last = 7 + int(MAX_TREE_ROWS_PER_LOT) - 1
                _span = 8
                for _li in range(_block_count):
                    _bs = 1 + _li * _span
                    _lot_col = col_letter(_bs + 2)
                    _eff_col = col_letter(_bs + 7)
                    _parts.append(
                        f"SUMIFS('{edit_sheet_ref}'!${_eff_col}${_first}:${_eff_col}${_last},"
                        f"'{edit_sheet_ref}'!${_lot_col}${_first}:${_lot_col}${_last},{current_lot_name_ref})"
                    )
                return '+'.join(_parts) if _parts else '0'

            for j, c in enumerate(lot_cols):
                lot_ws[f'{c}{used_row}'] = f'=SUMPRODUCT({c}{data_start}:{c}{data_end},$B{data_start}:$B{data_end})'

                # Tổng đã dùng của CÙNG Shade ở tất cả loại vải đứng trước.
                _prev_used_terms = []
                for _pb in prior_lot_note_blocks:
                    _prev_used_terms.append(
                        f'SUMIF(${_pb["first_col"]}${_pb["title_row"]}:${_pb["last_col"]}${_pb["title_row"]},'
                        f'{c}${title_row},'
                        f'${_pb["first_col"]}${_pb["used_row"]}:${_pb["last_col"]}${_pb["used_row"]})'
                    )
                _prev_used_expr = '+'.join(_prev_used_terms) if _prev_used_terms else '0'
                _original_total_expr = _original_lot_total_expr(f'{c}${title_row}')

                # Nếu dữ liệu nguồn đặc biệt làm tổng Shade gốc không đọc được, ít nhất
                # vẫn giữ Tổng hiện tại >= phần mét đã cấp cho loại vải này.
                _cascade_total_expr = (
                    f'MAX({c}{cap_row},MAX(0,({_original_total_expr})-({_prev_used_expr})))'
                )
                _cascade_remain_expr = f'MAX(0,({_cascade_total_expr})-{c}{used_row})'

                # Hàng CÒN DƯ của helper cũng dùng cùng số dư dây chuyền để các công thức
                # kiểm tra/đối chiếu trong file Excel nhất quán với GHI CHÚ.
                lot_ws[f'{c}{remain_row}'] = f'={_cascade_remain_expr}'
                lot_ws[f'{c}{note_row}'] = (
                    f'=IF(AND({c}{cap_row}>0,{c}{title_row}<>""),'
                    f'{c}{title_row}&": Tổng "&TEXT(({_cascade_total_expr}),"0.00")&'
                    f'" m | dùng "&TEXT({c}{used_row},"0.00")&'
                    f'" m | dư "&TEXT(({_cascade_remain_expr}),"0.00")&" m","")'
                )
                lot_ws[f'{c}{used_row}'].number_format = '0.00'
                lot_ws[f'{c}{remain_row}'].number_format = '0.00'

            # Tổng mét chưa được cấp Shade (do thiếu mét).
            lot_ws[f'D{used_row}'] = f'=SUMPRODUCT($D{data_start}:$D{data_end},$B{data_start}:$B{data_end})'
            lot_ws[f'D{used_row}'].number_format = '0.00'

            # Công thức GHI CHÚ trên BIỂU CẮT - chỉ hiện Shade có TỔNG MÉT > 0.
            # Shade chưa nhập mét vẫn tồn tại để người dùng điều chỉnh sau khi xuất,
            # nhưng tên Shade đó không xuất hiện trong GHI CHÚ cho tới khi có giá trị mét.
            note_parts = []
            previous_caps = []
            for c in lot_cols:
                cap_ref = f"'{helper_sheet_ref}'!{c}${cap_row}"
                note_ref = f"'{helper_sheet_ref}'!{c}{note_row}"
                if previous_caps:
                    prev_sum = 'SUM(' + ','.join(previous_caps) + ')'
                    prefix = f'IF({prev_sum}>0,CHAR(10),"")&'
                else:
                    prefix = ''
                note_parts.append(f'IF({cap_ref}>0,{prefix}{note_ref},"")')
                previous_caps.append(cap_ref)

            # V34: BIỂU CẮT không hiển thị dòng THIẾU VẢI theo mét.
            # Thiếu mét được tổng hợp riêng tại SỬA PHÂN CÂY.
            # Excel giới hạn công thức trong một ô ở 8.192 ký tự. Tách ghi chú
            # thành các phần ngắn trên sheet ẩn để luôn nằm dưới giới hạn đó.
            if note_parts:
                note_chunk_parts = []
                current_chunk = []
                current_chunk_length = 1  # dấu '=' đầu công thức
                max_note_formula_length = 7000
                for note_part in note_parts:
                    extra_length = len(note_part) + (1 if current_chunk else 0)
                    if current_chunk and current_chunk_length + extra_length > max_note_formula_length:
                        note_chunk_parts.append('&'.join(current_chunk))
                        current_chunk = []
                        current_chunk_length = 1
                        extra_length = len(note_part)
                    current_chunk.append(note_part)
                    current_chunk_length += extra_length
                if current_chunk:
                    note_chunk_parts.append('&'.join(current_chunk))

                note_chunk_col_idx = lot_first_col_idx + len(lot_cols) + 1
                note_chunk_refs = []
                for chunk_index, chunk_formula in enumerate(note_chunk_parts):
                    chunk_col = col_letter(note_chunk_col_idx + chunk_index)
                    lot_ws.cell(note_row, note_chunk_col_idx + chunk_index, '=' + chunk_formula)
                    note_chunk_refs.append(f"'{helper_sheet_ref}'!{chunk_col}{note_row}")
                note_formula = '=' + '&'.join(note_chunk_refs)
            else:
                note_formula = '=""'

            # V48: lưu tọa độ helper + Shade xạ dòng SỬA PHÂN CÂY -> cột Shade helper.
            supp_cols = []
            edit_lot_cols = {}
            for j, lot in enumerate(lots):
                if lot.get('editable'):
                    er = int(lot.get('edit_row'))
                    info = {'col': lot_cols[j], 'edit_row': er, 'slot_no': int(lot.get('slot_no', j + 1)),
                            'supplemental': bool(lot.get('supplemental'))}
                    edit_lot_cols[er] = lot_cols[j]
                    if lot.get('supplemental'): supp_cols.append(info)
            supp_lot_helper_info[id(fabric)] = {
                'title_row': title_row, 'cap_row': cap_row, 'used_row': used_row, 'remain_row': remain_row,
                'data_start': data_start, 'data_end': data_end, 'main_rows': list(main_rows),
                'supp_cols': supp_cols, 'all_lot_cols': list(lot_cols), 'edit_lot_cols': edit_lot_cols}

            # V60: ghi lại block Shade của loại vải hiện tại để loại vải sau
            # trừ đúng lượng đã dùng của cùng Shade.
            if lot_cols:
                prior_lot_note_blocks.append({
                    'title_row': title_row,
                    'used_row': used_row,
                    'first_col': lot_cols[0],
                    'last_col': lot_cols[-1],
                })

            # Chừa khoảng cách giữa các block vải.
            return data_end + 3, note_formula

        size_keys = [s['key'] for s in self.sizes]
        size_names = [s['name'] for s in self.sizes]
        size_cols = [col_letter(7 + i) for i in range(len(self.sizes))]  # bắt đầu G
        total_col = col_letter(7 + len(self.sizes))
        norm_col = col_letter(8 + len(self.sizes))
        need_col = col_letter(9 + len(self.sizes))
        note_col = col_letter(10 + len(self.sizes))  # 5 size mặc định => cột O
        # V25: cột điều chỉnh số lá nằm NGAY SAU GHI CHÚ và luôn ở ngoài vùng in A4.
        # Khi thêm/xóa size, cột này tự dịch theo vì được tính động từ note_col.
        adjust_col = col_letter(11 + len(self.sizes))  # 5 size mặc định => cột P
        # V32: cột chỉnh tổng mét Shade nằm ngay bên phải cột chỉnh số lá,
        # cũng nằm ngoài vùng in A4. 5 size mặc định => cột R.
        adjust_lot_col = col_letter(12 + len(self.sizes))
        first_size_col = size_cols[0]
        last_size_col = size_cols[-1]
        # Bố cục biểu cắt có thêm cột LOT nhà sản xuất sau Shade.
        plan_size_cols = [col_letter(8 + i) for i in range(len(self.sizes))]
        plan_total_col = col_letter(8 + len(self.sizes))
        plan_norm_col = col_letter(9 + len(self.sizes))
        plan_need_col = col_letter(10 + len(self.sizes))
        plan_note_col = col_letter(11 + len(self.sizes))
        plan_width_col = col_letter(12 + len(self.sizes))
        plan_adjust_col = col_letter(13 + len(self.sizes))
        plan_adjust_lot_col = col_letter(14 + len(self.sizes))
        # Ẩn cột chỉnh số lá theo yêu cầu; công thức vẫn có thể đọc giá trị nếu cần.
        ws.column_dimensions[plan_adjust_col].hidden = True
        plan_first_size_col = plan_size_cols[0]
        plan_last_size_col = plan_size_cols[-1]

        # Kích thước cột. Cột GHI CHÚ tự ước lượng theo tên Shade nhưng được
        # giới hạn để không chiếm quá nhiều bề ngang A4; chữ dài sẽ wrap.
        lot_note_samples = []
        # V41: Shade va GHI CHU tu co dan theo noi dung thuc te.
        # Shade rong toi thieu vua tieu de; neu co ten Shade dai / nhieu Shade thi tang rong.
        lot_cell_samples = []
        for fabric in self.fabric_list:
            fabric_lot_parts = []
            for lot in fabric.get('lots', []) or []:
                name = str(lot.get('name', '')).strip() or 'Shade'
                # Mau gan voi noi dung thuc te trong cot Shade: "TEN Shade: 000 la".
                part = f"{name}: 000 lá"
                fabric_lot_parts.append(part)
                lot_cell_samples.append(part)
                try:
                    meters = float(lot.get('meters', 0) or 0)
                except (TypeError, ValueError):
                    meters = 0.0
                if meters > 0:
                    lot_note_samples.append(f"{name}: Tổng {meters:.2f} m | dùng 0000.00 m | dư 0000.00 m")

            # Một bàn có thể dùng nhiều Shade. Đồng thời phải tính cả trường hợp
            # bàn dùng một phần Shade rồi còn THIẾU, vì đây là chuỗi dài nhất thường gặp.
            if fabric_lot_parts:
                joined = ' | '.join(fabric_lot_parts)
                lot_cell_samples.append(joined)
                lot_cell_samples.append(joined + ' | THIẾU: 000 lá')
            else:
                lot_cell_samples.append('THIẾU: 000 lá')

        max_lot_len = max([len(x) for x in lot_cell_samples], default=3)
        # Excel không có AutoFit thật sự cho ô công thức khi tạo bằng openpyxl,
        # nên ước lượng độ rộng theo chuỗi Shade dài nhất có thể xuất hiện.
        # Dùng hệ số rộng hơn để tránh trường hợp công thức tính ra "Shade | THIẾU" bị cắt.
        lot_width = max(9.0, max_lot_len * 1.15 + 2.0)

        max_note_len = max([len(x) for x in lot_note_samples], default=24)
        # GHI CHÚ ưu tiên rộng hơn nhưng không thu nhỏ chữ; nội dung dài sẽ wrap.
        note_width = min(48.0, max(28.0, max_note_len * 0.66))

        column_widths = {
            'A': 12.43, 'B': 7.43, 'C': 45.71, 'D': 14.29,
            'E': lot_width, 'F': 18.0, 'G': 8.43,
            norm_col: 11.86,
            need_col: 17.43,
            note_col: note_width,
            # Các cột nhập tay ngoài vùng in, có kẻ ô nhưng không đưa vào Print Area.
            adjust_col: 15.0,
        }
        for col in size_cols:
            column_widths[col] = 8.43
        for col in plan_size_cols:
            column_widths[col] = 8.43
        column_widths[total_col] = 10.0
        column_widths[plan_total_col] = 10.0
        column_widths[plan_norm_col] = 11.86
        column_widths[plan_need_col] = 17.43
        column_widths[plan_note_col] = note_width
        column_widths[plan_width_col] = 12.0
        column_widths[plan_adjust_col] = 15.0
        for col, width in column_widths.items():
            ws.column_dimensions[col].width = width
        # V60: bỏ hẳn cột ĐIỀU CHỈNH TỔNG Shade khỏi giao diện BIỂU CẮT.
        # Tổng Shade chỉ lấy từ SỬA PHÂN CÂY. Giữ cột kỹ thuật ẩn để không làm đổi vị trí các cột khác.
        ws.column_dimensions[plan_adjust_lot_col].hidden = True
        ws.column_dimensions[plan_adjust_lot_col].width = 0.1

        # ===== V32: ĐIỀU CHỈNH TỔNG Shade THEO TỪNG KHỐI LOẠI VẢI =====
        # Ô chỉnh Shade sẽ được tạo đúng tại các dòng của loại vải tương ứng,
        # ngay bên phải cột ĐIỀU CHỈNH SỐ LÁ và vẫn nằm ngoài vùng in A4.
        lot_adjust_cells = {}

        # ===== THÔNG TIN ĐƠN HÀNG + BẢNG PO ĐỘNG =====
        # V34: thông tin bổ sung không còn mặc định đẩy toàn bộ bảng PO xuống.
        # Chỉ khi đúng vị trí đó va vào vùng dữ liệu thì phần phía dưới mới dịch đều.
        ws.row_dimensions[1].height = 48.0
        info = self.get_current_info()

        # ===== LOGO: bỏ khung tại vị trí logo và phủ vừa A1:B3 =====
        # Không tạo khung/merge cho logo. Chỉ chèn ảnh và xóa mọi viền ở vùng A1:B3.
        logo_buffer = None
        for rr in range(1, 4):
            for cc in range(1, 3):
                set_cell(f'{col_letter(cc)}{rr}', border=make_border(), fill=PatternFill(fill_type=None))

        if getattr(self, 'logo_path', None) and os.path.isfile(self.logo_path):
            try:
                if PILImage is None:
                    raise RuntimeError("Thiếu thư viện Pillow (pip install pillow)")

                # Kích thước vùng A1:B3 xấp xỉ theo bố cục hiện tại.
                box_w, box_h = 145, 78
                with PILImage.open(self.logo_path) as pil_logo:
                    pil_logo.load()
                    pil_logo = pil_logo.convert('RGBA')
                    if pil_logo.width <= 0 or pil_logo.height <= 0:
                        raise ValueError("Kích thước logo không hợp lệ")

                    resized = pil_logo.resize((box_w, box_h), PILImage.LANCZOS)
                    logo_buffer = io.BytesIO()
                    resized.save(logo_buffer, format='PNG')
                    logo_buffer.seek(0)

                logo_img = XLImage(logo_buffer)
                logo_img.width = box_w
                logo_img.height = box_h
                logo_img.anchor = 'A1'
                ws.add_image(logo_img)
            except Exception as logo_error:
                messagebox.showwarning(
                    "Logo không được chèn",
                    f"File Excel vẫn được xuất nhưng logo không thể chèn:\n{logo_error}"
                )

        set_cell('E1', 'TÁC NGHIỆP CẮT -CUTTING PLAN', font=font_title,
                 alignment=Alignment(horizontal='center', vertical='center', wrap_text=False))

        def excel_col_to_index(col_name):
            n = 0
            for ch in str(col_name).upper():
                if 'A' <= ch <= 'Z':
                    n = n * 26 + (ord(ch) - 64)
            return n

        # Các ô thông tin chuẩn đã chiếm ở phần đầu trang.
        occupied_info = {(1, 5)}  # E1: tiêu đề
        if getattr(self, 'logo_path', None):
            occupied_info.update({(r, c) for r in range(1, 4) for c in range(1, 3)})
        max_info_row = 4
        # CODE + DATE hiển thị trong vùng N1:O1, cùng một dòng.
        info_box_start_col = 'N'
        info_box_end_col = 'O'
        info_box_start_row = 1
        info_box_end_row = 1
        info_box_start_idx = excel_col_to_index(info_box_start_col)
        info_box_end_idx = excel_col_to_index(info_box_end_col)
        info_box_range = f'{info_box_start_col}{info_box_start_row}:{info_box_end_col}{info_box_end_row}'

        code_text = str(info.get('code', '') or '').strip()
        date_text = str(info.get('date', '') or '').strip()
        info_lines = []
        if code_text:
            info_lines.append(f'CODE: {code_text}')
        if date_text:
            info_lines.append(f'DATE: {date_text}')

        if info_lines:
            try:
                ws.merge_cells(info_box_range)
            except Exception:
                pass

            for rr in range(info_box_start_row, info_box_end_row + 1):
                for cc in range(info_box_start_idx, info_box_end_idx + 1):
                    left_side = medium if cc == info_box_start_idx else None
                    right_side = medium if cc == info_box_end_idx else None
                    top_side = medium if rr == info_box_start_row else None
                    bottom_side = medium if rr == info_box_end_row else None
                    set_cell(
                        f'{col_letter(cc)}{rr}',
                        border=make_border(left=left_side, right=right_side, top=top_side, bottom=bottom_side)
                    )
                    occupied_info.add((rr, cc))

            set_cell(
                f'{info_box_start_col}{info_box_start_row}',
                '\n'.join(info_lines),
                font=font_bold,
                alignment=Alignment(horizontal='left', vertical='center', wrap_text=True)
            )
            max_info_row = max(max_info_row, info_box_end_row)
            ws.row_dimensions[1].height = max(float(ws.row_dimensions[1].height or 15), 24.0)

        # Thông tin chuẩn. Ô nào để trống thì không xuất.
        color_col_idx = max(8, min(12, 10 + len(self.sizes)))
        standard_info = [
            ('customer', 'KHÁCH HÀNG/CUSTOMER', 'C', 3, True),
            ('style', 'MÃ HÀNG/STYLE', 'C', 4, True),
            ('batch', 'ĐỢT/BATCH', 'F', 3, True),
            ('season', 'MÙA/SEASON', 'F', 4, True),
            ('color', 'MÀU/COLOR', 'I', 3, True),
            ('actual_export_date', 'NGÀY/DATE', 'M', 3, True),
            ('prepared_by', 'NGƯỜI LẬP BIỂU', 'M', 4, True),
        ]
        # Chừa vùng rộng cố định cho từng nhóm thông tin để nội dung dài
        # không tràn sang ô bên cạnh khi xuất Excel.
        for _header_range in ('F3:H3', 'F4:H4', 'I3:L3', 'M3:P3', 'M4:P4'):
            _range_match = re.fullmatch(r'([A-Z]+)(\d+):([A-Z]+)(\d+)', _header_range)
            if _range_match:
                _c1 = excel_col_to_index(_range_match.group(1))
                _r1 = int(_range_match.group(2))
                _c2 = excel_col_to_index(_range_match.group(3))
                _r2 = int(_range_match.group(4))
                for _rr in range(_r1, _r2 + 1):
                    for _cc in range(_c1, _c2 + 1):
                        ws.cell(_rr, _cc).border = Border()
                        occupied_info.add((_rr, _cc))
            ws.merge_cells(_header_range)

        for key, label, col, row, bold in standard_info:
            value = str(info.get(key, '') or '').strip()
            if not value:
                continue
            ci = excel_col_to_index(col)
            set_cell(f'{col}{row}', f'{label}: {value}',
                     font=font_bold if bold else font_normal,
                     alignment=Alignment(vertical='center', wrap_text=False, shrink_to_fit=False))
            occupied_info.add((row, ci))
            max_info_row = max(max_info_row, row)
            ws.row_dimensions[row].height = max(float(ws.row_dimensions[row].height or 15), 25.0)

        # Chuẩn hóa thông tin bổ sung trước khi tính vị trí các khối.
        # Nếu trùng đúng ô thông tin ở phần đầu trang thì dời riêng thông tin đó xuống
        # ô trống kế tiếp trong cùng cột; không đụng đến toàn bộ bố cục.
        pending_custom_info = []
        custom_taken = set()
        for item in getattr(self, 'custom_info_list', []) or []:
            col = str(item.get('col', '') or '').strip().upper()
            if not re.fullmatch(r'[A-Z]{1,2}', col):
                continue
            ci = excel_col_to_index(col)
            try:
                row = max(1, int(item.get('row', 1)))
            except (TypeError, ValueError):
                row = 1
            name = str(item.get('name', '') or '').strip()
            value = str(item.get('value', '') or '').strip()
            text_value = f'{name}: {value}' if name and value else (name or value)
            if not text_value:
                continue

            while (row, ci) in occupied_info or (row, ci) in custom_taken:
                row += 1
            custom_taken.add((row, ci))
            pending_custom_info.append({
                'col': col, 'ci': ci, 'row': row, 'text': text_value
            })

        # ===== TÍNH VỊ TRÍ BẢNG PO =====
        # PO mặc định bắt đầu từ dòng 5. Chỉ những thông tin bổ sung thực sự nằm
        # trong vùng C -> TỔNG của bảng PO mới khiến cả khối PO dịch xuống đều.
        po_first_col_idx = excel_col_to_index('C')
        po_last_col_idx = excel_col_to_index(total_col)

        # V160:
        # - Không tích ÁP DỤNG % DƯƠNG -> Excel không có dòng % DƯƠNG.
        # - Có tích -> xuất dòng % DƯƠNG.
        export_increase_row = bool(self._increase_enabled())
        percent_row = 5

        increase_po_count = sum(1 for po in self.po_list if self._po_increase_active(po))
        po_span_rows = (
            len(self.po_list) + increase_po_count
            + (4 if export_increase_row else 3)
        )
        while True:
            po_end_row = percent_row + po_span_rows - 1
            conflicts = [
                x['row'] for x in pending_custom_info
                if po_first_col_idx <= x['ci'] <= po_last_col_idx
                and percent_row <= x['row'] <= po_end_row
            ]
            if not conflicts:
                break
            new_percent_row = max(conflicts) + 1
            if new_percent_row <= percent_row:
                break
            percent_row = new_percent_row

        po_header_row = percent_row + (1 if export_increase_row else 0)
        po_data_start = po_header_row + 1
        projected_total_row = (
            po_data_start + len(self.po_list) + increase_po_count + 1
        )

        # ===== LẬP KẾ HOẠCH VỊ TRÍ CÁC KHỐI LOẠI VẢI =====
        # Nếu thông tin bổ sung nằm đúng trong một khối vải, chỉ khối đó và các
        # khối phía sau dịch xuống. Nếu nằm ở ô/cột trống thì giữ nguyên vị trí.
        note_col_idx = excel_col_to_index(plan_note_col)
        adjust_col_idx = excel_col_to_index(plan_adjust_col)
        adjust_lot_col_idx = excel_col_to_index(plan_adjust_lot_col)

        def custom_conflicts_fabric_cell(item, fabric, header_row, end_row):
            if not (header_row <= item['row'] <= end_row):
                return False
            ci = item['ci']
            if 1 <= ci <= note_col_idx:
                return True
            if ci == adjust_col_idx:
                return True
            if ci == adjust_lot_col_idx and (fabric.get('lots', []) or []):
                return True
            return False

        fabric_spacer_rows = []
        cut_manufacturer_mark_cells = {}
        cut_fabric_width_cells = {}
        planned_spacer = projected_total_row + 3
        for result in results:
            fabric = result['fabric']
            table_count = len(result['cutting_tables']) + RESERVE_TABLES_PER_FABRIC
            lot_count = len([lot for lot in (fabric.get('lots', []) or [])
                             if str(lot.get('name', '')).strip()]) + len(supp_lot_input_rows.get(id(fabric), {}).get('blank_rows', []))
            while True:
                header_row = planned_spacer + 1
                # Header 2 dòng + bàn + thực cắt + dương. Shade chỉnh tay có thể dài hơn số bàn.
                main_end = planned_spacer + table_count + RESERVE_TABLES_PER_FABRIC + 4
                lot_adjust_end = planned_spacer + lot_count + 2 if lot_count else main_end
                occupied_end = max(main_end, lot_adjust_end)
                conflicts = [
                    x['row'] for x in pending_custom_info
                    if custom_conflicts_fabric_cell(x, fabric, header_row, occupied_end)
                ]
                if not conflicts:
                    break
                # Để nguyên thông tin ở đúng dòng được yêu cầu; đẩy cả khối vải xuống dưới nó.
                planned_spacer = max(conflicts)
            fabric_spacer_rows.append(planned_spacer)
            # Sau dòng DƯƠNG có 2 dòng cách như bố cục hiện tại.
            planned_spacer = planned_spacer + table_count + 6

        # Hàng có thông tin bổ sung được tăng chiều cao nhưng không làm dịch dòng.
        for x in pending_custom_info:
            ws.row_dimensions[x['row']].height = max(float(ws.row_dimensions[x['row']].height or 15), 24.0)

        # Toàn bộ phần THÔNG TIN CHUNG luôn một dòng, không xuống dòng và KHÔNG thu nhỏ font.
        # Nếu ô kế bên trống, Excel sẽ cho chữ hiển thị tràn sang cột sau.
        for rr in range(1, max_info_row + 1):
            for cc in range(1, 11 + len(self.sizes)):
                cell = ws.cell(rr, cc)
                if cell.value is not None:
                    cell.alignment = Alignment(
                        horizontal=cell.alignment.horizontal,
                        vertical=cell.alignment.vertical or 'center',
                        text_rotation=cell.alignment.textRotation,
                        wrap_text=False,
                        shrink_to_fit=False,
                        indent=cell.alignment.indent
                    )


        # Khôi phục định dạng xuống dòng cho khung CODE/DATE sau bước chuẩn hóa NO WRAP.
        if info_lines:
            ws[f'{info_box_start_col}1'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)

        if export_increase_row:
            ws.row_dimensions[percent_row].height = 36.0
        ws.row_dimensions[po_header_row].height = 32.0

        # V160: dòng % DƯƠNG chỉ xuất khi bật ÁP DỤNG % DƯƠNG.
        # Người dùng nhập trực tiếp 1%, 2.5%... tại đúng cột size.
        # Không còn một ô % chung cho tất cả size.
        percent_cells_by_col = {}

        if export_increase_row:
            for col in ['C', 'D', 'E', 'F', 'G']:
                set_cell(
                    f'{col}{percent_row}',
                    border=make_border(
                        left=medium if col == 'C' else None,
                        right=medium if col == 'F' else None,
                        top=medium, bottom=medium
                    ),
                    fill=fill_percent_row
                )
            ws.merge_cells(f'C{percent_row}:F{percent_row}')

            _pct_mode_label = (
                'TẤT CẢ PO'
                if self._increase_mode() == 'all'
                else 'TỪNG PO ĐƯỢC CHỌN'
            )
            set_cell(
                f'C{percent_row}',
                f'% DƯƠNG TỪNG CỠ / INCREASE BY SIZE (%) - {_pct_mode_label}',
                font=font_bilingual,
                alignment=align_bilingual,
                border=make_border(
                    left=medium, right=medium,
                    top=medium, bottom=medium
                ),
                fill=fill_percent_row
            )

            for idx, (col, name) in enumerate(zip(size_cols, size_names)):
                left = medium if idx == 0 else thin
                right = medium if idx == len(size_cols) - 1 else thin

                pct_raw = max(
                    0.0,
                    float(self.sizes[idx].get('increase_pct', 0.0) or 0.0)
                )

                # Chỉ cỡ có % dương mới hiện số; cỡ 0% để trống.
                pct_value = (pct_raw / 100.0) if pct_raw > 0 else None

                set_cell(
                    f'{col}{percent_row}',
                    pct_value,
                    font=font_bold,
                    alignment=align_center,
                    border=make_border(
                        left=left, right=right,
                        top=medium, bottom=medium
                    ),
                    fill=fill_percent_row
                )
                ws[f'{col}{percent_row}'].number_format = '0.00%'

                percent_cells_by_col[col] = (
                    f'${col}${percent_row}' if pct_raw > 0 else '0'
                )

            # Tổng % được gán công thức sau khi đã có dòng tổng đơn hàng/kế hoạch.
            set_cell(
                f'{total_col}{percent_row}',
                None,
                font=font_bold,
                alignment=align_center,
                border=make_border(
                    left=medium, right=medium,
                    top=medium, bottom=medium
                ),
                fill=fill_percent_row
            )
            ws[f'{total_col}{percent_row}'].number_format = '0.00%'

        else:
            # Tắt áp dụng dương: không có dòng % và mọi công thức tăng dùng 0.
            percent_cells_by_col = {col: '0' for col in size_cols}

        # V68: tách phần đầu bảng thành PO | MÀU/COLOR giống mẫu người dùng.
        for col in ['C', 'D']:
            set_cell(f'{col}{po_header_row}', border=make_border(
                left=medium if col == 'C' else None,
                right=medium if col == 'D' else None,
                top=medium, bottom=medium), fill=fill_theme4_tint60)
        for col in ['E', 'F']:
            set_cell(f'{col}{po_header_row}', border=make_border(
                left=medium if col == 'E' else None,
                right=medium if col == 'G' else None,
                top=medium, bottom=medium), fill=fill_theme4_tint60)
        ws.merge_cells(f'C{po_header_row}:D{po_header_row}')
        ws.merge_cells(f'E{po_header_row}:F{po_header_row}')
        set_cell(f'C{po_header_row}', 'PO', font=font_bold, alignment=align_center,
                 border=make_border(left=medium, right=medium, top=medium, bottom=medium),
                 fill=fill_theme4_tint60)
        set_cell(f'E{po_header_row}', 'MÀU/COLOR', font=font_bold, alignment=align_center,
                 border=make_border(left=medium, right=medium, top=medium, bottom=medium),
                 fill=fill_theme4_tint60)

        for idx, (col, name) in enumerate(zip(size_cols, size_names)):
            set_cell(f'{col}{po_header_row}', name, font=font_normal, alignment=align_center,
                     border=make_border(left=thin if idx > 0 else None,
                                        right=medium if idx == len(size_cols)-1 else thin,
                                        top=medium, bottom=medium),
                     fill=fill_theme8_tint0)
        set_cell(f'{total_col}{po_header_row}', 'TỔNG', font=font_bold, alignment=align_center,
                 border=make_border(left=medium, right=medium, top=medium, bottom=medium))

        current_row = po_data_start
        # V64:
        # - PO có tích TĂNG %: xuất dòng PO + dòng SẢN LƯỢNG DƯƠNG.
        # - PO không tích: chỉ xuất đúng 1 dòng PO, không chừa dòng dương trống.
        # - Ô không có số lượng / không phát sinh dương hiển thị trống thay vì 0.
        po_excel_rows = {}
        po_excess_excel_rows = {}
        raw_po_rows_all = []
        excess_po_rows_all = []
        for po in self.po_list:
            po_name_for_map = str(po.get('po', '')).strip()
            raw_row = current_row
            po_excel_rows.setdefault(po_name_for_map, []).append(raw_row)
            raw_po_rows_all.append(raw_row)
            ws.row_dimensions[raw_row].height = 23.0
            for col in ['C', 'D']:
                set_cell(f'{col}{raw_row}', border=make_border(
                    left=medium if col == 'C' else None,
                    right=medium if col == 'D' else None,
                    top=thin, bottom=thin))
            for col in ['E', 'F']:
                set_cell(f'{col}{raw_row}', border=make_border(
                    left=medium if col == 'E' else None,
                    right=medium if col == 'G' else None,
                    top=thin, bottom=thin))
            ws.merge_cells(f'C{raw_row}:D{raw_row}')
            ws.merge_cells(f'E{raw_row}:F{raw_row}')
            set_cell(f'C{raw_row}', int(po['po']) if str(po['po']).isdigit() else po['po'],
                     font=font_normal, alignment=align_center,
                     border=make_border(left=medium, right=medium, top=thin, bottom=thin))
            set_cell(f'E{raw_row}', str(po.get('color', '') or '').strip() or None,
                     font=font_normal, alignment=align_center,
                     border=make_border(left=medium, right=medium, top=thin, bottom=thin))
            for idx, (key, col) in enumerate(zip(size_keys, size_cols)):
                val = po.get(key, 0)
                set_cell(f'{col}{raw_row}', val if val > 0 else None,
                         font=font_normal, alignment=align_center,
                         border=make_border(left=thin if idx > 0 else None,
                                            right=medium if idx == len(size_cols)-1 else thin,
                                            top=thin, bottom=thin))
            # Nếu toàn bộ cỡ của PO trống thì tổng cũng để trống.
            set_cell(f'{total_col}{raw_row}',
                     f'=IF(COUNT({first_size_col}{raw_row}:{last_size_col}{raw_row})=0,"",SUM({first_size_col}{raw_row}:{last_size_col}{raw_row}))',
                     font=font_normal, alignment=align_center,
                     border=make_border(left=thin, right=medium, top=thin, bottom=thin))

            po_apply_increase = self._po_increase_active(po)
            if po_apply_increase:
                # Dòng ngay dưới PO: chỉ tạo khi PO được tích TĂNG %.
                current_row += 1
                excess_row = current_row
                po_excess_excel_rows.setdefault(po_name_for_map, []).append(excess_row)
                excess_po_rows_all.append(excess_row)
                ws.row_dimensions[excess_row].height = 22.0
                for col in ['C', 'D', 'E', 'F', 'G']:
                    set_cell(f'{col}{excess_row}', border=make_border(
                        left=medium if col == 'C' else None,
                        right=medium if col == 'F' else None,
                        top=thin, bottom=thin), fill=fill_theme9_tint80)
                ws.merge_cells(f'C{excess_row}:F{excess_row}')
                set_cell(f'C{excess_row}', 'SẢN LƯỢNG DƯƠNG / EXCESS QTY',
                         font=Font(name='Calibri', size=9, bold=True), alignment=align_center,
                         border=make_border(left=medium, right=medium, top=thin, bottom=thin),
                         fill=fill_theme9_tint80)
                for idx, (key, col) in enumerate(zip(size_keys, size_cols)):
                    pct_ref = percent_cells_by_col.get(col, '0')
                    # Không có SL gốc hoặc % không làm phát sinh thêm SP -> để trống.
                    extra_expr = f'ROUNDUP({col}{raw_row}*(1+{pct_ref}),0)-{col}{raw_row}'
                    formula = f'=IF({col}{raw_row}="","",IF({extra_expr}>0,{extra_expr},""))'
                    set_cell(f'{col}{excess_row}', formula, font=font_normal, alignment=align_center,
                             border=make_border(left=thin if idx > 0 else None,
                                                right=medium if idx == len(size_cols)-1 else thin,
                                                top=thin, bottom=thin), fill=fill_theme9_tint80)
                set_cell(f'{total_col}{excess_row}',
                         f'=IF(COUNT({first_size_col}{excess_row}:{last_size_col}{excess_row})=0,"",SUM({first_size_col}{excess_row}:{last_size_col}{excess_row}))',
                         font=font_bold, alignment=align_center,
                         border=make_border(left=thin, right=medium, top=thin, bottom=thin),
                         fill=fill_theme9_tint80)
            else:
                # Giữ vị trí tương ứng với raw_rows cho trường hợp trùng tên PO.
                po_excess_excel_rows.setdefault(po_name_for_map, []).append(None)

            current_row += 1

        # TỔNG ĐƠN HÀNG: merge C:G và tăng chiều cao.
        base_total_row = current_row
        ws.row_dimensions[base_total_row].height = 30.0
        for col in ['C', 'D', 'E', 'F']:
            set_cell(f'{col}{base_total_row}', border=make_border(
                left=medium if col == 'C' else None,
                right=medium if col == 'G' else None,
                top=medium, bottom=thin), fill=fill_total_order)
        ws.merge_cells(f'C{base_total_row}:F{base_total_row}')
        set_cell(f'C{base_total_row}', 'TỔNG ĐƠN HÀNG/TOTAL ORDER', font=font_bold, alignment=Alignment(horizontal='center', vertical='center', wrap_text=False, shrink_to_fit=True),
