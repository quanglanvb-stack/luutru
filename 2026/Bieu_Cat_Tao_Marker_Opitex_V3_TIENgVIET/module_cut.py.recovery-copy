                block_sr1 = source_first_row + li * MAX_TREE_ROWS_PER_LOT
                block_sr2 = min(source_last_row, block_sr1 + MAX_TREE_ROWS_PER_LOT - 1)
                if block_sr1 > source_last_row:
                    break
                if block is not None:
                    vbs = int(block['start_col'])
                    # V34: lấy LOẠI VẢI trực tiếp từ từng dòng cây nhìn thấy.
                    vis_assign_col = col_letter(vbs)
                    vis_mark_col = col_letter(vbs+1)
                    vis_lot_col = col_letter(vbs+2)
                    vis_roll_col = col_letter(vbs+3)
                    vis_meter_col = col_letter(vbs+5)
                    vis_width_col = col_letter(vbs+8)
                else:
                    vis_assign_col = vis_mark_col = vis_lot_col = vis_roll_col = vis_meter_col = vis_width_col = None

                for j in range(MAX_TREE_ROWS_PER_LOT):
                    sr = block_sr1 + j
                    if sr > block_sr2:
                        break
                    if block is not None:
                        vr = lot_data_first_row + j
                        # V58: mỗi DÒNG CÂY chỉ khớp đúng 1 LOẠI VẢI.
                        row_assign_ref = f'{vis_assign_col}{vr}'
                        safe_fname_upper = fname.upper().replace('"','""')
                        cond = f'UPPER(TRIM({row_assign_ref}))="{safe_fname_upper}"'
                        _eff_ref = f'{col_letter(vbs+9)}{vr}'
                        meter_formula = f'=IFERROR(IF({cond},MAX(0,N({_eff_ref})),0),0)'
                        edit_ws.cell(sr,bs+3,meter_formula)
                        edit_ws.cell(sr,bs+12,f'=IF(N({meter_col}{sr})>0,{vis_width_col}{vr},"")')
                        edit_ws.cell(sr,bs,   f'=IF(N({meter_col}{sr})>0,{vis_mark_col}{vr},"")')
                        edit_ws.cell(sr,bs+1, f'=IF(N({meter_col}{sr})>0,{vis_lot_col}{vr},"")')
                        edit_ws.cell(sr,bs+2, f'=IF(N({meter_col}{sr})>0,{vis_roll_col}{vr},"")')
                    else:
                        edit_ws.cell(sr,bs,'')
                        edit_ws.cell(sr,bs+1,'')
                        edit_ws.cell(sr,bs+2,'')
                        edit_ws.cell(sr,bs+3,0)
                    edit_ws.cell(sr,bs+3).number_format='0.00'
                    edit_ws.cell(sr,bs+6, sr-source_first_row+1)
                    edit_ws.cell(sr,bs+7, f'=IF(AND({lot_col}{sr}<>"",{roll_col}{sr}<>"",N({meter_col}{sr})>0),1,0)')
                    edit_ws.cell(sr,bs+8, f'=IF({lot_col}{sr}="",0,IF(COUNTIF(${lot_col}${source_first_row}:{lot_col}{sr},{lot_col}{sr})=1,1,0))')
                    edit_ws.cell(sr,bs+9, f'=IF({hfirst}{sr}=1,COUNTIF(${hfirst}${source_first_row}:{hfirst}{sr},1),0)')
                    edit_ws.cell(sr,bs+10,f'=IF({hvalid}{sr}=1,COUNTIF(${hvalid}${source_first_row}:{hvalid}{sr},1),0)')
                    edit_ws.cell(sr,bs+11,f'=IF({hvalid}{sr}=1,1,0)')

            info={
                'start_col':bs, 'first_row':source_first_row, 'last_row':source_last_row,
                'mark_col':mark_col, 'lot_col':lot_col, 'roll_col':roll_col, 'meter_col':meter_col,
                'status_col':status_col, 'note_col':note_col_src,
                'row_idx_col':hrow, 'valid_col':hvalid, 'lot_first_col':hfirst,
                'lot_order_col':hlotorder, 'tree_order_col':htreeorder, 'allow_col':hallow, 'width_col':hwidth,
            }
            edit_range_info_by_fabric[id(fabric)] = info
            prior_fabric_source_infos.append(info)

        # Trạng thái/GHI CHÚ nhìn thấy sẽ được nối lại sau khi _ROLL_CALC tính xong.
        for li, block in enumerate(lot_blocks):
            vbs=int(block['start_col'])
            for vr in range(lot_data_first_row, lot_data_last_row+1):
                lot_ref=f'{col_letter(vbs+2)}{vr}'
                roll_ref=f'{col_letter(vbs+3)}{vr}'
                meter_ref=f'{col_letter(vbs+5)}{vr}'
                edit_ws.cell(vr,vbs+6, f'=IF(OR({lot_ref}="",{roll_ref}="",N({meter_ref})<=0),"","CHƯA DÙNG")')
                edit_ws.cell(vr,vbs+7, f'=IF(OR({lot_ref}="",{roll_ref}="",N({meter_ref})<=0),"","Chưa dùng")')

        visible_last_row = lot_data_last_row
        for rr in range(visible_last_row+1, source_last_row+1):
            edit_ws.row_dimensions[rr].hidden = True

        # Helper Shade + helper cây ẩn cho từng loại vải, đọc vùng nguồn ẩn ở trên.
        for fabric in export_edit_fabrics:
            sec = supp_lot_input_rows.get(id(fabric), {}) or {}
            info = edit_range_info_by_fabric.get(id(fabric))
            if not info:
                continue
            fr, lr = info['first_row'], info['last_row']
            lot_rng = f"${info['lot_col']}${fr}:${info['lot_col']}${lr}"
            mark_rng = f"${info['mark_col']}${fr}:${info['mark_col']}${lr}"
            roll_rng = f"${info['roll_col']}${fr}:${info['roll_col']}${lr}"
            meter_rng = f"${info['meter_col']}${fr}:${info['meter_col']}${lr}"
            row_idx_rng = f"${info['row_idx_col']}${fr}:${info['row_idx_col']}${lr}"
            lot_order_rng = f"${info['lot_order_col']}${fr}:${info['lot_order_col']}${lr}"
            tree_order_rng = f"${info['tree_order_col']}${fr}:${info['tree_order_col']}${lr}"
            lot_rows = list(sec.get('input_rows',[]) or [])
            for n, agg_row in enumerate(lot_rows, start=1):
                src_idx = f'SUMIFS({row_idx_rng},{lot_order_rng},{n})'
                edit_ws.cell(agg_row,2, f'=IF(({src_idx})=0,"",INDEX({lot_rng},{src_idx}))')
                edit_ws.cell(agg_row,3, f'=IF(B{agg_row}="","",IFERROR(LOOKUP(2,1/(({lot_rng}=B{agg_row})*({mark_rng}<>"")),{mark_rng}),""))')
                edit_ws.cell(agg_row,4, f'=IF(B{agg_row}="",0,COUNTIFS({lot_rng},B{agg_row},{roll_rng},"<>",{meter_rng},">0"))')
                edit_ws.cell(agg_row,5, f'=IF(B{agg_row}="",0,SUMIFS({meter_rng},{lot_rng},B{agg_row}))')
                edit_ws.row_dimensions[agg_row].hidden = True

            ms = int(sec.get('mirror_start',0) or 0)
            me = int(sec.get('mirror_end',0) or 0)
            detail_infos=[]
            if ms > 0 and me >= ms:
                for idx, rr in enumerate(range(ms, me + 1), start=1):
                    src_idx=f'SUMIFS({row_idx_rng},{tree_order_rng},{idx})'
                    edit_ws.cell(rr,1,idx)
                    edit_ws.cell(rr,2,f'=IF(({src_idx})=0,"",INDEX({lot_rng},{src_idx}))')
                    edit_ws.cell(rr,3,f'=IF(({src_idx})=0,"",INDEX({mark_rng},{src_idx}))')
                    edit_ws.cell(rr,4,f'=IF(({src_idx})=0,"",INDEX({roll_rng},{src_idx}))')
                    edit_ws.cell(rr,5,f'=IF(({src_idx})=0,0,N(INDEX({meter_rng},{src_idx})))')
                    edit_ws.row_dimensions[rr].hidden=True
                    detail_infos.append({'row':rr})
            sec['detail_rows_info']=detail_infos

        edit_ws.freeze_panes='A7'
        edit_ws.sheet_properties.pageSetUpPr.fitToPage=True
        edit_ws.page_setup.orientation=edit_ws.ORIENTATION_LANDSCAPE
        edit_ws.page_setup.paperSize=edit_ws.PAPERSIZE_A4
        edit_ws.page_setup.fitToWidth=1
        edit_ws.page_setup.fitToHeight=0
        edit_ws.print_area=f'A1:{col_letter(edit_last_visible_col)}{visible_last_row}'

        # ===== V84: SHEET SỐ MÉT Shade CÒN LẠI sẽ tạo sau khi _ROLL_CALC hoàn tất =====

        # ===== V62: HELPER PHÂN CÂY ĐỌC TRỰC TIẾP VÙNG SỬA PHÂN CÂY =====
        # Không đi qua các dòng mirror/helper trên SỬA PHÂN CÂY nữa. Mỗi dòng helper
        # tương ứng trực tiếp với dòng thứ n của tblSuaPhanCay, vì vậy SỐ CÂY mới
        # thêm vào Table có thể được PHÂN CÂY dùng ngay.
        roll_calc_ws = wb.create_sheet("_ROLL_CALC")
        roll_calc_ws.sheet_state = 'hidden'
        roll_calc_ref = roll_calc_ws.title.replace("'", "''")
        roll_calc_info = {}
        rc_cursor = 1

        for res in results:
            fabric = res.get('fabric')
            helper = supp_lot_helper_info.get(id(fabric), {})
            main_rows_rc = list(helper.get('main_rows', []) or [])
            tables = res.get('cutting_tables', []) or []
            if not main_rows_rc:
                continue

            fname = str(fabric.get('name','') or '')
            safe_fname = fname.replace('"','""')
            reserve_m, reserve_plies = self._fabric_roll_reserve_settings(fabric)
            reserve_m_excel = (f"{reserve_m:.10f}".rstrip('0').rstrip('.') or '0')
            split_priority_width = str(fabric.get('split_priority','lot')).lower() == 'width'
            info_rc = edit_range_info_by_fabric.get(id(fabric))
            title_r = rc_cursor
            data_r1 = title_r + 2
            data_r2 = data_r1 + MAX_TREE_ROWS_PER_FABRIC - 1

            # A:G = nguồn trực tiếp từ vùng SỬA PHÂN CÂY.
            roll_calc_ws.cell(title_r,1,'STT TABLE')
            roll_calc_ws.cell(title_r,2,'LOẠI VẢI')
            roll_calc_ws.cell(title_r,3,'Shade')
            roll_calc_ws.cell(title_r,4,'Lot nhà sản xuất')
            roll_calc_ws.cell(title_r,5,'SỐ CÂY')
            roll_calc_ws.cell(title_r,6,'SỐ MÉT')
            roll_calc_ws.cell(title_r,7,'CHO PHÉP DÙNG')
            roll_calc_ws.cell(title_r,8,'KHỔ VẢI (cm)')

            # V91: ƯU TIÊN CÂY ĐANG DỞ + BEST-FIT CÂY MỚI TRONG TỪNG Shade, tự cập nhật theo CHIỀU DÀI SƠ ĐỒ.
            # -------------------------------------------------------------------------
            # Với mỗi bàn, Excel tự tính số lá tối đa từng cây còn có thể trải.
            # Sau đó xếp ưu tiên trong Shade:
            #   1) cây có sức chứa <= số lá bàn: chọn cây có sức chứa gần số lá bàn nhất
            #      để dùng hết tối đa số vải của cây đó;
            #   2) nếu cây lớn hơn số lá bàn: chọn cây để lại ít mét dư nhất;
            #   3) chỉ khi Shade hiện tại hết khả năng mới chuyển sang Shade kế tiếp.
            # Cây đã dùng ở bàn trước chỉ tiếp tục nếu phần vải còn lại có thể trải >= 3 lá.
            # Do CAP / FIT / RANK đều là công thức nên đổi CHIỀU DÀI SƠ ĐỒ sẽ tự đổi
            # cây được chọn, số cây và số lá từng cây mà không cần xuất lại Excel.
            table_count = len(main_rows_rc)
            real_table_indexes_rc = [i for i, t in enumerate(tables) if int(t.get('plies', 0) or 0) > 0]
            short_table_idx_rc = None
            if real_table_indexes_rc:
                min_len_rc = min(float(tables[i].get('length', 0) or 0) for i in real_table_indexes_rc)
                short_table_idx_rc = max(i for i in real_table_indexes_rc if abs(float(tables[i].get('length', 0) or 0) - min_len_rc) < 1e-9)

            # I... = sức chứa động (số lá tối đa) cho từng bàn; H dành riêng cho khổ vải.
            first_cap_col = 9
            cap_cols=[]
            for ti in range(table_count):
                ci=first_cap_col+ti
                cap_cols.append(col_letter(ci))
                roll_calc_ws.cell(title_r,ci,f'B{ti+1} SỨC CHỨA')

            # Sau CAP là điểm phù hợp (FIT) dùng để lọc cây trong cùng Shade.
            first_fit_col = first_cap_col + table_count
            fit_cols=[]
            for ti in range(table_count):
                ci=first_fit_col+ti
                fit_cols.append(col_letter(ci))
                roll_calc_ws.cell(title_r,ci,f'B{ti+1} FIT')

            # Ưu tiên khổ phù hợp riêng cho từng bàn.
            first_width_fit_col = first_fit_col + table_count
            width_fit_cols=[]
            for ti in range(table_count):
                ci=first_width_fit_col+ti
                width_fit_cols.append(col_letter(ci))
                roll_calc_ws.cell(title_r,ci,f'B{ti+1} ƯU TIÊN KHỔ')

            # Sau FIT KHỔ là số lá thực tế cấp cho cây.
            first_alloc_col = first_width_fit_col + table_count
            alloc_cols=[]
            for ti in range(table_count):
                ci=first_alloc_col+ti
                alloc_cols.append(col_letter(ci))
                roll_calc_ws.cell(title_r,ci,f'B{ti+1} LÁ')

            # RANK = thứ tự cây sau khi lọc best-fit. Các cây thực sự được dùng luôn
            # có rank liên tục 1..N nên PHÂN CÂY có thể lấy bằng MATCH như cũ.
            first_rank_col = first_alloc_col + table_count
            rank_cols=[]
            for ti in range(table_count):
                ci=first_rank_col+ti
                rank_cols.append(col_letter(ci))
                roll_calc_ws.cell(title_r,ci,f'B{ti+1} THỨ TỰ')

            # V50: đầu tấm chỉ được tính vào TỔNG của bàn nếu cây KHÔNG được dùng tiếp ở bàn sau.
            first_rem_col = first_rank_col + table_count
            remnant_cols=[]
            for ti in range(table_count):
                ci=first_rem_col+ti
                remnant_cols.append(col_letter(ci))
                roll_calc_ws.cell(title_r,ci,f'B{ti+1} ĐẦU TẤM TÍNH TỔNG')

            used_m_col_idx = first_rem_col + table_count
            used_m_col = col_letter(used_m_col_idx)
            roll_calc_ws.cell(title_r,used_m_col_idx,'MÉT ĐÃ DÙNG')
            first_flag_col_idx = used_m_col_idx + 1
            first_flag_col = col_letter(first_flag_col_idx)
            lot_order_col_idx = first_flag_col_idx + 1
            lot_order_col = col_letter(lot_order_col_idx)
            roll_calc_ws.cell(title_r,first_flag_col_idx,'Shade ĐẦU TIÊN')
            roll_calc_ws.cell(title_r,lot_order_col_idx,'THỨ TỰ Shade')
            # V88: bảng tổng hợp lấy mọi cây đã được dùng, kể cả khi mét còn lại bằng 0.
            # Tách riêng MÉT CÒN LẠI + THỨ TỰ CÂY để Excel tính ổn định.
            remaining_m_col_idx = lot_order_col_idx + 1
            remaining_m_col = col_letter(remaining_m_col_idx)
            remaining_rank_col_idx = remaining_m_col_idx + 1
            remaining_rank_col = col_letter(remaining_rank_col_idx)
            manufacturer_order_col_idx = remaining_rank_col_idx + 1
            manufacturer_order_col = col_letter(manufacturer_order_col_idx)
            roll_calc_ws.cell(title_r, remaining_m_col_idx, 'MÉT CÒN LẠI')
            roll_calc_ws.cell(title_r, remaining_rank_col_idx, 'THỨ TỰ CÂY CÒN LẠI')
            roll_calc_ws.cell(title_r, manufacturer_order_col_idx, 'THỨ TỰ LOT NHÀ SẢN XUẤT')

            for j in range(MAX_TREE_ROWS_PER_FABRIC):
                rr = data_r1 + j
                src_n = j + 1
                roll_calc_ws.cell(rr,1,src_n)
                if info_rc:
                    _fr, _lr = info_rc['first_row'], info_rc['last_row']
                    _lot_rng = f"'{edit_sheet_ref}'!${info_rc['lot_col']}${_fr}:${info_rc['lot_col']}${_lr}"
                    _mark_rng = f"'{edit_sheet_ref}'!${info_rc['mark_col']}${_fr}:${info_rc['mark_col']}${_lr}"
                    _roll_rng = f"'{edit_sheet_ref}'!${info_rc['roll_col']}${_fr}:${info_rc['roll_col']}${_lr}"
                    _meter_rng = f"'{edit_sheet_ref}'!${info_rc['meter_col']}${_fr}:${info_rc['meter_col']}${_lr}"
                    _allow_rng = f"'{edit_sheet_ref}'!${info_rc['allow_col']}${_fr}:${info_rc['allow_col']}${_lr}"
                    _width_rng = f"'{edit_sheet_ref}'!${info_rc['width_col']}${_fr}:${info_rc['width_col']}${_lr}"
                    roll_calc_ws.cell(rr,2,f'=IFERROR(IF(INDEX({_lot_rng},$A{rr})<>"","{safe_fname}",""),"")')
                    roll_calc_ws.cell(rr,3,f'=IFERROR(INDEX({_lot_rng},$A{rr}),"")')
                    roll_calc_ws.cell(rr,4,f'=IFERROR(INDEX({_mark_rng},$A{rr}),"")')
                    roll_calc_ws.cell(rr,5,f'=IFERROR(INDEX({_roll_rng},$A{rr}),"")')
                    roll_calc_ws.cell(rr,6,f'=IFERROR(N(INDEX({_meter_rng},$A{rr})),0)')
                    roll_calc_ws.cell(rr,7,f'=IFERROR(N(INDEX({_allow_rng},$A{rr})),0)')
                    roll_calc_ws.cell(rr,8,f'=IFERROR(VALUE(INDEX({_width_rng},$A{rr})),0)')
                else:
                    roll_calc_ws.cell(rr,2,'')
                    roll_calc_ws.cell(rr,3,'')
                    roll_calc_ws.cell(rr,4,'')
                    roll_calc_ws.cell(rr,5,'')
                    roll_calc_ws.cell(rr,6,0)
                    roll_calc_ws.cell(rr,7,0)
                    roll_calc_ws.cell(rr,8,0)
                roll_calc_ws.cell(rr,6).number_format='0.00'

                # Mét của cùng một cây đã được loại vải đứng trước sử dụng.
                prior_fabric_used_terms=[]
                for _pinfo in roll_calc_info.values():
                    _prr=int(_pinfo.get('data_start',0) or 0)+j
                    if _prr <= int(_pinfo.get('data_end',0) or 0):
                        prior_fabric_used_terms.append(
                            f"N('{roll_calc_ref}'!${_pinfo['used_m_col']}${_prr})"
                        )
                prior_fabric_used = '+'.join(prior_fabric_used_terms) if prior_fabric_used_terms else '0'

                # Shade order theo block 100 cây/Shade của SỬA PHÂN CÂY.
                # Ghi order cho MỌI cây trong Shade để có thể xếp hạng động bằng COUNTIFS/SUMIFS.
                lot_seq = int(j // MAX_TREE_ROWS_PER_LOT) + 1
                _width_rank_expr = f'IF(N(H{rr})>0,COUNTIF($H${data_r1}:$H${data_r2},"<"&H{rr})+1,1000000)'
                _maker_rank_expr = f'IFERROR(MATCH(D{rr},$D${data_r1}:$D${data_r2},0),1000000)'
                _primary_rank_expr = _width_rank_expr if split_priority_width else _maker_rank_expr
                _secondary_rank_expr = _maker_rank_expr if split_priority_width else _width_rank_expr
                _maker_rank_formula = (
                    f'=IF(AND(B{rr}="{safe_fname}",C{rr}<>"",E{rr}<>"",F{rr}>0,G{rr}=1),'
                    f'({_primary_rank_expr})*100000+({_secondary_rank_expr}),0)'
                )
                roll_calc_ws.cell(rr, manufacturer_order_col_idx, _maker_rank_formula)
                roll_calc_ws.cell(
                    rr, lot_order_col_idx,
                    f'=IF(AND(B{rr}="{safe_fname}",C{rr}<>"",E{rr}<>"",F{rr}>0,G{rr}=1),{lot_seq},0)'
                )

                # 1) CAP + FIT cho từng bàn.
                for ti, main_r in enumerate(main_rows_rc):
                    capc=cap_cols[ti]
                    fitc=fit_cols[ti]
                    mpp=f"(N('{main_sheet_ref}'!D{main_r})*1.01)"
                    target=f"N('{main_sheet_ref}'!G{main_r})"
                    prev_meter_terms=[]
                    prev_alloc_terms=[]
                    for pti, prev_main in enumerate(main_rows_rc[:ti]):
                        pac=alloc_cols[pti]
                        prev_meter_terms.append(
                            f"N({pac}{rr})*(N('{main_sheet_ref}'!D{prev_main})*1.01)"
                        )
                        prev_alloc_terms.append(f'N({pac}{rr})')
                    prev_used_m='+'.join(prev_meter_terms) if prev_meter_terms else '0'
                    prev_alloc='+'.join(prev_alloc_terms) if prev_alloc_terms else '0'
                    base_meter=f'MAX(0,N($F{rr})-({prior_fabric_used}))'
                    available_m=f'MAX(0,({base_meter})-({prev_used_m}))'
                    raw_cap=f'IF({mpp}>0,INT(({available_m})/{mpp}),0)'
                    # V163: sức chứa thực tế chừa đầu tấm theo thiết lập từng loại vải.
                    # Mặc định: nếu phần dư < 1.00 m thì bớt 1 lá.
                    raw_rem=f'MAX(0,({available_m})-({raw_cap})*({mpp}))'
                    reserve_cap=(
                        f'IF(AND(({raw_cap})>0,({raw_rem})<{reserve_m_excel}),'                         f'MAX(0,({raw_cap})-{reserve_plies}),({raw_cap}))'
                    )

                    # Cây đã xuất hiện ở bàn trước: nếu phần còn lại chỉ trải được 1-2 lá
                    # thì không cho vào bàn hiện tại; giữ lại để xét bàn ngắn hơn phía sau.
                    if ti == short_table_idx_rc:
                        # Bàn vét vẫn chừa đầu tấm theo ngưỡng/số lá đã cài,
                        # nhưng được nhận cả phần còn đủ 1-2 lá sau khi chừa.
                        effective_cap = reserve_cap
                    else:
                        effective_cap=f'IF(AND(({prev_alloc})>0,({reserve_cap})<3),0,({reserve_cap}))'
                    roll_calc_ws.cell(
                        rr, first_cap_col+ti,
                        f'=IFERROR(IF(OR($B{rr}<>"{safe_fname}",TRIM($C{rr})="",TRIM($E{rr})="",'
                        f'N($F{rr})<=0,N($G{rr})<>1,{mpp}<=0,{target}<=0),0,MAX(0,{effective_cap})),0)'
                    )
                    roll_calc_ws.cell(rr, first_cap_col+ti).number_format='0'

                    # FIT càng nhỏ càng tốt.
                    # - CAP <= target: ưu tiên CAP gần target, rồi ưu tiên phần mét lẻ sau khi
                    #   trải hết CAP càng nhỏ càng tốt.
                    # - CAP > target: cây này là cây chốt; ưu tiên phần mét còn lại sau khi
                    #   hoàn tất target càng nhỏ càng tốt.
                    remainder_full=f'MAX(0,({available_m})-N({capc}{rr})*({mpp}))'
                    remainder_finish=f'MAX(0,({available_m})-({target})*({mpp}))'
                    # Ưu tiên cây đã mở; giữa các cây đang dở cùng LOT/Shade thì
                    # dùng cây còn ít mét trước để không bỏ đầu tấm nhỏ và làm dư cây khác.
                    # Giới hạn điểm mét ở 900 m để cây mới (1E+15) luôn đứng sau cây dở.
                    opened_priority=f'IF(({prev_alloc})>0,0,1E+15)'
                    opened_rem_priority=(
                        f'IF(({prev_alloc})>0,ROUND(MIN(900,MAX(0,({available_m}))) * 1000,0) * 1000000000,0)'
                    )
                    fit_formula=(
                        f'=IF(N({capc}{rr})<=0,1E+15,({opened_priority})+({opened_rem_priority})+'
                        f'IF(N({capc}{rr})<=({target}),'
                        f'(({target})-N({capc}{rr}))*100000000+ROUND(({remainder_full})*1000,0)*1000+(100000-N({capc}{rr})),'
                        f'1000000000000+ROUND(({remainder_finish})*1000,0)*1000+(N({capc}{rr})-({target}))))'
                    )
                    roll_calc_ws.cell(rr, first_fit_col+ti, fit_formula)
                    roll_calc_ws.cell(rr, first_fit_col+ti).number_format='0'
                    # Điểm chọn khổ riêng cho bàn: đủ nhu cầu thì phần dư ít nhất đứng trước;
                    # nếu không khổ nào đủ thì ưu tiên khổ thiếu ít nhất.
                    _width_range = f'$H${data_r1}:$H${data_r2}'
                    _width_ref = f'$H${rr}'
                    _group_cap = f'SUMIFS(${capc}${data_r1}:${capc}${data_r2},{_width_range},{_width_ref})'
                    _width_score = f'IF(N({_width_ref})<=0,1E+15,IF(({_group_cap})>=({target}),({_group_cap})-({target}),1E+10+({target})-({_group_cap})))'
                    roll_calc_ws.cell(rr, first_width_fit_col+ti, f'=IF(N({capc}{rr})<=0,1E+15,{_width_score})')

                # 2) RANK + ALLOC cho từng bàn.
                for ti, main_r in enumerate(main_rows_rc):
                    capc=cap_cols[ti]
                    fitc=fit_cols[ti]
                    ac=alloc_cols[ti]
                    rc=rank_cols[ti]
                    target=f"N('{main_sheet_ref}'!G{main_r})"
                    cap_rng=f'${capc}${data_r1}:${capc}${data_r2}'
                    fit_rng=f'${fitc}${data_r1}:${fitc}${data_r2}'
                    lotord_rng=f'${lot_order_col}${data_r1}:${lot_order_col}${data_r2}'
                    maker_rng=f'${manufacturer_order_col}${data_r1}:${manufacturer_order_col}${data_r2}'
                    width_fitc=width_fit_cols[ti]
                    width_fit_rng=f'${width_fitc}${data_r1}:${width_fitc}${data_r2}'
                    width_fit_ref=f'${width_fitc}${rr}'
                    idx_rng=f'$A${data_r1}:$A${data_r2}'
                    rank_rng=f'${rc}${data_r1}:${rc}${data_r2}'
                    lotord_ref=f'${lot_order_col}{rr}'
                    maker_ref=f'${manufacturer_order_col}{rr}'
                    fit_ref=f'${fitc}{rr}'

                    # Khi ưu tiên khổ, xếp nhóm khổ phù hợp của bàn trước rồi xét Lot/cây.
                    if split_priority_width:
                        rank_formula=(
                            f'=IF(OR(N({capc}{rr})<=0,N({lotord_ref})<=0,N({maker_ref})<=0),0,'
                            f'COUNTIFS({width_fit_rng},"<"&{width_fit_ref},{cap_rng},">0")+'
                            f'COUNTIFS({width_fit_rng},{width_fit_ref},{maker_rng},"<"&{maker_ref},{cap_rng},">0")+'
                            f'COUNTIFS({width_fit_rng},{width_fit_ref},{maker_rng},{maker_ref},{lotord_rng},"<"&{lotord_ref},{cap_rng},">0")+'
                            f'COUNTIFS({width_fit_rng},{width_fit_ref},{maker_rng},{maker_ref},{lotord_rng},{lotord_ref},{fit_rng},"<"&{fit_ref},{cap_rng},">0")+'
                            f'COUNTIFS({width_fit_rng},{width_fit_ref},{maker_rng},{maker_ref},{lotord_rng},{lotord_ref},{fit_rng},{fit_ref},{idx_rng},"<="&$A{rr},{cap_rng},">0"))'
                        )
                    else:
                        rank_formula=(
                            f'=IF(OR(N({capc}{rr})<=0,N({lotord_ref})<=0,N({maker_ref})<=0),0,'
                            f'COUNTIFS({maker_rng},">0",{maker_rng},"<"&{maker_ref},{cap_rng},">0")+'
                            f'COUNTIFS({maker_rng},{maker_ref},{lotord_rng},">0",{lotord_rng},"<"&{lotord_ref},{cap_rng},">0")+'
                            f'COUNTIFS({maker_rng},{maker_ref},{lotord_rng},{lotord_ref},{cap_rng},">0",{fit_rng},"<"&{fit_ref})+'
                            f'COUNTIFS({maker_rng},{maker_ref},{lotord_rng},{lotord_ref},{cap_rng},">0",{fit_rng},{fit_ref},{idx_rng},"<="&$A{rr}))'
                        )
                    roll_calc_ws.cell(rr, first_rank_col+ti, rank_formula)
                    roll_calc_ws.cell(rr, first_rank_col+ti).number_format='0'

                    # Tổng sức chứa của các cây xếp trước. Các cây trước được dùng hết;
                    # cây chốt chỉ lấy phần còn thiếu. Khi đổi marker length, CAP/RANK đổi
                    # nên số cây được dùng cũng tự đổi.
                    prior_capacity=(
                        f'SUMIFS({cap_rng},{rank_rng},">0",{rank_rng},"<"&N({rc}{rr}))'
                    )
                    need=f'MAX(0,({target})-({prior_capacity}))'
                    alloc_formula=(
                        f'=IFERROR(IF(OR(N({rc}{rr})<=0,N({capc}{rr})<=0,({need})<=0),0,'
                        f'MIN(N({capc}{rr}),({need}))),0)'
                    )
                    roll_calc_ws.cell(rr, first_alloc_col+ti, alloc_formula)
                    roll_calc_ws.cell(rr, first_alloc_col+ti).number_format='0'

                # V50: phần đầu tấm được phép hiển thị ở từng bàn, nhưng chỉ cộng vào
                # dòng TỔNG của bàn cuối cùng mà cây đó thực sự xuất hiện. Nếu cây còn
                # được lấy sang bất kỳ bàn phía sau thì đầu tấm tại bàn hiện tại = 0 khi tính tổng.
                base_meter_for_rem=f'MAX(0,N($F{rr})-({prior_fabric_used}))'
                for ti, main_r in enumerate(main_rows_rc):
                    ac=alloc_cols[ti]
                    later_alloc_terms=[f'N({alloc_cols[k]}{rr})' for k in range(ti+1, len(main_rows_rc))]
                    later_alloc='+'.join(later_alloc_terms) if later_alloc_terms else '0'
                    used_through_terms=[]
                    for k, _mr in enumerate(main_rows_rc[:ti+1]):
                        used_through_terms.append(
                            f"N({alloc_cols[k]}{rr})*(N('{main_sheet_ref}'!D{_mr})*1.01)"
                        )
                    used_through='+'.join(used_through_terms) if used_through_terms else '0'
                    rem_formula=(
                        f'=IF(N({ac}{rr})<=0,0,IF(({later_alloc})>0,0,'
                        f'MAX(0,({base_meter_for_rem})-({used_through}))))'
                    )
                    roll_calc_ws.cell(rr, first_rem_col+ti, rem_formula)
                    roll_calc_ws.cell(rr, first_rem_col+ti).number_format='0.00'

                used_terms=[]
                for ti, main_r in enumerate(main_rows_rc):
                    ac=alloc_cols[ti]
                    used_terms.append(f"N({ac}{rr})*(N('{main_sheet_ref}'!D{main_r})*1.01)")
                roll_calc_ws.cell(rr,used_m_col_idx,'=' + ('+'.join(used_terms) if used_terms else '0'))
                roll_calc_ws.cell(rr,used_m_col_idx).number_format='0.00'

                # V88: số mét còn lại thật; bảng tổng hợp chỉ xếp hạng cây có MÉT ĐÃ DÙNG > 0.
                # prior_fabric_used đã được tính ở trên theo cùng vị trí cây.
                roll_calc_ws.cell(
                    rr, remaining_m_col_idx,
                    f'=IFERROR(IF(OR($B{rr}<>"{safe_fname}",TRIM($C{rr})="",TRIM($E{rr})="",N($F{rr})<=0,N($G{rr})<>1),0,'
                    f'MAX(0,N($F{rr})-({prior_fabric_used})-N(${used_m_col}{rr}))),0)'
                )
                roll_calc_ws.cell(rr, remaining_m_col_idx).number_format='0.00'
                # Rank liên tục 1..N cho các cây còn mét, theo đúng thứ tự nguồn.
                _rem_rng = f'${remaining_m_col}${data_r1}:${remaining_m_col}${data_r2}'
                _used_rng = f'${used_m_col}${data_r1}:${used_m_col}${data_r2}'
                _b_rng = f'$B${data_r1}:$B${data_r2}'
                _g_rng = f'$G${data_r1}:$G${data_r2}'
                _e_rng = f'$E${data_r1}:$E${data_r2}'
                _a_rng = f'$A${data_r1}:$A${data_r2}'
                # Xếp hạng mọi cây đã thực sự được dùng cho loại vải này, kể cả cây đã dùng hết mét.
                # Các dòng cây mới điền trong SỬA PHÂN CÂY cũng được nhận bởi công thức vùng nguồn.
                roll_calc_ws.cell(
                    rr, remaining_rank_col_idx,
                    f'=IF(OR($B{rr}<>"{safe_fname}",N(${used_m_col}{rr})<=0,N($G{rr})<>1,TRIM($E{rr})=""),0,'
                    f'COUNTIFS({_b_rng},"{safe_fname}",{_g_rng},1,{_e_rng},"<>",{_used_rng},">0",{_a_rng},"<="&$A{rr}))'
                )
                roll_calc_ws.cell(rr, remaining_rank_col_idx).number_format='0'

                # SỬA PHÂN CÂY hiển thị ĐÃ DÙNG / CHƯA DÙNG theo phân bổ thật.
                if info_rc:
                    _er = int(info_rc['first_row']) + j
                    _lotc = f"{info_rc['lot_col']}{_er}"
                    _rollc = f"{info_rc['roll_col']}{_er}"
                    _metc = f"{info_rc['meter_col']}{_er}"
                    _usedref = f"'{roll_calc_ref}'!${used_m_col}${rr}"
                    edit_ws[f"{info_rc['status_col']}{_er}"] = (
                        f'=IF(OR({_lotc}="",{_rollc}="",N({_metc})<=0),"",IF(N({_usedref})>0,"ĐÃ DÙNG","CHƯA DÙNG"))'
                    )
                    edit_ws[f"{info_rc['note_col']}{_er}"] = (
                        f'=IF(OR({_lotc}="",{_rollc}="",N({_metc})<=0),"",'
                        f'IF(N({_usedref})>0,"Cây đã dùng | còn "&TEXT(MAX(0,N({_metc})-N({_usedref})),"0.00")&" m","Chưa dùng"))'
                    )

                # Đánh dấu dòng đầu tiên của Shade; summary vẫn lấy Shade theo lot_order.
                if rr == data_r1:
                    prev_count='0'
                else:
                    prev_count=f'COUNTIFS($B${data_r1}:B{rr-1},"{safe_fname}",$C${data_r1}:C{rr-1},C{rr})'
                roll_calc_ws.cell(
                    rr, first_flag_col_idx,
                    f'=IF(AND(B{rr}="{safe_fname}",C{rr}<>"",E{rr}<>"",F{rr}>0,G{rr}=1,({prev_count})=0),1,0)'
                )

            # Tối đa 50 Shade / loại vải; Shade mới thêm trong vùng nhập được nhận tự động.
            summary_r1 = data_r2 + 2
            summary_r2 = summary_r1 + MAX_DYNAMIC_LOTS - 1
            sum_name_col=1; sum_cap_col=2; sum_used_col=3; sum_note_col=4; sum_first_plies_col=5
            roll_calc_ws.cell(summary_r1-1,sum_name_col,'TỔNG HỢP Shade')
            roll_calc_ws.cell(summary_r1-1,sum_cap_col,'TỔNG MÉT')
            roll_calc_ws.cell(summary_r1-1,sum_used_col,'MÉT ĐÃ DÙNG')
            roll_calc_ws.cell(summary_r1-1,sum_note_col,'GHI CHÚ Shade')
            for ti in range(len(main_rows_rc)):
                roll_calc_ws.cell(summary_r1-1,sum_first_plies_col+ti,f'B{ti+1} LÁ / Shade')

            for si in range(MAX_DYNAMIC_LOTS):
                sr=summary_r1+si
                order_no=si+1
                pos_expr=f'MATCH({order_no},${lot_order_col}${data_r1}:${lot_order_col}${data_r2},0)'
                roll_calc_ws.cell(sr,sum_name_col,
                    f'=IFERROR(INDEX($C${data_r1}:$C${data_r2},{pos_expr}),"")')
                roll_calc_ws.cell(sr,sum_cap_col,
                    f'=IF($A{sr}="",0,SUMIFS($F${data_r1}:$F${data_r2},$B${data_r1}:$B${data_r2},"{safe_fname}",$C${data_r1}:$C${data_r2},$A{sr},$G${data_r1}:$G${data_r2},1))')
                roll_calc_ws.cell(sr,sum_used_col,
                    f'=IF($A{sr}="",0,SUMIFS(${used_m_col}${data_r1}:${used_m_col}${data_r2},$B${data_r1}:$B${data_r2},"{safe_fname}",$C${data_r1}:$C${data_r2},$A{sr},$G${data_r1}:$G${data_r2},1))')
                roll_calc_ws.cell(sr,sum_cap_col).number_format='0.00'
                roll_calc_ws.cell(sr,sum_used_col).number_format='0.00'
                if sr==summary_r1:
                    note_prefix='""'
                else:
                    note_prefix=f'IF(COUNTIF($B${summary_r1}:B{sr-1},">0")>0,CHAR(10),"")'
                roll_calc_ws.cell(sr,sum_note_col,
                    f'=IF(AND($A{sr}<>"",$B{sr}>0),{note_prefix}&$A{sr}&": Tổng "&TEXT($B{sr},"0.00")&'
                    f'" m | dùng "&TEXT($C{sr},"0.00")&" m | dư "&TEXT(MAX(0,$B{sr}-$C{sr}),"0.00")&" m","")')
                for ti,ac in enumerate(alloc_cols):
                    pc=col_letter(sum_first_plies_col+ti)
                    roll_calc_ws.cell(sr,sum_first_plies_col+ti,
                        f'=IF($A{sr}="",0,SUMIFS(${ac}${data_r1}:${ac}${data_r2},$B${data_r1}:$B${data_r2},"{safe_fname}",$C${data_r1}:$C${data_r2},$A{sr}))')
                    roll_calc_ws.cell(sr,sum_first_plies_col+ti).number_format='0'

            # BIỂU CẮT: Shade chỉ hiện một lần / Shade; nếu thiếu thì thêm THIẾU.
            for ti,main_r in enumerate(main_rows_rc):
                ac=alloc_cols[ti]
                pc=col_letter(sum_first_plies_col+ti)
                lot_parts=[]
                for sr in range(summary_r1,summary_r2+1):
                    name_ref=f"'{roll_calc_ref}'!$A${sr}"
                    plies_ref=f"'{roll_calc_ref}'!${pc}${sr}"
                    if sr==summary_r1:
                        prefix='""'
                    else:
                        prev_range=f"'{roll_calc_ref}'!${pc}${summary_r1}:${pc}{sr-1}"
                        prefix=f'IF(COUNTIF({prev_range},">0")>0," | ","")'
                    lot_parts.append(f'IF({plies_ref}>0,{prefix}&{name_ref}&": "&{plies_ref}&" lá","")')
                total_alloc_expr=f"SUM('{roll_calc_ref}'!{ac}${data_r1}:{ac}${data_r2})"
                missing=f"MAX(0,N('{main_sheet_ref}'!G{main_r})-({total_alloc_expr}))"
                all_plies_range=f"'{roll_calc_ref}'!${pc}${summary_r1}:${pc}${summary_r2}"
                miss_prefix=f'IF(COUNTIF({all_plies_range},">0")>0," | ","")'
                lot_parts.append(f'IF(({missing})>0,{miss_prefix}&"THIẾU: "&({missing})&" lá","")')
                ws[f'E{main_r}']='=IF(OR(TRIM($C%d)="",$D%d="",$G%d=""),"",%s)' % (
                    main_r,main_r,main_r,'&'.join(lot_parts))
                ws[f'E{main_r}'].alignment=Alignment(horizontal='center',vertical='center',wrap_text=False,shrink_to_fit=False)

            note_refs=[f"'{roll_calc_ref}'!$D${sr}" for sr in range(summary_r1,summary_r2+1)]
            note_formula='='+'&'.join(note_refs) if note_refs else '=""'
            for main_r in main_rows_rc:
                _note_cell=ws[f'{note_col}{main_r}']
                if _note_cell.__class__.__name__=='MergedCell':
                    continue
                _note_cell.value=note_formula
                _note_cell.alignment=Alignment(horizontal='left',vertical='center',wrap_text=True,shrink_to_fit=False)

            roll_calc_info[id(fabric)]={
                'title_row':title_r,'data_start':data_r1,'data_end':data_r2,
                'alloc_cols':alloc_cols,'rank_cols':rank_cols,'remnant_cols':remnant_cols,'used_m_col':used_m_col,
                'remaining_m_col': remaining_m_col, 'remaining_rank_col': remaining_rank_col,
                'main_rows':main_rows_rc,'source_fabric_col':'B','source_lot_col':'C',
                'source_mark_col':'D','source_roll_col':'E','source_meter_col':'F','source_allow_col':'G',
                'summary_start':summary_r1,'summary_end':summary_r2,
                'summary_first_plies_col':col_letter(sum_first_plies_col)
            }
            rc_cursor=summary_r2+3

        # Khổ vải trên BIỂU CẮT lấy động từ SỬA PHÂN CÂY sau khi xuất file.
        # _ROLL_CALC nhóm các cây cùng khổ và cộng số lá theo từng bàn.
        _width_acc_next_col = roll_calc_ws.max_column + 1
        for _res_width in results:
            _fabric_width = _res_width.get('fabric')
            _width_cells = cut_fabric_width_cells.get(id(_fabric_width), {})
            _rc_width = roll_calc_info.get(id(_fabric_width), {})
            if not _width_cells or not _rc_width:
                continue
            _width_start = int(_rc_width.get('data_start', 0) or 0)
            _width_end = int(_rc_width.get('data_end', 0) or 0)
            _width_alloc_cols = list(_rc_width.get('alloc_cols', []) or [])
            for _table_pos, _alloc_col in enumerate(_width_alloc_cols):
                _target_width = _width_cells.get(_table_pos)
                if not _target_width:
                    continue
                _target_ws, _target_coord = _target_width
                _acc_col_idx = _width_acc_next_col
                _width_acc_next_col += 1
                _acc_col = col_letter(_acc_col_idx)
                roll_calc_ws.cell(int(_rc_width.get('title_row', 1) or 1), _acc_col_idx,
                                  f'B{_table_pos + 1} KHỔ VẢI TỔNG HỢP')
                for _rr_width in range(_width_start, _width_end + 1):
                    _prev_acc = f'{_acc_col}{_rr_width - 1}' if _rr_width > _width_start else '""'
                    _width_ref = f'$H{_rr_width}'
                    _alloc_ref = f'${_alloc_col}{_rr_width}'
                    if _rr_width > _width_start:
                        _seen_width = (
                            f'COUNTIFS($H${_width_start}:H{_rr_width - 1},{_width_ref},'
                            f'${_alloc_col}${_width_start}:${_alloc_col}{_rr_width - 1},">0")'
                        )
                    else:
                        _seen_width = '0'
                    _width_total_plies = (
                        f'SUMIFS(${_alloc_col}${_width_start}:${_alloc_col}${_width_end},'
                        f'$H${_width_start}:$H${_width_end},{_width_ref})'
                    )
                    _width_append = (
                        f'IF({_prev_acc}<>"",{_prev_acc}&" | ","")&'
                        f'TEXT(N({_width_ref}),"0.##")&" cm ("&{_width_total_plies}&" lá)"'
                    )
                    _acc_formula = (
                        f'=IF(OR(N({_width_ref})<=0,N({_alloc_ref})<=0),{_prev_acc},'
                        f'IF({_seen_width}>0,{_prev_acc},{_width_append}))'
                    )
                    roll_calc_ws.cell(_rr_width, _acc_col_idx, _acc_formula)
                _target_ws[_target_coord] = f"='{roll_calc_ref}'!${_acc_col}${_width_end}"
                _target_ws[_target_coord].alignment = Alignment(
                    horizontal='center', vertical='center', wrap_text=True)

        # LOT nhà sản xuất trên BIỂU CẮT lấy từ đúng các cây mà _ROLL_CALC đã cấp
        # cho từng bàn, để khớp với danh sách cây hiển thị trên PHÂN CÂY.
        for _res_marks in results:
            _fabric_marks = _res_marks.get('fabric')
            _mark_cells = cut_manufacturer_mark_cells.get(id(_fabric_marks), {})
            _rc_marks = roll_calc_info.get(id(_fabric_marks), {})
            if not _mark_cells or not _rc_marks:
                continue
            _mark_start = int(_rc_marks.get('data_start', 0) or 0)
            _mark_end = int(_rc_marks.get('data_end', 0) or 0)
            _mark_col = str(_rc_marks.get('source_mark_col', 'D') or 'D')
            _alloc_cols_for_marks = list(_rc_marks.get('alloc_cols', []) or [])
            _maker_values = []
            _fabric_name_for_marks = str((_fabric_marks or {}).get('name', '') or '').strip()
            for _source_block in lot_blocks:
                _block_assignment = str(_source_block.get('assigned', '') or '').strip()
                _roll_map_for_marks = _source_block.get('roll_fabric_map', {}) or {}
                for _roll_mark in (_source_block.get('details', []) or []):
                    _maker = str(_roll_mark.get('lot_mark', _source_block.get('lot_mark', '')) or '').strip()
                    _roll_name = str(_roll_mark.get('roll', '') or '').strip()
                    _roll_key = (_roll_name.lower(), _maker.lower())
                    _row_fabric = str(_roll_map_for_marks.get(_roll_key, '') or '').strip()
                    if not _row_fabric:
                        _row_fabric = str(_roll_map_for_marks.get(_roll_name.lower(), '') or '').strip()
                    if not _row_fabric:
                        _row_fabric = _block_assignment if _block_assignment.upper() != 'CHƯA GÁN' and ' + ' not in _block_assignment else ''
                    if _row_fabric == _fabric_name_for_marks and _maker and _maker not in _maker_values:
                        _maker_values.append(_maker)
            _mark_range = f"'{roll_calc_ref}'!${_mark_col}${_mark_start}:${_mark_col}${_mark_end}"
            for _table_pos, _alloc_col in enumerate(_alloc_cols_for_marks):
                _target = _mark_cells.get(_table_pos)
                if not _target:
                    continue
                _target_ws, _target_cell = _target
                _alloc_range = f"'{roll_calc_ref}'!${_alloc_col}${_mark_start}:${_alloc_col}${_mark_end}"
                _mark_parts = []
                _prior_mark_sums = []
                for _maker in _maker_values:
                    _safe_maker = _maker.replace('\"', '\"\"')
                    _maker_sum = f'SUMIFS({_alloc_range},{_mark_range},\"{_safe_maker}\")'
                    _prefix = f'IF(SUM({",".join(_prior_mark_sums)})>0,\" | \",\"\")&' if _prior_mark_sums else ''
                    _mark_parts.append(f'IF({_maker_sum}>0,{_prefix}\"{_safe_maker}\",\"\")')
                    _prior_mark_sums.append(_maker_sum)
                _mark_formula = '&'.join(_mark_parts) if _mark_parts else '\"\"'
                _target_ws[_target_cell] = f'=IFERROR({_mark_formula},\"\")'
                _target_ws[_target_cell].alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)

        # ===== V32: ĐỒNG BỘ TRẠNG THÁI/GHI CHÚ CÂY + THIẾU MÉT THEO LOẠI VẢI =====
        # Sau khi _ROLL_CALC đã tính xong, nối ngược kết quả về từng cụm Shade.
        # Mỗi dòng cây chỉ thuộc 1 loại vải; dòng trùng Shade+CÂY là đầu tấm được chuyển thủ công sang loại vải khác.
        for li, block in enumerate(lot_blocks):
            vbs = int(block['start_col'])
            used_refs_by_fabric = []
            for fabric in export_edit_fabrics:
                rinfo = roll_calc_info.get(id(fabric))
                if not rinfo:
                    continue
                fname = str(fabric.get('name','') or '')
                used_refs_by_fabric.append((fname, rinfo))

            for j, vr in enumerate(range(lot_data_first_row, lot_data_last_row+1)):
                lot_ref=f'{col_letter(vbs+2)}{vr}'
                roll_ref=f'{col_letter(vbs+3)}{vr}'
                meter_ref=f'{col_letter(vbs+5)}{vr}'
                per_fabric_parts=[]
                used_refs=[]
                for fname, rinfo in used_refs_by_fabric:
                    rr = int(rinfo['data_start']) + li * MAX_TREE_ROWS_PER_LOT + j
                    if rr > int(rinfo['data_end']):
                        continue
                    uref=f"'{roll_calc_ref}'!${rinfo['used_m_col']}${rr}"
                    used_refs.append(uref)
                    safe_label=fname.replace('"','""')
                    if per_fabric_parts:
                        prev_sum='+'.join(f'N({x})' for x in used_refs[:-1]) or '0'
                        prefix=f'IF(({prev_sum})>0," | ","")&'
                    else:
                        prefix=''
                    per_fabric_parts.append(
                        f'IF(N({uref})>0,{prefix}"{safe_label}: "&TEXT(N({uref}),"0.00")&" m","")'
                    )
                total_used_expr = '+'.join(f'N({x})' for x in used_refs) if used_refs else '0'
                detail_expr = '&'.join(per_fabric_parts) if per_fabric_parts else '""'

                # V58: GHI CHÚ cây gốc tự trừ phần đầu tấm đã chuyển sang dòng khác.
                _fab_col = col_letter(vbs)
                _mark_col_v = col_letter(vbs+1)
                _lot_col_v = col_letter(vbs+2)
                _roll_col_v = col_letter(vbs+3)
                _meter_col_v = col_letter(vbs+5)
                _fab_ref = f'{_fab_col}{vr}'
                _mark_ref = f'{_mark_col_v}{vr}'
                _seen_count = (
                    f'COUNTIFS(${_lot_col_v}${lot_data_first_row}:{_lot_col_v}{vr},{lot_ref},'
                    f'${_mark_col_v}${lot_data_first_row}:${_mark_col_v}{vr},{_mark_ref},'
                    f'${_roll_col_v}${lot_data_first_row}:${_roll_col_v}{vr},{roll_ref})'
                )
                if vr < lot_data_last_row:
                    _later_m = f'${_meter_col_v}${vr+1}:${_meter_col_v}${lot_data_last_row}'
                    _later_l = f'${_lot_col_v}${vr+1}:${_lot_col_v}${lot_data_last_row}'
                    _later_k = f'${_mark_col_v}${vr+1}:${_mark_col_v}${lot_data_last_row}'
                    _later_r = f'${_roll_col_v}${vr+1}:${_roll_col_v}${lot_data_last_row}'
                    _later_f = f'${_fab_col}${vr+1}:${_fab_col}${lot_data_last_row}'
                    _later_nonblank = f'SUMIFS({_later_m},{_later_l},{lot_ref},{_later_k},{_mark_ref},{_later_r},{roll_ref},{_later_f},"<>")'
                    _later_same = f'SUMIFS({_later_m},{_later_l},{lot_ref},{_later_k},{_mark_ref},{_later_r},{roll_ref},{_later_f},{_fab_ref})'
                    transfer_out_expr = f'IF(({_seen_count})=1,MAX(0,({_later_nonblank})-({_later_same})),0)'
                else:
                    transfer_out_expr = '0'
                _activity_expr = f'(({total_used_expr})+({transfer_out_expr}))'
                edit_ws.cell(vr,vbs+6,
                    f'=IF(OR({lot_ref}="",{roll_ref}="",N({meter_ref})<=0),"",IF({_activity_expr}>0,"ĐÃ DÙNG","CHƯA DÙNG"))')
                # V181: GHI CHÚ chỉ còn Dùng bao nhiêu m | còn bao nhiêu m.
                # Dùng format 0.## để 1.20m hiển thị thành 1.2m, 2.00m thành 2m.
                edit_ws.cell(vr,vbs+7,
                    f'=IF(OR({lot_ref}="",{roll_ref}="",N({meter_ref})<=0),"",'
                    f'IF({_activity_expr}>0,'
                    f'"Dùng "&TEXT(MAX(0,{_activity_expr}),"0.##")&"m | còn "&'
                    f'TEXT(MAX(0,N({meter_ref})-({_activity_expr})),"0.##")&"m",'
                    f'"Chưa dùng"))')

            # Dòng 5 của cụm: tổng hợp loại vải nào thực tế đã dùng bao nhiêu mét từ Shade này.
            summary_parts=[]
            summary_used_refs=[]
            for fname, rinfo in used_refs_by_fabric:
                rr1 = int(rinfo['data_start']) + li * MAX_TREE_ROWS_PER_LOT
                rr2 = min(int(rinfo['data_end']), rr1 + MAX_TREE_ROWS_PER_LOT - 1)
                if rr1 > int(rinfo['data_end']):
                    continue
                sref=f"SUM('{roll_calc_ref}'!${rinfo['used_m_col']}${rr1}:${rinfo['used_m_col']}${rr2})"
                summary_used_refs.append(sref)
                safe_label=fname.replace('"','""')
                if summary_parts:
                    prev_sum='+'.join(f'({x})' for x in summary_used_refs[:-1]) or '0'
                    prefix=f'IF(({prev_sum})>0," | ","")&'
                else:
                    prefix=''
                summary_parts.append(f'IF(({sref})>0,{prefix}"{safe_label}: "&TEXT(({sref}),"0.00")&" m","")')
            visible_meter_col=col_letter(vbs+5)
            effective_meter_col=col_letter(int(block.get('effective_meter_col', vbs+9)))
            lot_total_expr=f'SUM({effective_meter_col}${lot_data_first_row}:{effective_meter_col}${lot_data_last_row})'
            lot_used_expr='+'.join(f'({x})' for x in summary_used_refs) if summary_used_refs else '0'
            summary_text='&'.join(summary_parts) if summary_parts else '""'
            summary_cell=edit_ws.cell(5,vbs+2)
            summary_cell.value=(
                f'=IF(({lot_used_expr})>0,"PHÂN BỔ: "&({summary_text})&" | DƯ Shade: "&'
                f'TEXT(MAX(0,({lot_total_expr})-({lot_used_expr})),"0.00")&" m","PHÂN BỔ: chưa sử dụng | DƯ Shade: "&TEXT(({lot_total_expr}),"0.00")&" m")'
            )
            summary_cell.alignment=Alignment(horizontal='left',vertical='center',wrap_text=True)

        # V34: KHÔNG ghi thiếu mét lên BIỂU CẮT. Thiếu mét chỉ hiển thị tại SỬA PHÂN CÂY.
        # Dòng 3 của SỬA PHÂN CÂY tổng hợp thiếu mét theo từng loại vải và tự cập nhật.
        shortage_parts=[]
        for fabric in export_edit_fabrics:
            rinfo = roll_calc_info.get(id(fabric))
            finfo = fabric_excel_info.get(id(fabric), {}) or {}
            need_expr = str(finfo.get('need_total_ref','0') or '0')
            if not rinfo:
                continue
            used_expr=f"SUM('{roll_calc_ref}'!${rinfo['used_m_col']}${rinfo['data_start']}:${rinfo['used_m_col']}${rinfo['data_end']})"
            missing_expr=f'MAX(0,({need_expr})-({used_expr}))'
            safe_name=str(fabric.get('name','') or '').replace('"','""')
            prefix='""' if not shortage_parts else '" | "'
            shortage_parts.append(f'{prefix}&"{safe_name}: "&TEXT(({missing_expr}),"0.00")&" m"')
        if shortage_parts:
            try:
                edit_ws.merge_cells(start_row=3,start_column=1,end_row=3,end_column=edit_last_visible_col)
            except Exception:
                pass
            edit_ws['A3']='="THIẾU VẢI: "&' + '&'.join(shortage_parts)
            edit_ws['A3'].font=Font(name='Calibri',size=11,bold=True,color='C00000')
            edit_ws['A3'].fill=PatternFill('solid',fgColor='FCE4D6')
            edit_ws['A3'].alignment=Alignment(horizontal='left',vertical='center',wrap_text=True)
            edit_ws.row_dimensions[3].height=24

        # ===== V84: SỐ MÉT Shade CÒN LẠI =====
        # Chỉ giữ 4 cột: Shade | Lot nhà sản xuất | SỐ CÂY | SỐ MÉT CÒN LẠI.
        # Công thức liên kết trực tiếp SỬA PHÂN CÂY + _ROLL_CALC nên khi đổi
        # chiều dài/số lá/phân cây hoặc nhập DÒNG DƯ, số mét còn lại tự cập nhật.
        remain_ws = wb.create_sheet('SỐ MÉT SHADE CÒN LẠI')
        remain_ws.sheet_view.showGridLines = False
        remain_ws.merge_cells('A1:D1')
        remain_ws['A1'] = 'SỐ MÉT SHADE CÒN LẠI'
        remain_ws['A1'].font = Font(name='Calibri', size=18, bold=True, color='FFFFFF')
        remain_ws['A1'].fill = edit_fill_title
        remain_ws['A1'].alignment = Alignment(horizontal='center', vertical='center')
        remain_ws.merge_cells('A2:D2')
        remain_ws['A2'] = 'Tự cập nhật theo SỬA PHÂN CÂY. Dòng đã dùng hết sẽ để trống; dòng còn mét hoặc dòng dư mới nhập sẽ hiện số mét còn lại.'
        remain_ws['A2'].alignment = Alignment(wrap_text=True, vertical='center')
        remain_ws.row_dimensions[1].height = 30
        remain_ws.row_dimensions[2].height = 34
        remain_headers = ['Shade', 'Lot nhà sản xuất', 'SỐ CÂY', 'SỐ MÉT CÒN LẠI']
        for ci, hv in enumerate(remain_headers, start=1):
            c = remain_ws.cell(4, ci, hv)
            c.font = edit_header_font
            c.fill = edit_fill_header
            c.border = edit_border
            c.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)

        remain_row = 5
        for li, block in enumerate(lot_blocks):
            vbs = int(block['start_col'])
            details = list(block.get('details', []) or [])
            source_rows = list(range(lot_data_first_row, lot_data_first_row + min(len(details), MAX_TREE_ROWS_PER_LOT)))
            for er in (block.get('extra_rows', []) or []):
                if er not in source_rows:
                    source_rows.append(er)
            source_rows = sorted(set(r for r in source_rows if lot_data_first_row <= r <= lot_data_last_row))

            for vr in source_rows:
                j = vr - lot_data_first_row
                lot_ref = f"'{edit_sheet_ref}'!{col_letter(vbs+2)}{vr}"
                mark_ref = f"'{edit_sheet_ref}'!{col_letter(vbs+1)}{vr}"
                roll_ref = f"'{edit_sheet_ref}'!{col_letter(vbs+3)}{vr}"
                meter_ref = f"'{edit_sheet_ref}'!{col_letter(vbs+5)}{vr}"
                fab_ref = f"'{edit_sheet_ref}'!{col_letter(vbs)}{vr}"

                used_refs = []
                for fabric in export_edit_fabrics:
                    rinfo = roll_calc_info.get(id(fabric))
                    if not rinfo:
                        continue
                    rr = int(rinfo['data_start']) + li * MAX_TREE_ROWS_PER_LOT + j
                    if rr <= int(rinfo['data_end']):
                        used_refs.append(f"N('{roll_calc_ref}'!${rinfo['used_m_col']}${rr})")
                total_used_expr = '+'.join(used_refs) if used_refs else '0'

                # V93: chuyển đầu tấm chỉ áp dụng khi trùng đủ Shade + Lot nhà sản xuất + SỐ CÂY.
                # Hai cây cùng số nhưng khác Lot nhà sản xuất là hai cây độc lập.
                seen_count = (
                    f'COUNTIFS(\'{edit_sheet_ref}\'!${col_letter(vbs+2)}${lot_data_first_row}:'
                    f'${col_letter(vbs+2)}{vr},{lot_ref},'
                    f'\'{edit_sheet_ref}\'!${col_letter(vbs+1)}${lot_data_first_row}:'
                    f'${col_letter(vbs+1)}{vr},{mark_ref},'
                    f'\'{edit_sheet_ref}\'!${col_letter(vbs+3)}${lot_data_first_row}:'
                    f'${col_letter(vbs+3)}{vr},{roll_ref})'
                )
                if vr < lot_data_last_row:
                    later_m = f"'{edit_sheet_ref}'!${col_letter(vbs+5)}${vr+1}:${col_letter(vbs+5)}${lot_data_last_row}"
                    later_l = f"'{edit_sheet_ref}'!${col_letter(vbs+2)}${vr+1}:${col_letter(vbs+2)}${lot_data_last_row}"
                    later_k = f"'{edit_sheet_ref}'!${col_letter(vbs+1)}${vr+1}:${col_letter(vbs+1)}${lot_data_last_row}"
                    later_r = f"'{edit_sheet_ref}'!${col_letter(vbs+3)}${vr+1}:${col_letter(vbs+3)}${lot_data_last_row}"
                    later_f = f"'{edit_sheet_ref}'!${col_letter(vbs)}${vr+1}:${col_letter(vbs)}${lot_data_last_row}"
                    later_nonblank = f'SUMIFS({later_m},{later_l},{lot_ref},{later_k},{mark_ref},{later_r},{roll_ref},{later_f},"<>")'
                    later_same = f'SUMIFS({later_m},{later_l},{lot_ref},{later_k},{mark_ref},{later_r},{roll_ref},{later_f},{fab_ref})'
                    transfer_out_expr = f'IF(({seen_count})=1,MAX(0,({later_nonblank})-({later_same})),0)'
                else:
                    transfer_out_expr = '0'

                remain_expr = f'MAX(0,N({meter_ref})-({total_used_expr})-({transfer_out_expr}))'
                valid_expr = f'AND({lot_ref}<>"",{roll_ref}<>"",N({meter_ref})>0,({remain_expr})>0)'
                vals = [
                    f'=IF({valid_expr},{lot_ref},"")',
                    f'=IF({valid_expr},{mark_ref},"")',
                    f'=IF({valid_expr},{roll_ref},"")',
                    f'=IF({valid_expr},ROUND(({remain_expr}),2),"")',
                ]
                for ci, val in enumerate(vals, start=1):
                    c = remain_ws.cell(remain_row, ci, val)
                    c.border = edit_border
                    c.font = edit_font
                    c.alignment = Alignment(horizontal='center', vertical='center')
                remain_ws.cell(remain_row, 4).number_format = '0.00'
                remain_row += 1

        # Nếu không có cây nào vẫn để một dòng trống có khung.
        if remain_row == 5:
            for ci in range(1, 5):
                remain_ws.cell(5, ci).border = edit_border
            remain_row = 6
        remain_ws.column_dimensions['A'].width = 16
        remain_ws.column_dimensions['B'].width = 20
        remain_ws.column_dimensions['C'].width = 14
        remain_ws.column_dimensions['D'].width = 20
        remain_ws.freeze_panes = 'A5'
        remain_ws.auto_filter.ref = f'A4:D{max(4, remain_row-1)}'
        remain_ws.sheet_properties.pageSetUpPr.fitToPage = True
        remain_ws.page_setup.orientation = remain_ws.ORIENTATION_PORTRAIT
        remain_ws.page_setup.paperSize = remain_ws.PAPERSIZE_A4
        remain_ws.page_setup.fitToWidth = 1
        remain_ws.page_setup.fitToHeight = 0
        remain_ws.print_title_rows = '1:4'
        remain_ws.print_area = f'A1:D{max(5, remain_row-1)}'

        # V50: tô màu để phân biệt cây đã dùng/chưa dùng trong SỬA PHÂN CÂY.
        used_fill = PatternFill('solid', fgColor='E2F0D9')      # xanh nhạt
        unused_fill = PatternFill('solid', fgColor='E7E6E6')    # xám nhạt
        for _block in lot_blocks:
            _bs=int(_block['start_col'])
            _be=int(_block['end_col'])
            _status_col=col_letter(_bs+6)
            _rng=f'{col_letter(_bs)}{lot_data_first_row}:{col_letter(_be)}{lot_data_last_row}'
            edit_ws.conditional_formatting.add(
                _rng, FormulaRule(formula=[f'${_status_col}{lot_data_first_row}="ĐÃ DÙNG"'], stopIfTrue=False, fill=used_fill))
            edit_ws.conditional_formatting.add(
                _rng, FormulaRule(formula=[f'${_status_col}{lot_data_first_row}="CHƯA DÙNG"'], stopIfTrue=False, fill=unused_fill))

        # V84: sheet SỐ MÉT Shade CÒN LẠI không cần tô màu trạng thái.

        # ===== SHEET PHÂN CÂY - FORM SHADING BAND =====
        # Bố cục theo mẫu người dùng: 4 bàn ngang / cụm, mỗi bàn 7 cột.
        # Cột: Shade | Lot nhà sản xuất | cây (roll#) | Chiều dài (Y) | Chiều dài (M)
        #      | số lá (tiêu đề cột hiển thị chiều dài sơ đồ) | đầu tấm.
        roll_results = [r for r in results if bool(r.get('fabric', {}).get('export_roll', True))]
        roll_sheet_needed = bool(roll_results)
        if roll_sheet_needed:
            roll_ws = wb.create_sheet("PHÂN CÂY")
            roll_ws.sheet_view.showGridLines = False
            # V95: khóa 4 dòng đầu; khi cuộn, dòng 1-4 luôn hiển thị.
            roll_ws.freeze_panes = 'A5'

            # ---------- style ----------
            shade_font = Font(name='Times New Roman', size=9)
            shade_font_bold = Font(name='Times New Roman', size=9, bold=True)
            shade_font_title = Font(name='Times New Roman', size=14, bold=True)
            shade_font_info = Font(name='Times New Roman', size=9, bold=True)
            shade_thin = Side(style='thin', color='808080')
            shade_medium = Side(style='medium', color='000000')
            shade_border = Border(left=shade_thin, right=shade_thin, top=shade_thin, bottom=shade_thin)
            shade_center = Alignment(horizontal='center', vertical='center', wrap_text=True)
            shade_left = Alignment(horizontal='left', vertical='center', wrap_text=False)

            # Mỗi bàn rộng 8 cột và có 1 cột đệm trắng để khung các bàn tách rời.
            block_starts = [1, 10, 19, 28]  # A, J, S, AB; I/R/AA là cột đệm
            block_width = 8
            last_col_idx = 35  # AI

            # Mỗi bàn có 8 cột dữ liệu; cột đệm giữa bàn hẹp và không có viền.
            # V183: đúng yêu cầu 5.00 (~40px).
            _shade_col_width = 5.00
            for _ci in range(1, last_col_idx + 1):
                roll_ws.column_dimensions[col_letter(_ci)].width = _shade_col_width
            for _spacer_col in (9, 18, 27):
                roll_ws.column_dimensions[col_letter(_spacer_col)].width = 2.50

            def _set_range_border(ws2, min_row, min_col, max_row, max_col, outer=shade_medium):
                """Kẻ viền mảnh bên trong và viền ngoài đậm cho một block."""
                for r2 in range(min_row, max_row + 1):
                    for c2 in range(min_col, max_col + 1):
                        cell = ws2.cell(r2, c2)
                        cell.border = Border(
                            left=outer if c2 == min_col else shade_thin,
                            right=outer if c2 == max_col else shade_thin,
                            top=outer if r2 == min_row else shade_thin,
                            bottom=outer if r2 == max_row else shade_thin,
                        )

            def _safe_merge(ws2, start_row, start_col, end_row, end_col):
                try:
                    ws2.merge_cells(start_row=start_row, start_column=start_col,
                                    end_row=end_row, end_column=end_col)
                except Exception:
                    pass

            # ---------- Header chung ----------
            _safe_merge(roll_ws, 1, 1, 1, last_col_idx - 3)
            roll_ws.cell(1, 1, 'BẢNG PHÂN Shade MÀU/SHADING BAND')
            roll_ws.cell(1, 1).font = shade_font_title
            roll_ws.cell(1, 1).alignment = shade_center
            roll_ws.row_dimensions[1].height = 25

            # V89: PHÂN CÂY lấy THÔNG TIN CHUNG trực tiếp từ sheet BIỂU CẮT bằng công thức.
            # Nhờ vậy nếu sửa KHÁCH HÀNG / MÃ HÀNG / ĐỢT / MÙA / MÀU / CODE / DATE
            # trên BIỂU CẮT sau khi xuất, PHÂN CÂY cũng tự cập nhật theo.
            _safe_merge(roll_ws, 1, last_col_idx - 2, 2, last_col_idx)
            roll_ws.cell(1, last_col_idx - 2, f"='{main_sheet_ref}'!$N$1")
            roll_ws.cell(1, last_col_idx - 2).font = Font(name='Times New Roman', size=9, bold=True)
            roll_ws.cell(1, last_col_idx - 2).alignment = shade_center
            _set_range_border(roll_ws, 1, last_col_idx - 2, 2, last_col_idx)

            # Logo vùng A2:B4.
            if getattr(self, 'logo_path', None) and os.path.isfile(self.logo_path):
                try:
                    logo2 = XLImage(self.logo_path)
                    logo2.width = 95
                    logo2.height = 70
                    logo2.anchor = 'A2'
                    roll_ws.add_image(logo2)
                except Exception:
                    pass

            # BIỂU CẮT lưu thông tin chuẩn ở C3/C4, H3/H4 và cột MÀU động.
            # Công thức dưới đây bỏ phần nhãn trước dấu ':' rồi gắn nhãn đúng của PHÂN CÂY.
            def _cut_info_value(cell_ref):
                src = f"'{main_sheet_ref}'!${cell_ref}"
                return f'IFERROR(TRIM(MID({src},FIND(":",{src})+1,999)),"")'

            customer_expr = _cut_info_value('C$3')
            style_expr = _cut_info_value('C$4')
            batch_expr = _cut_info_value('F$3')
            season_expr = _cut_info_value('F$4')
            color_expr = _cut_info_value('I$3')
            date_expr = _cut_info_value('M$3')
            prepared_by_expr = _cut_info_value('M$4')

            # Bố cục đồng nhất với BIỂU CẮT, mỗi nhóm có vùng rộng riêng.
            # Khách hàng/Mã hàng bên trái; Đợt/Mùa dịch trái; Ngày/Người lập bên phải.
            _safe_merge(roll_ws, 2, 3, 2, 8)
            roll_ws.cell(2, 3, f'="KHÁCH HÀNG (BUYER) : "&({customer_expr})')
            _safe_merge(roll_ws, 3, 3, 3, 8)
            roll_ws.cell(3, 3, f'="MÃ HÀNG (STYLE) : "&({style_expr})')

            _safe_merge(roll_ws, 2, 9, 2, 14)
            roll_ws.cell(2, 9, f'="ĐỢT/BATCH: "&({batch_expr})')
            _safe_merge(roll_ws, 3, 9, 3, 14)
            roll_ws.cell(3, 9, f'="MÙA/SEASON: "&({season_expr})')

            _safe_merge(roll_ws, 2, 15, 2, 24)
            roll_ws.cell(2, 15, f'="NGÀY/DATE: "&({date_expr})')
            _safe_merge(roll_ws, 3, 15, 3, 24)
            roll_ws.cell(3, 15, f'="NGƯỜI LẬP BIỂU: "&({prepared_by_expr})')

            # Màu hiển thị phía trái ở hàng riêng, tránh đè lên ngày.
            _safe_merge(roll_ws, 4, 3, 4, 24)
            roll_ws.cell(4, 3, f'="MÀU/COLOR: "&({color_expr})')

            for rr, cc in ((2,3),(3,3),(2,9),(3,9),(2,15),(3,15),(4,3)):
                roll_ws.cell(rr, cc).font = shade_font_info
                roll_ws.cell(rr, cc).alignment = shade_center

            current_row_roll = 5

            # Mỗi loại vải có phần thông tin riêng rồi các bàn theo nhóm 4.
            for res in roll_results:
                fabric = res['fabric']
                # Đồng bộ lại Shade tự động trước khi lập sheet.
                self._sync_roll_lots(fabric)

                # V98: PO ở PHÂN CÂY chỉ là TÊN hiển thị do người dùng chọn riêng.
                # KHÔNG ảnh hưởng số lượng/tính toán: phần tính vẫn dùng toàn bộ PO áp dụng của loại vải.
                roll_po_names = self._fabric_roll_po_names(fabric)
                po_text = ' + '.join(roll_po_names)
                _safe_merge(roll_ws, current_row_roll, 1, current_row_roll, 10)
                _fabric_header_text = f"CHỦNG LOẠI VẢI (KIND OF FABRIC): {fabric.get('name','')}"
                roll_ws.cell(current_row_roll, 1, _fabric_header_text)
                roll_ws.cell(current_row_roll, 1).font = shade_font_info
                roll_ws.cell(current_row_roll, 1).alignment = Alignment(
                    horizontal='center', vertical='center', wrap_text=True, shrink_to_fit=False)
                _safe_merge(roll_ws, current_row_roll, 11, current_row_roll, last_col_idx)
                safe_po_text = str(po_text or '').replace('"', '""')
                roll_ws.cell(current_row_roll, 11, f'="PO: {safe_po_text}"')
                roll_ws.cell(current_row_roll, 11).font = shade_font_info
                roll_ws.cell(current_row_roll, 11).alignment = Alignment(
                    horizontal='center', vertical='center', wrap_text=True, shrink_to_fit=False)
                _fabric_lines = max(1, math.ceil(len(_fabric_header_text) / 52))
                _po_lines = max(1, math.ceil(len(str(po_text or '')) / 88))
                roll_ws.row_dimensions[current_row_roll].height = max(22, 8 + 17 * max(_fabric_lines, _po_lines))
                for c2 in range(1, last_col_idx + 1):
                    roll_ws.cell(current_row_roll, c2).border = Border(bottom=shade_medium)
                current_row_roll += 1

                tables = res.get('cutting_tables', []) or []
                helper = supp_lot_helper_info.get(id(fabric), {})
                rcinfo = roll_calc_info.get(id(fabric), {})
                rc_data_start = int(rcinfo.get('data_start', 0) or 0)
                rc_alloc_cols = list(rcinfo.get('alloc_cols', []) or [])
                rc_rank_cols = list(rcinfo.get('rank_cols', []) or [])
                rc_remnant_cols = list(rcinfo.get('remnant_cols', []) or [])
                roll_calc_ref_pc = roll_calc_ws.title.replace("'", "''")
                main_rows_pc_all = list(helper.get('main_rows', []) or [])
                # V82: PHÂN CÂY giữ đủ bàn thực tế + đúng 3 bàn dự phòng như BIỂU CẮT.
                table_slot_count = min(len(main_rows_pc_all), len(tables) + RESERVE_TABLES_PER_FABRIC)
                table_indexes = list(range(table_slot_count))
                real_indexes = [i for i, t in enumerate(tables) if int(t.get('plies', 0) or 0) > 0]
                short_idx = None
                if real_indexes:
                    min_len_pc = min(float(tables[i].get('length',0) or 0) for i in real_indexes)
                    short_idx = max(i for i in real_indexes if abs(float(tables[i].get('length',0) or 0)-min_len_pc)<1e-9)
                if not table_indexes:
                    current_row_roll += 2
                    continue

                # V100: khung mỗi nhóm bàn chỉ cao theo số cây thực tế dự kiến của bàn
                # có nhiều cây nhất trong nhóm + số dòng trống do người dùng chọn.
                # Không còn lấy tổng số cây của cả loại vải + 12 nên tránh lãng phí giấy.
                # Biến tổng cây vẫn giữ để dùng riêng cho bảng tổng hợp cuối loại vải.
                initial_active_tree_count = sum(
                    1 for rr in (fabric.get('rolls', []) or [])
                    if str(rr.get('roll','') or '').strip() and float(rr.get('length',0) or 0) > 0
                )
                extra_blank_rows_pc = self._get_roll_extra_blank_rows(silent=True)

                def _estimate_table_roll_counts(_fabric, _tables):
                    _reserve_m, _reserve_plies = self._fabric_roll_reserve_settings(_fabric)
                    _states = []
                    for _i, _r in enumerate((_fabric or {}).get('rolls', []) or []):
                        try:
                            _length = max(0.0, float(_r.get('length', 0) or 0))
                        except Exception:
                            _length = 0.0
                        if _length <= 0:
                            continue
                        _states.append({
                            'source_index': _i,
                            'lot': str(_r.get('lot','') or '').strip(),
                            'lot_mark': str(_r.get('lot_mark', _r.get('manufacturer_lot', '')) or '').strip(),
                            'remaining': _length,
                            'had_alloc': False,
                        })
                    _lot_order = {}
                    _maker_order = {}
                    for _st in _states:
                        if _st['lot'] not in _lot_order:
                            _lot_order[_st['lot']] = len(_lot_order) + 1
                        if _st['lot_mark'] not in _maker_order:
                            _maker_order[_st['lot_mark']] = len(_maker_order) + 1
                    _counts = []
                    _eps = 1e-9
                    _real_est = [i for i, t in enumerate(_tables or []) if int(t.get('plies', 0) or 0) > 0]
                    _short_est = None
                    if _real_est:
                        _min_len_est = min(float((_tables or [])[i].get('length', 0) or 0) for i in _real_est)
                        _short_est = max(i for i in _real_est if abs(float((_tables or [])[i].get('length', 0) or 0) - _min_len_est) < 1e-9)
                    for _table_pos, _t in enumerate(_tables or []):
                        try:
                            _target = max(0, int(_t.get('plies', 0) or 0))
                            _mpp = max(0.0, float(_t.get('length', 0) or 0)) * 1.01
                        except Exception:
                            _target, _mpp = 0, 0.0
                        if _target <= 0 or _mpp <= 0:
                            _counts.append(0)
                            continue
                        _cands = []
                        for _st in _states:
                            _raw_cap = max(0, int((_st['remaining'] + _eps) // _mpp))
                            if _raw_cap > 0:
                                _rem_after_raw = max(0.0, _st['remaining'] - _raw_cap * _mpp)
                                _reserve_cap = (max(0, _raw_cap - _reserve_plies)
                                                if _rem_after_raw < _reserve_m - _eps else _raw_cap)
                            else:
                                _reserve_cap = 0
                            _cap = _reserve_cap if _table_pos == _short_est else (0 if (_st['had_alloc'] and _reserve_cap < 3) else _reserve_cap)
                            if _cap <= 0:
                                continue
                            if _cap <= _target:
                                _rem_full = max(0.0, _st['remaining'] - _cap * _mpp)
                                _fit = ((_target - _cap) * 100000000
                                        + round(_rem_full * 1000) * 1000
                                        + (100000 - _cap))
                            else:
                                _rem_finish = max(0.0, _st['remaining'] - _target * _mpp)
                                _fit = (1000000000000
                                        + round(_rem_finish * 1000) * 1000
                                        + (_cap - _target))
                            if _st['had_alloc']:
                                _fit += min(900.0, max(0.0, _st['remaining'])) * 1_000_000_000_000
                            else:
                                _fit += 1_000_000_000_000_000
                            _cands.append((_maker_order.get(_st['lot_mark'], 10**9),
                                           _lot_order.get(_st['lot'], 10**9), _fit,
                                           _st['source_index'], _cap, _st))
                        _cands.sort(key=lambda x: (x[0], x[1], x[2], x[3]))
                        _prior_capacity = 0
                        _used_rows = 0
                        for _makerord, _lotord, _fit, _src, _cap, _st in _cands:
                            _need = max(0, _target - _prior_capacity)
                            if _need <= 0:
                                break
                            _alloc = min(_cap, _need)
                            if _alloc <= 0:
                                continue
                            _st['remaining'] = max(0.0, _st['remaining'] - _alloc * _mpp)
                            _st['had_alloc'] = True
                            _prior_capacity += _cap
                            _used_rows += 1
                        _counts.append(_used_rows)
                    return _counts

                _initial_tables_pc = _excel_initial_tables(res)
                _table_roll_counts_pc = _estimate_table_roll_counts(fabric, _initial_tables_pc)
                # V88: ghi nhớ nhóm cuối để đặt bảng TỔNG HỢP song song với bàn cuối
                # nếu hàng đó vẫn còn cột trống. Chỉ khi đủ 4 block mới xuống hàng dưới.
                last_group_title_row = None
                last_group_total_row = None
                last_group_slots = 0

                # 4 bàn ngang / nhóm.
                for group_pos in range(0, len(table_indexes), 4):
                    group = table_indexes[group_pos:group_pos + 4]
                    real_rows_in_group = max(
                        [(_table_roll_counts_pc[i] if i < len(_table_roll_counts_pc) else 0)
                         for i in group] or [0]
                    )
                    # Ít nhất 1 dòng dữ liệu; bàn dự phòng vẫn có đúng số dòng trống người dùng chọn.
                    body_rows = max(1, min(80, int(real_rows_in_group) + int(extra_blank_rows_pc)))
                    title_row = current_row_roll
                    header_row = title_row + 1
                    data_start = header_row + 1
                    total_row = data_start + body_rows

                    for slot, table_idx in enumerate(group):
                        bs = block_starts[slot]
                        be = bs + block_width - 1
                        table = tables[table_idx] if table_idx < len(tables) else {'table': f'B{table_idx+1}', 'length': 0, 'plies': 0, 'ratio_map': {}}
                        table_name = str(table.get('table', f'B{table_idx+1}'))
                        marker_len = float(table.get('length', 0) or 0)
                        is_short = (table_idx == short_idx)

                        # Title block.
                        _safe_merge(roll_ws, title_row, bs, title_row, be)
                        main_rows_pc = helper.get('main_rows', []) or []
                        mr_pc = int(main_rows_pc[table_idx]) if table_idx < len(main_rows_pc) else 0
                        active_expr_pc = f"TRIM('{main_sheet_ref}'!C{mr_pc})<>\"\"" if mr_pc else 'FALSE'
                        # V90: chỉ hiển thị số bàn. Không gắn nhãn "BÀN NGẮN CUỐI"
                        # vì khi người dùng thêm bàn dự phòng trong Excel, nhãn tĩnh đó
                        # không thể tự chuyển sang bàn mới cuối cùng.
                        title = f"BÀN {table_name.replace('B','',1)}"
                        roll_ws.cell(title_row, bs, f'=IF({active_expr_pc},"{title}","")' if mr_pc else '')
                        roll_ws.cell(title_row, bs).font = shade_font_bold
                        roll_ws.cell(title_row, bs).alignment = shade_center
                        roll_ws.row_dimensions[title_row].height = 21

                        # Header 8 cột. Cột chiều dài marker dùng chính chiều dài sơ đồ làm tiêu đề.
                        header_vals = [
                            'Shade', 'Lot nhà\nsản xuất', 'Khổ vải\n(cm)', 'cây\n(roll#)',
                            'Chiều\ndài (Y)', 'Chiều\ndài (M)', '', 'đầu tấm'
                        ]
                        for off, hv in enumerate(header_vals):
                            if off == 6:
                                val = f"=IF({active_expr_pc},N('{main_sheet_ref}'!D{mr_pc}),\"\")" if mr_pc else ''
                            else:
                                safe_hv = str(hv).replace('"','""')
                                val = f'=IF({active_expr_pc},"{safe_hv}","")' if mr_pc else ''
                            cell = roll_ws.cell(header_row, bs + off, val)
                            cell.font = shade_font_bold
                            cell.alignment = shade_center
                        if mr_pc:
                            roll_ws.cell(header_row, bs + 6).number_format = '0.0'
                        roll_ws.row_dimensions[header_row].height = 50

                        # V54: nén cây đang dùng lên ngay dưới tiêu đề, không để dòng trống ở giữa.
                        # AGGREGATE tìm cây thứ n có số lá > 0 của đúng bàn hiện tại.
                        for j in range(body_rows):
                            r2 = data_start + j
                            if table_idx < len(rc_alloc_cols) and rc_data_start > 0:
                                ac = rc_alloc_cols[table_idx]
                                rk = rc_rank_cols[table_idx] if table_idx < len(rc_rank_cols) else ''
                                rc_r1 = rc_data_start
                                rc_r2 = int(rcinfo.get('data_end', 0) or 0)
                                if rk and rc_r2 >= rc_r1:
                                    pos_expr = f"IFERROR(MATCH({j+1},'{roll_calc_ref_pc}'!${rk}${rc_r1}:${rk}${rc_r2},0),999999)"
                                else:
                                    pos_expr = '999999'
                                tree_plies = f"IFERROR(INDEX('{roll_calc_ref_pc}'!${ac}${rc_r1}:${ac}${rc_r2},{pos_expr}),0)"
                                lot_src = f"IFERROR(INDEX('{roll_calc_ref_pc}'!$C${rc_r1}:$C${rc_r2},{pos_expr}),\"\")"
                                mark_src = f"IFERROR(INDEX('{roll_calc_ref_pc}'!$D${rc_r1}:$D${rc_r2},{pos_expr}),\"\")"
                                width_src = f"IFERROR(INDEX('{roll_calc_ref_pc}'!$H${rc_r1}:$H${rc_r2},{pos_expr}),0)"
                                roll_src = f"IFERROR(INDEX('{roll_calc_ref_pc}'!$E${rc_r1}:$E${rc_r2},{pos_expr}),\"\")"
                                meter_src = f"IFERROR(N(INDEX('{roll_calc_ref_pc}'!$F${rc_r1}:$F${rc_r2},{pos_expr})),0)"
                                main_rows_pc = helper.get('main_rows', []) or []
                                mpp_ref = f"(N('{main_sheet_ref}'!D{main_rows_pc[table_idx]})*1.01)" if table_idx < len(main_rows_pc) else '0'
                                # Tổng mét cây đã dùng ở các bàn trước, lấy cùng vị trí nguồn.
                                prev_terms=[]
                                for pti in range(min(table_idx,len(rc_alloc_cols))):
                                    pac=rc_alloc_cols[pti]
                                    if pti < len(main_rows_pc):
                                        prev_terms.append(f"IFERROR(INDEX('{roll_calc_ref_pc}'!${pac}${rc_r1}:${pac}${rc_r2},{pos_expr}),0)*(N('{main_sheet_ref}'!D{main_rows_pc[pti]})*1.01)")
                                used_before_tree = '+'.join(prev_terms) if prev_terms else '0'
                                start_available = f'MAX(0,({meter_src})-({used_before_tree}))'
                                rem_tree = f'MAX(0,({start_available})-({tree_plies})*({mpp_ref}))'
                                formulas = [
                                    f'=IF(({tree_plies})>0,{lot_src},"")',
                                    f'=IF(({tree_plies})>0,{mark_src},"")',
                                    f'=IF(({tree_plies})>0,{width_src},"")',
                                    f'=IF(({tree_plies})>0,{roll_src},"")',
                                    f'=IF(({tree_plies})>0,IFERROR(({start_available})/0.9144,""),"")',
                                    f'=IF(({tree_plies})>0,{start_available},"")',
                                    f'=IF(({tree_plies})>0,{tree_plies},"")',
                                    f'=IF(({tree_plies})>0,{rem_tree},"")',
                                ]
                                for off, val in enumerate(formulas):
                                    cell = roll_ws.cell(r2, bs + off, val)
                                    cell.font = shade_font; cell.alignment = shade_center
                                for off in (4,5,7): roll_ws.cell(r2, bs + off).number_format='0.0'
                                roll_ws.cell(r2, bs + 2).number_format='0.##'
                            else:
                                for off in range(8): roll_ws.cell(r2, bs + off, '')
                            roll_ws.row_dimensions[r2].height = 20

                        # Dòng tổng động theo các Shade đang thực sự dùng ở bàn này.
                        # LEN chỉ đếm cây đang hiển thị thật; COUNTIF("<>") có thể
                        # đếm cả ô công thức trả về chuỗi rỗng và làm hiện số cây sai.
                        roll_ws.cell(total_row, bs + 3, f'=IF({active_expr_pc},SUMPRODUCT(--(LEN({col_letter(bs+3)}{data_start}:{col_letter(bs+3)}{total_row-1})>0)),"")')
                        roll_ws.cell(total_row, bs + 4, f'=IF({active_expr_pc},SUM({col_letter(bs+4)}{data_start}:{col_letter(bs+4)}{total_row-1}),"")')
                        roll_ws.cell(total_row, bs + 5, f'=IF({active_expr_pc},SUM({col_letter(bs+5)}{data_start}:{col_letter(bs+5)}{total_row-1}),"")')
                        roll_ws.cell(total_row, bs + 6, f'=IF({active_expr_pc},SUM({col_letter(bs+6)}{data_start}:{col_letter(bs+6)}{total_row-1}),"")')
                        # V50: TỔNG ĐẦU TẤM không cộng phần còn lại của cây nếu cây đó
                        # còn được chuyển sang một bàn phía sau. Chỉ cộng đầu tấm cuối cùng
                        # của cây sau lần sử dụng cuối.
                        if table_idx < len(rc_remnant_cols) and rc_data_start > 0:
                            _remc = rc_remnant_cols[table_idx]
                            _rc_end = int(rcinfo.get('data_end', 0) or 0)
                            _rem_total = f"SUM('{roll_calc_ref_pc}'!${_remc}${rc_data_start}:${_remc}${_rc_end})"
                            roll_ws.cell(total_row, bs + 7, f'=IF({active_expr_pc},{_rem_total},"")')
                        else:
                            roll_ws.cell(total_row, bs + 7, f'=IF({active_expr_pc},SUM({col_letter(bs+7)}{data_start}:{col_letter(bs+7)}{total_row-1}),"")')
                        for off in range(8):
                            c = roll_ws.cell(total_row, bs + off)
                            c.font = shade_font_bold
                            c.alignment = shade_center
                        for off in (4, 5, 7):
                            roll_ws.cell(total_row, bs + off).number_format = '0.0'

                        _set_range_border(roll_ws, title_row, bs, total_row, be)
                        # Bàn trống ẩn lưới; chỉ giữ cạnh phải ở bàn cuối của phần phân bổ. Bàn có dữ liệu hiện đủ khung.
                        if mr_pc:
                            _white = 'FFFFFF'
                            _blank_right = (Side(style='medium', color='000000')
                                             if table_idx == len(tables) - 1
                                             else Side(style='thin', color=_white))
                            _wb = Border(left=Side(style='thin', color=_white), right=_blank_right,
                                         top=Side(style='thin', color=_white), bottom=Side(style='thin', color=_white))
                            _rule = FormulaRule(formula=[f"TRIM('{main_sheet_ref}'!$C${mr_pc})=\"\""],
                                                stopIfTrue=True,
                                                font=Font(color=_white),
                                                fill=PatternFill('solid', fgColor=_white),
                                                border=_wb)
                            roll_ws.conditional_formatting.add(
                                f"{col_letter(bs)}{title_row}:{col_letter(be)}{total_row}", _rule)

                        # Bàn cuối của nhóm phải luôn có viền phải rõ, kể cả nhóm chỉ có 1-3 bàn.
                        for _border_row in range(title_row, total_row + 1):
                            _edge_cell = roll_ws.cell(_border_row, be)
                            _edge_old = _edge_cell.border
                            _edge_cell.border = Border(
                                left=_edge_old.left, right=shade_medium,
                                top=_edge_old.top, bottom=_edge_old.bottom,
                                diagonal=_edge_old.diagonal, diagonal_direction=_edge_old.diagonal_direction,
                                diagonalUp=_edge_old.diagonalUp, diagonalDown=_edge_old.diagonalDown,
                                outline=_edge_old.outline, vertical=_edge_old.vertical, horizontal=_edge_old.horizontal
                            )

                    last_group_title_row = title_row
                    last_group_total_row = total_row
                    last_group_slots = len(group)
                    current_row_roll = total_row + 2

                # V185: bố trí PHÂN CÂY + TỔNG HỢP merge và khối TỔNG đúng ảnh mẫu:
