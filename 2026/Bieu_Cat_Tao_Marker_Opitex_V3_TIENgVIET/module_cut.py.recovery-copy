    def rename_size(self, key):
        """Cập nhật tên size nhưng không thay đổi dữ liệu PO bên trong."""
        if key not in self.size_name_entries:
            return
        new_name = self.size_name_entries[key].get().strip()
        if not new_name:
            # Không cho tên rỗng, trả lại tên cũ.
            old_name = next((s['name'] for s in self.sizes if s['key'] == key), '')
            self.size_name_entries[key].delete(0, tk.END)
            self.size_name_entries[key].insert(0, old_name)
            return

        # Không cho trùng tên size (không phân biệt hoa thường).
        for size in self.sizes:
            if size['key'] != key and size['name'].strip().lower() == new_name.lower():
                messagebox.showwarning("Cảnh báo", f"Tên size '{new_name}' đã tồn tại!")
                old_name = next((s['name'] for s in self.sizes if s['key'] == key), '')
                self.size_name_entries[key].delete(0, tk.END)
                self.size_name_entries[key].insert(0, old_name)
                return

        for size in self.sizes:
            if size['key'] == key:
                size['name'] = new_name
                break

        # Đồng bộ label nhập số lượng và tiêu đề bảng.
        if key in self.size_labels:
            self.size_labels[key].config(text=f"{new_name}:")
        self.refresh_po_tree_columns()
        self.status_var.set(f"Đã đổi tên size: {new_name}")

    def delete_size(self, key):
        """Xoa mot size va cot du lieu tu tat ca PO. Khong cho xoa size cuoi cung."""
        if len(self.sizes) <= 1:
            messagebox.showwarning("Cảnh báo", "Phải giữ lại ít nhất 1 size!")
            return

        size = next((item for item in self.sizes if item['key'] == key), None)
        if not size:
            return

        # Neu size da co du lieu, hoi xac nhan truoc khi xoa.
        has_qty = any(po.get(key, 0) not in (0, '', None) for po in self.po_list)
        if has_qty:
            ok = messagebox.askyesno(
                "Xác nhận xóa size",
                f"Size {size['name']} đang có số lượng trong PO.\n\n"
                f"Xóa size này sẽ xóa luôn số lượng {size['name']} trong tất cả PO.\n\n"
                "Bạn có chắc muốn xóa?"
            )
            if not ok:
                return

        self.sizes = [item for item in self.sizes if item['key'] != key]
        for po in self.po_list:
            po.pop(key, None)
            po['total'] = sum(po.get(item['key'], 0) for item in self.sizes)

        self.refresh_size_ui()
        self.status_var.set(f"Đã xóa size: {size['name']}")

    def _suggest_adjacent_size_name(self, add_to_start=False):
        """V183: gợi ý cỡ nhỏ hơn/lớn hơn dựa trên danh sách cỡ hiện có.

        Ví dụ:
        S, M, L -> đầu = XS, cuối = XL
        XS, S, M, L, XL -> đầu = XXS, cuối = XXL
        38, 40, 42 -> đầu = 36, cuối = 44
        """
        names = [str(s.get('name', '') or '').strip().upper() for s in self.sizes]
        names = [n for n in names if n]
        if not names:
            return "S"

        edge = names[0] if add_to_start else names[-1]

        # Chuỗi cỡ chữ phổ biến, đủ rộng cho đa số mã hàng.
        alpha_order = [
            'XXXXS', 'XXXS', 'XXS', 'XS',
            'S', 'M', 'L',
            'XL', 'XXL', 'XXXL',
            '4XL', '5XL', '6XL', '7XL', '8XL'
        ]

        # Chuẩn hóa các kiểu 2XL / 3XL sang XXL / XXXL để suy ra cỡ kế tiếp.
        aliases = {
            '2XL': 'XXL',
            '3XL': 'XXXL',
        }
        edge_norm = aliases.get(edge, edge)

        if edge_norm in alpha_order:
            idx = alpha_order.index(edge_norm)
            if add_to_start:
                if idx > 0:
                    return alpha_order[idx - 1]
                # Nếu đã tới XXXXS thì mở rộng thêm X.
                if edge_norm.endswith('S'):
                    return 'X' + edge_norm
            else:
                if idx < len(alpha_order) - 1:
                    return alpha_order[idx + 1]
                # Sau 8XL tăng số XL.
                m = re.fullmatch(r'(\d+)XL', edge_norm)
                if m:
                    return f"{int(m.group(1)) + 1}XL"

        # Cỡ số: suy ra bước từ hai cỡ ngoài cùng, ví dụ 38-40-42 => 36 / 44.
        try:
            numeric = [float(n.replace(',', '.')) for n in names]
            if len(numeric) >= 2:
                if add_to_start:
                    step = numeric[1] - numeric[0]
                    if abs(step) < 1e-9:
                        step = 1
                    val = numeric[0] - step
                else:
                    step = numeric[-1] - numeric[-2]
                    if abs(step) < 1e-9:
                        step = 1
                    val = numeric[-1] + step
            else:
                val = numeric[0] - 1 if add_to_start else numeric[0] + 1

            if abs(val - round(val)) < 1e-9:
                return str(int(round(val)))
            return f"{val:g}"
        except Exception:
            pass

        # Tên không theo chuẩn: vẫn tạo tên dễ hiểu để người dùng sửa ngay.
        return "CỠ NHỎ MỚI" if add_to_start else "CỠ LỚN MỚI"

    def delete_size_first(self):
        """Xóa cỡ NHỎ / cỡ đầu danh sách."""
        if not self.sizes:
            return
        self.delete_size(self.sizes[0]['key'])

    def delete_size_last(self):
        """V182: xóa cỡ LỚN / cỡ cuối danh sách."""
        if not self.sizes:
            return
        self.delete_size(self.sizes[-1]['key'])

    def add_size_first(self):
        """V158: thêm một cỡ mới vào ĐẦU danh sách size."""
        key = f"size{self.next_size_number}"
        self.next_size_number += 1

        # V183: tự gợi ý cỡ nhỏ hơn dựa trên cỡ đầu hiện có.
        new_name = self._suggest_adjacent_size_name(add_to_start=True)
        used = {str(s.get('name', '')).strip().upper() for s in self.sizes}
        if str(new_name).upper() in used:
            base = str(new_name)
            no = 2
            while f"{base}_{no}".upper() in used:
                no += 1
            new_name = f"{base}_{no}"

        new_size = {
            'key': key,
            'name': new_name,
            'factor': 1.00,
            'increase_pct': 0.0
        }
        self.sizes.insert(0, new_size)

        # PO cũ được bổ sung cỡ mới với số lượng 0.
        for po in self.po_list:
            po[key] = 0
            po['total'] = sum(po.get(s['key'], 0) for s in self.sizes)

        self.refresh_size_ui()
        self.status_var.set(f"Đã thêm cỡ nhỏ: {new_name}")

        # Đưa con trỏ vào ô tên cỡ vừa thêm để đổi tên ngay.
        if key in self.size_name_entries:
            try:
                self.size_name_entries[key].focus_set()
                self.size_name_entries[key].selection_range(0, tk.END)
            except Exception:
                pass

    def add_size(self):
        """V158: thêm một cỡ mới vào CUỐI danh sách size."""
        key = f"size{self.next_size_number}"
        self.next_size_number += 1
        # V183: tự gợi ý cỡ lớn hơn dựa trên cỡ cuối hiện có.
        new_name = self._suggest_adjacent_size_name(add_to_start=False)
        used = {str(s.get('name', '')).strip().upper() for s in self.sizes}
        if str(new_name).upper() in used:
            base = str(new_name)
            no = 2
            while f"{base}_{no}".upper() in used:
                no += 1
            new_name = f"{base}_{no}"

        self.sizes.append({
            'key': key, 'name': new_name,
            'factor': 1.00, 'increase_pct': 0.0
        })

        # Bổ sung cột dữ liệu mới cho các PO đã nhập.
        for po in self.po_list:
            po[key] = 0
            po['total'] = sum(po.get(s['key'], 0) for s in self.sizes)

        self.refresh_size_ui()
        self.status_var.set(f"Đã thêm cỡ lớn: {new_name}")
        # Đưa con trỏ vào ô tên size mới.
        if key in self.size_name_entries:
            self.size_name_entries[key].focus_set()
            self.size_name_entries[key].selection_range(0, tk.END)

    def refresh_po_tree_columns(self):
        """V26: cập nhật cột PO. Nếu đang dùng bảng ô Excel thì vẽ lại bảng."""
        # Đồng bộ lại CÂY và Shade tự động từ Shade trước mỗi lần tính/xuất.
        self._sync_all_shade_lots()
        if hasattr(self, 'po_grid_inner'):
            self.refresh_po_grid()
            return
        if not hasattr(self, 'po_tree'):
            return
        size_keys = [s['key'] for s in self.sizes]
        columns = ['po', 'color'] + size_keys + ['total']
        self.po_tree['columns'] = columns
        self.po_tree.heading('po', text='Số PO')
        self.po_tree.column('po', width=100, anchor='center')
        self.po_tree.heading('color', text='MÀU/COLOR')
        self.po_tree.column('color', width=160, anchor='center')
        for size in self.sizes:
            self.po_tree.heading(size['key'], text=size['name'])
            self.po_tree.column(size['key'], width=90, anchor='center')
        self.po_tree.heading('total', text='TỔNG')
        self.po_tree.column('total', width=100, anchor='center')

    def add_po(self):
        try:
            po = self.entry_po.get().strip()
            if not po:
                messagebox.showwarning("Cảnh báo", "Vui lòng nhập số PO!")
                return
            color = self.entry_po_color.get().strip() if hasattr(self, 'entry_po_color') else ''

            sizes = {}
            for size in self.sizes:
                key = size['key']
                entry = self.size_entries[key]
                val = entry.get().strip()
                sizes[key] = int(val) if val else 0

            total = sum(sizes.values())
            po_data = {'po': po, 'color': color, 'apply_increase': False, **sizes, 'total': total}
            self.po_list.append(po_data)
            new_row_index = len(self.po_list) - 1

            # V186: cập nhật đúng 1 dòng trên lưới, không refresh cả bảng.
            if not self._po_grid_update_row_in_place(new_row_index):
                self.refresh_po_grid()
            self.update_summary()
            self._schedule_smooth_refresh(delay=300)

            self.entry_po.delete(0, tk.END)
            if hasattr(self, 'entry_po_color'):
                self.entry_po_color.delete(0, tk.END)
            for entry in self.size_entries.values():
                entry.delete(0, tk.END)

            self.status_var.set(f"Đã thêm PO: {po}")

        except ValueError:
            messagebox.showerror("Lỗi", "Số lượng phải là số nguyên!")

    def delete_po(self):
        # V26: bảng PO dạng ô dùng dòng đang chọn thay cho selection của Treeview.
        if hasattr(self, 'po_grid_inner'):
            if not self.po_list:
                messagebox.showwarning("Cảnh báo", "Chưa có PO để xóa!")
                return
            row = int(getattr(self, 'po_grid_selected', (0, 0))[0])
            if row < 0 or row >= len(self.po_list):
                messagebox.showwarning("Cảnh báo", "Hãy chọn một ô trong dòng PO cần xóa!")
                return
            name = str(self.po_list[row].get('po', '') or '')
            if not messagebox.askyesno('Xác nhận', f'Xóa PO {name}?'):
                return
            del self.po_list[row]
            self.po_grid_selected = (max(0, min(row, len(self.po_list)-1)), 0)
            self.update_po_table()
            self.update_summary()
            self.status_var.set("Đã xóa PO được chọn")
            return

        selected = self.po_tree.selection()
        if not selected:
            messagebox.showwarning("Cảnh báo", "Vui lòng chọn PO cần xóa!")
            return
        for item in selected:
            idx = self.po_tree.index(item)
            if 0 <= idx < len(self.po_list):
                del self.po_list[idx]
        self.update_po_table()
        self.update_summary()
        self.status_var.set("Đã xóa PO được chọn")

    def clear_all_pos(self):
        if messagebox.askyesno("Xác nhận", "Bạn có chắc muốn xóa tất cả PO?"):
            self.po_list.clear()
            self.update_po_table()
            self.update_summary()
            self.status_var.set("Đã xóa tất cả PO")

    def update_po_table(self):
        # V26: bảng PO dạng ô giống Excel.
        if hasattr(self, 'po_grid_inner'):
            self.refresh_po_grid()
            self._refresh_fabric_po_selector()
            return
        if not hasattr(self, 'po_tree'):
            return
        for item in self.po_tree.get_children():
            self.po_tree.delete(item)
        self.refresh_po_tree_columns()
        size_keys = [s['key'] for s in self.sizes]
        for po in self.po_list:
            values = [po.get('po', ''), po.get('color', '')] + [po.get(k, 0) for k in size_keys]
            values.append(sum(po.get(k, 0) for k in size_keys))
            self.po_tree.insert('', 'end', values=tuple(values))
        self._refresh_fabric_po_selector()

    # ==================== V62: % DƯƠNG RIÊNG TỪNG CỠ TRONG PHẦN MỀM ====================
    def _parse_size_percent(self, value, silent=False):
        raw = str(value if value is not None else '').strip().replace('%', '').replace(',', '.')
        if raw == '':
            return 0.0
        try:
            pct = float(raw)
        except Exception:
            if silent:
                return 0.0
            raise ValueError('% dương từng cỡ phải là số, ví dụ 1 hoặc 1.5.')
        if pct < 0:
            if silent:
                return 0.0
            raise ValueError('% dương từng cỡ không được âm.')
        return pct

    def update_size_percent(self, key):
        entry = getattr(self, 'size_percent_entries', {}).get(key)
        size = next((x for x in self.sizes if x.get('key') == key), None)
        if entry is None or size is None:
            return
        try:
            pct = self._parse_size_percent(entry.get(), silent=False)
        except ValueError as e:
            messagebox.showerror('Lỗi', str(e))
            pct = float(size.get('increase_pct', 0.0) or 0.0)
        size['increase_pct'] = pct
        try:
            entry.delete(0, tk.END)
            entry.insert(0, (f"{pct:.4f}").rstrip('0').rstrip('.') if abs(pct) > 1e-12 else '')
        except Exception:
            pass
        self.update_summary()
        if hasattr(self, 'status_var'):
            self.status_var.set(f"% dương {size.get('name','')}: {pct:g}%")

    def _sync_size_percent_from_ui(self, silent=False):
        entries = getattr(self, 'size_percent_entries', {}) or {}
        for size in self.sizes:
            key = size.get('key')
            entry = entries.get(key)
            if entry is None:
                size.setdefault('increase_pct', 0.0)
                continue
            try:
                pct = self._parse_size_percent(entry.get(), silent=silent)
            except ValueError:
                if silent:
                    pct = float(size.get('increase_pct', 0.0) or 0.0)
                else:
                    raise
            size['increase_pct'] = pct
        return {s['key']: float(s.get('increase_pct', 0.0) or 0.0) for s in self.sizes}

    def _size_percent_map(self):
        return {s['key']: max(0.0, float(s.get('increase_pct', 0.0) or 0.0)) for s in self.sizes}

    def _increase_enabled(self):
        try:
            return bool(self.increase_enabled_var.get())
        except Exception:
            return True

    def _increase_mode(self):
        try:
            mode = str(self.increase_mode_var.get() or 'all').strip().lower()
        except Exception:
            mode = 'all'
        return mode if mode in ('all', 'selected') else 'all'

    def _po_increase_active(self, po):
        """V83: PO này có thực sự được áp dụng % dương hay không."""
        if not self._increase_enabled():
            return False
        if self._increase_mode() == 'all':
            return True
        return bool((po or {}).get('apply_increase', False))

    def _on_increase_mode_changed(self):
        """Cập nhật ngay kế hoạch và cột tích PO khi đổi chế độ % dương."""
        try:
            self.update_summary()
        except Exception:
            pass
        try:
            self.refresh_po_grid()
        except Exception:
            pass
        if self.fabric_list:
            try:
                self._sync_global_lots()
                self.update_fabric_table()
            except Exception:
                pass
        if hasattr(self, 'status_var'):
            if not self._increase_enabled():
                msg = 'Đã tắt % dương cho tất cả PO'
            elif self._increase_mode() == 'all':
                msg = 'Áp dụng % dương cho TẤT CẢ PO'
            else:
                msg = 'Áp dụng % dương theo TỪNG PO được tích chọn'
            self.status_var.set(msg)

    def _planned_po_qty(self, po, key):
        raw = max(0, int(po.get(key, 0) or 0))
        # V83: có 3 trạng thái: tắt % dương / dương tất cả PO / dương từng PO.
        if not self._po_increase_active(po):
            return raw
        pct = self._size_percent_map().get(key, 0.0)
        if raw <= 0:
            return 0
        return int(math.ceil(raw * (1.0 + pct / 100.0) - 1e-12))

    def get_production_percent(self, silent=False):
        """Lấy % tăng sản lượng. Người dùng nhập 2 nghĩa là tăng 2%."""
        if not hasattr(self, 'production_percent_var'):
            return 0.0
        raw = str(self.production_percent_var.get()).strip().replace(',', '.')
        if raw == '':
            return 0.0
        try:
            value = float(raw)
        except ValueError:
            if silent:
                return 0.0
            raise ValueError("% tăng sản lượng phải là số. Ví dụ nhập 2 để tăng 2%.")
        if value < 0:
            if silent:
                return 0.0
            raise ValueError("% tăng sản lượng không được âm.")
        return value

    def on_production_percent_changed(self, event=None):
        try:
            pct = self.get_production_percent()
        except ValueError as e:
            messagebox.showerror("Lỗi", str(e))
            self.production_percent_var.set('0')
            pct = 0.0
        # Chuẩn hóa cách hiển thị, nhưng không ép số lẻ không cần thiết.
        if abs(pct - round(pct)) < 1e-9:
            self.production_percent_var.set(str(int(round(pct))))
        else:
            self.production_percent_var.set((f"{pct:.4f}").rstrip('0').rstrip('.'))
        self.update_summary()
        if hasattr(self, 'status_var'):
            self.status_var.set(f"Tăng sản lượng: {pct:g}%")

    def update_summary(self):
        """V186: tổng kết PO; khi chưa có dữ liệu không hiển thị hàng loạt số 0."""
        if not self.po_list:
            try:
                self.summary_label.config(text='Chưa có PO')
            except Exception:
                pass
            return

        raw_by_size = {
            size['key']: sum(int(po.get(size['key'], 0) or 0) for po in self.po_list)
            for size in self.sizes
        }
        planned_by_size = {
            size['key']: sum(self._planned_po_qty(po, size['key']) for po in self.po_list)
            for size in self.sizes
        }
        total_raw = sum(raw_by_size.values())
        total_plan = sum(planned_by_size.values())
        if not self._increase_enabled():
            mode_text = 'DƯƠNG: TẮT'
        elif self._increase_mode() == 'all':
            mode_text = 'DƯƠNG: TẤT CẢ PO'
        else:
            selected_count = sum(1 for po in self.po_list if bool(po.get('apply_increase', False)))
            mode_text = f'DƯƠNG: {selected_count}/{len(self.po_list)} PO'
        parts = [f"Tổng gốc: {total_raw} SP", f"Kế hoạch: {total_plan} SP", mode_text]
        for size in self.sizes:
            key = size['key']
            pct = float(size.get('increase_pct', 0.0) or 0.0)
            parts.append(f"{size['name']}: {raw_by_size[key]}→{planned_by_size[key]} (+{pct:g}%)")
        self.summary_label.config(text=" | ".join(parts))

    # ==================== V26: BẢNG PO DẠNG Ô + DÁN THEO Ô ====================
    def _po_grid_columns(self):
        return ['po', 'color', 'apply_increase'] + [s['key'] for s in self.sizes] + ['total']

    def _po_grid_headers(self):
        return ['SỐ PO', 'MÀU/COLOR', 'DƯƠNG %'] + [s['name'] for s in self.sizes] + ['TỔNG']

    def _on_po_grid_canvas_configure(self, event=None):
        """V112: ép bảng PO vừa đúng chiều rộng canvas, không sinh cuộn ngang."""
        try:
            if event is not None and getattr(event, 'widget', None) == self.po_grid_canvas:
                width = max(1, int(event.width or 1))
                self.po_grid_canvas.itemconfigure(self.po_grid_window, width=width)
            self.po_grid_canvas.configure(scrollregion=self.po_grid_canvas.bbox('all'))
        except Exception:
            pass

    def _po_grid_selection_bounds(self):
        a = getattr(self, 'po_grid_selection_anchor', getattr(self, 'po_grid_selected', (0, 0)))
        b = getattr(self, 'po_grid_selection_end', getattr(self, 'po_grid_selected', (0, 0)))
        r1, r2 = sorted((max(0, int(a[0])), max(0, int(b[0]))))
        c1, c2 = sorted((max(0, int(a[1])), max(0, int(b[1]))))
        return r1, c1, r2, c2

    def _po_grid_highlight_selection(self):
        """V186: chỉ vẽ lại các ô thay đổi trạng thái chọn.

        Bản cũ mỗi lần click 1 ô lại configure toàn bộ bảng PO, dễ thấy chớp.
        """
        r1, c1, r2, c2 = self._po_grid_selection_bounds()
        widgets = getattr(self, 'po_grid_cell_widgets', {}) or {}
        new_cells = {
            (r, c) for (r, c) in widgets
            if r1 <= r <= r2 and c1 <= c <= c2
        }
        old_cells = set(getattr(self, '_po_grid_last_highlighted', set()) or set())
        old_active = getattr(self, '_po_grid_last_active_cell', None)
        new_active = getattr(self, 'po_grid_selected', (-1, -1))

        affected = old_cells | new_cells
        if old_active is not None:
            affected.add(old_active)
        affected.add(new_active)

        for rc in affected:
            w = widgets.get(rc)
            if w is None:
                continue
            try:
                base = getattr(self, 'po_grid_base_bg', {}).get(rc, 'white')
                w.configure(bg=('#cfe8ff' if rc in new_cells else base))
                if rc == new_active:
                    w.configure(
                        highlightthickness=2,
                        highlightbackground='#1f6aa5',
                        highlightcolor='#1f6aa5'
                    )
                else:
                    w.configure(highlightthickness=0)
            except Exception:
                pass

        self._po_grid_last_highlighted = new_cells
        self._po_grid_last_active_cell = new_active

    def _po_grid_select_cell(self, row_index, col_index, widget=None, extend=False):
        row_index = max(0, int(row_index)); col_index = max(0, int(col_index))
        if not extend:
            self.po_grid_selection_anchor = (row_index, col_index)
        self.po_grid_selection_end = (row_index, col_index)
        self.po_grid_selected = (row_index, col_index)
        self.po_grid_selected_widget = widget
        self._po_grid_highlight_selection()
        headers = self._po_grid_headers()
        title = headers[col_index] if 0 <= col_index < len(headers) else ''
        if hasattr(self, 'po_paste_info_var'):
            r1, c1, r2, c2 = self._po_grid_selection_bounds()
            if (r1, c1) == (r2, c2):
                self.po_paste_info_var.set(f'Ô chọn: {title} - dòng {row_index + 1}')
            else:
                self.po_paste_info_var.set(f'Vùng chọn: dòng {r1+1}:{r2+1}, cột {c1+1}:{c2+1}')

    def _po_grid_mouse_down(self, event, row_index, col_index, widget):
        extend = bool(int(getattr(event, 'state', 0) or 0) & 0x0001)
        self._po_grid_select_cell(row_index, col_index, widget, extend=extend)

    def _po_grid_drag_select(self, event):
        try:
            target = self.root.winfo_containing(event.x_root, event.y_root)
            while target is not None and target not in self.po_grid_widget_coords:
                parent_name = target.winfo_parent()
                if not parent_name:
                    target = None
                    break
                target = target._nametowidget(parent_name)
            if target in self.po_grid_widget_coords:
                r, c = self.po_grid_widget_coords[target]
                self._po_grid_select_cell(r, c, target, extend=True)
        except Exception:
            pass

    def _po_grid_select_row(self, row_index):
        cols = self._po_grid_columns()
        if not cols:
            return
        self.po_grid_selection_anchor = (row_index, 0)
        self.po_grid_selection_end = (row_index, len(cols)-1)
        self.po_grid_selected = (row_index, 0)
        self._po_grid_highlight_selection()
        if hasattr(self, 'po_paste_info_var'):
            self.po_paste_info_var.set(f'Đã chọn dòng {row_index + 1}')

    def _po_grid_select_all(self, event=None):
        cols = self._po_grid_columns()
        if not cols:
            return 'break'
        last_row = max(0, len(self.po_list)-1)
        self.po_grid_selection_anchor = (0, 0)
        self.po_grid_selection_end = (last_row, len(cols)-1)
        self.po_grid_selected = (0, 0)
        self._po_grid_highlight_selection()
        return 'break'

    def _po_grid_get_value(self, row_index, col_index):
        cols = self._po_grid_columns()
        if not (0 <= col_index < len(cols)) or not (0 <= row_index < len(self.po_list)):
            return ''
        key = cols[col_index]
        po = self.po_list[row_index]
        if key == 'po':
            return str(po.get('po', '') or '')
        if key == 'color':
            return str(po.get('color', '') or '')
        if key == 'apply_increase':
            return '1' if bool(po.get('apply_increase', True)) else '0'
        if key == 'total':
            return str(sum(int(po.get(sz['key'], 0) or 0) for sz in self.sizes))
        return str(po.get(key, 0) or 0)

    def _copy_po_grid_selection(self, event=None):
        r1, c1, r2, c2 = self._po_grid_selection_bounds()
        lines = []
        for r in range(r1, r2 + 1):
            lines.append('\t'.join(self._po_grid_get_value(r, c) for c in range(c1, c2 + 1)))
        try:
            self.root.clipboard_clear()
            self.root.clipboard_append('\n'.join(lines))
            self.status_var.set(f'Đã copy vùng PO dòng {r1+1}:{r2+1}')
        except Exception:
            pass
        return 'break'

    def _clear_po_grid_selection(self, event=None):
        r1, c1, r2, c2 = self._po_grid_selection_bounds()
        cols = self._po_grid_columns()
        changed = 0
        for r in range(r1, min(r2, len(self.po_list)-1) + 1):
            for c in range(c1, min(c2, len(cols)-1) + 1):
                key = cols[c]
                if key in ('po', 'total'):
                    continue
                clear_value = '' if key == 'color' else '0'
                if self._po_cell_set_value(r, key, clear_value, show_error=False):
                    changed += 1
        if changed:
            self.update_po_table(); self.update_summary(); self._refresh_fabric_po_selector()
            if self.fabric_list:
                self._sync_global_lots(); self.update_fabric_table()
            self.status_var.set(f'Đã xóa số lượng trong {changed} ô')
        return 'break'

    def _po_grid_commit_size_header(self, key, var):
        new_name = str(var.get() or '').strip()
        size = next((x for x in self.sizes if x['key'] == key), None)
        if size is None:
            return
        old_name = str(size.get('name', '') or '')
        if not new_name:
            var.set(old_name); return
        if any(x['key'] != key and str(x.get('name','')).strip().lower() == new_name.lower() for x in self.sizes):
            messagebox.showwarning('Cảnh báo', f"Tên size '{new_name}' đã tồn tại!")
            var.set(old_name); return
        if new_name == old_name:
            return
        size['name'] = new_name
        if key in getattr(self, 'size_name_entries', {}):
            e = self.size_name_entries[key]
            e.delete(0, tk.END); e.insert(0, new_name)
        if key in getattr(self, 'size_labels', {}):
            self.size_labels[key].configure(text=f'{new_name}:')
        self.update_summary()
        self.status_var.set(f'Đã đổi tên size: {new_name}')
        self.root.after_idle(self.refresh_po_grid)

    def _po_cell_set_value(self, row_index, col_key, value, show_error=True):
        if not (0 <= row_index < len(self.po_list)):
            return False
        if col_key == 'total':
            return False
        po = self.po_list[row_index]
        raw = str(value or '').strip()
        try:
            if col_key == 'apply_increase':
                po['apply_increase'] = str(raw).strip().lower() not in ('', '0', 'false', 'no', 'không', 'khong', 'off', '☐')
            elif col_key == 'po':
                if not raw:
                    raise ValueError('Số PO không được để trống!')
                old_name = str(po.get('po', '') or '').strip()
                if any(i != row_index and str(x.get('po','')).strip() == raw
                       for i, x in enumerate(self.po_list)):
                    raise ValueError(f'PO {raw} đã tồn tại!')
                po['po'] = raw
                if old_name != raw:
                    for fabric in self.fabric_list:
                        if str(fabric.get('po_mode','all')).lower() != 'all':
                            fabric['po_targets'] = [raw if str(x) == old_name else x
                                                    for x in (fabric.get('po_targets', []) or [])]
                            fabric['roll_po_targets'] = [raw if str(x) == old_name else x
                                                         for x in (fabric.get('roll_po_targets', []) or [])]
            elif col_key == 'color':
                po['color'] = raw
            else:
                qty = int(float(raw.replace(',', '.'))) if raw else 0
                if qty < 0:
                    raise ValueError('Số lượng PO không được âm!')
                po[col_key] = qty
        except Exception as e:
            if show_error:
                messagebox.showerror('Lỗi', str(e))
            return False
        po['total'] = sum(int(po.get(sz['key'], 0) or 0) for sz in self.sizes)
        return True

    def _po_grid_update_row_in_place(self, row_index):
        """V186: cập nhật một dòng PO mà không phá/vẽ lại toàn bộ bảng."""
        if not (0 <= row_index < len(self.po_list)):
            return False
        if row_index >= int(getattr(self, '_po_grid_display_rows', 0) or 0):
            return False

        po = self.po_list[row_index]
        cols = self._po_grid_columns()
        total = sum(int(po.get(sz['key'], 0) or 0) for sz in self.sizes)

        total_var = getattr(self, 'po_grid_total_vars', {}).get(row_index)
        if total_var is not None:
            try:
                total_var.set(str(total) if total else '')
            except Exception:
                pass

        for c, key in enumerate(cols):
            w = getattr(self, 'po_grid_cell_widgets', {}).get((row_index, c))
            if w is None:
                continue

            if key == 'total':
                continue

            if key == 'apply_increase':
                flag = getattr(self, 'po_grid_apply_vars', {}).get(row_index)
                if flag is not None:
                    try:
                        flag.set(bool(po.get('apply_increase', False)))
                    except Exception:
                        pass
                selectable = self._increase_enabled() and self._increase_mode() == 'selected'
                bg = '#fff2a8' if selectable else '#eeeeee'
                try:
                    w.configure(
                        state=('normal' if selectable else 'disabled'),
                        bg=bg,
                        activebackground=bg
                    )
                    self.po_grid_base_bg[(row_index, c)] = bg
                except Exception:
                    pass
                continue

            if not isinstance(w, tk.Entry):
                continue

            if key == 'po':
                shown = str(po.get('po', '') or '')
            elif key == 'color':
                shown = str(po.get('color', '') or '')
            else:
                qty = int(po.get(key, 0) or 0)
                shown = str(qty) if qty else ''

            try:
                if w.get() != shown:
                    w.delete(0, tk.END)
                    w.insert(0, shown)
            except Exception:
                pass

        return True

    def _po_grid_commit_entry(self, row_index, col_key, var, old_value='', total_var=None):
        value = str(var.get() or '').strip()
        created = False
        # Dòng trống kiểu Excel: nhập SỐ PO trước để tạo dòng dữ liệu mới.
        if row_index >= len(self.po_list):
            if not value:
                return
            if col_key != 'po':
                messagebox.showwarning('Danh sách PO', 'Dòng mới hãy nhập SỐ PO trước, sau đó nhập số lượng từng cỡ.')
                var.set('')
                return
            if any(str(x.get('po','')).strip() == value for x in self.po_list):
                messagebox.showerror('Lỗi', f'PO {value} đã tồn tại!')
                var.set('')
                return
            new = {'po': value, 'color': '', 'apply_increase': False}
            for sz in self.sizes:
                new[sz['key']] = 0
            new['total'] = 0
            self.po_list.append(new)
            created = True
        else:
            current = self.po_list[row_index].get('po', '') if col_key == 'po' else self.po_list[row_index].get(col_key, '' if col_key == 'color' else 0)
            if value == str(current).strip():
                return
            if not self._po_cell_set_value(row_index, col_key, value, show_error=True):
                current = self.po_list[row_index].get('po', '') if col_key == 'po' else self.po_list[row_index].get(col_key, '' if col_key == 'color' else 0)
                var.set(str(current))
                return

        if total_var is not None and 0 <= row_index < len(self.po_list):
            _t = int(self.po_list[row_index].get('total', 0) or 0)
            total_var.set(str(_t) if _t else '')
        self.update_summary()
        # V185-SMOOTH: không rebuild danh sách loại vải ngay sau từng ô PO.
        # Dữ liệu PO đã commit; phần phụ được cập nhật gộp sau khi ngừng nhập.
        self._schedule_smooth_refresh(delay=320)
        self.status_var.set('Đã thêm PO mới' if created else 'Đã sửa trực tiếp ô PO')
        if created:
            # V186: dòng trống đã tồn tại sẵn; chỉ biến dòng đó thành PO thật.
            # Không destroy/rebuild cả bảng nên không còn chớp.
            if not self._po_grid_update_row_in_place(row_index):
                self.root.after_idle(self.refresh_po_grid)

    def _po_grid_focus_cell(self, row_index, col_index):
        w = getattr(self, 'po_grid_cell_widgets', {}).get((row_index, col_index))
        if w is not None:
            try:
                w.focus_set()
                if isinstance(w, tk.Entry):
                    w.selection_range(0, tk.END)
            except Exception:
                pass
            self._po_grid_select_cell(row_index, col_index, w)

    def _po_grid_commit_and_move(self, row_index, col_index, col_key, var, total_var, dr=0, dc=0):
        self._po_grid_commit_entry(row_index, col_key, var, '', total_var)
        nr = max(0, row_index + dr); nc = max(0, min(col_index + dc, len(self._po_grid_columns()) - 1))
        self.root.after_idle(lambda: self._po_grid_focus_cell(nr, nc))
        return 'break'

    def _bind_po_grid_keys(self, widget):
        widget.bind('<Control-c>', self._copy_po_grid_selection)
        widget.bind('<Control-C>', self._copy_po_grid_selection)
        widget.bind('<Control-v>', lambda e: (self._paste_po_grid_from_clipboard(), 'break')[1])
        widget.bind('<Control-V>', lambda e: (self._paste_po_grid_from_clipboard(), 'break')[1])
        widget.bind('<Control-a>', self._po_grid_select_all)
        widget.bind('<Control-A>', self._po_grid_select_all)
        widget.bind('<Delete>', self._clear_po_grid_selection)

    def _sync_po_grid_from_ui(self):
        """V93: đồng bộ dữ liệu đang nhìn thấy trong bảng PO trước khi tính/xuất.

        Tkinter Button không phải lúc nào cũng làm ô Entry mất focus ngay, nên giá trị vừa gõ
        (đặc biệt MÀU/COLOR) có thể còn nằm trong ô giao diện nhưng chưa vào self.po_list.
        Hàm này đọc trực tiếp các Entry của những PO đã tồn tại để Excel luôn nhận đúng dữ liệu.
        """
        if not hasattr(self, 'po_grid_cell_widgets') or not self.po_list:
            return
        cols = self._po_grid_columns()
        for r in range(len(self.po_list)):
            for c, key in enumerate(cols):
                if key in ('apply_increase', 'total'):
                    continue
                w = self.po_grid_cell_widgets.get((r, c))
                if w is None or not isinstance(w, tk.Entry):
                    continue
                try:
                    value = w.get()
                except Exception:
                    continue
                # Không hiện popup trong lúc xuất; nếu giá trị không hợp lệ thì giữ dữ liệu cũ.
                self._po_cell_set_value(r, key, value, show_error=False)
        for po in self.po_list:
            po['total'] = sum(int(po.get(sz['key'], 0) or 0) for sz in self.sizes)

    def refresh_po_grid(self):
        if not hasattr(self, 'po_grid_inner'):
            return
        for child in self.po_grid_inner.winfo_children():
            child.destroy()
        self.po_grid_cell_widgets = {}
        self.po_grid_widget_coords = {}
        self.po_grid_base_bg = {}
        self.po_grid_total_vars = {}
        self.po_grid_apply_vars = {}
        cols = self._po_grid_columns()
        headers = self._po_grid_headers()
        # V112: width widget để rất nhỏ, còn chiều rộng thực tế do GRID tự chia.
