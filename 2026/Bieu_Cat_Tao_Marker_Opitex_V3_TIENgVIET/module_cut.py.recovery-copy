    def build_form10_workbook(self, data, path):
        """
        Tạo FORM 10 theo cùng logic sắp xếp với FORM BẢNG CẮT:
        - A4 ngang, in cố định 85%; phần nội dung bảng kết thúc ở hàng 41.
        - Trong cùng một cột có thể xếp nhiều cỡ/Shade nếu còn đủ chiều cao.
        - Nếu khối kế tiếp không còn vừa toàn bộ phần trống thì chuyển sang cột bên cạnh.
        - Nếu một khối dài thì chỉ ngắt theo cụm 10 dòng số thứ tự; không để 1-2 dòng lẻ ở cuối cột.
        - Khi hết các cột ngang của một trang thì tự sang trang A4 kế tiếp.
        - Số thứ tự vẫn lấy liên tục từ dữ liệu bảng cắt, mỗi dòng FORM 10 là 10 sản phẩm.
        """
        wb = Workbook()
        ws = wb.active
        ws.title = "FORM 10"
        ws.sheet_view.showGridLines = True

        # FORM 10: A4 ngang, sát mép. Ở mức in 84%, hàng 41 là đáy vùng nội dung.
        ws.page_setup.orientation = "landscape"
        ws.page_setup.paperSize = ws.PAPERSIZE_A4
        # FORM 10 dùng tỉ lệ in cố định 85% theo yêu cầu.
        # Không dùng Fit-to-Width vì Excel sẽ tự đổi % tùy máy in.
        ws.page_setup.scale = 82
        ws.page_setup.fitToWidth = None
        ws.page_setup.fitToHeight = None
        ws.sheet_properties.pageSetUpPr.fitToPage = False
        ws.page_margins.left = 0.05
        ws.page_margins.right = 0.05
        ws.page_margins.top = 0.10
        ws.page_margins.bottom = 0.10
        ws.page_margins.header = 0.0
        ws.page_margins.footer = 0.0
        ws.print_options.horizontalCentered = True

        # FORM 10 rộng 10 cột/khối:
        # SL | Số thứ tự (3 cột) | TT (2) | TS (2) | TAY (2).
        # Xếp 3 khối trên một hàng A4, chừa 1 cột làm khoảng cách.
        starts = [1, 12, 23]  # A, L, W
        block_width = 10
        first_data_top = 5
        fixed_page_bottom_row = 40
        page_body_rows = fixed_page_bottom_row - first_data_top + 1
        page_bottom_offset = page_body_rows - 1
        gap_rows = 2

        # Chiều cao dòng cố định để giới hạn A4 ổn định.
        title_h = 22
        head_h = 20
        data_h = 18
        blank_h = 15
        for r in range(1, 4):
            ws.row_dimensions[r].height = 20
        ws.row_dimensions[1].height = 25

        # Giữ 3 khối nằm trọn 1 trang A4 ngang ở mức in 85%.
        # 6 cột NHẬN/PHÁT khoảng 45 px/cột; các cột còn lại thu gọn vừa đủ.
        # SL | số đầu | - | số cuối | TT(N/P) | TS(N/P) | TAY(N/P)
        block_widths = [4.2, 6.5, 1.6, 6.5, 6.1, 6.1, 6.1, 6.1, 6.1, 6.1]
        for c0 in starts:
            for off, w in enumerate(block_widths):
                ws.column_dimensions[get_column_letter(c0 + off)].width = w
            # cột khoảng cách giữa các khối
            if c0 + block_width <= 30:
                ws.column_dimensions[get_column_letter(c0 + block_width)].width = 2.0

        thin = Side(style="thin", color="000000")
        medium = Side(style="medium", color="000000")
        border = Border(left=thin, right=thin, top=thin, bottom=thin)
        title_font = Font(name="Times New Roman", size=18, bold=True)
        info_font = Font(name="Times New Roman", size=11, bold=True)
        block_title_font = Font(name="Times New Roman", size=12, bold=True)
        head_font = Font(name="Times New Roman", size=10, bold=True)
        data_font = Font(name="Times New Roman", size=10)
        # Màu tiêu đề khối FORM 10: CỠ / SL / Shade.
        # Dùng xanh nhạt để dễ phân biệt nhưng vẫn in rõ trên A4.
        block_title_fill = PatternFill("solid", fgColor="B8CCE4")

        def draw_page_header(page_top):
            """Vẽ phần thông tin chung ở đầu mỗi trang A4."""
            base = page_top - 4
            ws.merge_cells(start_row=base, start_column=8, end_row=base, end_column=20)
            c = ws.cell(base, 8, "BIỂU GIAO NHẬN HÀNG")
            c.font = title_font
            c.alignment = Alignment(horizontal="center", vertical="center")

            items = [
                (base + 1, 4, f"KHÁCH HÀNG : {data['customer']}"),
                (base + 1, 12, f"ĐỢT : {data['batch']}"),
                (base + 1, 18, f"MÙA : {data.get('season', '')}"),
                (base + 1, 27, f"PO : {data['po']}"),
                (base + 2, 4, f"MÃ HÀNG : {data['style_code']}"),
                (base + 2, 13, f"MÀU : {data['color']}"),
                (base + 2, 20, f"TỔNG SỐ LƯỢNG : {data['total']}"),
            ]
            for rr, cc, vv in items:
                cell = ws.cell(rr, cc, vv)
                cell.font = info_font
                cell.alignment = Alignment(vertical="center")

        draw_page_header(first_data_top)

        # Trạng thái đóng gói giống bảng cắt.
        page_index = 0
        slot = 0
        page_top = first_data_top
        page_bottom = page_top + page_bottom_offset
        cursor_row = page_top
        last_used_row = 3
        page_break_rows = []
        # Các dòng trống được chèn sau mỗi 10 dòng số thứ tự.
        # Excel chỉ cho đặt chiều cao theo CẢ HÀNG, không theo từng khối cột,
        # nên sẽ chỉ thu xuống 12 px khi hàng đó không chứa dữ liệu của khối khác.
        form10_blank_rows = set()

        def new_slot():
            nonlocal page_index, slot, page_top, page_bottom, cursor_row
            slot += 1
            if slot >= len(starts):
                slot = 0
                page_index += 1
                page_top = first_data_top + page_index * page_body_rows
                page_bottom = page_top + page_bottom_offset
                cursor_row = page_top
                page_break_rows.append(page_top)
            else:
                cursor_row = page_top

        def rows_for_light(qty):
            return int(math.ceil(qty / 10.0))

        def full_block_capacity(start_row):
            # 3 dòng tiêu đề, phần còn lại dành cho các dòng số.
            return max(0, page_bottom - (start_row + 3) + 1)

        def rows_fit_from(start_row, data_count):
            return start_row + 3 + data_count - 1 <= page_bottom

        def make_form10_rows(qty, seq_start):
            """
            Tạo các dòng FORM 10. Sau mỗi 10 dòng số thứ tự, nếu vẫn còn dữ liệu
            thì chèn 1 dòng trống. Dòng trống được đánh dấu bằng None.
            """
            rows = []
            remain = qty
            num = seq_start
            data_row_count = 0
            while remain > 0:
                q = min(10, remain)
                end_num = num + q - 1
                rows.append((q, num, end_num))
                data_row_count += 1
                num = end_num + 1
                remain -= q
                if data_row_count % 10 == 0 and remain > 0:
                    rows.append(None)
            return rows

        def split_row_groups(rows):
            """Chia dữ liệu thành các cụm tối đa 10 dòng số thứ tự.
            Dòng None (khoảng cách sau 10 dòng) luôn đi cùng cụm 10 dòng PHÍA TRƯỚC.
            Nhờ vậy khi một phần được chuyển sang cột mới sẽ không bao giờ có
            dòng trống đầu tiên ngay dưới hàng NHẬN/PHÁT.
            """
            groups = []
            cur = []
            data_count = 0
            for row in rows:
                if row is None:
                    # Khoảng cách sau 10 dòng phải thuộc cụm vừa kết thúc,
                    # không được trở thành dòng đầu của cụm tiếp theo.
                    if cur:
                        cur.append(None)
                    elif groups:
                        groups[-1].append(None)
                    continue

                cur.append(row)
                data_count += 1
                if data_count == 10:
                    groups.append(cur)
                    cur = []
                    data_count = 0

            if cur:
                groups.append(cur)
            return groups

        def take_groups_that_fit(groups, capacity):
            """Lấy số cụm 10 dòng lớn nhất còn vừa cột hiện tại.
            Không tách 1-2 dòng lẻ của cụm kế tiếp xuống cuối cột.
            """
            if capacity <= 0 or not groups:
                return [], 0
            chosen = []
            used = 0
            for group in groups:
                glen = len(group)
                if used + glen > capacity:
                    break
                chosen.extend(group)
                used += glen
            return chosen, used

        def draw_form10_block(size_name, light_name, light_total_qty, rows_data,
                              r0, c0, continued=False):
            nonlocal last_used_row
            c1 = c0 + block_width - 1
            # Dòng dữ liệu đầu tiên nằm ngay dưới hàng tiêu đề, không chèn dòng cách ở đầu khối.
            data_start = r0 + 3
            data_end = data_start + len(rows_data) - 1

            ws.row_dimensions[r0].height = title_h
            ws.row_dimensions[r0 + 1].height = head_h
            ws.row_dimensions[r0 + 2].height = head_h
            for rr in range(data_start, data_end + 1):
                ws.row_dimensions[rr].height = data_h

            # Dòng tiêu đề cỡ / SL / Shade. Viết tắt SL và bỏ dấu "-" để tránh đè chữ.
            # Tiêu đề chia theo tỉ lệ mới: CỠ 4 cột | SL 3 cột | Shade 3 cột.
            ws.merge_cells(start_row=r0, start_column=c0, end_row=r0, end_column=c0 + 3)
            ws.cell(r0, c0, f"CỠ {size_name}" + (" (tiếp)" if continued else ""))
            ws.merge_cells(start_row=r0, start_column=c0 + 4, end_row=r0, end_column=c0 + 6)
            ws.cell(r0, c0 + 4, f"SL: {light_total_qty}")
            ws.merge_cells(start_row=r0, start_column=c0 + 7, end_row=r0, end_column=c1)
            ws.cell(r0, c0 + 7, f"Shade {light_name}" if str(light_name).strip() else "")

            for cc in range(c0, c1 + 1):
                ws.cell(r0, cc).font = block_title_font
                ws.cell(r0, cc).alignment = Alignment(horizontal="center", vertical="center")
                ws.cell(r0, cc).fill = block_title_fill

            # Chia rõ 3 ô tiêu đề CỠ | SL | Shade bằng viền đậm.
            # Các ô merge vẫn được viền lại toàn vùng để khi in không bị mất đường chia.
            title_sections = [
                (c0, c0 + 3),      # CỠ: 4 cột
                (c0 + 4, c0 + 6),  # SL: 3 cột
                (c0 + 7, c1),      # Shade: 3 cột
            ]
            for sec_start, sec_end in title_sections:
                for cc in range(sec_start, sec_end + 1):
                    left_side = medium if cc == sec_start else thin
                    right_side = medium if cc == sec_end else thin
                    ws.cell(r0, cc).border = Border(
                        left=left_side,
                        right=right_side,
                        top=medium,
                        bottom=medium,
                    )

            # Header 2 tầng.
            ws.merge_cells(start_row=r0 + 1, start_column=c0, end_row=r0 + 2, end_column=c0)
            ws.cell(r0 + 1, c0, "SL")
            ws.merge_cells(start_row=r0 + 1, start_column=c0 + 1, end_row=r0 + 2, end_column=c0 + 3)
            ws.cell(r0 + 1, c0 + 1, "Số thứ tự")
            ws.merge_cells(start_row=r0 + 1, start_column=c0 + 4, end_row=r0 + 1, end_column=c0 + 5)
            ws.cell(r0 + 1, c0 + 4, "TT")
            ws.merge_cells(start_row=r0 + 1, start_column=c0 + 6, end_row=r0 + 1, end_column=c0 + 7)
            ws.cell(r0 + 1, c0 + 6, "TS")
            ws.merge_cells(start_row=r0 + 1, start_column=c0 + 8, end_row=r0 + 1, end_column=c0 + 9)
            ws.cell(r0 + 1, c0 + 8, "TAY")
            ws.cell(r0 + 2, c0 + 4, "NHẬN")
            ws.cell(r0 + 2, c0 + 5, "PHÁT")
            ws.cell(r0 + 2, c0 + 6, "NHẬN")
            ws.cell(r0 + 2, c0 + 7, "PHÁT")
            ws.cell(r0 + 2, c0 + 8, "NHẬN")
            ws.cell(r0 + 2, c0 + 9, "PHÁT")

            for rr in (r0 + 1, r0 + 2):
                for cc in range(c0, c1 + 1):
                    ws.cell(rr, cc).font = head_font
                    ws.cell(rr, cc).alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)

            # Dữ liệu.
            for i, row_data in enumerate(rows_data):
                rr = data_start + i
                if row_data is None:
                    # Dòng trống sau mỗi 10 dòng số thứ tự.
                    # Ghi nhận để xử lý chiều cao 12 px sau khi vẽ toàn bộ các khối,
                    # tránh làm thấp một hàng đang có dữ liệu ở khối bên cạnh.
                    form10_blank_rows.add(rr)
                    for cc in range(c0, c1 + 1):
                        ws.cell(rr, cc, None)
                        ws.cell(rr, cc).font = data_font
                        ws.cell(rr, cc).alignment = Alignment(horizontal="center", vertical="center")
                else:
                    q, num, end_num = row_data
                    ws.cell(rr, c0, q)
                    ws.cell(rr, c0 + 1, num)
                    ws.cell(rr, c0 + 2, "-")
                    ws.cell(rr, c0 + 3, end_num)
                    for cc in range(c0, c1 + 1):
                        ws.cell(rr, cc).font = data_font
                        ws.cell(rr, cc).alignment = Alignment(horizontal="center", vertical="center")

            # Kẻ ô + viền ngoài đậm cho các dòng bình thường.
            # Dòng r0 (CỠ / SL / Shade) đã có viền đậm riêng ở trên nên không ghi đè.
            for rr in range(r0 + 1, data_end + 1):
                for cc in range(c0, c1 + 1):
                    ws.cell(rr, cc).border = border
            for cc in range(c0, c1 + 1):
                top = ws.cell(r0, cc)
                bottom = ws.cell(data_end, cc)
                top.border = Border(top=medium, left=top.border.left, right=top.border.right, bottom=top.border.bottom)
                bottom.border = Border(bottom=medium, left=bottom.border.left, right=bottom.border.right, top=bottom.border.top)
            for rr in range(r0, data_end + 1):
                left = ws.cell(rr, c0)
                right = ws.cell(rr, c1)
                left.border = Border(left=medium, right=left.border.right, top=left.border.top, bottom=left.border.bottom)
                right.border = Border(right=medium, left=right.border.left, top=right.border.top, bottom=right.border.bottom)

            # Dòng ngăn cách sau mỗi 10 dòng số thứ tự theo mẫu:
            # - cao khoảng 12 px (~9 pt)
            # - không có đường dọc chia ô bên trong
            # - có đường ngang mảnh ở trên và dưới
            # - hai cạnh ngoài vẫn đậm để khung CỠ liền mạch.
            for i, row_data in enumerate(rows_data):
                if row_data is None:
                    rr = data_start + i
                    ws.row_dimensions[rr].height = 9
                    for cc in range(c0, c1 + 1):
                        left_side = medium if cc == c0 else Side(style=None)
                        right_side = medium if cc == c1 else Side(style=None)
                        ws.cell(rr, cc).border = Border(
                            left=left_side,
                            right=right_side,
                            top=thin,
                            bottom=thin,
                        )

            last_used_row = max(last_used_row, data_end)
            return data_end

        # Mỗi Shade là một khối, nhưng toàn bộ khối được xếp theo logic giống bảng cắt.
        # Trong cùng một cột có thể có nhiều size/Shade nếu còn vừa.
        for item in data["sizes"]:
            seq = item["start_no"]
            for light_index, light in enumerate(item["lights"]):
                all_rows = make_form10_rows(light["qty"], seq)
                light_end = seq + light["qty"] - 1
                if light_index < len(item["lights"]) - 1:
                    seq = next_light_start(light_end, 10)
                else:
                    seq = light_end + 1

                # Nếu đang ở giữa cột và toàn bộ khối không vừa thì chuyển sang cột kế bên.
                # Không nhét vài dòng của một size/Shade mới vào cuối cột cũ.
                if cursor_row > page_top and not rows_fit_from(cursor_row, len(all_rows)):
                    new_slot()

                groups = split_row_groups(all_rows)
                first_part = True
                while groups:
                    cap = full_block_capacity(cursor_row)
                    if cap <= 0:
                        new_slot()
                        cap = full_block_capacity(cursor_row)

                    chunk, used = take_groups_that_fit(groups, cap)

                    # Nếu cột hiện tại chỉ còn chỗ cho 1-2 dòng lẻ của cụm kế tiếp
                    # thì không đặt các dòng đó ở đây; chuyển cả cụm 10 dòng sang cột kế bên.
                    if not chunk:
                        new_slot()
                        cap = full_block_capacity(cursor_row)
                        chunk, used = take_groups_that_fit(groups, cap)

                    # Trường hợp cực đoan: một cụm vẫn không vừa trang (thực tế khó xảy ra),
                    # lấy theo sức chứa để tránh vòng lặp vô hạn.
                    if not chunk:
                        first_group = groups[0]
                        used = min(cap, len(first_group))
                        chunk = first_group[:used]
                        groups[0] = first_group[used:]
                        if not groups[0]:
                            groups.pop(0)
                    else:
                        remaining = used
                        while groups and remaining >= len(groups[0]):
                            remaining -= len(groups[0])
                            groups.pop(0)

                    c0 = starts[slot]
                    data_end = draw_form10_block(
                        item["size"], light["light"], light["qty"], chunk,
                        cursor_row, c0, continued=not first_part
                    )
                    first_part = False

                    if groups:
                        # Còn dữ liệu: chuyển sang cột kế bên, luôn bắt đầu bằng nguyên cụm 10 dòng.
                        new_slot()
                    else:
                        # Khối hoàn tất: chừa 2 dòng, rồi size/Shade kế tiếp có thể nằm ngay dưới.
                        for rr in range(data_end + 1, data_end + 1 + gap_rows):
                            ws.row_dimensions[rr].height = blank_h
                        cursor_row = data_end + 1 + gap_rows

        # Tất cả các hàng ngăn cách sau mỗi 10 dòng đều thu xuống 12 px (~9 pt).
        # Phần viền của chính khối đã được xóa trong draw_form10_block().
        for rr in sorted(form10_blank_rows):
            ws.row_dimensions[rr].height = 9

        for br in sorted(set(page_break_rows)):
            try:
                ws.row_breaks.append(Break(id=br - 1))
            except Exception:
                pass

        ws.freeze_panes = "A5"
        ws.print_title_rows = "1:4"
        # 3 khối tới AF. In 85%; tổng chiều rộng được khống chế để không phát sinh trang ngang phụ.
        ws.print_area = f"A1:AF{max(last_used_row, page_bottom)}"
        wb.save(path)

    def build_workbook(self, data, path):
