    def _app_base_dir(self):
        """Thư mục chứa file .py hoặc .exe để có thể đặt logo.png cạnh chương trình."""
        if getattr(sys, 'frozen', False):
            return os.path.dirname(os.path.abspath(sys.executable))
        return os.path.dirname(os.path.abspath(__file__))

    def _logo_config_dir(self):
        """Thư mục lưu cấu hình/logo mặc định, dùng được cả khi đóng gói EXE."""
        base = os.environ.get('APPDATA') or os.path.expanduser('~')
        folder = os.path.join(base, 'CuttingPlan')
        try:
            os.makedirs(folder, exist_ok=True)
        except Exception:
            # Nếu không tạo được AppData thì dùng thư mục chương trình.
            folder = self._app_base_dir()
        return folder

    def _logo_config_file(self):
        return os.path.join(self._logo_config_dir(), 'config.json')

    def _load_default_logo_path(self):
        """Ưu tiên logo đã lưu. Nếu chưa có cấu hình thì tìm logo cạnh chương trình."""
        config_file = self._logo_config_file()
        try:
            if os.path.isfile(config_file):
                with open(config_file, 'r', encoding='utf-8') as f:
                    cfg = json.load(f)
                # Có khóa logo_path rỗng nghĩa là người dùng đã chủ động Bỏ logo.
                if 'logo_path' in cfg:
                    saved = str(cfg.get('logo_path') or '').strip()
                    if not saved:
                        return None
                    if os.path.isfile(saved):
                        return saved
        except Exception:
            pass

        # Lần đầu chạy: chỉ cần đặt một file tên logo.png cạnh chương trình.
        base = self._app_base_dir()
        for name in ('logo.png', 'logo.jpg', 'logo.jpeg', 'logo.bmp', 'logo.webp'):
            candidate = os.path.join(base, name)
            if os.path.isfile(candidate):
                return candidate
        return None

    def _save_logo_preference(self, logo_path):
        """Lưu đường dẫn logo để lần sau tự chọn."""
        try:
            cfg = {'logo_path': logo_path or ''}
            with open(self._logo_config_file(), 'w', encoding='utf-8') as f:
                json.dump(cfg, f, ensure_ascii=False, indent=2)
        except Exception:
            # Không làm gián đoạn chương trình nếu máy không cho ghi cấu hình.
            pass

    def _store_logo_as_default(self, source_path):
        """Chép/chuyển logo người dùng chọn thành PNG mặc định bền vững trong AppData."""
        if PILImage is None:
            self._save_logo_preference(source_path)
            return source_path
        try:
            dest = os.path.join(self._logo_config_dir(), 'default_logo.png')
            with PILImage.open(source_path) as img:
                img.load()
                # Giữ nền trong suốt nếu có.
                if img.mode not in ('RGB', 'RGBA'):
                    img = img.convert('RGBA')
                img.save(dest, format='PNG')
            self._save_logo_preference(dest)
            return dest
        except Exception:
            self._save_logo_preference(source_path)
            return source_path

    def _apply_loaded_logo_to_ui(self):
        """Sau khi giao diện đã tạo, hiển thị logo mặc định lên preview."""
        if not getattr(self, 'logo_path', None):
            return
        if hasattr(self, 'logo_name_var'):
            self.logo_name_var.set(os.path.basename(self.logo_path))
        if self._update_logo_preview() and hasattr(self, 'status_var'):
            self.status_var.set(f"Đã nạp logo mặc định: {os.path.basename(self.logo_path)}")

    def _update_logo_preview(self):
        """Hiển thị logo đã chọn trên giao diện và kiểm tra ảnh có đọc được hay không."""
        if not getattr(self, 'logo_path', None):
            self.logo_preview_photo = None
            if hasattr(self, 'logo_preview_label'):
                self.logo_preview_label.config(image='', text='Chưa có logo')
            return True

        if PILImage is None or ImageTk is None:
            messagebox.showerror(
                "Thiếu thư viện Pillow",
                "Không thể hiển thị/chèn logo vì máy chưa có Pillow.\n\n"
                "Mở Command Prompt và chạy:\npip install pillow"
            )
            return False

        try:
            with PILImage.open(self.logo_path) as img:
                # Đọc ảnh ngay để phát hiện file lỗi trước khi xuất Excel.
                img.load()
                preview = img.convert('RGBA')
                preview.thumbnail((110, 42), PILImage.Resampling.LANCZOS)
                self.logo_preview_photo = ImageTk.PhotoImage(preview)

            if hasattr(self, 'logo_preview_label'):
                self.logo_preview_label.config(
                    image=self.logo_preview_photo,
                    text='',
                    width=110,
                    height=42
                )
            return True
        except Exception as e:
            self.logo_preview_photo = None
            if hasattr(self, 'logo_preview_label'):
                self.logo_preview_label.config(image='', text='Logo không đọc được')
            messagebox.showerror("Lỗi logo", f"Không thể mở file logo:\n{e}")
            return False

    def select_logo(self):
        filename = filedialog.askopenfilename(
            title="Chọn logo",
            filetypes=[
                ("Image files", "*.png *.jpg *.jpeg *.bmp *.webp"),
                ("PNG", "*.png"),
                ("JPEG", "*.jpg *.jpeg"),
                ("BMP", "*.bmp"),
                ("WEBP", "*.webp"),
                ("All files", "*.*"),
            ]
        )
        if not filename:
            return

        # Chỉ nhận logo sau khi đã xác nhận ảnh đọc được.
        old_logo = getattr(self, 'logo_path', None)
        self.logo_path = filename
        if not self._update_logo_preview():
            self.logo_path = old_logo
            self._update_logo_preview()
            return

        # Lưu thành logo mặc định để lần mở chương trình sau tự nạp lại.
        saved_logo = self._store_logo_as_default(filename)
        self.logo_path = saved_logo
        self._update_logo_preview()

        if hasattr(self, 'logo_name_var'):
            self.logo_name_var.set(os.path.basename(filename))
        if hasattr(self, 'status_var'):
            self.status_var.set(f"Đã chọn và lưu logo mặc định: {os.path.basename(filename)}")

    def clear_logo(self):
        self.logo_path = None
        self._save_logo_preference(None)
        self.logo_preview_photo = None
        if hasattr(self, 'logo_name_var'):
            self.logo_name_var.set("Chưa chọn logo")
        if hasattr(self, 'logo_preview_label'):
            self.logo_preview_label.config(image='', text='Chưa có logo', width=14, height=2)
        if hasattr(self, 'status_var'):
            self.status_var.set("Đã bỏ logo")

    def add_custom_order_info(self):
        name = self.entry_extra_info_name.get().strip()
        value = self.entry_extra_info_value.get().strip()
        col = self.entry_extra_info_col.get().strip().upper()
        row_text = self.entry_extra_info_row.get().strip()

        if not name and not value:
            messagebox.showwarning("Cảnh báo", "Vui lòng nhập tên thông tin hoặc nội dung!")
            return
        if not re.fullmatch(r'[A-Z]{1,2}', col or ''):
            messagebox.showwarning("Cảnh báo", "Cột Excel phải là chữ, ví dụ C, H, O, AA...")
            return
        try:
            row = int(row_text)
        except ValueError:
            messagebox.showwarning("Cảnh báo", "Dòng Excel phải là số nguyên dương!")
            return
        if row < 1:
            messagebox.showwarning("Cảnh báo", "Dòng Excel phải từ 1 trở lên!")
            return

        self.custom_info_list.append({'name': name, 'value': value, 'col': col, 'row': row})
        self.update_custom_info_table()
        self.entry_extra_info_name.delete(0, tk.END)
        self.entry_extra_info_value.delete(0, tk.END)
        self.entry_extra_info_col.delete(0, tk.END)
        self.entry_extra_info_row.delete(0, tk.END)
        self.status_var.set(f"Đã thêm thông tin đơn hàng tại {col}{row}")

    def update_custom_info_table(self):
        if not hasattr(self, 'info_tree'):
            return
        for item in self.info_tree.get_children():
            self.info_tree.delete(item)
        for item in self.custom_info_list:
            self.info_tree.insert('', 'end', values=(
                item.get('name', ''), item.get('value', ''),
                item.get('col', ''), item.get('row', '')
            ))

    def delete_custom_order_info(self):
        if not hasattr(self, 'info_tree'):
            return
        selected = self.info_tree.selection()
        if not selected:
            messagebox.showwarning("Cảnh báo", "Vui lòng chọn thông tin cần xóa!")
            return
        indices = sorted({self.info_tree.index(i) for i in selected}, reverse=True)
        for idx in indices:
            if 0 <= idx < len(self.custom_info_list):
                del self.custom_info_list[idx]
        self.update_custom_info_table()

    def clear_custom_order_info(self):
        if self.custom_info_list and messagebox.askyesno("Xác nhận", "Xóa tất cả thông tin đơn hàng đã thêm?"):
            self.custom_info_list.clear()
            self.update_custom_info_table()

