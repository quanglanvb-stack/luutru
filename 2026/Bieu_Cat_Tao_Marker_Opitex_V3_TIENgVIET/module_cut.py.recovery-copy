        rows = []
        for row in list(getattr(self, 'size_rows', []) or []):
            try:
                lights = []
                for holder in list(getattr(row, 'light_rows', []) or []):
                    lights.append({
                        'qty': str(holder['qty_var'].get()),
                        'light': str(holder['light_var'].get()),
                    })
                rows.append({
                    'size': str(row.size_var.get()),
                    'start': str(row.start_var.get()),
                    'lights': lights,
                })
            except Exception:
                continue

        def _v(name, default=''):
            var = getattr(self, name, None)
            try:
                return str(var.get()) if var is not None else str(default)
            except Exception:
                return str(default)

        return {
            'version': 1,
            'launch_mode': str(getattr(self, 'launch_mode', 'both') or 'both'),
            'customer': _v('customer'),
            'style_code': _v('style_code'),
            'color': _v('color'),
            'batch': _v('batch'),
            'po': _v('po'),
            'season': _v('season'),
            'date': _v('date'),
            'round_qty': _v('round_qty', '50'),
            'last_limit': _v('last_limit', '75'),
            'rows': rows,
            'logo': self._aux_project_logo_payload(),
        }

    def _restore_aux_project_logo(self, logo_info):
        """V113: khôi phục logo riêng của BẢNG CẮT / FORM 10."""
        if not isinstance(logo_info, dict):
            return
        path = str(logo_info.get('path', '') or '').strip()
        restored = None
        try:
            if logo_info.get('embedded') and logo_info.get('data_base64'):
                name = str(logo_info.get('name', '') or 'aux_project_logo.png')
                ext = os.path.splitext(name)[1].lower()
                if ext not in ('.png', '.jpg', '.jpeg', '.bmp', '.webp'):
                    ext = '.png'
                owner = getattr(self, 'owner', None)
                if owner is not None and hasattr(owner, '_logo_config_dir'):
                    folder = owner._logo_config_dir()
                else:
                    folder = os.path.dirname(os.path.abspath(__file__))
                restored = os.path.join(folder, 'project_aux_logo' + ext)
                raw = base64.b64decode(str(logo_info.get('data_base64')).encode('ascii'))
                with open(restored, 'wb') as f:
                    f.write(raw)
            elif path and os.path.isfile(path):
                restored = path
        except Exception:
            restored = path if path and os.path.isfile(path) else None
        if restored and os.path.isfile(restored):
            self.logo_path = restored
            try:
                self.logo_label.configure(text=str(logo_info.get('name', '') or os.path.basename(restored)))
            except Exception:
                pass

    def apply_project_state(self, state):
        """V113: nạp lại dữ liệu dùng chung của XUẤT BẢNG CẮT và XUẤT FORM 10."""
        if not isinstance(state, dict):
            return

        mapping = {
            'customer': 'customer',
            'style_code': 'style_code',
            'color': 'color',
            'batch': 'batch',
            'po': 'po',
            'season': 'season',
            'date': 'date',
            'round_qty': 'round_qty',
            'last_limit': 'last_limit',
        }
        for key, attr in mapping.items():
            var = getattr(self, attr, None)
            if var is None:
                continue
            try:
                var.set(str(state.get(key, '') if state.get(key, '') is not None else ''))
            except Exception:
                pass

        # Xóa các dòng mặc định rồi dựng lại đúng số cỡ / số Shade đã lưu.
        for row in list(getattr(self, 'size_rows', []) or []):
            try:
                row.destroy()
            except Exception:
                pass
        self.size_rows.clear()

        for item in state.get('rows') or []:
            if not isinstance(item, dict):
                continue
            row = self.add_size_row()
            row.size_var.set(str(item.get('size', '') or ''))
            row.start_var.set(str(item.get('start', '') or ''))
            lights = item.get('lights') or []
            if not isinstance(lights, list):
                lights = []
            if not lights:
                lights = [{'qty': '', 'light': ''}]

            first = lights[0] if isinstance(lights[0], dict) else {}
            row.set_first_light(
                str(first.get('qty', '') if first.get('qty', '') is not None else ''),
                str(first.get('light', '') if first.get('light', '') is not None else '')
            )
            for extra in lights[1:]:
                if not isinstance(extra, dict):
                    continue
                h = row.add_light_row(first=False)
                h['qty_var'].set(str(extra.get('qty', '') if extra.get('qty', '') is not None else ''))
                h['light_var'].set(str(extra.get('light', '') if extra.get('light', '') is not None else ''))

        # Dự án có thể được lưu khi danh sách cỡ trống; vẫn giữ một dòng để tiếp tục nhập.
        if not self.size_rows:
            self.add_size_row()
        self._regrid_rows()

        try:
            self.set_mode(str(state.get('launch_mode', 'both') or 'both'))
        except Exception:
            self.set_mode('both')
        self._restore_aux_project_logo(state.get('logo'))
        if hasattr(self, 'update_status_var'):
            self.update_status_var.set('Đã khôi phục dữ liệu BẢNG CẮT + FORM 10 từ dự án')

    def collect_data(self):
        sizes = []
        for row in self.size_rows:
            d = row.get()
            if not d["size"] and d["qty"] == 0:
                continue
            if not d["size"]:
                raise ValueError("Có dòng chưa nhập tên cỡ.")
            if not d["lights"]:
                raise ValueError(f"Cỡ {d['size']} chưa có Shade / số lượng.")
            for light in d["lights"]:
                if light["qty"] <= 0:
                    raise ValueError(f"Cỡ {d['size']} - Shade {light['light']} phải có số lượng > 0.")
            if d["qty"] <= 0:
                raise ValueError(f"Cỡ {d['size']} phải có tổng số lượng > 0.")
            sizes.append(d)
        if not sizes:
            raise ValueError("Chưa có cỡ để xuất.")

        round_qty = safe_int(self.round_qty.get(), 0)
        last_limit = safe_int(self.last_limit.get(), 0)
        if round_qty <= 0:
            raise ValueError("Số lượng làm tròn phải > 0.")
        if last_limit < round_qty:
            raise ValueError("Giới hạn bàn cuối phải >= số lượng làm tròn.")

        # Logic số bắt đầu không cần chế độ chọn:
        # - Cỡ đầu tiên phải có số bắt đầu.
        # - Cỡ nào để trống sẽ tự bắt đầu sau mốc làm tròn kế tiếp của cỡ trước.
        #   Ví dụ cỡ trước 1-252, làm tròn 50 -> cỡ kế tiếp bắt đầu 301.
        # - Nếu người dùng nhập số bắt đầu ở bất kỳ cỡ nào, số đó được ưu tiên;
        #   các cỡ để trống phía sau lại tiếp tục tự tính từ cỡ vừa nhập đó.
        if sizes[0]["start_no"] <= 0:
            raise ValueError(f"Cỡ đầu tiên ({sizes[0]['size']}) phải nhập Số bắt đầu > 0.")

        current_start = sizes[0]["start_no"]
        for i, d in enumerate(sizes):
            if i == 0:
                d["start_no"] = current_start
            elif d["start_no"] > 0:
                current_start = d["start_no"]
            else:
                d["start_no"] = current_start

            # Trong cùng một cỡ, Shade sau được làm tròn theo chục:
            # ví dụ Shade A kết thúc 204 -> Shade B bắt đầu 211.
            # Vì có thể phát sinh khoảng trống giữa các Shade, số kết thúc của cỡ
            # phải tính theo từng Shade thay vì chỉ start + tổng SL - 1.
            end_no = size_end_with_lights(d["start_no"], d["lights"], 10)
            current_start = int(math.ceil(end_no / round_qty) * round_qty) + 1

        return {
            "customer": self.customer.get().strip(),
            "style_code": self.style_code.get().strip(),
            "color": self.color.get().strip(),
            "batch": self.batch.get().strip(),
            "po": self.po.get().strip(),
            "season": self.season.get().strip(),
            "date": self.date.get().strip(),
            "round_qty": round_qty,
            "last_limit": last_limit,
            "sizes": sizes,
            "total": sum(x["qty"] for x in sizes),
            "logo": self.logo_path,
        }

