        # Theo ảnh kiểm tra của người dùng: hàng 55 là mép dưới A4.
        # Trang đầu bắt đầu phần bảng ở hàng 6, vì vậy mỗi trang dành các hàng 6..55 cho bảng.
        fixed_page_bottom_row = 55
        page_body_rows = fixed_page_bottom_row - first_data_top + 1
