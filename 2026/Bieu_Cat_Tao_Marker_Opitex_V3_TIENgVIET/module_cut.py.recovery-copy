                    pts, fill=fill, outline=outline, width=1,
                    tags=(tag, 'topnav')
                )

                r = 10
                nav.create_oval(
                    circle_x-r, mid-r, circle_x+r, mid+r,
                    fill='#ffffff' if idx == self._current_top_page else '#d7e8f7',
                    outline='', tags=(tag, 'topnav')
                )
                nav.create_text(
                    circle_x, mid,
                    text=str(idx+1),
                    fill=selected if idx == self._current_top_page else '#315d82',
                    font=('Segoe UI', 7, 'bold'),
                    tags=(tag, 'topnav')
                )

                nav.create_text(
                    (x0+x1)/2 + (5 if i else 0), mid,
                    text=label,
                    fill=fg,
                    font=('Segoe UI', 9 if idx == self._current_top_page else 8, 'bold'),
                    tags=(tag, 'topnav')
                )

                # V151: chỉ bind click. Không redraw ở Enter/Leave vì có thể
                # tạo vòng lặp sự kiện Canvas trên Windows và làm cửa sổ Not Responding.
                nav.tag_bind(tag, '<Button-1>', lambda e, n=idx: show_page(n))
                x = x1 - overlap

        def show_page(index):
            if getattr(self, '_nav_switching', False):
                return
            if getattr(self, '_calculation_busy', False) or getattr(self, '_export_busy', False):
                try:
                    self.status_var.set('Đang xử lý, vui lòng chờ hoàn tất trước khi đổi trang.')
                except Exception:
                    pass
                return
            index = max(0, min(len(nav_items) - 1, int(index)))
            if index == getattr(self, '_current_top_page', 0):
                return
            self._nav_switching = True
            try:
                workflow.select(index)
                self._current_top_page = index
                _draw_nav()
            except Exception:
                pass
            finally:
                self._nav_switching = False

