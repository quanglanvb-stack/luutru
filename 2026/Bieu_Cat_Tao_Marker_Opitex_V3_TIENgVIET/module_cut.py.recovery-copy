        return int(value)

    def _on_fabric_all_po_toggled(self):
        """Bật TẤT CẢ PO thì khóa các ô chọn PO riêng; tắt thì cho chọn nhiều PO."""
        state = 'disabled' if bool(self.fabric_all_po_var.get()) else 'normal'
        for cb in getattr(self, 'fabric_po_checkbuttons', []):
            try:
                cb.config(state=state)
            except tk.TclError:
                pass

    def _refresh_fabric_po_selector(self):
        """Vẽ lại danh sách PO trong phần chọn PO của LOẠI VẢI."""
        if not hasattr(self, 'fabric_po_checks_frame'):
            return

        old_selected = {
            str(po): bool(var.get())
            for po, var in getattr(self, 'fabric_po_vars', {}).items()
        }
        for widget in self.fabric_po_checks_frame.winfo_children():
            widget.destroy()

        self.fabric_po_vars = {}
        self.fabric_po_checkbuttons = []
        po_names = []
        for po in self.po_list:
            name = str(po.get('po', '')).strip()
            if name and name not in po_names:
                po_names.append(name)

        if not po_names:
            tk.Label(self.fabric_po_checks_frame, text="Chưa có PO - hãy thêm PO trước",
                     font=('Arial', 9), fg='#7f8c8d').pack(side='left', padx=4)
            return

        for name in po_names:
            var = tk.BooleanVar(value=old_selected.get(name, False))
            po_obj = next((x for x in self.po_list if str(x.get('po','')).strip() == name), None)
            color = str((po_obj or {}).get('color', '') or '').strip()
            label = f'{name} - {color}' if color else name
            cb = tk.Checkbutton(self.fabric_po_checks_frame, text=label, variable=var,
                                font=('Arial', 9))
            cb.pack(side='left', padx=4)
            self.fabric_po_vars[name] = var
            self.fabric_po_checkbuttons.append(cb)

        self._on_fabric_all_po_toggled()

    def _on_fabric_no_lot_toggled(self):
        no_lot = bool(getattr(self, 'fabric_no_lot_var', tk.BooleanVar(value=False)).get())
        if no_lot:
            self.fabric_all_lot_var.set(False)
        state = 'disabled' if no_lot else 'normal'
        if hasattr(self, 'fabric_all_lot_check'):
            self.fabric_all_lot_check.config(state=state)
        for cb in getattr(self, 'fabric_lot_checkbuttons', []):
            try: cb.config(state=state)
            except tk.TclError: pass

    def _on_fabric_all_lot_toggled(self):
        if bool(getattr(self, 'fabric_all_lot_var', tk.BooleanVar(value=False)).get()):
            if hasattr(self, 'fabric_no_lot_var'):
                self.fabric_no_lot_var.set(False)
        no_lot = bool(getattr(self, 'fabric_no_lot_var', tk.BooleanVar(value=False)).get())
        state = 'disabled' if no_lot or bool(getattr(self, 'fabric_all_lot_var', tk.BooleanVar(value=False)).get()) else 'normal'
        for cb in getattr(self, 'fabric_lot_checkbuttons', []):
            try: cb.config(state=state)
            except tk.TclError: pass

    def _refresh_fabric_lot_selector(self):
        if not hasattr(self, 'fabric_lot_checks_frame'):
            return
        old = {name: bool(var.get()) for name,var in getattr(self,'fabric_lot_vars',{}).items()}
        for w in self.fabric_lot_checks_frame.winfo_children(): w.destroy()
        self.fabric_lot_vars = {}; self.fabric_lot_checkbuttons = []
        names=[]
        for row in getattr(self,'global_lot_rows',[]) or []:
            name=str(row.get('lot','') or '').strip()
            if name and name not in names: names.append(name)
        if not names:
            tk.Label(self.fabric_lot_checks_frame, text='Chưa có Shade - có thể thêm loại vải chỉ theo PO',
                     font=('Arial',9), fg='#7f8c8d').pack(side='left', padx=4)
            self._on_fabric_no_lot_toggled()
            return
        for name in names:
            var=tk.BooleanVar(value=old.get(name, False))
            cb=tk.Checkbutton(self.fabric_lot_checks_frame, text=name, variable=var, font=('Arial',9),
                              command=lambda: getattr(self, 'fabric_no_lot_var', tk.BooleanVar(value=False)).set(False))
            cb.pack(side='left', padx=4)
            self.fabric_lot_vars[name]=var; self.fabric_lot_checkbuttons.append(cb)
        self._on_fabric_no_lot_toggled()
        self._on_fabric_all_lot_toggled()

    def _get_fabric_lot_selection(self):
        if bool(getattr(self,'fabric_no_lot_var',tk.BooleanVar(value=False)).get()):
            return 'none', []
        if bool(getattr(self,'fabric_all_lot_var',tk.BooleanVar(value=False)).get()):
            return 'all', []
        selected=[name for name,var in getattr(self,'fabric_lot_vars',{}).items() if bool(var.get())]
        # Không chọn Shade cũng hợp lệ: loại vải chỉ lấy sản lượng PO.
        return ('selected', selected) if selected else ('none', [])

    def _fabric_lot_names(self, fabric):
        mode=str(fabric.get('lot_mode','none') or 'none').lower()
        if mode == 'none':
            return []
        if mode == 'all':
            return [str(r.get('lot','')).strip() for r in getattr(self,'global_lot_rows',[]) or [] if str(r.get('lot','')).strip()]
        return [str(x).strip() for x in (fabric.get('lot_targets',[]) or []) if str(x).strip()]

    def _fabric_lot_display(self, fabric):
        mode=str(fabric.get('lot_mode','none') or 'none').lower()
        if mode == 'none':
            return 'KHÔNG DÙNG Shade'
        if mode == 'all':
            return 'TẤT CẢ Shade'
        names=self._fabric_lot_names(fabric)
        return ', '.join(names) if names else 'KHÔNG DÙNG Shade'

    def _get_fabric_po_selection(self):
        """Trả về ('all', []) hoặc ('selected', [PO...]) từ giao diện thêm vải."""
        if bool(getattr(self, 'fabric_all_po_var', tk.BooleanVar(value=True)).get()):
            return 'all', []
        selected = [name for name, var in getattr(self, 'fabric_po_vars', {}).items() if bool(var.get())]
        return 'selected', selected

    def _fabric_po_names(self, fabric):
        """Danh sách tên PO thực tế áp dụng cho một loại vải."""
        mode = str(fabric.get('po_mode', 'all') or 'all').lower()
        if mode == 'all':
            return [str(po.get('po', '')).strip() for po in self.po_list if str(po.get('po', '')).strip()]
        selected = [str(x).strip() for x in (fabric.get('po_targets', []) or []) if str(x).strip()]
        return selected

    def _fabric_po_display(self, fabric):
        if str(fabric.get('po_mode', 'all') or 'all').lower() == 'all':
            return 'TẤT CẢ PO'
        names = self._fabric_po_names(fabric)
        return ', '.join(names) if names else '(CHƯA CHỌN PO)'

    def _po_color_text(self, po_name):
        """Trả về màu của một PO; PO cũ chưa có màu thì trả chuỗi rỗng."""
        name = str(po_name or '').strip()
        po = next((x for x in self.po_list if str(x.get('po','')).strip() == name), None)
        return str((po or {}).get('color', '') or '').strip()

    def _fabric_po_color_lines(self, fabric):
        """Mỗi PO - MÀU một dòng để ghi trong ô LOẠI VẢI khi xuất Excel."""
        lines = []
        for po_name in self._fabric_po_names(fabric):
            color = self._po_color_text(po_name)
            lines.append(f'PO: {po_name} - MÀU: {color}' if color else f'PO: {po_name}')
        return lines

    def _fabric_po_color_display(self, fabric):
        lines = self._fabric_po_color_lines(fabric)
        return ' | '.join(lines) if lines else self._fabric_po_display(fabric)

    def _fabric_total_by_size(self, fabric):
        """Tổng sản lượng theo cỡ chỉ từ các PO mà loại vải được phép áp dụng."""
        size_keys = [item['key'] for item in self.sizes]
        totals = {key: 0 for key in size_keys}
        mode = str(fabric.get('po_mode', 'all') or 'all').lower()
        selected = set(self._fabric_po_names(fabric)) if mode != 'all' else None
        for po in self.po_list:
            po_name = str(po.get('po', '')).strip()
            if selected is not None and po_name not in selected:
                continue
            for key in size_keys:
                totals[key] += int(po.get(key, 0) or 0)
        return totals

    def _fabric_planned_total_by_size(self, fabric):
        """V62: kế hoạch theo từng PO, làm tròn tăng riêng từng cỡ rồi mới cộng."""
        size_keys = [item['key'] for item in self.sizes]
        totals = {key: 0 for key in size_keys}
        mode = str(fabric.get('po_mode', 'all') or 'all').lower()
        selected = set(self._fabric_po_names(fabric)) if mode != 'all' else None
        for po in self.po_list:
            po_name = str(po.get('po', '')).strip()
            if selected is not None and po_name not in selected:
                continue
            for key in size_keys:
                totals[key] += self._planned_po_qty(po, key)
        return totals

