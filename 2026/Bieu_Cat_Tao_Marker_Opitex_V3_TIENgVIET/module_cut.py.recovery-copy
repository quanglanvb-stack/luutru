    # ==================== HÀM XỬ LÝ LOẠI VẢI + Shade ====================
    def _selected_fabric_index(self):
        """Index loại vải đang chọn trong bảng danh sách loại vải."""
        selected = self.fabric_tree.selection() if hasattr(self, 'fabric_tree') else ()
        if not selected:
            return None
        idx = self.fabric_tree.index(selected[0])
        return idx if 0 <= idx < len(self.fabric_list) else None

    def _lot_target_fabric_index(self):
        """Index loại vải mà khu vực Shade đang áp dụng.

        Dùng combobox riêng để Shade không thể vô tình dùng chung cho nhiều loại vải.
        """
        if hasattr(self, 'lot_fabric_combo'):
            idx = self.lot_fabric_combo.current()
            if 0 <= idx < len(self.fabric_list):
                return idx
        return None

    def _refresh_lot_fabric_combo(self, select_index=None):
        if not hasattr(self, 'lot_fabric_combo'):
            return
        values = [f"{i+1}. {fabric['name']}" for i, fabric in enumerate(self.fabric_list)]
        self.lot_fabric_combo['values'] = values

        if not values:
            self.lot_fabric_var.set('')
            self.lot_fabric_combo.set('')
            self.selected_fabric_var.set("Chưa chọn loại vải")
            return

        if select_index is not None and 0 <= select_index < len(values):
            self.lot_fabric_combo.current(select_index)
            self.selected_fabric_var.set(f"Loại vải: {self.fabric_list[select_index]['name']}")
        else:
            cur = self.lot_fabric_combo.current()
            if cur < 0 or cur >= len(values):
                self.lot_fabric_combo.set('')
                self.selected_fabric_var.set("Chưa chọn loại vải")

    def on_lot_fabric_selected(self, event=None):
        """Chọn loại vải đích cho Shade; đồng bộ lựa chọn ở bảng loại vải."""
        idx = self._lot_target_fabric_index()
        if idx is None:
            self.selected_fabric_var.set("Chưa chọn loại vải")
            self.refresh_lot_table()
            return

        self.selected_fabric_var.set(f"Loại vải: {self.fabric_list[idx]['name']}")
        if hasattr(self, 'fabric_tree'):
            children = self.fabric_tree.get_children()
            if idx < len(children):
                item = children[idx]
                self.fabric_tree.selection_set(item)
                self.fabric_tree.focus(item)
                self.fabric_tree.see(item)
        self.refresh_lot_table()

    def on_fabric_selected(self, event=None):
        idx = self._selected_fabric_index()
        if idx is None:
            self.selected_fabric_var.set("Chưa chọn loại vải")
            if hasattr(self, 'lot_fabric_combo'):
                self.lot_fabric_combo.set('')
        else:
            # Khi chọn loại vải ở bảng, khu vực Shade chuyển đúng sang loại vải đó.
            self._refresh_lot_fabric_combo(select_index=idx)
            self.selected_fabric_var.set(f"Loại vải: {self.fabric_list[idx]['name']}")
            try:
                self._show_fabric_dashboard(idx)
            except Exception:
                pass
        self.refresh_lot_table()

    def add_fabric(self):
        try:
            name = self.entry_fabric_name.get().strip()
            if not name:
                messagebox.showwarning("Cảnh báo", "Vui lòng nhập tên loại vải!")
                return

            norm_text = self.entry_fabric_norm.get().strip().replace(',', '.')
            min_text = self.entry_fabric_minlen.get().strip().replace(',', '.') if hasattr(self, 'entry_fabric_minlen') else '1'
            max_text = self.entry_fabric_maxlen.get().strip().replace(',', '.')
            max_sp_text = self.entry_fabric_max_products.get().strip().replace(',', '.') if hasattr(self, 'entry_fabric_max_products') else ''
            if not norm_text:
                messagebox.showwarning("Cảnh báo", "Vui lòng nhập định mức trung bình!")
                return
            norm = float(norm_text)
            min_length = float(min_text) if min_text else 1.0
            max_length = float(max_text) if max_text else 0.0
            max_products = int(float(max_sp_text)) if max_sp_text else 0
            if norm <= 0:
                messagebox.showwarning("Cảnh báo", "Định mức phải lớn hơn 0!")
                return
            if max_length <= 0 and max_products <= 0:
                messagebox.showwarning("Cảnh báo", "Chỉ cần nhập CHIỀU DÀI TỐI ĐA hoặc SP TỐI ĐA / 1 SƠ ĐỒ (ít nhất một mục phải > 0).")
                return
            if min_length < 0 or max_length < 0 or max_products < 0:
                messagebox.showwarning("Cảnh báo", "Giới hạn không được nhỏ hơn 0!")
                return
            if max_length > 0 and min_length > max_length + 1e-9:
                messagebox.showwarning("Cảnh báo", "CHIỀU DÀI TỐI THIỂU không được lớn hơn CHIỀU DÀI TỐI ĐA!")
                return

            # V40: mỗi loại vải chọn PO áp dụng riêng; PO vẫn nhập ở tab PO như cũ.
            po_mode, po_targets = self._get_fabric_po_selection()
            if po_mode == 'selected' and not po_targets:
                messagebox.showwarning("Cảnh báo", "Hãy chọn ít nhất 1 PO cho loại vải hoặc chọn TẤT CẢ PO!")
                return

            lot_mode, lot_targets = self._get_fabric_lot_selection()
            # V47: Shade là tùy chọn. Loại vải có thể chỉ lấy số lượng PO mà không dùng Shade.

            cut_mode = self._fabric_mode_key_from_label(
                self.fabric_mode_var.get() if hasattr(self, 'fabric_mode_var') else 'TỰ ĐỘNG'
            )

            self.fabric_list.append({
                'name': name,
                'cut_mode': cut_mode,
                'optimizer_mode': 'smart',
                'even_ratio': False,
                'norm': norm,
                'min_length': min_length,
                'max_length': max_length,
                'max_products': max_products,
                'balance_pct': 1.0,
                # V163: đầu tấm mặc định 1 m / chừa 1 lá.
                'reserve_m': 1.0,
                'reserve_plies': 1,
                'po_mode': po_mode,
                'po_targets': list(po_targets),
                'lot_mode': lot_mode,
                'lot_targets': list(lot_targets),
                'export_roll': bool(getattr(self, 'fabric_export_roll_var', tk.BooleanVar(value=True)).get()),
                # V98: mặc định chưa chốt lựa chọn PO hiển thị -> khi mở popup sẽ tích toàn bộ PO áp dụng.
                'roll_po_targets': [], 'roll_po_selection_set': False,
                'export_edit': bool(getattr(self, 'fabric_export_edit_var', tk.BooleanVar(value=True)).get()),
                'lots': [],
                'rolls': [],
                'shades': []
            })

            new_idx = len(self.fabric_list) - 1
            self.update_fabric_table(select_index=new_idx)
            self.entry_fabric_name.delete(0, tk.END)
            self.entry_fabric_name.insert(0, 'VẢI LÓT')
            self.entry_fabric_norm.delete(0, tk.END)
            if hasattr(self, 'entry_fabric_minlen'):
                self.entry_fabric_minlen.delete(0, tk.END)
                self.entry_fabric_minlen.insert(0, '1')
            self.entry_fabric_maxlen.delete(0, tk.END)
            if hasattr(self, 'entry_fabric_max_products'):
                self.entry_fabric_max_products.delete(0, tk.END)
            if hasattr(self, 'fabric_mode_var'):
                self.fabric_mode_var.set('TỰ ĐỘNG')
            if hasattr(self, 'fabric_export_roll_var'):
                self.fabric_export_roll_var.set(True)
            if hasattr(self, 'fabric_export_edit_var'):
                self.fabric_export_edit_var.set(True)
            self._sync_global_lots()
            po_text = self._fabric_po_display(self.fabric_list[new_idx])
            lot_text = self._fabric_lot_display(self.fabric_list[new_idx])
            self.status_var.set(f"Đã thêm loại vải: {name} | PO: {po_text} | {lot_text}")

        except ValueError:
            messagebox.showerror("Lỗi", "Định mức, chiều dài tối thiểu/tối đa và SP tối đa phải là số!")

    def delete_fabric(self):
        selected = self.fabric_tree.selection()
        if not selected:
            messagebox.showwarning("Cảnh báo", "Vui lòng chọn loại vải cần xóa!")
            return

        indices = sorted({self.fabric_tree.index(item) for item in selected}, reverse=True)
        for idx in indices:
            if 0 <= idx < len(self.fabric_list):
                del self.fabric_list[idx]

        self._sync_global_lots()
        self.update_fabric_table()
        self.selected_fabric_var.set("Chưa chọn loại vải")
