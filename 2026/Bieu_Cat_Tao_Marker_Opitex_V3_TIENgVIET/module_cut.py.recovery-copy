    # ==================== CÂY / Shade VẢI - V43 ====================
    def _po_qty_for_fabric(self, fabric):
        """Trả về [(PO, số lượng)] đúng các PO mà loại vải đang áp dụng."""
        mode = str(fabric.get('po_mode', 'all') or 'all').lower()
        allowed = set(self._fabric_po_names(fabric)) if mode != 'all' else None
        result = []
        for po in self.po_list:
            po_name = str(po.get('po', '') or '').strip()
            if not po_name:
                continue
            if allowed is not None and po_name not in allowed:
                continue
            qty = sum(int(po.get(size['key'], 0) or 0) for size in self.sizes)
            if qty > 0:
                result.append((po_name, qty))
        return result

    def _global_lot_row_scope_text(self, row):
        fabrics = row.get('fabric_names', []) or []
        pos = row.get('po_names', []) or []
        ftxt = 'TẤT CẢ' if row.get('fabric_mode', 'all') == 'all' else ', '.join(fabrics)
        ptxt = 'TẤT CẢ' if row.get('po_mode', 'all') == 'all' else ', '.join(pos)
        return ftxt, ptxt

    def _global_lot_targets(self, row):
        """Danh sách loại vải được phép dùng Shade này.

        V57: một Shade có thể cấp cho NHIỀU loại vải. Phạm vi trong QUẢN LÝ
        CÂY/Shade và lựa chọn Shade ở từng loại vải được giao nhau để xác định
        các loại vải hợp lệ.
        """
        lot_name = str(row.get('lot','') or '').strip()
        row_mode = str(row.get('fabric_mode','all') or 'all').lower()
        row_names = {str(x).strip().lower() for x in (row.get('fabric_names',[]) or []) if str(x).strip()}
        targets=[]
        for fidx, fabric in enumerate(self.fabric_list):
            fname = str(fabric.get('name','') or '').strip()
            if row_mode == 'selected' and fname.lower() not in row_names:
                continue
            mode=str(fabric.get('lot_mode','none') or 'none').lower()
            if mode == 'none':
                continue
            allowed={str(x).strip().lower() for x in (fabric.get('lot_targets',[]) or []) if str(x).strip()}
            if mode != 'all' and lot_name.lower() not in allowed:
                continue
            po_items=self._po_qty_for_fabric(fabric)
            total_qty=sum(q for _,q in po_items)
            if total_qty <= 0:
                continue
            demand=float(fabric.get('norm',1.0) or 1.0) * total_qty
            targets.append((fidx, po_items, demand))
        return targets

    def _choose_one_fabric_for_lot(self, row, targets, remaining_need, assigned_count=None):
        """Chọn đúng 1 loại vải cho toàn bộ Shade.

        V65:
        - Shade không bao giờ bị xé cho nhiều loại vải.
        - Trước tiên cố gắng cho mỗi loại vải còn nhu cầu nhận ít nhất 1 Shade.
        - Sau đó chọn Shade gần với số mét còn thiếu nhất.
        - Khi tất cả loại vải phù hợp đã đủ mét thì Shade còn lại để CHƯA GÁN.
        """
        if not targets:
            return None
        assigned_count = assigned_count or {}
        manual=row.get('manual_fabric_index', None)
        if manual is not None:
            try: manual=int(manual)
            except Exception: manual=None
            if manual is not None and any(fidx==manual for fidx,_,_ in targets):
                return manual
        try: lot_m=max(0.0,float(row.get('meters',0) or 0))
        except Exception: lot_m=0.0

        candidates=[]
        for fidx, po_items, demand in targets:
            need=max(0.0,float(remaining_need.get(fidx,demand)))
            if need <= 1e-9:
                continue
            # Ưu tiên loại vải chưa có Shade trước, sau đó ưu tiên Shade không vượt nhu cầu
            # và khoảng cách mét gần nhất.
            first_penalty = 0 if int(assigned_count.get(fidx,0) or 0) == 0 else 1
            overshoot_penalty = 0 if lot_m <= need + 1e-9 else 1
            score=(first_penalty, overshoot_penalty, abs(need-lot_m), -need, fidx)
            candidates.append((score,fidx))
        if not candidates:
            return None
        candidates.sort(key=lambda x:x[0])
        return candidates[0][1]

    @staticmethod
    def _split_integer_by_weights(total, weighted_keys):
        total=max(0,int(total or 0))
        if total <= 0 or not weighted_keys:
            return {k:0 for k,_ in weighted_keys}
        sw=sum(max(0.0,float(w)) for _,w in weighted_keys)
        if sw <= 0:
            result={k:0 for k,_ in weighted_keys}
            for i in range(total): result[weighted_keys[i % len(weighted_keys)][0]] += 1
            return result
        raw=[(k,total*max(0.0,float(w))/sw) for k,w in weighted_keys]
        result={k:int(v) for k,v in raw}
        left=total-sum(result.values())
        order=sorted(raw,key=lambda kv:(kv[1]-int(kv[1])),reverse=True)
        for i in range(left): result[order[i % len(order)][0]] += 1
        return result

    def _sync_global_lots(self):
        """V58: đồng bộ Shade dùng chung theo CÂY.

        - Một Shade có thể cấp cho nhiều loại vải.
        - Mỗi CÂY tự động chỉ thuộc đúng 1 loại vải tại một thời điểm; không tự xé
          cùng một cây cho nhiều loại vải.
        - Chương trình chỉ lấy các cây cần thiết theo số mét còn thiếu. Khi tất cả
          loại vải đã đủ, Shade/cây còn lại giữ CHƯA GÁN để người dùng điều chỉnh sau.
        - Sau khi xuất Excel, nếu muốn CHUYỂN ĐẦU TẤM thủ công sang loại vải khác,
          người dùng có thể nhập lại cùng Shade + SỐ CÂY ở một dòng khác với số mét
          đầu tấm. Dòng gốc sẽ tự trừ số mét đã chuyển, tránh nhân đôi tồn vải.
        """
        for fabric in self.fabric_list:
            fabric['lots']=[lot for lot in (fabric.get('lots',[]) or [])
                            if not lot.get('auto_global_lot') and not lot.get('auto_roll_lot') and not lot.get('auto_shade_lot')]
            fabric['rolls']=[r for r in (fabric.get('rolls',[]) or []) if not r.get('auto_global_roll')]

        remaining_need={}
        for fidx,fabric in enumerate(self.fabric_list):
            po_items=self._po_qty_for_fabric(fabric)
            qty=sum(q for _,q in po_items)
            remaining_need[fidx]=max(0.0,float(fabric.get('norm',1.0) or 1.0)*qty)

        for row_index,row in enumerate(getattr(self,'global_lot_rows',[]) or []):
            self._ensure_lot_roll_details(row)
            self._recalc_lot_from_roll_details(row)
            lot_name=str(row.get('lot','') or '').strip()
            lot_mark=str(row.get('lot_mark','') or '').strip()
            if not lot_name:
                continue

            row['assigned_fabric_name']=''
            row['assigned_fabric_index']=None
            row['display_fabric_name']=''
            row['display_fabric_index']=None
            row['assigned_rolls_by_fabric']={}

            targets=self._global_lot_targets(row)
            if not targets:
                continue
            target_ids=[fidx for fidx,_,_ in targets]

            # Nếu người dùng từng gán thủ công 1 loại vải thì giữ ưu tiên đó.
            manual=row.get('manual_fabric_index', None)
            try:
                manual=int(manual) if manual is not None else None
            except Exception:
                manual=None
            if manual not in target_ids:
                manual=None

            details = self._ensure_lot_roll_details(row)
            per_fabric_rolls={fidx:[] for fidx in target_ids}
            per_fabric_meters={fidx:0.0 for fidx in target_ids}
            per_lot_count={fidx:0 for fidx in target_ids}

            # V57: chia theo từng cây. Ưu tiên loại vải chưa nhận cây nào từ Shade này,
            # sau đó chọn loại còn thiếu sao cho cây hiện tại khớp nhu cầu nhất.
            for j,d in enumerate(details):
                try:
                    length=max(0.0,float(d.get('meters',0) or 0))
                except Exception:
                    length=0.0
                if length <= 0:
                    continue
                roll_name=str(d.get('roll','') or (j+1))
                mark=str(d.get('lot_mark',lot_mark) or '')

                if manual is not None and remaining_need.get(manual,0.0) > 1e-9:
                    chosen=manual
                else:
                    cand=[]
                    for fidx in target_ids:
                        need=max(0.0,float(remaining_need.get(fidx,0.0)))
                        if need <= 1e-9:
                            continue
                        first_penalty = 0 if per_lot_count.get(fidx,0) == 0 else 1
                        overshoot_penalty = 0 if length <= need + 1e-9 else 1
                        cand.append(((first_penalty, overshoot_penalty, abs(need-length), -need, fidx), fidx))
                    if not cand:
                        # Tất cả loại vải đã đủ: cây còn lại giữ CHƯA DÙNG / chưa gán.
                        continue
                    cand.sort(key=lambda x:x[0])
                    chosen=cand[0][1]

                per_fabric_rolls[chosen].append({
                    'roll':roll_name, 'lot':lot_name, 'lot_mark':mark, 'shade':mark,
                    'length':length, 'fabric_width_cm':str(d.get('fabric_width_cm','') or ''),
                    'auto_global_roll':True, 'global_row':row_index,
                    'source_roll_no':j+1, 'source_total_length':length
                })
                per_fabric_meters[chosen]+=length
                per_lot_count[chosen]+=1
                remaining_need[chosen]=max(0.0,float(remaining_need.get(chosen,0.0))-length)

            used_names=[]
            for fidx in target_ids:
                meters=per_fabric_meters.get(fidx,0.0)
                rolls=per_fabric_rolls.get(fidx,[])
                if meters <= 0 and not rolls:
                    continue
                fabric=self.fabric_list[fidx]
                fname=str(fabric.get('name','') or '')
                used_names.append(fname)
                fabric.setdefault('lots',[]).append({
                    'name':lot_name, 'meters':meters, 'auto_global_lot':True,
                    'source_lot':lot_name, 'global_row':row_index, 'lot_mark':lot_mark,
                    'roll_count_source':len(rolls), 'shared_lot':len(target_ids)>1
                })
                fabric.setdefault('rolls',[]).extend(rolls)
                # V93: lưu khóa cây theo SỐ CÂY + Lot nhà sản xuất để không gộp
                # hai cây trùng số nhưng khác nhãn/Lot nhà sản xuất.
                row['assigned_rolls_by_fabric'][fname]=[
                    f"{str(r.get('roll','') or '').strip()}||{str(r.get('lot_mark','') or '').strip()}"
                    for r in rolls
                ]

            if used_names:
                row['assigned_fabric_name']=' + '.join(used_names)
                row['display_fabric_name']=row['assigned_fabric_name']
                if len(used_names)==1:
                    only=used_names[0]
                    try:
                        idx=next(i for i,f in enumerate(self.fabric_list) if str(f.get('name','') or '')==only)
                    except StopIteration:
                        idx=None
                    row['assigned_fabric_index']=idx
                    row['display_fabric_index']=idx

    def _sync_roll_lots(self, fabric):
        """Tên hàm cũ được giữ để các phần khác của chương trình vẫn tương thích."""
        if getattr(self, 'global_lot_rows', None):
            self._sync_global_lots()
            return [lot for lot in (fabric.get('lots', []) or []) if lot.get('auto_global_lot')]

        # Tương thích dữ liệu cây cũ nếu chưa dùng kho Shade V43.
        manual_lots = [
            lot for lot in (fabric.get('lots', []) or [])
            if not lot.get('auto_roll_lot') and not lot.get('auto_shade_lot')
        ]
        grouped = {}
        order = []
        for r in fabric.get('rolls', []) or []:
            lot_name = str(r.get('lot', r.get('shade', '')) or '').strip()
            try:
                length = float(r.get('length', 0) or 0)
            except (TypeError, ValueError):
                length = 0.0
            if lot_name and length > 0:
                if lot_name not in grouped:
                    grouped[lot_name] = 0.0
                    order.append(lot_name)
                grouped[lot_name] += length
        po_items = self._po_qty_for_fabric(fabric)
        total_qty = sum(q for _, q in po_items)
        auto_lots = []
        for lot_name in order:
            total_m = grouped[lot_name]
            allocated = 0.0
            for i, (po_name, qty) in enumerate(po_items):
                meters = round(total_m - allocated, 2) if i == len(po_items)-1 else round(total_m*qty/total_qty, 2)
                if i != len(po_items)-1:
                    allocated += meters
                auto_lots.append({'name': f'{lot_name} - {po_name}', 'meters': meters,
                                  'auto_roll_lot': True, 'source_lot': lot_name, 'po': po_name})
        fabric['lots'] = manual_lots + auto_lots
        return auto_lots

    def _sync_shade_lots(self, fabric):
        return self._sync_roll_lots(fabric)

    def _sync_all_shade_lots(self):
        if getattr(self, 'global_lot_rows', None):
            self._sync_global_lots()
            return
        for fabric in self.fabric_list:
            if fabric.get('rolls'):
                self._sync_roll_lots(fabric)
            else:
                fabric['lots'] = [
                    lot for lot in (fabric.get('lots', []) or [])
                    if not lot.get('auto_roll_lot') and not lot.get('auto_shade_lot')
                ]

