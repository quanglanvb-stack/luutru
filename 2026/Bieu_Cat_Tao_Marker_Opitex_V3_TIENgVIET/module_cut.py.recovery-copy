    def _prepare_cutplan_for_write(self, filename):
        """V184: gỡ các thuộc tính Windows có thể chặn ghi đè file .cutplan cũ.

        Một số bản trước có thể để file ở trạng thái Hidden/System/Read-only.
        Trước khi lưu lại, tạm đưa file về trạng thái có thể ghi.
        Sau khi lưu xong, save_project sẽ đặt Hidden lại.
        """
        try:
            path = os.path.abspath(str(filename or ''))
            if not path or not os.path.isfile(path):
                return True

            # Bỏ read-only ở mức Python trước.
            try:
                import stat
                os.chmod(path, stat.S_IWRITE | stat.S_IREAD)
            except Exception:
                pass

            if os.name != 'nt':
                return True

            import ctypes
            FILE_ATTRIBUTE_READONLY = 0x00000001
            FILE_ATTRIBUTE_HIDDEN   = 0x00000002
            FILE_ATTRIBUTE_SYSTEM   = 0x00000004
            FILE_ATTRIBUTE_NORMAL   = 0x00000080
            INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF

            kernel32 = ctypes.windll.kernel32
            kernel32.GetFileAttributesW.argtypes = [ctypes.c_wchar_p]
            kernel32.GetFileAttributesW.restype = ctypes.c_uint32
            kernel32.SetFileAttributesW.argtypes = [ctypes.c_wchar_p, ctypes.c_uint32]
            kernel32.SetFileAttributesW.restype = ctypes.c_int

            attrs = kernel32.GetFileAttributesW(path)
            if attrs == INVALID_FILE_ATTRIBUTES:
                return False

            new_attrs = attrs & ~(
                FILE_ATTRIBUTE_READONLY |
                FILE_ATTRIBUTE_HIDDEN |
                FILE_ATTRIBUTE_SYSTEM
            )
            if new_attrs == 0:
                new_attrs = FILE_ATTRIBUTE_NORMAL

            return bool(kernel32.SetFileAttributesW(path, new_attrs))
        except Exception:
            # Không chặn luồng lưu; bước ghi file phía sau sẽ báo lỗi thật nếu vẫn bị khóa.
            return False

    def _set_cutplan_hidden(self, filename, hidden=True):
        """Đặt/bỏ thuộc tính Hidden cho file .cutplan trên Windows.

        Chỉ thay thuộc tính của file, không đổi tên/đuôi/nội dung nên phần mềm
        vẫn có thể mở trực tiếp bằng đường dẫn đầy đủ.
        """
        try:
            path = os.path.abspath(str(filename or ''))
            if not path.lower().endswith('.cutplan') or not os.path.isfile(path):
                return False
            if os.name != 'nt':
                return True

            import ctypes
            FILE_ATTRIBUTE_READONLY = 0x1
            FILE_ATTRIBUTE_HIDDEN = 0x2
            FILE_ATTRIBUTE_SYSTEM = 0x4
            FILE_ATTRIBUTE_NORMAL = 0x80
            INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF
            kernel32 = ctypes.windll.kernel32
            kernel32.GetFileAttributesW.argtypes = [ctypes.c_wchar_p]
            kernel32.GetFileAttributesW.restype = ctypes.c_uint32
            kernel32.SetFileAttributesW.argtypes = [ctypes.c_wchar_p, ctypes.c_uint32]
            kernel32.SetFileAttributesW.restype = ctypes.c_int
            attrs = kernel32.GetFileAttributesW(path)
            if attrs == INVALID_FILE_ATTRIBUTES:
                return False
            # File dự án chỉ cần Hidden; không để lại READONLY/SYSTEM vì sẽ cản lần lưu kế tiếp.
            base_attrs = attrs & ~(FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_SYSTEM)
            if hidden:
                new_attrs = base_attrs | FILE_ATTRIBUTE_HIDDEN
            else:
                new_attrs = base_attrs & ~FILE_ATTRIBUTE_HIDDEN
                if new_attrs == 0:
                    new_attrs = FILE_ATTRIBUTE_NORMAL
            return bool(kernel32.SetFileAttributesW(path, new_attrs))
        except Exception:
            # Không để lỗi thuộc tính Hidden làm hỏng thao tác LƯU/MỞ dự án.
            return False

    def _project_picker_initial_dir(self):
        """Thư mục khởi đầu cho cửa sổ MỞ DỰ ÁN riêng của phần mềm."""
        candidates = []
        try:
            if self.current_project_path:
                candidates.append(os.path.dirname(os.path.abspath(self.current_project_path)))
        except Exception:
            pass
        try:
            last_dir = str(getattr(self, '_last_project_dir', '') or '').strip()
            if last_dir:
                candidates.append(last_dir)
        except Exception:
            pass
        try:
            candidates.append(os.path.join(os.path.expanduser('~'), 'Documents'))
        except Exception:
            pass
        candidates.append(os.getcwd())
        for folder in candidates:
            try:
                if folder and os.path.isdir(folder):
                    return os.path.abspath(folder)
            except Exception:
                pass
        return os.getcwd()

    def _choose_project_file_in_app(self):
        """Mở trực tiếp hộp chọn file Windows và ép hiện cả .cutplan đang Hidden.

        Không tạo thêm cửa sổ danh sách riêng. Trên Windows dùng GetOpenFileNameW
        với OFN_FORCESHOWHIDDEN để file .cutplan vẫn Hidden trong Explorer nhưng
        vẫn xuất hiện ngay trong hộp MỞ của phần mềm.
        """
        initial_dir = self._project_picker_initial_dir()

        # Windows: dùng Common File Dialog native + OFN_FORCESHOWHIDDEN.
        if os.name == 'nt':
            try:
                import ctypes
                from ctypes import wintypes

                OFN_READONLY = 0x00000001
                OFN_HIDEREADONLY = 0x00000004
                OFN_PATHMUSTEXIST = 0x00000800
                OFN_FILEMUSTEXIST = 0x00001000
                OFN_EXPLORER = 0x00080000
                OFN_NOCHANGEDIR = 0x00000008
                OFN_FORCESHOWHIDDEN = 0x10000000

                LPOFNHOOKPROC = ctypes.c_void_p

                class OPENFILENAMEW(ctypes.Structure):
                    _fields_ = [
                        ('lStructSize', wintypes.DWORD),
                        ('hwndOwner', wintypes.HWND),
                        ('hInstance', wintypes.HINSTANCE),
                        ('lpstrFilter', wintypes.LPCWSTR),
                        ('lpstrCustomFilter', wintypes.LPWSTR),
                        ('nMaxCustFilter', wintypes.DWORD),
                        ('nFilterIndex', wintypes.DWORD),
                        ('lpstrFile', wintypes.LPWSTR),
                        ('nMaxFile', wintypes.DWORD),
                        ('lpstrFileTitle', wintypes.LPWSTR),
                        ('nMaxFileTitle', wintypes.DWORD),
                        ('lpstrInitialDir', wintypes.LPCWSTR),
                        ('lpstrTitle', wintypes.LPCWSTR),
                        ('Flags', wintypes.DWORD),
                        ('nFileOffset', wintypes.WORD),
                        ('nFileExtension', wintypes.WORD),
                        ('lpstrDefExt', wintypes.LPCWSTR),
                        ('lCustData', wintypes.LPARAM),
                        ('lpfnHook', LPOFNHOOKPROC),
                        ('lpTemplateName', wintypes.LPCWSTR),
                        ('pvReserved', ctypes.c_void_p),
                        ('dwReserved', wintypes.DWORD),
                        ('FlagsEx', wintypes.DWORD),
                    ]

                # Bộ lọc: mặc định chỉ hiện dự án .cutplan.
                filter_text = (
                    'Dự án Cutting Plan (*.cutplan)\0*.cutplan\0'
                    'Tất cả file (*.*)\0*.*\0\0'
                )
                file_buffer = ctypes.create_unicode_buffer(32768)

                try:
                    self.root.update_idletasks()
                    owner = wintypes.HWND(int(self.root.winfo_id()))
                except Exception:
                    owner = None

                ofn = OPENFILENAMEW()
                ofn.lStructSize = ctypes.sizeof(OPENFILENAMEW)
                ofn.hwndOwner = owner
                ofn.lpstrFilter = filter_text
                ofn.nFilterIndex = 1
                ofn.lpstrFile = ctypes.cast(file_buffer, wintypes.LPWSTR)
                ofn.nMaxFile = len(file_buffer)
                ofn.lpstrInitialDir = initial_dir
                ofn.lpstrTitle = 'Mở dự án Cutting Plan (.cutplan)'
                ofn.Flags = (
                    OFN_EXPLORER
                    | OFN_FILEMUSTEXIST
                    | OFN_PATHMUSTEXIST
                    | OFN_HIDEREADONLY
                    | OFN_NOCHANGEDIR
                    | OFN_FORCESHOWHIDDEN
                )
                ofn.lpstrDefExt = 'cutplan'

                comdlg32 = ctypes.windll.comdlg32
                comdlg32.GetOpenFileNameW.argtypes = [ctypes.POINTER(OPENFILENAMEW)]
                comdlg32.GetOpenFileNameW.restype = wintypes.BOOL

                ok = bool(comdlg32.GetOpenFileNameW(ctypes.byref(ofn)))
                if not ok:
                    # 0 = người dùng bấm Cancel. Mã khác = lỗi dialog.
                    err = int(comdlg32.CommDlgExtendedError())
                    if err:
                        raise OSError(f'Windows OpenFile dialog error: 0x{err:08X}')
                    return None

                filename = os.path.abspath(file_buffer.value)
                if filename:
                    try:
                        self._last_project_dir = os.path.dirname(filename)
                    except Exception:
                        pass
                    return filename
                return None

            except Exception:
                # Nếu máy Windows nào đó không gọi được Common Dialog native,
                # fallback về hộp thoại Tkinter để vẫn mở dự án được.
                pass

        # Fallback (hoặc khi chạy ngoài Windows).
        filename = filedialog.askopenfilename(
            title='Mở dự án Cutting Plan (.cutplan)',
            initialdir=initial_dir,
            defaultextension='.cutplan',
            filetypes=[
                ('Cutting Plan Project', '*.cutplan'),
                ('All files', '*.*'),
            ],
            parent=self.root,
        )
        if filename:
            try:
                self._last_project_dir = os.path.dirname(os.path.abspath(filename))
            except Exception:
                pass
            return os.path.abspath(filename)
        return None

