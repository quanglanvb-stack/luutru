    def update_fabric_table(self, select_index=None):
        if not hasattr(self, 'fabric_tree'):
            return
        for item in self.fabric_tree.get_children():
            self.fabric_tree.delete(item)

        for fabric in self.fabric_list:
            # V57: cùng một Shade có thể cấp các cây khác nhau cho nhiều loại vải;
            # tổng mét hiển thị ở đây chỉ là phần mét thực sự đã phân cho loại vải này.
            lots = fabric.get('lots', []) or []
            total_meters = sum(float(lot.get('meters', 0)) for lot in lots)
            min_len = max(0.0, float(fabric.get('min_length', 1.0) or 0))
            max_len = float(fabric.get('max_length', 0) or 0)
            max_sp = int(fabric.get('max_products', 0) or 0)
            self.fabric_tree.insert('', 'end', values=(
                fabric['name'], '▼  ' + self._fabric_mode_display(fabric),
                '▼  ' + self.OPTIMIZER_LABELS.get(self._optimizer_mode_key_from_label(fabric.get('optimizer_mode','smart')), 'TOÀN CỤC'),
                self._fabric_po_display(fabric) + '  ▼', self._fabric_lot_display(fabric) + '  ▼',
                f"{float(fabric.get('norm',0) or 0):.2f}", f"{min_len:.2f}", (f"{max_len:.2f}" if max_len > 0 else ''),
                (str(max_sp) if max_sp > 0 else ''),
                len(lots), f"{total_meters:.2f}", len(fabric.get('rolls', []) or []),
                (('☑ CÓ: ' + ' + '.join(self._fabric_roll_po_names(fabric))) if bool(fabric.get('export_roll', True)) else '☐ KHÔNG'),
                ('☑ CÓ' if bool(fabric.get('export_edit', True)) else '☐ KHÔNG')
            ))

        # Tự mở rộng 4 -> 10 dòng. Từ dòng 11 trở đi giữ chiều cao 10 và dùng scrollbar.
        try:
            self.fabric_tree.configure(height=min(10, max(4, len(self.fabric_list))))
        except Exception:
            pass

        self._refresh_lot_fabric_combo(select_index=select_index)
        try:
            self._refresh_fabric_dashboard_list(select_index=select_index)
        except Exception:
            pass

        if select_index is not None and 0 <= select_index < len(self.fabric_list):
            children = self.fabric_tree.get_children()
            if select_index < len(children):
                item = children[select_index]
                self.fabric_tree.selection_set(item)
                self.fabric_tree.focus(item)
                self.fabric_tree.see(item)
                self.on_fabric_selected()
        else:
            self.refresh_lot_table()

