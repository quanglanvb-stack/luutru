    def _selected_dashboard_fabric_index(self):
        tree = getattr(self, 'fabric_nav_tree', None)
        if tree is None or not tree.selection():
            return None
        try:
            idx = int(str(tree.selection()[0]).replace('fabric_', ''))
            return idx if 0 <= idx < len(self.fabric_list) else None
        except Exception:
            return None

    def _refresh_fabric_dashboard_list(self, select_index=None):
        tree = getattr(self, 'fabric_nav_tree', None)
        if tree is None:
            return
        old_idx = self._selected_dashboard_fabric_index()
        for item in tree.get_children():
            tree.delete(item)
        for i, fabric in enumerate(self.fabric_list):
            cached = self._dashboard_cached_result(i)
            raw_item = getattr(self, '_fabric_preview_cache', {}).get(i)
            has_old = isinstance(raw_item, dict) and raw_item.get('result') is not None
            if cached is not None:
                mark = '✓ '
            elif has_old:
                mark = '⚠ '
            else:
                mark = '  '
            tree.insert('', 'end', iid=f'fabric_{i}', text=mark + str(fabric.get('name','')))
        idx = select_index if select_index is not None else old_idx
        if idx is None and self.fabric_list:
            idx = 0
        if idx is not None and 0 <= idx < len(self.fabric_list):
            iid = f'fabric_{idx}'
            try:
                tree.selection_set(iid); tree.focus(iid); tree.see(iid)
            except Exception:
                pass
            self._show_fabric_dashboard(idx)
        elif not self.fabric_list:
            self._clear_fabric_dashboard()

    def _on_fabric_nav_selected(self, event=None):
        idx = self._selected_dashboard_fabric_index()
        if idx is None:
            return
        if hasattr(self, 'fabric_tree'):
            children = self.fabric_tree.get_children()
            if idx < len(children):
                item = children[idx]
                try:
                    self.fabric_tree.selection_set(item); self.fabric_tree.focus(item)
                except Exception:
                    pass
        self._show_fabric_dashboard(idx)
        try:
            self._refresh_lot_fabric_combo(select_index=idx)
            self.refresh_lot_table()
        except Exception:
            pass

    def _current_plan_cache_key_for_dashboard(self):
        try:
            payload = {
                'sizes': self.sizes,
                'po_list': self.po_list,
                'fabric_list': self.fabric_list,
                'global_lot_rows': self.global_lot_rows,
                'increase_enabled': bool(self.increase_enabled_var.get()),
                'increase_mode': str(self.increase_mode_var.get()),
                'max_over': int(self.MAX_OVER),
            }
            return json.dumps(payload, ensure_ascii=False, sort_keys=True, default=str)
        except Exception:
            return None

    def _single_fabric_cache_key(self, idx):
        if not (0 <= idx < len(self.fabric_list)):
            return None
        try:
            payload = {
                'idx': idx, 'sizes': self.sizes, 'po_list': self.po_list,
                'fabric': self.fabric_list[idx], 'global_lot_rows': self.global_lot_rows,
                'increase_enabled': bool(self.increase_enabled_var.get()),
                'increase_mode': str(self.increase_mode_var.get()), 'max_over': int(self.MAX_OVER),
            }
            return json.dumps(payload, ensure_ascii=False, sort_keys=True, default=str)
        except Exception:
            return None

    def _dashboard_cached_result(self, idx):
        if not (0 <= idx < len(self.fabric_list)):
            return None
        key = self._single_fabric_cache_key(idx)
        item = getattr(self, '_fabric_preview_cache', {}).get(idx)
        if isinstance(item, dict) and item.get('key') == key and item.get('result') is not None:
            return item.get('result')
        global_key = self._current_plan_cache_key_for_dashboard()
        if global_key is None or global_key != getattr(self, '_cut_plan_cache_key', None):
            return None
        results = getattr(self, '_cut_plan_cache_results', None)
        if not isinstance(results, list) or idx >= len(results):
            return None
        return results[idx]

    def _snapshot_dashboard_results(self, exclude_idx=None):
        """V139: giữ nguyên kết quả đã tính của các loại vải khác.

        Khi tính lại 1 loại vải, một số bước đồng bộ Shade có thể làm thay đổi
        cache-key chung. Vì vậy cần chụp kết quả thực tế trước khi cập nhật loại
        đang chọn, rồi gắn lại key mới cho các loại còn lại sau khi tính xong.
        """
        saved = {}
        preview_cache = getattr(self, '_fabric_preview_cache', {}) or {}
        global_results = getattr(self, '_cut_plan_cache_results', None)

        for i in range(len(self.fabric_list)):
            if exclude_idx is not None and i == exclude_idx:
                continue

            result = None

            # Ưu tiên kết quả từng loại đã lưu riêng, kể cả key cũ.
            item = preview_cache.get(i)
            if isinstance(item, dict) and item.get('result') is not None:
                result = item.get('result')

            # Nếu chưa có cache riêng, lấy từ cache toàn bộ gần nhất.
            if result is None and isinstance(global_results, list) and i < len(global_results):
                result = global_results[i]

            if result is not None:
                saved[i] = result

        return saved

    def _restore_dashboard_results(self, saved, exclude_idx=None):
        """V139: ghi lại kết quả các loại khác với cache-key hiện tại."""
        if not isinstance(saved, dict):
            return
        for i, result in saved.items():
            if exclude_idx is not None and i == exclude_idx:
                continue
            if 0 <= i < len(self.fabric_list) and result is not None:
                self._cache_dashboard_result(i, result)

    def _cache_dashboard_result(self, idx, result):
        if not hasattr(self, '_fabric_preview_cache') or not isinstance(self._fabric_preview_cache, dict):
            self._fabric_preview_cache = {}
        key = self._single_fabric_cache_key(idx)
        self._fabric_preview_cache[idx] = {'key': key, 'result': result}

    def _promote_individual_cache_to_global(self):
        if not self.fabric_list:
            return
        results = []
        for i in range(len(self.fabric_list)):
            r = self._dashboard_cached_result(i)
            if r is None:
                return
            results.append(r)
        key = self._current_plan_cache_key_for_dashboard()
        if key is not None:
            self._cut_plan_cache_key = key
            self._cut_plan_cache_results = results

