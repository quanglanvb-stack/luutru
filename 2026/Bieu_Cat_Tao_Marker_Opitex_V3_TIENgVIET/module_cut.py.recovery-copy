        po_box.pack(side="left", fill="both", expand=True, padx=(0, 5))
        lot_box.pack(side="left", fill="both", expand=True, padx=(5, 0))

        po_vars = {name: tk.BooleanVar(value=True) for name in po_names}
        po_all_var = tk.BooleanVar(value=True)
        def set_all_pos():
            v = bool(po_all_var.get())
            for vv in po_vars.values(): vv.set(v)
        tk.Checkbutton(po_box, text="TẤT CẢ PO", variable=po_all_var, command=set_all_pos,
