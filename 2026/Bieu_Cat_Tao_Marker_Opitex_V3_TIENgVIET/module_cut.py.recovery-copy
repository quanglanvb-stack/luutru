    def _apply_fabric_dashboard_editors(self, silent=False):
        idx = self._selected_dashboard_fabric_index()
        if idx is None:
            return False
        fabric = self.fabric_list[idx]
        v = self.fabric_dash_edit_vars
        try:
            name = v['name'].get().strip()
            if not name:
                raise ValueError('Tên loại vải không được để trống.')
            norm = float(v['norm'].get().strip().replace(',', '.'))
            min_len = float((v['min'].get().strip() or '0').replace(',', '.'))
            max_len = float((v['max'].get().strip() or '0').replace(',', '.'))
            maxsp = int(float((v['maxsp'].get().strip() or '0').replace(',', '.')))
            table_count = int(float((v['table_count'].get().strip() or '0').replace(',', '.')))
            balance_pct = float((v['balance_pct'].get().strip() or '1').replace(',', '.'))
            reserve_m = float((v['reserve_m'].get().strip() or '1').replace(',', '.'))
            reserve_plies = int(float((v['reserve_plies'].get().strip() or '1').replace(',', '.')))
            if norm <= 0: raise ValueError('Định mức TB phải lớn hơn 0.')
            if min_len < 0 or max_len < 0 or maxsp < 0: raise ValueError('Các giới hạn không được âm.')
            if table_count < 0 or table_count > 6:
                raise ValueError('Số bàn cố định: nhập 0 để tự động, hoặc từ 1 đến 6 bàn.')
            if balance_pct < 0 or balance_pct > 100:
                raise ValueError('% âm/dương phải nằm trong khoảng 0 đến 100.')
            if reserve_m < 0:
                raise ValueError('Mét đầu tấm không được âm.')
            if reserve_plies < 1:
                raise ValueError('Số lá để lại phải từ 1 lá trở lên.')
            if max_len <= 0 and maxsp <= 0: raise ValueError('Cần nhập Chiều dài tối đa hoặc SP tối đa/sơ đồ.')
            if max_len > 0 and min_len > max_len + 1e-9: raise ValueError('Chiều dài tối thiểu không được lớn hơn tối đa.')
            po_mode, po_targets = self._parse_fabric_po_text(v['po'].get())
            lot_mode, lot_targets = self._parse_fabric_lot_text(v['lot'].get())
            fabric.update({
                'name': name,
                'cut_mode': self._fabric_mode_key_from_label(v['mode'].get()),
                'optimizer_mode': self._optimizer_mode_key_from_label(v['optimizer'].get()),
                'po_mode': po_mode, 'po_targets': list(po_targets),
                'lot_mode': lot_mode, 'lot_targets': list(lot_targets),
                'norm': norm, 'min_length': min_len, 'max_length': max_len,
                'max_products': maxsp,
                'even_ratio': bool(self.fabric_dash_even_ratio_var.get()),
                'table_count': table_count,
                'balance_pct': balance_pct,
                'reserve_m': reserve_m,
                'reserve_plies': reserve_plies,
                'export_roll': str(v['export_roll'].get()).strip().upper() != 'KHÔNG',
                'export_edit': str(v['export_edit'].get()).strip().upper() != 'KHÔNG',
                'split_priority': 'width' if str(v['split_priority'].get()).strip().lower().startswith('khổ') else 'lot',
            })
        except Exception as e:
            if not silent:
                messagebox.showerror('Thông tin loại vải', str(e))
            return False

        # V140: KHÔNG xóa kết quả bàn cũ của loại đang sửa.
        # Key của loại đã thay đổi nên kết quả này tự trở thành "cũ/chưa tính lại",
        # nhưng vẫn được giữ để hiển thị cho người dùng đối chiếu.
        self._cut_plan_cache_key = None
        self._cut_plan_cache_results = None
        try:
            self.update_fabric_table(select_index=idx)
            self._refresh_lot_fabric_combo(select_index=idx)
        except Exception:
            pass
        self._refresh_fabric_dashboard_list(select_index=idx)
        if not silent:
            self.status_var.set(f"Đã cập nhật thông tin: {fabric.get('name','')}. Bấm TÍNH LẠI loại này nếu cần.")
        return True

    def _format_ratio_map_dashboard(self, ratio_map):
        """V156: định dạng tỉ lệ theo thứ tự size hiện tại, ví dụ S/1 + M/2 + L/1."""
        order = {s.get('key'): i for i, s in enumerate(self.sizes)}
        names = {s.get('key'): str(s.get('name', s.get('key', ''))) for s in self.sizes}
        rm = {
            k: int(v or 0)
            for k, v in (ratio_map or {}).items()
            if int(v or 0) > 0
        }
        parts = []
        for k in sorted(rm, key=lambda x: order.get(x, 10**9)):
            parts.append(f"{names.get(k, k)}/{rm[k]}")
        return ' + '.join(parts)

    def _parse_ratio_text_dashboard(self, text_value):
        """V156: đọc tỉ lệ người dùng gõ trên dashboard.

        Hỗ trợ:
          S/1 + M/2 + L/1
          S:1, M:2, L:1
          S*1 | M*2 | L*1
          M            -> hiểu M/1
        """
        raw = str(text_value or '').strip()
        if not raw:
            raise ValueError('Tỉ lệ sơ đồ không được để trống.')

        name_to_key = {}
        for s in self.sizes:
            name = str(s.get('name', '') or '').strip()
            key = s.get('key')
            if name and key:
                name_to_key[name.casefold()] = key

        # Cho phép nhiều kiểu dấu phân cách.
        normalized = raw.replace('＋', '+').replace('×', '*')
        parts = [
            p.strip()
            for p in re.split(r'\s*(?:\+|,|;|\|)\s*', normalized)
            if p.strip()
        ]
        if not parts:
            raise ValueError('Không đọc được tỉ lệ sơ đồ.')

        ratio_map = {}
        for part in parts:
            m = re.match(r'^(.*?)\s*(?:/|:|\*|x|X)\s*(\d+)\s*$', part)
            if m:
                size_name = m.group(1).strip()
                ratio = int(m.group(2))
            else:
                size_name = part.strip()
                ratio = 1

            key = name_to_key.get(size_name.casefold())
            if key is None:
                raise ValueError(
                    f"Không tìm thấy size '{size_name}'. "
                    "Hãy nhập đúng tên size đang có trong đơn hàng."
                )
            if ratio <= 0:
                raise ValueError(f"Tỉ lệ của size {size_name} phải lớn hơn 0.")
            ratio_map[key] = int(ratio_map.get(key, 0)) + ratio

        if not ratio_map:
            raise ValueError('Tỉ lệ sơ đồ không hợp lệ.')
        return ratio_map

    def _rebuild_tables_after_ratio_edit_dashboard(self, idx, result, edited_table_index, new_ratio_map):
        """V161: sửa TỈ LỆ chỉ làm thay đổi BÀN ĐANG SỬA.

        Quy tắc:
        - Các bàn khác GIỮ NGUYÊN số lá và sản lượng.
        - Bàn đang sửa:
            + Chiều dài = Định mức TB × tổng tỉ lệ mới.
            + Số lá = số lá cần để bù phần sản lượng còn thiếu,
              sau khi đã trừ sản lượng của TẤT CẢ các bàn khác.
        - Không chạy chia lại số lá từ B1 -> B cuối.

        Ví dụ:
        B6 đang S/3 x 10 lá = 30 SP.
        Các bàn B1-B5 đã có 327 SP S, kế hoạch S = 356.
        Đổi B6 thành S/1 -> B6 tự thành 29 lá, B1-B5 giữ nguyên.
        """
        if not (0 <= idx < len(self.fabric_list)):
            raise ValueError('Không tìm thấy loại vải đang chọn.')

        fabric = self.fabric_list[idx]
        norm = float(fabric.get('norm', 0) or 0)
        if norm <= 0:
            raise ValueError('Định mức TB phải lớn hơn 0.')

        max_len = float(fabric.get('max_length', 0) or 0)
        max_products = int(fabric.get('max_products', 0) or 0)

        required = {
            k: int(v or 0)
            for k, v in (result.get('total_by_size', {}) or {}).items()
        }
        size_keys = [s.get('key') for s in self.sizes]
        size_names = {
            s.get('key'): str(s.get('name', s.get('key', '')))
            for s in self.sizes
        }

        old_tables = list(result.get('cutting_tables', []) or [])
        if not (0 <= edited_table_index < len(old_tables)):
            raise ValueError('Không tìm thấy bàn cần sửa.')

        # Copy sâu các phần cần chỉnh.
        tables = []
        for tb in old_tables:
            nt = dict(tb)
            nt['ratio_map'] = dict(tb.get('ratio_map', {}) or {})
            nt['sizes'] = dict(tb.get('sizes', {}) or {})
            tables.append(nt)

        # Chỉ thay tỉ lệ bàn được sửa.
        tables[edited_table_index]['ratio_map'] = dict(new_ratio_map)

        # Chuẩn hóa tỉ lệ + chiều dài.
        for i, tb in enumerate(tables):
            rm = {
                k: int(v or 0)
                for k, v in (tb.get('ratio_map', {}) or {}).items()
                if int(v or 0) > 0
            }
            if not rm:
                raise ValueError(f"Bàn {i+1} không có size nào.")

            ratio_total = sum(rm.values())
            if bool(fabric.get('even_ratio', False)):
                invalid_sizes = [v for v in rm.values() if v != 1 and v % 2]
                if invalid_sizes:
                    raise ValueError(
                        f"Bàn {i+1}: tỷ lệ từng cỡ chỉ được là 1 hoặc số chẵn (2, 4, 6...)."
                    )
                if ratio_total != 1 and ratio_total % 2:
                    raise ValueError(
                        f"Bàn {i+1}: tổng tỷ lệ sơ đồ phải là 1 hoặc số chẵn; hiện tại là {ratio_total}."
                    )
            raw_len = float(norm) * float(ratio_total)

            if max_len > 0 and raw_len > max_len + 1e-9:
                raise ValueError(
                    f"Bàn {i+1}: chiều dài tự tính {raw_len:.2f}m "
                    f"vượt tối đa {max_len:.2f}m."
                )
            if max_products > 0 and ratio_total > max_products:
                raise ValueError(
                    f"Bàn {i+1}: tổng tỉ lệ {ratio_total} vượt "
                    f"SP tối đa/sơ đồ ({max_products})."
                )

            tb['ratio_map'] = rm
            tb['ratio'] = self._format_ratio_map_dashboard(rm)
            tb['raw_length'] = raw_len
            tb['length'] = raw_len
            tb['meter_rate'] = raw_len / max(1, ratio_total)
            tb['size_count'] = len(rm)

        # ==========================================================
        # V161: KHÓA TOÀN BỘ BÀN KHÁC.
        # Chúng giữ nguyên số lá; chỉ đồng bộ lại sizes = ratio × lá.
        # ==========================================================
        actual_other = {k: 0 for k in size_keys}

        for i, tb in enumerate(tables):
            if i == edited_table_index:
                continue

            plies = max(0, int(tb.get('plies', 0) or 0))
            tb['plies'] = plies

            rm = tb.get('ratio_map', {}) or {}
            sizes = {}
            for k, ratio in rm.items():
                qty = int(ratio or 0) * plies
                if qty > 0:
                    sizes[k] = qty
                    actual_other[k] = int(actual_other.get(k, 0) or 0) + qty

            tb['sizes'] = sizes
            tb['total_output'] = sum(sizes.values())

        # ==========================================================
        # TÍNH RIÊNG SỐ LÁ BÀN ĐANG SỬA.
        # Cần bao nhiêu sản lượng sau khi trừ tất cả bàn khác?
        # ==========================================================
        edited = tables[edited_table_index]
        edited_rm = edited.get('ratio_map', {}) or {}

        residual = {
            k: max(
                0,
                int(required.get(k, 0) or 0)
                - int(actual_other.get(k, 0) or 0)
            )
            for k in size_keys
        }

        # Nếu một cỡ còn thiếu nhưng tỉ lệ bàn sửa không chứa cỡ đó,
        # thì không thể sửa riêng bàn này mà vẫn đủ sản lượng.
        impossible = {
            k: qty
            for k, qty in residual.items()
            if qty > 0 and int(edited_rm.get(k, 0) or 0) <= 0
        }
        if impossible:
            detail = ', '.join(
                f"{size_names.get(k, k)} thiếu {v}"
                for k, v in impossible.items()
            )
            raise ValueError(
                "Tỉ lệ mới làm thiếu sản lượng ở cỡ không có trong bàn đang sửa: "
                + detail
                + ". Hãy thêm cỡ đó vào tỉ lệ bàn này hoặc sửa một bàn khác."
            )

        needed_plies = []
        for k, ratio in edited_rm.items():
            ratio = int(ratio or 0)
            need = int(residual.get(k, 0) or 0)
            if ratio > 0 and need > 0:
                needed_plies.append(
                    int(math.ceil(float(need) / float(ratio)))
                )

        # Nếu các bàn khác đã đủ toàn bộ cỡ của bàn này thì bàn sửa = 0 lá.
        new_plies = max(needed_plies) if needed_plies else 0
        new_plies = max(0, int(new_plies))
        edited['plies'] = new_plies

        edited_sizes = {}
        for k, ratio in edited_rm.items():
            qty = int(ratio or 0) * new_plies
            if qty > 0:
                edited_sizes[k] = qty
        edited['sizes'] = edited_sizes
        edited['total_output'] = sum(edited_sizes.values())

        # Tổng sản lượng cuối sau khi ghép lại bàn sửa + các bàn khóa.
        actual = dict(actual_other)
        for k, qty in edited_sizes.items():
            actual[k] = int(actual.get(k, 0) or 0) + int(qty or 0)

        missing = {
            k: max(
                0,
                int(required.get(k, 0) or 0)
                - int(actual.get(k, 0) or 0)
            )
            for k in size_keys
        }
        missing = {k: v for k, v in missing.items() if v > 0}

        if missing:
            detail = ', '.join(
                f"{size_names.get(k, k)} thiếu {v}"
                for k, v in missing.items()
            )
            raise ValueError(
                "Tỉ lệ mới vẫn chưa đủ sản lượng: " + detail + "."
            )

        # Cập nhật thông tin thống kê theo đúng thứ tự bàn,
        # nhưng KHÔNG thay đổi số lá của các bàn khác.
        cumulative = {k: 0 for k in size_keys}
        for i, tb in enumerate(tables, start=1):
            tb['table'] = f'B{i}'
            for k, qty in (tb.get('sizes', {}) or {}).items():
                cumulative[k] = int(cumulative.get(k, 0) or 0) + int(qty or 0)

            tb['left_total'] = sum(
                max(
                    0,
                    int(required.get(k, 0) or 0)
                    - int(cumulative.get(k, 0) or 0)
                )
                for k in size_keys
            )
            tb['over_total'] = sum(
                max(
                    0,
                    int(cumulative.get(k, 0) or 0)
                    - int(required.get(k, 0) or 0)
                )
                for k in size_keys
            )

        # Shade/phân cây chạy lại vì bàn sửa đã đổi chiều dài/số lá.
        preview_tables, lot_summary = self.allocate_lots_to_tables(
            fabric, tables
        )

        new_result = dict(result)
        new_result['cutting_tables'] = tables
        new_result['preview_tables'] = preview_tables
        new_result['lot_summary'] = lot_summary
        new_result['manual_ratio_edit'] = True
        new_result['manual_ratio_lock_other_tables'] = True

        info = dict(new_result.get('adjust_info', {}) or {})
        info['manual_ratio_edit'] = True
        info['manual_ratio_lock_other_tables'] = True
        info['optimizer_strategy'] = 'manual_ratio_locked'
        new_result['adjust_info'] = info

        return new_result


    def _apply_dashboard_ratio_edit(self, idx, table_index, value):
        """V161: áp dụng ô tỉ lệ vừa sửa rồi refresh chiều dài/số lá ngay."""
        if getattr(self, '_dashboard_ratio_edit_busy', False):
            return
        self._dashboard_ratio_edit_busy = True
        try:
            result = self._dashboard_cached_result(idx)
            if result is None:
                raise ValueError(
                    'Kết quả hiện tại đã cũ. Hãy TÍNH LẠI loại vải này trước khi sửa tỉ lệ.'
                )

            new_ratio_map = self._parse_ratio_text_dashboard(value)

            old_tables = result.get('cutting_tables', []) or []
            if 0 <= table_index < len(old_tables):
                old_ratio_map = {
                    k: int(v or 0)
                    for k, v in (old_tables[table_index].get('ratio_map', {}) or {}).items()
                    if int(v or 0) > 0
                }
                if old_ratio_map == new_ratio_map:
                    return

            new_result = self._rebuild_tables_after_ratio_edit_dashboard(
                idx, result, table_index, new_ratio_map
            )

            # Cache ngay phương án sửa tay để Xuất Excel dùng đúng bàn vừa sửa.
            self._cache_dashboard_result(idx, new_result)
            self._promote_individual_cache_to_global()

            try:
                self.fabric_dash_cache_var.set('✎ ĐÃ SỬA TỈ LỆ')
                self.fabric_dash_note_var.set(
                    'Tỉ lệ đã sửa thủ công • Các bàn khác giữ nguyên • Chiều dài và số lá bàn này tự tính lại • '
                    'Xuất Excel sẽ dùng phương án này.'
                )
            except Exception:
                pass

            self._render_fabric_result_grid(new_result)
            self.status_var.set(
                f"B{table_index+1}: đã sửa tỉ lệ; chiều dài và số lá tự cập nhật."
            )

        except Exception as e:
            messagebox.showerror('Sửa tỉ lệ sơ đồ', str(e))
            try:
                current = self._dashboard_cached_result(idx)
                if current is not None:
                    self._render_fabric_result_grid(current)
            except Exception:
                pass
        finally:
            self._dashboard_ratio_edit_busy = False

    def _add_dashboard_table(self):
        """V157: thêm bàn mới, người dùng chỉ nhập TỈ LỆ."""
        idx = self._selected_dashboard_fabric_index()
        if idx is None or not (0 <= idx < len(self.fabric_list)):
            messagebox.showwarning('Thêm bàn', 'Hãy chọn loại vải cần thêm bàn.')
            return

        result = self._dashboard_cached_result(idx)
        if result is None:
            messagebox.showwarning(
                'Thêm bàn',
                'Hãy TÍNH LẠI loại vải này trước, sau đó mới thêm bàn.'
            )
            return

        tables = list(result.get('cutting_tables', []) or [])
        new_no = len(tables) + 1

        suggestion = ''
        if tables:
            suggestion = (
                tables[-1].get('ratio', '')
                or self._format_ratio_map_dashboard(tables[-1].get('ratio_map', {}))
            )
        if not suggestion and self.sizes:
            suggestion = f"{self.sizes[0].get('name', 'SIZE')}/1"

        top = tk.Toplevel(self.root)
        top.title(f'THÊM BÀN B{new_no}')
        top.configure(bg=self.UI_BG)
        top.transient(self.root)
        try:
            top.resizable(False, False)
            top.attributes('-topmost', True)
        except Exception:
            pass

        box = tk.Frame(
            top, bg='white',
            highlightthickness=1, highlightbackground=self.UI_BORDER
        )
        box.pack(fill='both', expand=True, padx=10, pady=10)

        tk.Label(
            box, text=f'＋  THÊM BÀN B{new_no}',
            font=('Segoe UI', 12, 'bold'),
            fg=self.UI_NAVY, bg='white'
        ).pack(anchor='w', padx=12, pady=(12, 3))

        tk.Label(
            box,
            text='Chỉ nhập TỈ LỆ SƠ ĐỒ. Chiều dài và số lá sẽ tự tính.',
            font=('Segoe UI', 8),
            fg=self.UI_MUTED, bg='white'
        ).pack(anchor='w', padx=12, pady=(0, 10))

        tk.Label(
            box, text='Tỉ lệ bàn mới',
            font=('Segoe UI', 8, 'bold'),
            fg=self.UI_TEXT, bg='white'
        ).pack(anchor='w', padx=12)

        ratio_var = tk.StringVar(value=suggestion)
        entry = tk.Entry(
            box, textvariable=ratio_var,
            font=('Segoe UI', 11, 'bold'),
            bg='#e2f0d9', fg='#17365d',
            relief='solid', bd=1,
            justify='center'
        )
        entry.pack(fill='x', padx=12, pady=(4, 5), ipady=6)

        tk.Label(
            box,
            text='Ví dụ: S/1 + M/2 + L/1',
            font=('Segoe UI', 8),
            fg=self.UI_MUTED, bg='white'
        ).pack(anchor='w', padx=12, pady=(0, 10))

        btns = tk.Frame(box, bg='white')
        btns.pack(fill='x', padx=12, pady=(0, 12))

        def close():
            try:
                top.grab_release()
            except Exception:
                pass
            try:
                top.destroy()
            except Exception:
                pass

        def apply_new_table():
            try:
                ratio_map = self._parse_ratio_text_dashboard(ratio_var.get())

                temp_result = dict(result)
                temp_tables = []
                for tb in tables:
                    nt = dict(tb)
                    nt['ratio_map'] = dict(tb.get('ratio_map', {}) or {})
                    nt['sizes'] = dict(tb.get('sizes', {}) or {})
                    temp_tables.append(nt)

                temp_tables.append({
                    'table': f'B{new_no}',
                    'ratio_map': dict(ratio_map),
                    'ratio': self._format_ratio_map_dashboard(ratio_map),
                    'length': 0.0,
                    'raw_length': 0.0,
                    'plies': 0,
                    'sizes': {},
                    'total_output': 0,
                    'size_count': len(ratio_map),
                })
                temp_result['cutting_tables'] = temp_tables

                new_result = self._rebuild_tables_after_ratio_edit_dashboard(
                    idx, temp_result, len(temp_tables) - 1, ratio_map
                )

                self._cache_dashboard_result(idx, new_result)
                self._promote_individual_cache_to_global()

                new_tables = new_result.get('cutting_tables', []) or []
                new_tb = new_tables[-1] if new_tables else {}
                new_plies = int(new_tb.get('plies', 0) or 0)
                new_len = float(new_tb.get('length', 0) or 0)

                try:
                    self.fabric_dash_cache_var.set('✎ ĐÃ THÊM BÀN')
                    self.fabric_dash_note_var.set(
                        'Đã thêm bàn thủ công • Chỉ sửa tỉ lệ • '
                        'Chiều dài và số lá tự tính • Xuất Excel dùng đúng phương án này.'
                    )
                except Exception:
                    pass

                self._render_fabric_result_grid(new_result)
                self.status_var.set(
                    f"Đã thêm B{len(new_tables)} • "
                    f"Dài {new_len:.2f}m • {new_plies} lá."
                )

                close()

                if new_plies <= 0:
                    messagebox.showinfo(
                        'Thêm bàn',
                        f'Đã thêm B{len(new_tables)}, nhưng số lá hiện tại = 0.\n\n'
                        'Các bàn phía trước đã đủ sản lượng cho tỉ lệ này.\n'
                        'Bạn có thể sửa tỉ lệ bàn trước hoặc bàn mới để phần mềm tự chia lại số lá.'
                    )

            except Exception as e:
                messagebox.showerror('Thêm bàn', str(e), parent=top)

        tk.Button(
            btns, text='HỦY', command=close,
            font=('Segoe UI', 9, 'bold'),
            bg='#64748b', fg='white',
            activebackground='#475569', activeforeground='white',
            relief='flat', bd=0, padx=18, pady=7,
            cursor='hand2'
        ).pack(side='right', padx=(6, 0))

        tk.Button(
            btns, text='✓  THÊM BÀN', command=apply_new_table,
            font=('Segoe UI', 9, 'bold'),
            bg='#16a34a', fg='white',
            activebackground='#15803d', activeforeground='white',
            relief='flat', bd=0, padx=18, pady=7,
            cursor='hand2'
        ).pack(side='right')

        entry.bind('<Return>', lambda e: apply_new_table())
        top.bind('<Escape>', lambda e: close())

        try:
            top.update_idletasks()
            w, h = 470, 245
            x = self.root.winfo_rootx() + max(20, (self.root.winfo_width() - w)//2)
            y = self.root.winfo_rooty() + max(20, (self.root.winfo_height() - h)//2)
            top.geometry(f'{w}x{h}+{x}+{y}')
            top.grab_set()
            top.lift()
            entry.focus_set()
            entry.selection_range(0, 'end')
        except Exception:
            pass

    def _render_fabric_result_grid(self, result):
        grid = getattr(self, 'fabric_result_grid', None)
        if grid is None:
            return
        for w in grid.winfo_children():
            w.destroy()

        size_keys = [s['key'] for s in self.sizes]
        size_names = [s['name'] for s in self.sizes]
        cols = ['table','ratio','length','plies'] + size_keys + ['total']
        headers = ['Số bàn','TỈ LỆ SƠ ĐỒ / MARKER RATE\n(SỬA + ENTER)','Chiều dài\n(TỰ NHẢY)','Số lá\n(TỰ NHẢY)'] + size_names + ['Tổng']
        widths = [7, 38, 11, 8] + [7]*len(size_keys) + [9]
        weights = [0, 5, 0, 0] + [1]*len(size_keys) + [0]
        for c, wt in enumerate(weights):
            grid.grid_columnconfigure(c, weight=wt, uniform=None if c==1 else 'qty')

        def cell(row, col, text='', bg='white', fg='#1f2937', bold=False, anchor='center', width=None):
            lbl = tk.Label(grid, text=text, bg=bg, fg=fg,
                           font=('Segoe UI', 8, 'bold' if bold else 'normal'),
                           relief='solid', bd=1, padx=4, pady=4, anchor=anchor,
                           justify='center')
            if width: lbl.configure(width=width)
            lbl.grid(row=row, column=col, sticky='nsew')
            return lbl

        for c, h in enumerate(headers):
            cell(0, c, h, bg='#d9e2f3', fg='#102a43', bold=True, width=widths[c])

        if result is None:
            cell(1, 0, 'CHƯA TÍNH', bg='#f8fafc', fg='#64748b', bold=True)
            cell(1, 1, 'Bấm TÍNH TOÀN BỘ hoặc TÍNH LẠI LOẠI VẢI NÀY', bg='#f8fafc', fg='#64748b')
            for c in range(2, len(cols)):
                cell(1, c, '', bg='#f8fafc')
            return

        required = result.get('total_by_size', {}) or {}
        # Hàng kế hoạch màu cam nhạt như Excel xuất.
        cell(1, 0, 'KH', bg='#fce4d6', bold=True)
        cell(1, 1, 'SẢN LƯỢNG KẾ HOẠCH', bg='#fce4d6', bold=True)
        cell(1, 2, '', bg='#fce4d6'); cell(1, 3, '', bg='#fce4d6')
        for i,k in enumerate(size_keys): cell(1, 4+i, int(required.get(k,0) or 0), bg='#fce4d6', bold=True)
        cell(1, 4+len(size_keys), sum(int(required.get(k,0) or 0) for k in size_keys), bg='#fce4d6', bold=True)

        tables = result.get('cutting_tables', []) or []
        actual = {k:0 for k in size_keys}
        r = 2
        selected_idx = self._selected_dashboard_fabric_index()
        editable_ratio = bool(
            selected_idx is not None
            and getattr(self, '_fabric_dashboard_result_editable', True)
        )

        for table_index, tb in enumerate(tables):
            sizes = tb.get('sizes', {}) or {}
            for k in size_keys:
                actual[k] += int(sizes.get(k,0) or 0)

            # Cột Số bàn.
            cell(r, 0, tb.get('table',''), bg='white', bold=True, width=widths[0])

            # V157: CHỈ TỈ LỆ được phép sửa.
            ratio_text = tb.get('ratio','') or self._format_ratio_map_dashboard(tb.get('ratio_map', {}))
            if editable_ratio:
                e = tk.Entry(
                    grid,
                    font=('Segoe UI', 9, 'bold'),
                    bg='#e2f0d9', fg='#17365d',
                    relief='solid', bd=1,
                    justify='center',
                    insertbackground='#17365d'
                )
                e.insert(0, ratio_text)
                e.grid(row=r, column=1, sticky='nsew', padx=0, pady=0, ipady=4)

                # Lưu text gốc để FocusOut chỉ tính khi người dùng thực sự thay đổi.
                e._ratio_original = ratio_text

                def _commit(ev=None, entry=e, fi=selected_idx, ti=table_index):
                    try:
                        new_text = entry.get().strip()
                        old_text = getattr(entry, '_ratio_original', '')
                        if new_text != old_text:
                            self._apply_dashboard_ratio_edit(fi, ti, new_text)
                    except Exception:
                        pass
                    return 'break' if ev is not None and getattr(ev, 'keysym', '') == 'Return' else None

                e.bind('<Return>', _commit)
                e.bind('<FocusOut>', _commit)
            else:
                cell(r, 1, ratio_text, bg='#e2f0d9', bold=True, width=widths[1])

            # Chiều dài + Số lá chỉ hiển thị, tự nhảy sau khi sửa tỉ lệ.
            cell(
                r, 2,
                f"{float(tb.get('length',0) or 0):.2f}".rstrip('0').rstrip('.'),
                bg='#eaf3ff', bold=False, width=widths[2]
            )
            cell(
                r, 3,
                int(tb.get('plies',0) or 0),
                bg='#fff2cc', bold=True, width=widths[3]
            )

            c0 = 4
            for j, k in enumerate(size_keys):
                qty = int(sizes.get(k,0) or 0)
                cell(r, c0+j, qty if qty else '', bg='white', width=widths[c0+j])

            cell(
                r, c0+len(size_keys),
                sum(int(sizes.get(k,0) or 0) for k in size_keys),
                bg='white',
                width=widths[c0+len(size_keys)]
            )
            r += 1

        # Hai dòng tổng kết xanh giống mockup / Excel.
        actual_vals = ['', 'SẢN LƯỢNG THỰC CẮT / ACTUAL CUT QTY', '', ''] + [actual[k] for k in size_keys] + [sum(actual.values())]
        diff = {k: actual[k] - int(required.get(k,0) or 0) for k in size_keys}
        diff_vals = ['', 'SẢN LƯỢNG ÂM/DƯƠNG (+/-)', '', ''] + [diff[k] for k in size_keys] + [sum(diff.values())]
        for vals, bg in ((actual_vals,'#c6e0b4'), (diff_vals,'#e2f0d9')):
            for c,val in enumerate(vals):
                cell(r,c,val,bg=bg,bold=True,width=widths[c])
            r += 1

