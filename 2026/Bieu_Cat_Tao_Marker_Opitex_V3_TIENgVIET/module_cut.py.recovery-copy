    def _export_progress_begin(self):
        """V150: bắt đầu xuất, khóa nút và giữ cửa sổ phản hồi."""
        self._export_progress_active = True
        self._export_progress_value = 0
        self._export_progress_started = time.monotonic()
        self._export_busy = True
        btn = getattr(self, 'fixed_export_button', None)
        if btn is not None:
            try:
                btn.config(
                    state='disabled',
                    text='⏳ ĐANG XUẤT... 0%',
                    bg='#9aa4ad', fg='white',
                    activebackground='#9aa4ad',
                    activeforeground='white',
                    disabledforeground='white',
                    relief='sunken'
                )
            except Exception:
                pass
        try:
            self.root.configure(cursor='watch')
            self.root.update()
        except Exception:
            pass

    def _export_progress(self, percent, stage=''):
        """V150: cập nhật tiến độ thật và xử lý event Windows."""
        if not getattr(self, '_export_progress_active', False):
            return
        try:
            pct = max(
                int(getattr(self, '_export_progress_value', 0) or 0),
                min(100, int(percent))
            )
        except Exception:
            pct = 0
        self._export_progress_value = pct

        btn = getattr(self, 'fixed_export_button', None)
        if btn is not None:
            try:
                btn.config(text=f'⏳ ĐANG XUẤT... {pct}%')
            except Exception:
                pass

        if stage and hasattr(self, 'status_var'):
            try:
                self.status_var.set(f'{stage} ({pct}%)')
            except Exception:
                pass

        try:
            self.root.update()
        except Exception:
            pass

    def _export_progress_end(self, success=True):
        """V150: kết thúc xuất và khôi phục trạng thái cửa sổ."""
        btn = getattr(self, 'fixed_export_button', None)
        if btn is not None:
            try:
                if success:
                    btn.config(
                        text='✅ HOÀN TẤT 100%',
                        bg='#7f8c8d', fg='white'
                    )
                self.root.update()
                btn.config(
                    state='normal',
                    text='📤  XUẤT EXCEL',
