        set_cell(f'{total_col}{base_total_row}',
                 f'=IF(COUNT({first_size_col}{base_total_row}:{last_size_col}{base_total_row})=0,"",SUM({first_size_col}{base_total_row}:{last_size_col}{base_total_row}))',
                 font=font_normal, alignment=align_center,
                 border=make_border(left=thin, right=medium, top=medium, bottom=thin),
                 fill=fill_total_order)

        # SẢN LƯỢNG KẾ HOẠCH: merge C:G và tăng chiều cao.
        total_row = base_total_row + 1
        ws.row_dimensions[total_row].height = 30.0
        for col in ['C', 'D', 'E', 'F']:
            set_cell(f'{col}{total_row}', border=make_border(
                left=medium if col == 'C' else None,
                right=medium if col == 'G' else None,
                top=thin, bottom=medium), fill=fill_plan_row)
        ws.merge_cells(f'C{total_row}:F{total_row}')
        set_cell(f'C{total_row}', 'SẢN LƯỢNG KẾ HOẠCH/PLANNED QTY', font=font_bilingual, alignment=align_bilingual,
                 border=make_border(left=medium, right=medium, top=thin, bottom=medium),
                 fill=fill_plan_row)
        for idx, (key, col) in enumerate(zip(size_keys, size_cols)):
            excess_refs = ','.join(f'{col}{rr}' for rr in excess_po_rows_all)
            extra_formula = f'SUM({excess_refs})' if excess_refs else '0'
            formula = f'=IF(N({col}{base_total_row})+{extra_formula}=0,"",N({col}{base_total_row})+{extra_formula})'
            set_cell(f'{col}{total_row}', formula, font=font_bold, alignment=align_center,
                     border=make_border(left=thin if idx > 0 else None,
                                        right=medium if idx == len(size_cols)-1 else thin,
                                        top=thin, bottom=medium), fill=fill_plan_row)
        set_cell(f'{total_col}{total_row}',
                 f'=IF(COUNT({first_size_col}{total_row}:{last_size_col}{total_row})=0,"",SUM({first_size_col}{total_row}:{last_size_col}{total_row}))',
                 font=font_bold, alignment=align_center,
                 border=make_border(left=thin, right=medium, top=thin, bottom=medium),
                 fill=fill_plan_row)

        # % tăng tổng có trọng số chỉ xuất khi đang bật % DƯƠNG.
        if export_increase_row:
            ws[f'{total_col}{percent_row}'] = (
                f'=IF({total_col}{base_total_row}>0,'
                f'IF({total_col}{total_row}/{total_col}{base_total_row}-1>0,'
                f'{total_col}{total_row}/{total_col}{base_total_row}-1,""),"")'
            )
            ws[f'{total_col}{percent_row}'].number_format = '0.00%'
            ws[f'{total_col}{percent_row}'].font = font_bold
            ws[f'{total_col}{percent_row}'].alignment = align_center
            ws[f'{total_col}{percent_row}'].fill = fill_percent_row
            ws[f'{total_col}{percent_row}'].border = make_border(
                left=medium, right=medium, top=medium, bottom=medium
            )

        current_row = total_row + 3
        lot_helper_next_row = 1

        # ===== TỰ CÂN TRANG A4 NGANG =====
        # Excel đang dùng Fit to 1 page wide nên toàn bộ chiều cao cũng bị thu theo
        # cùng tỷ lệ bề ngang. V21 dùng ngưỡng cố định 500 pt nên ngắt trang quá sớm,
        # làm trang in còn rất nhiều khoảng trắng. V23 tính ngưỡng chiều cao theo
        # chính độ rộng các cột hiện tại để tận dụng gần hết khổ A4 nhưng vẫn không
        # chẻ đôi một khối loại vải.
        from openpyxl.worksheet.pagebreak import Break

        A4_LANDSCAPE_WIDTH_PT = 841.89
        A4_LANDSCAPE_HEIGHT_PT = 595.28
        PRINT_MARGIN_LEFT_IN = 0.10
        PRINT_MARGIN_RIGHT_IN = 0.10
        PRINT_MARGIN_TOP_IN = 0.10
        PRINT_MARGIN_BOTTOM_IN = 0.10

        def excel_width_to_points(width):
            # Xấp xỉ cách Excel chuyển ColumnWidth -> pixel -> point.
            # Đủ chính xác để tính page break; Excel vẫn là nơi quyết định scale in cuối cùng.
            try:
                width = float(width)
            except (TypeError, ValueError):
                width = 8.43
            if width < 1:
                pixels = int(width * 12)
            else:
                pixels = int(((256 * width + int(128 / 7)) / 256) * 7)
            return pixels * 0.75

        # Tổng độ rộng từ A đến cột KHỔ VẢI. Cột điều chỉnh số lá được ẩn và nằm ngoài vùng in.
        last_print_col_idx = 12 + len(self.sizes)
        total_width_points = 0.0
        for cc in range(1, last_print_col_idx + 1):
            col = col_letter(cc)
            width = ws.column_dimensions[col].width
            total_width_points += excel_width_to_points(width)

        printable_width_points = (
            A4_LANDSCAPE_WIDTH_PT
            - (PRINT_MARGIN_LEFT_IN + PRINT_MARGIN_RIGHT_IN) * 72.0
        )
        printable_height_points = (
            A4_LANDSCAPE_HEIGHT_PT
            - (PRINT_MARGIN_TOP_IN + PRINT_MARGIN_BOTTOM_IN) * 72.0
        )

        # Tỷ lệ mà Excel phải thu bề ngang để vừa đúng 1 trang. Khi sheet rộng,
        # scale < 1 và theo đó một trang chứa được nhiều row point hơn.
        estimated_print_scale = min(1.0, printable_width_points / max(total_width_points, 1.0))

        # V25 dùng gần tối đa chiều cao A4; chừa 1.5% cho sai số driver máy in.
        PAGE_BODY_POINTS = (printable_height_points / max(estimated_print_scale, 0.10)) * 0.985
        page_start_row = 1

        def row_height_points(row_num):
            return float(ws.row_dimensions[row_num].height or 15.0)

        def used_points_on_page(start_row, end_row):
            if end_row < start_row:
                return 0.0
            return sum(row_height_points(r) for r in range(start_row, end_row + 1))

        def build_fabric_target_by_col(fabric):
            """Công thức sản lượng kế hoạch theo từng cỡ cho đúng PO của loại vải."""
            mode = str(fabric.get('po_mode', 'all') or 'all').lower()
            if mode == 'all':
                return {plan_col: f'{source_col}${total_row}' for plan_col, source_col in zip(plan_size_cols, size_cols)}

            selected = [str(x).strip() for x in (fabric.get('po_targets', []) or []) if str(x).strip()]
            result_map = {}
            for plan_col, source_col in zip(plan_size_cols, size_cols):
                refs = []
                for po_name in selected:
                    raw_rows = po_excel_rows.get(po_name, [])
                    excess_rows = po_excess_excel_rows.get(po_name, [])
                    for pos, rr in enumerate(raw_rows):
                        er = excess_rows[pos] if pos < len(excess_rows) else None
                        refs.append(f'(N({source_col}${rr})+N({source_col}${er}))' if er else f'N({source_col}${rr})')
                result_map[plan_col] = ('+'.join(refs)) if refs else '0'
            return result_map

        def build_fabric_order_by_col(fabric):
            """Công thức số lượng gốc theo từng cỡ cho đúng PO của loại vải.

            - Nếu loại vải áp dụng TẤT CẢ PO: lấy dòng TỔNG ĐƠN HÀNG.
            - Nếu loại vải áp dụng theo PO: cộng đúng các dòng PO đã chọn.
            """
            mode = str(fabric.get('po_mode', 'all') or 'all').lower()
            if mode == 'all':
                return {plan_col: f'{source_col}${base_total_row}' for plan_col, source_col in zip(plan_size_cols, size_cols)}

            selected = [str(x).strip() for x in (fabric.get('po_targets', []) or []) if str(x).strip()]
            result_map = {}
            for plan_col, source_col in zip(plan_size_cols, size_cols):
                refs = []
                for po_name in selected:
                    for rr in po_excel_rows.get(po_name, []):
                        refs.append(f'N({source_col}${rr})')
                result_map[plan_col] = ('+'.join(refs)) if refs else '0'
            return result_map


        def estimate_fabric_block_points(tables):
            # 1 dòng cách + 3 dòng header (tiêu đề / tên cỡ / SL theo cỡ) + các bàn + 2 dòng tổng kết + 1 dòng cách.
            # V82: 3 dòng bàn dự phòng đang ẩn mặc định nên không tính chiều cao khi phân trang in.
            pts = 15.75 + 42.0 + 26.25 + 20.0 + 18.0 + 18.0 + 15.0
            for table in tables:
                ratio_text = str(table.get('ratio', ''))
                approx_lines = max(1, math.ceil(len(ratio_text) / 42))
                pts += max(26.25, 17.0 * approx_lines)
            return pts

        fabric_excel_info = {}

        _excel_result_count = max(1, len(results))
        for fabric_idx, result in enumerate(results):
            fabric = result['fabric']
            self._export_progress(66 + int(26 * fabric_idx / _excel_result_count),
                                  f"Đang ghi Excel: {fabric.get('name', 'loại vải')}")
            tables = result['cutting_tables']
            # V40: mục tiêu sản lượng của khối này là theo PO áp dụng của chính loại vải.
            fabric_target_by_col = build_fabric_target_by_col(fabric)

            # V34: nếu thông tin đơn hàng chiếm vị trí của khối này thì chỉ khối này
            # và các khối phía sau dịch xuống; các phần phía trên giữ nguyên.
            if fabric_idx < len(fabric_spacer_rows):
                current_row = max(current_row, fabric_spacer_rows[fabric_idx])

            # Chỉ ngắt trang khi khối mới không còn vừa phần còn lại của A4.
            block_points = estimate_fabric_block_points(tables)
            used_points = used_points_on_page(page_start_row, current_row - 1)
            if used_points > 0 and used_points + block_points > PAGE_BODY_POINTS:
                break_after = max(1, current_row - 1)
                ws.row_breaks.append(Break(id=break_after))
                page_start_row = current_row

            ws.row_dimensions[current_row].height = 15.75
            current_row += 1
            ws.row_dimensions[current_row].height = 42.0

            header_row = current_row
            size_name_row = header_row + 1
            size_qty_row = header_row + 2
            ws.row_dimensions[size_name_row].height = 26.25
            ws.row_dimensions[size_qty_row].height = 20.0

            # Số lượng gốc dưới từng cỡ:
            # - TẤT CẢ PO -> lấy TỔNG ĐƠN HÀNG
            # - Theo PO -> lấy tổng đúng PO áp dụng của loại vải.
            fabric_order_by_col = build_fabric_order_by_col(fabric)

            # ===== HEADER THEO MAU HINH 2 =====
            # A:G gop doc 3 dong; cac cot TONG / DINH MUC / SO M CAN DUNG cung gop doc.
            header_map = {
                'A': 'LOẠI VẢI\nFABRIC TYPE', 'B': 'SỐ BÀN\nTABLE NO.', 'C': 'TỈ LỆ SƠ ĐỒ/MARKER RATE',
                'D': 'CHIỀU DÀI SƠ ĐỒ\nMARKER LENGTH', 'E': 'Ánh màu\nShade', 'F': 'Lot nhà sản xuất', 'G': 'SỐ LÁ\nPLIES'
            }
            for col, value in header_map.items():
                fill = fill_theme4_tint60 if col == 'C' else None
                set_cell(f'{col}{header_row}', value,
                         font=font_bold if col == 'E' else font_bilingual,
                         alignment=align_center if col in ('E', 'F') else align_bilingual,
                         border=make_border(left=medium, right=medium, top=medium, bottom=medium),
                         fill=fill)
                set_cell(f'{col}{size_name_row}', border=make_border(left=medium, right=medium), fill=fill)
                set_cell(f'{col}{size_qty_row}', border=make_border(left=medium, right=medium, bottom=medium), fill=fill)
                ws.merge_cells(f'{col}{header_row}:{col}{size_qty_row}')

            # Vùng SẢN LƯỢNG TỪNG CỠ: dòng 1 tiêu đề, dòng 2 tên cỡ, dòng 3 số lượng theo cỡ.
            marker_title_range = f'{plan_first_size_col}{header_row}:{plan_last_size_col}{header_row}'
            for idx, col in enumerate(plan_size_cols):
                set_cell(f'{col}{header_row}',
                         border=make_border(left=medium if idx == 0 else thin,
                                            right=medium if idx == len(plan_size_cols)-1 else thin,
                                            top=medium, bottom=thin),
                         fill=fill_theme8_tint0)
            ws.merge_cells(marker_title_range)
            set_cell(f'{plan_first_size_col}{header_row}', 'SẢN LƯỢNG TỪNG CỠ/QTY BY SIZE', font=font_bilingual,
                     alignment=align_bilingual,
                     border=make_border(left=medium, right=medium, top=medium, bottom=thin),
                     fill=fill_theme8_tint0)

            for idx, (col, name) in enumerate(zip(plan_size_cols, size_names)):
                left = medium if idx == 0 else thin
                right = medium if idx == len(plan_size_cols)-1 else thin
                set_cell(f'{col}{size_name_row}', name, font=font_normal, alignment=align_center,
                         border=make_border(left=left, right=right, top=thin, bottom=thin),
                         fill=fill_theme8_tint0)
                qty_expr = fabric_order_by_col.get(col, '0')
                qty_formula = f'=IFERROR({qty_expr},0)' if qty_expr != '0' else '=0'
                set_cell(f'{col}{size_qty_row}', qty_formula, font=font_normal, alignment=align_center,
                         border=make_border(left=left, right=right, top=thin, bottom=medium),
                         fill=fill_total_order)

            # TONG / DINH MUC / SO M CAN DUNG merge doc 3 dong nhu hinh 2.
            side_headers = [
                (plan_total_col, 'TỔNG\nTOTAL', fill_theme8_tint0),
                (plan_norm_col, 'ĐỊNH MỨC\nCONSUMPTION', None),
                (plan_need_col, 'SỐ M CẦN DÙNG\nFABRIC REQUIRED', None),
                (plan_note_col, 'GHI CHÚ/REMARKS', None),
            ]
            for col, value, fill in side_headers:
                set_cell(f'{col}{header_row}', value, font=font_bilingual_small, alignment=align_bilingual,
                         border=make_border(left=medium, right=medium, top=medium, bottom=medium), fill=fill)
                set_cell(f'{col}{size_name_row}', border=make_border(left=medium, right=medium), fill=fill)
                set_cell(f'{col}{size_qty_row}', border=make_border(left=medium, right=medium, bottom=medium), fill=fill)
                ws.merge_cells(f'{col}{header_row}:{col}{size_qty_row}')

            set_cell(f'{plan_width_col}{header_row}', 'KHỔ VẢI\nFABRIC WIDTH', font=font_bilingual_small, alignment=align_bilingual,
                     border=make_border(left=medium, right=medium, top=medium, bottom=medium))
            set_cell(f'{plan_width_col}{size_name_row}', border=make_border(left=medium, right=medium))
            set_cell(f'{plan_width_col}{size_qty_row}', border=make_border(left=medium, right=medium, bottom=medium))
            ws.merge_cells(f'{plan_width_col}{header_row}:{plan_width_col}{size_qty_row}')

            # Cột điều chỉnh số lá vẫn được giữ ẩn ngoài vùng in.
            set_cell(f'{plan_adjust_col}{header_row}', 'ĐIỀU CHỈNH SỐ LÁ\nADJUST PLIES',
                     font=font_bilingual_small, alignment=align_bilingual,
                     border=make_border(left=medium, right=medium, top=medium, bottom=medium),
                     fill=fill_plan_row)
            set_cell(f'{plan_adjust_col}{size_name_row}', border=make_border(left=medium, right=medium), fill=fill_plan_row)
            set_cell(f'{plan_adjust_col}{size_qty_row}', border=make_border(left=medium, right=medium, bottom=medium), fill=fill_plan_row)
            ws.merge_cells(f'{plan_adjust_col}{header_row}:{plan_adjust_col}{size_qty_row}')

            # V60: không còn cột ĐIỀU CHỈNH TỔNG Shade trên BIỂU CẮT.
            # Shade/tổng mét được đọc duy nhất từ Excel Table ở SỬA PHÂN CÂY.
            fabric_lot_slots = []
            current_row = size_qty_row + 1
            first_table_row = current_row

            table_excel_rows = []
            reserve_count = reserve_rows_for(len(tables))
            total_table_rows = len(tables) + reserve_count
            reserve_start_row = first_table_row + len(tables)
            reserve_end_row = reserve_start_row + reserve_count - 1
            if reserve_count > 0:
                reserve_row_groups.append(list(range(reserve_start_row, reserve_end_row + 1)))
            last_table_row = first_table_row + total_table_rows - 1

            # LOT nhà sản xuất ban đầu cho từng bàn gốc, gom theo các phần bàn
            # thực tế mà bộ phân Shade đã chia theo LOT.
            manufacturer_marks_by_table = {}
            fabric_widths_by_table = {}
            # Preview rows normally point back to the source marker. Older/additional
            # generated rows may only carry their displayed B1/B2/... label; map those
            # to the matching BIỂU CẮT row so the added table also shows its fabric width.
            preview_widths_by_label = {}
            preview_marks_by_label = {}
            for preview_table in result.get('preview_tables', []) or []:
                source_idx = preview_table.get('source_table_index')
                try:
                    source_idx = int(source_idx) if source_idx is not None else None
                except (TypeError, ValueError):
                    source_idx = None
                table_label = str(preview_table.get('table', '') or '').strip().upper()
                label_match = re.search(r'B\s*(\d+)', table_label)
                label_idx = int(label_match.group(1)) - 1 if label_match else None
                mark = str(preview_table.get('lot_mark', '') or '').strip()
                width = str(preview_table.get('fabric_width_cm','') or '').strip()
                plies = int(preview_table.get('plies',0) or 0)
                if source_idx is not None:
                    if mark:
                        marks = manufacturer_marks_by_table.setdefault(source_idx, [])
                        if mark not in marks:
                            marks.append(mark)
                    if width:
                        width_map = fabric_widths_by_table.setdefault(source_idx, {})
                        width_map[width] = width_map.get(width, 0) + plies
                # Keep a label-based fallback for added rows with no source index, and
                # for source indices that do not correspond to the exported marker row.
                if label_idx is not None:
                    if mark:
                        marks = preview_marks_by_label.setdefault(label_idx, [])
                        if mark not in marks:
                            marks.append(mark)
                    if width:
                        width_map = preview_widths_by_label.setdefault(label_idx, {})
                        width_map[width] = width_map.get(width, 0) + plies

            for _idx, _parts in preview_widths_by_label.items():
                if _idx not in fabric_widths_by_table:
                    fabric_widths_by_table[_idx] = _parts
            for _idx, _marks in preview_marks_by_label.items():
                if _idx not in manufacturer_marks_by_table:
                    manufacturer_marks_by_table[_idx] = _marks

            for table_idx in range(total_table_rows):
                is_reserve = table_idx >= len(tables)
                if is_reserve:
                    reserve_no = table_idx - len(tables) + 1
                    table = {
                        'table': f'B{table_idx + 1}',
                        'ratio': '',
                        'length': '',
                        'ratio_map': {},
                    }
                else:
                    table = tables[table_idx]
                    reserve_no = 0

                # Marker dài được wrap và tự tăng chiều cao dòng để không bị che chữ.
                ratio_text = str(table.get('ratio', '') or '')
                approx_lines = max(1, math.ceil(len(ratio_text) / 42))
                ws.row_dimensions[current_row].height = max(26.25, 17.0 * approx_lines)
                top_border = thin if table_idx > 0 else medium

                set_cell(f'A{current_row}', border=make_border(left=medium, right=medium, top=top_border))
                set_cell(f'B{current_row}', table.get('table', f'B{table_idx + 1}'),
                         font=font_normal, alignment=align_center,
                         border=make_border(right=thin, top=top_border, bottom=thin))
                set_cell(f'C{current_row}', table.get('ratio', '') or None,
                         font=font_normal, alignment=align_center_wrap,
                         border=make_border(left=thin, right=thin, top=top_border, bottom=thin),
                         fill=fill_theme9_tint80)

                length_value = table.get('length', '')
                if length_value not in ('', None):
                    try:
                        length_value = round(float(length_value), 2)
                    except (TypeError, ValueError):
                        pass
                else:
                    length_value = None
                set_cell(f'D{current_row}', length_value, font=font_normal, alignment=align_center,
                         border=make_border(left=thin, right=thin, top=top_border, bottom=thin))
                ws[f'D{current_row}'].number_format = '0.##'

                # Shade là công thức động; giá trị sẽ được gán sau khi tạo block helper.
                set_cell(f'E{current_row}', font=font_normal,
                         alignment=Alignment(horizontal='center', vertical='center', wrap_text=True, shrink_to_fit=False),
                         border=make_border(left=thin, right=thin, top=top_border, bottom=thin))

                manufacturer_mark_text = ' | '.join(manufacturer_marks_by_table.get(table_idx, [])) if not is_reserve else ''
                set_cell(f'F{current_row}', manufacturer_mark_text or None, font=font_normal, alignment=Alignment(horizontal='center', vertical='center', wrap_text=True), border=make_border(left=thin, right=thin, top=top_border, bottom=thin))
                cut_manufacturer_mark_cells.setdefault(id(fabric), {})[table_idx] = (ws, f'F{current_row}')
                width_parts = fabric_widths_by_table.get(table_idx, {})
                width_text = ' | '.join(f'{w} cm ({n} lá)' for w,n in width_parts.items())
                set_cell(f'{plan_width_col}{current_row}', width_text or None, font=font_normal, alignment=align_center_wrap,
                         border=make_border(left=medium, right=medium, top=top_border, bottom=thin))
                cut_fabric_width_cells.setdefault(id(fabric), {})[table_idx] = (ws, f'{plan_width_col}{current_row}')

                # SỐ LÁ:
                # - Dòng gốc giữ đúng thuật toán cũ nếu tỷ lệ C chưa bị sửa.
                # - Nếu sửa C hoặc dùng dòng dự phòng, tự đọc tỷ lệ mới trong C và tính lại.
                edited_formula = edited_ratio_plies_formula(
                    current_row, first_table_row, fabric_target_by_col, size_names, plan_size_cols
                )
                edited_expr = edited_formula[1:]

                if not is_reserve:
                    original_formula = dynamic_plies_formula(
                        table_idx, tables, current_row, first_table_row, fabric_target_by_col,
                        size_keys, plan_size_cols, result.get('total_by_size', {})
                    )
                    original_expr = original_formula[1:] if original_formula.startswith('=') else original_formula
                    original_ratio = str(table.get('ratio', '') or '').replace('"', '""')
                    auto_expr = (
                        f'IF($C{current_row}="{original_ratio}",({original_expr}),({edited_expr}))'
                    )
                else:
                    auto_expr = edited_expr

                final_plies_formula = (
                    f'=IF(TRIM($C{current_row})="","",'
                    f'IF({plan_adjust_col}{current_row}<>"",{plan_adjust_col}{current_row},{auto_expr}))'
                )
                set_cell(f'G{current_row}', final_plies_formula, font=font_normal, alignment=align_center,
                         border=make_border(left=thin, right=thin, top=top_border, bottom=thin),
                         fill=fill_plan_row)

                # Ô chỉnh số lá để trống, CÓ viền nhưng vẫn nằm ngoài Print Area.
                ws[f'{plan_adjust_col}{current_row}'].border = make_border(
                    left=medium, right=medium, top=top_border, bottom=thin)
                ws[f'{plan_adjust_col}{current_row}'].alignment = align_center
                ws[f'{plan_adjust_col}{current_row}'].fill = fill_theme6_tint80
                ws[f'{plan_adjust_col}{current_row}'].number_format = '0'

                # V38: sản lượng từng cỡ đọc TRỰC TIẾP tỷ lệ trong cột C.
                # Vì vậy sửa tỷ lệ sơ đồ ở bất kỳ hàng nào sẽ cập nhật cả hàng đó.
                for idx, (size_name, col) in enumerate(zip(size_names, plan_size_cols)):
                    ratio_expr = ratio_value_formula(current_row, size_name)
                    qty_formula = (
                        f'=IF(OR(TRIM($C{current_row})="",G{current_row}=""),"",'
                        f'IF(({ratio_expr})>0,G{current_row}*({ratio_expr}),""))'
                    )
                    set_cell(f'{col}{current_row}', qty_formula, font=font_normal, alignment=align_center,
                             border=make_border(left=medium if idx == 0 else thin,
                                                right=medium if idx == len(plan_size_cols)-1 else thin,
                                                top=thin, bottom=thin), fill=fill_theme8_tint80)

                set_cell(f'{plan_total_col}{current_row}',
                         f'=IF(TRIM($C{current_row})="","",SUM({plan_first_size_col}{current_row}:{plan_last_size_col}{current_row}))',
                         font=font_normal, alignment=align_center,
                         border=make_border(left=medium, right=thin, bottom=thin))
                # SỐ M CẦN DÙNG = chiều dài sơ đồ x số lá x 1.01 (cộng 1%).
                set_cell(f'{plan_need_col}{current_row}',
                         f'=IF(OR(TRIM($C{current_row})="",D{current_row}="",G{current_row}=""),"",ROUND(D{current_row}*G{current_row}*1.01,2))',
                         font=font_normal, alignment=align_center,
                         border=make_border(left=thin, right=thin, bottom=thin))
                ws[f'{plan_need_col}{current_row}'].number_format = '0.00'

                # ĐỊNH MỨC TỪNG BÀN = SỐ MÉT CẦN DÙNG / TỔNG SỐ LƯỢNG CỦA BÀN.
                set_cell(f'{plan_norm_col}{current_row}',
                         f'=IFERROR(IF(OR({plan_need_col}{current_row}="",{plan_total_col}{current_row}="",{plan_total_col}{current_row}=0),"",ROUND({plan_need_col}{current_row}/{plan_total_col}{current_row},4)),"")',
                         font=font_normal, alignment=align_center,
                         border=make_border(left=thin, right=thin, bottom=thin))
                ws[f'{plan_norm_col}{current_row}'].number_format = '0.00'

                set_cell(f'{plan_note_col}{current_row}', border=make_border(left=thin, right=medium, bottom=thin))

                table_excel_rows.append(current_row)
                current_row += 1

            last_table_row = table_excel_rows[-1] if table_excel_rows else first_table_row

            # Tạo công thức Shade động cho cả bàn gốc + 3 dòng dự phòng.
            lot_helper_next_row, dynamic_note_formula = build_dynamic_lot_formulas(
                fabric, table_excel_rows, lot_helper_next_row
            )

            # Không tạo dòng trống không có bàn; dòng tổng kết nằm ngay sau bàn cuối.

            # Dòng SẢN LƯỢNG THỰC CẮT
            ws.row_dimensions[current_row].height = 18.0
            actual_row = current_row
            set_cell(f'A{actual_row}', border=make_border(left=medium, right=medium))

            # Merge B:G giống bố cục biểu cắt.
            for col in ['B', 'C', 'D', 'E', 'F', 'G']:
                set_cell(f'{col}{actual_row}', border=make_border(
                    left=medium if col == 'B' else None,
                    right=medium if col == 'G' else None,
                    top=medium, bottom=thin), fill=fill_theme9_tint80)
            ws.merge_cells(f'B{actual_row}:G{actual_row}')
            set_cell(f'B{actual_row}', 'SẢN LƯỢNG THỰC CẮT/ACTUAL CUT QTY', font=Font(name='Calibri', size=9), alignment=Alignment(horizontal='center', vertical='center', wrap_text=False, shrink_to_fit=True),
                     border=make_border(left=medium, right=medium, top=medium, bottom=thin), fill=fill_theme9_tint80)

            for idx, (key, col) in enumerate(zip(size_keys, plan_size_cols)):
                left = medium if idx == 0 else thin
                right = medium if idx == len(plan_size_cols)-1 else thin
                # THUC CAT = tong san luong that su cua co do tren cac ban.
                formula = f'=SUM({col}{first_table_row}:{col}{last_table_row})' if table_excel_rows else '=0'
                set_cell(f'{col}{actual_row}', formula, font=font_normal, alignment=align_center,
                         border=make_border(left=left, right=right, top=medium, bottom=thin), fill=fill_theme9_tint60)

            set_cell(f'{plan_total_col}{actual_row}',
                     f'=SUM({plan_first_size_col}{actual_row}:{plan_last_size_col}{actual_row})',
                     font=font_bold, alignment=align_center,
                     border=make_border(left=medium, right=thin, top=medium, bottom=thin),
                     fill=fill_theme9_tint60)
            set_cell(f'{plan_norm_col}{actual_row}', border=make_border(left=thin, right=thin, top=medium, bottom=thin))
            # Tổng SỐ M CẦN DÙNG = tổng bàn gốc + 3 dòng dự phòng (dòng trống tự cho 0/blank).
            last_table_row = table_excel_rows[-1] if table_excel_rows else first_table_row
            set_cell(f'{plan_need_col}{actual_row}', f'=ROUND(SUM({plan_need_col}{first_table_row}:{plan_need_col}{last_table_row}),2)',
                     font=font_normal, alignment=align_center,
                     border=make_border(left=thin, right=thin, top=medium, bottom=thin))
            ws[f'{plan_need_col}{actual_row}'].number_format = '0.00'
            set_cell(f'{plan_note_col}{actual_row}', border=make_border(left=thin, right=thin, top=medium, bottom=thin))
            set_cell(f'{plan_width_col}{actual_row}', border=make_border(left=thin, right=medium, top=medium, bottom=thin))
            ws[f'{plan_adjust_col}{actual_row}'].border = make_border(left=medium, right=medium, top=medium, bottom=thin)
            ws[f'{plan_adjust_col}{actual_row}'].fill = fill_theme6_tint80

            current_row += 1

            # Dòng SẢN LƯỢNG DƯƠNG = THỰC CẮT - TỔNG SẢN LƯỢNG CỠ.
            ws.row_dimensions[current_row].height = 18.0
            diff_row = current_row
            set_cell(f'A{diff_row}', border=make_border(left=medium, right=medium, bottom=medium))

            for col in ['B', 'C', 'D', 'E', 'F', 'G']:
                set_cell(f'{col}{diff_row}', border=make_border(
                    left=medium if col == 'B' else None,
                    right=medium if col == 'G' else None,
                    top=thin, bottom=medium), fill=fill_theme9_tint80)
            ws.merge_cells(f'B{diff_row}:G{diff_row}')
            _fabric_mode_for_diff = str(result.get('fabric_mode', '') or '')
            _diff_label = ('SẢN LƯỢNG ÂM/DƯƠNG / +/- QTY'
                           if _fabric_mode_for_diff in ('interlining', 'padding')
                           else 'SẢN LƯỢNG DƯƠNG/EXCESS QTY')
            set_cell(f'B{diff_row}', _diff_label, font=Font(name='Calibri', size=9), alignment=Alignment(horizontal='center', vertical='center', wrap_text=False, shrink_to_fit=True),
                     border=make_border(left=medium, right=medium, top=thin, bottom=medium), fill=fill_theme9_tint80)

            for idx, (key, col) in enumerate(zip(size_keys, plan_size_cols)):
                left = medium if idx == 0 else thin
                right = medium if idx == len(plan_size_cols)-1 else thin
                target_expr = fabric_target_by_col.get(col, '0')
                formula = f'={col}{actual_row}-({target_expr})'
                set_cell(f'{col}{diff_row}', formula, font=font_normal, alignment=align_center,
                         border=make_border(left=left, right=right, top=thin, bottom=medium),
                         fill=fill_theme9_tint60)

            set_cell(f'{plan_total_col}{diff_row}', f'=SUM({plan_first_size_col}{diff_row}:{plan_last_size_col}{diff_row})',
                     font=font_bold, alignment=align_center,
                     border=make_border(left=medium, right=thin, top=thin, bottom=medium),
                     fill=fill_theme9_tint60)
            set_cell(f'{plan_norm_col}{diff_row}', border=make_border(left=thin, right=thin, top=thin, bottom=medium))
            # Theo mau hinh 2: dong duong hien dinh muc thuc te binh quan = Tong met / Tong thuc cat.
            set_cell(f'{plan_need_col}{diff_row}', f'=ROUND(IFERROR({plan_need_col}{actual_row}/{plan_total_col}{actual_row},0),2)',
                     font=font_normal, alignment=align_center,
                     border=make_border(left=thin, right=thin, top=thin, bottom=medium))
            ws[f'{plan_need_col}{diff_row}'].number_format = '0.00'
            set_cell(f'{plan_note_col}{diff_row}', border=make_border(left=thin, right=thin, top=thin, bottom=medium))
            set_cell(f'{plan_width_col}{diff_row}', border=make_border(left=thin, right=medium, top=thin, bottom=medium))
            ws[f'{plan_adjust_col}{diff_row}'].border = make_border(left=medium, right=medium, top=thin, bottom=medium)
            ws[f'{plan_adjust_col}{diff_row}'].fill = fill_theme6_tint80

            # GHI CHÚ Shade V21: là công thức động. Khi sửa chiều dài sơ đồ / số lá
            # trong Excel, số mét dùng, Shade đã dùng và mét dư tự cập nhật.
            ws.merge_cells(f'{plan_note_col}{first_table_row}:{plan_note_col}{diff_row}')
            set_cell(
                f'{plan_note_col}{first_table_row}',
                dynamic_note_formula if dynamic_note_formula else None,
                font=font_normal,
                alignment=Alignment(horizontal='left', vertical='center', wrap_text=True),
                border=make_border(left=medium, right=medium, top=medium, bottom=medium)
            )

            # MERGE phần LOẠI VẢI theo toàn bộ khối từ B1 đến SẢN LƯỢNG DƯƠNG.
            ws.merge_cells(start_row=first_table_row, start_column=1,
                           end_row=diff_row, end_column=1)
            set_cell(f'A{first_table_row}', fabric['name'], font=font_normal,
                     alignment=Alignment(horizontal='center', vertical='center', wrap_text=True),
                     border=make_border(left=medium, right=medium, top=medium, bottom=medium))

            # V32: lưu vùng BIỂU CẮT của từng loại vải để SỬA PHÂN CÂY có thể
            # tự chia một Shade cho 1 hoặc nhiều loại vải theo số mét còn thiếu.
            fabric_excel_info[id(fabric)] = {
                'first_table_row': first_table_row,
                'last_table_row': last_table_row,
                'actual_row': actual_row,
                'diff_row': diff_row,
                'need_total_ref': f"SUM('{main_sheet_ref}'!{plan_need_col}{first_table_row}:{plan_need_col}{last_table_row})",
                'label_cell': f'A{first_table_row}',
            }

            current_row += 2

        # ===== GHI THÔNG TIN ĐƠN HÀNG BỔ SUNG =====
        # Ghi ở cuối quá trình dựng bố cục để không bị các bảng PO/vải ghi đè.
        # Các vị trí đã được lập kế hoạch ở trên nên ô trống giữ nguyên đúng dòng.
        max_custom_print_row = 0
        for item in pending_custom_info:
            row = item['row']
            ci = item['ci']
            col = item['col']

            # Lớp bảo vệ cuối: nếu có một ô phát sinh ngoài dự kiến, chỉ dời riêng
            # thông tin này tới ô trống kế tiếp; tuyệt đối không ghi đè dữ liệu.
            while True:
                cell = ws.cell(row, ci)
                merged_hit = any(cell.coordinate in rng for rng in ws.merged_cells.ranges)
                if cell.value is None and not merged_hit:
                    break
                row += 1

            set_cell(f'{col}{row}', item['text'], font=font_bold,
                     alignment=Alignment(vertical='center', wrap_text=False))
            ws.row_dimensions[row].height = max(float(ws.row_dimensions[row].height or 15), 24.0)
            if ci <= note_col_idx:
                max_custom_print_row = max(max_custom_print_row, row)

        # ===== V82: 3 BÀN DỰ PHÒNG - MỞ TỪNG BÀN =====
        # Dùng 3 cấp Outline lồng nhau. Bàn thật luôn level 0 và không bị ẩn.
        # Khi đóng chỉ có 1 dấu + cạnh bàn thật cuối; bấm + hiện đúng 1 bàn dự phòng.
        # Sau khi bàn đó hiện, dấu + kế tiếp cho phép mở bàn tiếp theo.
        ws.sheet_properties.outlinePr.summaryBelow = False
        ws.sheet_view.showOutlineSymbols = True

        for reserve_rows in reserve_row_groups:
            if not reserve_rows:
                continue
            for pos, reserve_row in enumerate(reserve_rows, start=1):
                rd = ws.row_dimensions[reserve_row]
                rd.outlineLevel = min(pos, 3)
                rd.hidden = True
                rd.collapsed = False

            # Bàn thật cuối là summary của cấp 1: luôn hiển thị, không bị Outline ẩn.
            outer_summary = reserve_rows[0] - 1
            if outer_summary >= 1:
                rd = ws.row_dimensions[outer_summary]
                rd.outlineLevel = 0
                rd.hidden = False
                rd.collapsed = True

            # Mỗi bàn dự phòng đã mở trở thành summary để mở bàn kế tiếp.
            for i in range(1, len(reserve_rows)):
                ws.row_dimensions[reserve_rows[i-1]].collapsed = True

        # ===== IN A4 NGANG =====
        # Thu đúng 1 trang theo bề ngang; chiều dọc để tự chạy nhiều trang.
        # Manual page break phía trên đã được tính theo scale thực tế của bề ngang,
        # vì vậy mỗi trang sẽ tận dụng khổ A4 tốt hơn nhưng vẫn giữ nguyên từng khối vải.
        ws.sheet_properties.pageSetUpPr.fitToPage = True
        ws.page_setup.orientation = ws.ORIENTATION_LANDSCAPE
        ws.page_setup.paperSize = ws.PAPERSIZE_A4
        ws.page_setup.fitToWidth = 1
        ws.page_setup.fitToHeight = 0
        ws.page_margins.left = PRINT_MARGIN_LEFT_IN
        ws.page_margins.right = PRINT_MARGIN_RIGHT_IN
        ws.page_margins.top = PRINT_MARGIN_TOP_IN
        ws.page_margins.bottom = PRINT_MARGIN_BOTTOM_IN
        ws.page_margins.header = 0.0
        ws.page_margins.footer = 0.0
        ws.print_options.horizontalCentered = True
        print_bottom_row = max(1, current_row - 1, max_custom_print_row)
        ws.print_area = f'A1:{plan_width_col}{print_bottom_row}'  # Cột điều chỉnh số lá được ẩn ngoài vùng in
        ws.sheet_view.showGridLines = False

        # Mọi ô MERGE đều có viền ngoài đậm (medium).
        # Làm ở cuối để không bị mất viền sau thao tác merge của openpyxl.
        from copy import copy
        for merged in list(ws.merged_cells.ranges):
            min_col, min_row, max_col, max_row = merged.bounds
            for rr in range(min_row, max_row + 1):
                for cc in range(min_col, max_col + 1):
                    cell = ws.cell(rr, cc)
                    old_border = cell.border
                    cell.border = Border(
                        left=medium if cc == min_col else old_border.left,
                        right=medium if cc == max_col else old_border.right,
                        top=medium if rr == min_row else old_border.top,
                        bottom=medium if rr == max_row else old_border.bottom
                    )

        # Chỉ xuống dòng ở những tiêu đề đã chủ động chèn \n vì cột hẹp.
        # Ô đủ rộng giữ Việt/Anh trên cùng một dòng. Phần thông tin chung luôn NO WRAP.
        for row in ws.iter_rows(min_row=percent_row, max_row=max(percent_row, current_row - 1),
                                min_col=1, max_col=10 + len(self.sizes)):
            for cell in row:
                if cell.value is not None:
                    al = copy(cell.alignment)
                    # Cột GHI CHÚ luôn giữ nguyên cỡ chữ, không shrink; nội dung dài tự xuống dòng.
                    if cell.column == excel_col_to_index(note_col):
                        al.wrap_text = True
                        al.shrink_to_fit = False
                    # V67: ô LOẠI VẢI ở cột A là ô merge dọc. Luôn WRAP để tên dài
                    # tự xuống dòng thay vì bị ép trên một dòng / thu nhỏ chữ.
                    elif cell.column == 1 and cell.coordinate in ws.merged_cells:
                        al.wrap_text = True
                        al.shrink_to_fit = False
                    else:
                        al.wrap_text = ('\n' in str(cell.value))
                        # Chỉ ô MERGE mới thu nhỏ chữ. Ô thường không shrink để chữ có thể tràn sang ô kế bên nếu ô đó trống.
                        al.shrink_to_fit = (cell.coordinate in ws.merged_cells)
                    cell.alignment = al

        # ===== V58: SỬA PHÂN CÂY - 1 Shade NHIỀU LOẠI VẢI, 1 CÂY / 1 LOẠI VẢI =====
        # Mỗi cây có ô LOẠI VẢI riêng và người dùng có thể sửa trực tiếp.
        # Tự động: một cây chỉ thuộc đúng một loại vải.
        # Thủ công: muốn chuyển đầu tấm sang loại vải khác thì nhập lại cùng Shade + SỐ CÂY
        # ở dòng khác với số mét đầu tấm; cây gốc tự trừ phần đã chuyển.
        edit_title_font = Font(name='Calibri', size=18, bold=True)
        edit_header_font = Font(name='Calibri', size=10, bold=True)
        edit_font = Font(name='Calibri', size=10)
        edit_fill_title = PatternFill('solid', fgColor='1F4E78')
        edit_fill_header = PatternFill('solid', fgColor='D9EAF7')
        edit_fill_input = PatternFill('solid', fgColor='FFF2CC')
        edit_fill_calc = PatternFill('solid', fgColor='E2F0D9')
        edit_fill_assign = PatternFill('solid', fgColor='FCE4D6')
        edit_thin = Side(style='thin', color='808080')
        edit_border = Border(left=edit_thin, right=edit_thin, top=edit_thin, bottom=edit_thin)

        edit_ws.sheet_view.showGridLines = False
        visible_edit_headers = ['LOẠI VẢI','Lot nhà sản xuất','Shade','SỐ CÂY','SỐ Y','SỐ MÉT','TRẠNG THÁI','GHI CHÚ','Khổ vải (cm)']
        edit_range_info_by_fabric = {}
        edit_table_info_by_fabric = edit_range_info_by_fabric

        # Lập danh sách Shade nguồn. Luôn giữ đủ Shade trong kho, kể cả Shade chưa gán.
        lot_blocks = []
        if getattr(self, 'global_lot_rows', None):
            for gi, grow in enumerate(self.global_lot_rows):
                lotn = str(grow.get('lot','') or '').strip()
                if not lotn:
                    continue
                lotmark = str(grow.get('lot_mark','') or '').strip()
                assigned = str(grow.get('assigned_fabric_name','') or '').strip() or 'CHƯA GÁN'
                details = list(self._ensure_lot_roll_details(grow) or [])
                roll_fabric_map = {}
                for _fname, _rolls in (grow.get('assigned_rolls_by_fabric', {}) or {}).items():
                    for _rn in (_rolls or []):
                        _raw_key = str(_rn or '').strip()
                        if '||' in _raw_key:
                            _rno, _rmark = _raw_key.split('||', 1)
                        else:
                            # Dự án cũ: chỉ có số cây, giữ tương thích với mark rỗng.
                            _rno, _rmark = _raw_key, ''
                        _rk = (str(_rno).strip().lower(), str(_rmark).strip().lower())
                        if _rk[0] and _rk not in roll_fabric_map:
                            roll_fabric_map[_rk] = str(_fname or '').strip()
                lot_blocks.append({'lot':lotn, 'lot_mark':lotmark, 'assigned':assigned,
                                   'details':details, 'global_index':gi,
                                   'roll_fabric_map':roll_fabric_map})
        else:
            seen = {}
            for fabric in self.fabric_list:
                fname = str(fabric.get('name','') or '')
                for rr in (fabric.get('rolls',[]) or []):
                    lotn = str(rr.get('lot', rr.get('shade','')) or '').strip()
                    if not lotn:
                        continue
                    if lotn not in seen:
                        seen[lotn] = {'lot':lotn, 'lot_mark':str(rr.get('lot_mark', rr.get('shade','')) or ''),
                                      'assigned':fname or 'CHƯA GÁN', 'details':[], 'global_index':None,
                                      'roll_fabric_map':{}}
                    _roll_name = str(rr.get('roll','') or '')
                    seen[lotn]['details'].append({'roll':_roll_name,
                                                  'lot_mark':str(rr.get('lot_mark', rr.get('shade','')) or ''),
                                                  'meters':float(rr.get('length',0) or 0)})
                    if _roll_name.strip() and fname:
                        _rmark = str(rr.get('lot_mark', rr.get('shade','')) or '').strip()
                        seen[lotn]['roll_fabric_map'][(_roll_name.strip().lower(), _rmark.lower())] = fname
            lot_blocks = list(seen.values())

        # V51: sắp xếp ban đầu phải dùng CÙNG logic BEST-FIT với _ROLL_CALC.
        # V50 dùng allocate_rolls_to_tables() (logic tuần tự cũ) nên có thể dự đoán sai
        # cây nào Excel thực sự chọn; kết quả là trạng thái ĐÃ DÙNG nằm xen giữa CHƯA DÙNG.
        # V53 mô phỏng đúng CAP/FIT/RANK/ALLOC của Excel trước khi ghi sheet:
        #   - ưu tiên Shade theo thứ tự;
        #   - trong Shade ưu tiên cây có sức chứa gần số lá bàn nhất;
        #   - cây đã dùng ở bàn trước chỉ đi tiếp nếu còn trải được >= 3 lá;
        #   - cây đã dùng xếp lên trên, rồi theo MÉT CÒN LẠI tăng dần.
        initial_usage = {}

        def _excel_initial_tables(_res):
            """Tính SỐ LÁ ban đầu đúng như công thức F trên BIỂU CẮT (khi % từng cỡ = 0).

            Python optimize_cutting() có thể cho số lá gốc hơi khác công thức động Excel ở
            một vài bàn cuối. Dùng lại đúng quy tắc dynamic_plies_formula để việc sắp cây
            khớp trạng thái ĐÃ DÙNG sau khi Excel tính công thức.
            """
            _tables = [dict(x) for x in ((_res or {}).get('cutting_tables', []) or [])]
            _targets = dict((_res or {}).get('total_by_size', {}) or {})
            _size_keys = [x.get('key') for x in self.sizes]
            _actual = {k: 0 for k in _size_keys}
            _out = []
            for _ti, _t in enumerate(_tables):
                _ratio_map = dict(_t.get('ratio_map', {}) or {})
                _parts = [(k, int(_ratio_map.get(k, 0) or 0)) for k in _size_keys
                          if int(_ratio_map.get(k, 0) or 0) > 0]
                if not _parts:
                    _plies = 0
                else:
                    _remaining = {k: max(0, int(_targets.get(k, 0) or 0) - int(_actual.get(k, 0) or 0))
                                  for k, _r in _parts}
                    _last = []
                    for k, _r in _parts:
                        _has_future = any(
                            int(((_ft.get('ratio_map', {}) or {}).get(k, 0) or 0)) > 0
                            for _ft in _tables[_ti + 1:]
                        )
                        if not _has_future:
                            _last.append((k, _r))
                    if sum(_remaining.values()) <= 0:
                        _plies = 0
                    elif _last:
                        _plies = max(
                            int(math.ceil(float(_remaining[k]) / float(r))) if r > 0 else 0
                            for k, r in _last
                        )
                    else:
                        _choices = [
                            int(math.ceil(float(_remaining[k]) / float(r)))
                            for k, r in _parts if r > 0 and _remaining[k] > 0
                        ]
                        _plies = min(_choices) if _choices else 0
                _nt = dict(_t)
                _nt['plies'] = max(0, int(_plies))
                _out.append(_nt)
                for k, r in _parts:
                    _actual[k] = int(_actual.get(k, 0) or 0) + int(_plies) * int(r)
            return _out

        def _estimate_bestfit_roll_states(_fabric, _tables):
            _reserve_m, _reserve_plies = self._fabric_roll_reserve_settings(_fabric)
            _states = []
            for _i, _r in enumerate((_fabric or {}).get('rolls', []) or []):
                try:
                    _length = max(0.0, float(_r.get('length', 0) or 0))
                except Exception:
                    _length = 0.0
                if _length <= 0:
                    continue
                _states.append({
                    'source_index': _i,
                    'lot': str(_r.get('lot','') or '').strip(),
                    'roll': str(_r.get('roll','') or '').strip() or str(_i + 1),
                    'lot_mark': str(_r.get('lot_mark', _r.get('shade','')) or '').strip(),
                    'length': _length,
                    'remaining': _length,
                    'used': 0.0,
                    'had_alloc': False,
                })

            # Thứ tự Shade đúng theo thứ tự nguồn đang có trong fabric['rolls'].
            _lot_order = {}
            for _st in _states:
                _ln = _st['lot']
                if _ln not in _lot_order:
                    _lot_order[_ln] = len(_lot_order) + 1

            _real_est_indexes = [i for i, t in enumerate(_tables or []) if int(t.get('plies', 0) or 0) > 0 and float(t.get('length', 0) or 0) > 0]
            _short_est_index = None
            if _real_est_indexes:
                _min_est_length = min(float((_tables or [])[i].get('length', 0) or 0) for i in _real_est_indexes)
                _short_est_index = max(i for i in _real_est_indexes if abs(float((_tables or [])[i].get('length', 0) or 0) - _min_est_length) < 1e-9)
            _eps = 1e-9
            for _table_est_index, _t in enumerate(_tables or []):
                try:
                    _target = max(0, int(_t.get('plies', 0) or 0))
                    _mpp = max(0.0, float(_t.get('length', 0) or 0)) * 1.01
                except Exception:
                    continue
                if _target <= 0 or _mpp <= 0:
                    continue

                _cands = []
                for _st in _states:
                    _raw_cap = max(0, int((_st['remaining'] + _eps) // _mpp))
                    # V163: ngưỡng mét đầu tấm + số lá chừa lấy từ từng loại vải.
                    if _raw_cap > 0:
                        _rem_after_raw = max(0.0, _st['remaining'] - _raw_cap * _mpp)
                        _reserve_cap = (max(0, _raw_cap - _reserve_plies)
                                        if _rem_after_raw < _reserve_m - _eps else _raw_cap)
                    else:
                        _reserve_cap = 0
                    # Bàn vét cho phép dùng phần còn lại sau khi đã chừa đầu tấm;
                    # bàn thường chỉ tiếp tục cây đang mở khi còn đủ từ 3 lá.
                    _cap = (_reserve_cap if _table_est_index == _short_est_index
                            else (0 if (_st['had_alloc'] and _reserve_cap < 3) else _reserve_cap))
                    if _cap <= 0:
                        continue
                    if _cap <= _target:
                        _rem_full = max(0.0, _st['remaining'] - _cap * _mpp)
                        _fit = ((_target - _cap) * 100000000
                                + round(_rem_full * 1000) * 1000
                                + (100000 - _cap))
                    else:
                        _rem_finish = max(0.0, _st['remaining'] - _target * _mpp)
                        _fit = (1000000000000
                                + round(_rem_finish * 1000) * 1000
                                + (_cap - _target))
                    # V91: trong cùng Shade, cây đã mở ở bàn trước luôn đứng trước cây mới
                    # nếu cây đang dở vẫn còn sức chứa >= 3 lá (đã được effective_cap lọc).
                    # Chỉ sau khi không còn cây đang dở phù hợp mới mở cây chưa dùng.
                    if _st['had_alloc']:
                        _fit += min(900.0, max(0.0, _st['remaining'])) * 1_000_000_000_000
                    else:
                        _fit += 1_000_000_000_000_000
                    _cands.append((_lot_order.get(_st['lot'], 10**9), _fit, _st['source_index'], _cap, _st))

                # Chính là RANK của Excel: Shade trước -> FIT tốt hơn -> thứ tự nguồn phá hòa.
                _cands.sort(key=lambda x: (x[0], x[1], x[2]))
                _prior_capacity = 0
                for _lotord, _fit, _src, _cap, _st in _cands:
                    _need = max(0, _target - _prior_capacity)
                    if _need <= 0:
                        break
                    _alloc = min(_cap, _need)
                    if _alloc <= 0:
                        continue
                    _meters = _alloc * _mpp
                    _st['remaining'] = max(0.0, _st['remaining'] - _meters)
                    _st['used'] += _meters
                    _st['had_alloc'] = True
                    # SUMIFS(prior capacity) của Excel dùng CAP của các cây xếp trước,
                    # không dùng số lá thực tế của cây chốt.
                    _prior_capacity += _cap

            return _states

        try:
            for _res in results:
                _fabric = _res.get('fabric')
                _tables = _excel_initial_tables(_res)
                for _st in _estimate_bestfit_roll_states(_fabric, _tables):
                    _key = (
                        str(_st.get('lot','') or '').strip(),
                        str(_st.get('lot_mark','') or '').strip(),
                        str(_st.get('roll','') or '').strip(),
                    )
                    _used = max(0.0, float(_st.get('used',0) or 0))
                    _rem = max(0.0, float(_st.get('remaining',0) or 0))
                    _old = initial_usage.get(_key)
                    if _old is None:
                        initial_usage[_key] = {'used': _used, 'remaining': _rem}
                    else:
                        _old['used'] += _used
                        _old['remaining'] = min(_old['remaining'], _rem)

            for _block in lot_blocks:
                _lotn = str(_block.get('lot','') or '').strip()
                _details = list(_block.get('details',[]) or [])
                _indexed = list(enumerate(_details))

                def _sort_tree(_item):
                    _idx, _d = _item
                    _roll = str(_d.get('roll','') or '').strip()
                    _mark = str(_d.get('lot_mark', _block.get('lot_mark','')) or '').strip()
                    _u = initial_usage.get((_lotn, _mark, _roll), {})
                    _used = float(_u.get('used',0) or 0)
                    _rem = float(_u.get('remaining', _d.get('meters',0) or 0) or 0)
                    # ĐÃ DÙNG trước -> còn ít mét nhất -> giữ thứ tự gốc khi bằng nhau.
                    return (0 if _used > 1e-9 else 1, _rem if _used > 1e-9 else 1e18, _idx)

                _block['details'] = [d for _, d in sorted(_indexed, key=_sort_tree)]
        except Exception as _sort_err:
